//@version=6
indicator('Smart Money Concepts [LUX]', 'Smart Money Concepts [LuxAlgo]', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// NOTE: All library imports were removed — none of the imported namespaces
// (Refiner/Drawing/FVG/Liq/Alert/D/PF/ND/M/SMC and the unaliased ta) is referenced
// anywhere in the script. Every ta.* call used is a core Pine v6 built-in, and the
// only 'FVG.new(...)' references bind to the user-defined `type FVG` declared below,
// not to the imported library. Compiling these unused libraries was the single
// largest contributor to the compile-time timeout.

display = display.all - display.status_line
//==============================================================================
//                     SHARED ZIGZAG SETTINGS
//==============================================================================
lbR = input.int(5, 'Lookback: Right', inline = 'lb', group = 'Zigzag Settings')
lbL = input.int(120, 'Left', inline = 'lb', group = 'Zigzag Settings')
show_zigzag = input.bool(true, 'Show Zigzag', inline = 'zigzag', group = 'Zigzag Settings')
zigzag_color = input.color(#c8ff0004, 'Color', inline = 'zigzag', group = 'Zigzag Settings')
retrepaint = input.bool(true, 'Repaint', inline = 'zigzag', group = 'Zigzag Settings') and show_zigzag

//==============================================================================
//                     SHARED ZIGZAG LOGIC
//==============================================================================
new_pivot_high = not na(ta.pivothigh(high, lbL, lbR))
new_pivot_low = not na(ta.pivotlow(low, lbL, lbR))
new_pivot = new_pivot_high or new_pivot_low

direction = math.sign(ta.barssince(new_pivot_high) - ta.barssince(new_pivot_low))
new_direction = bool(ta.change(direction))

var chart.point last_pivot = chart.point.now(low)
var chart.point second_last_pivot = chart.point.now(high)

if new_direction
    second_last_pivot := last_pivot.copy()

if new_pivot_high
    if new_direction
        last_pivot := chart.point.from_index(bar_index - lbR, high[lbR])
    else
        if high[lbR] > last_pivot.price
            last_pivot := chart.point.from_index(bar_index - lbR, high[lbR])

if new_pivot_low
    if new_direction
        last_pivot := chart.point.from_index(bar_index - lbR, low[lbR])
    else
        if low[lbR] < last_pivot.price
            last_pivot := chart.point.from_index(bar_index - lbR, low[lbR])

var line retzigzag = na

if new_pivot and show_zigzag
    retzigzag := line.new(last_pivot, second_last_pivot, xloc.bar_index, extend.none, zigzag_color)
    if not new_direction
        line.delete(retzigzag[1])

var array<chart.point> points = array.new<chart.point>()

if bool(ta.change(bar_index))
    points.clear()
    points.push(last_pivot)
    points.push(chart.point.now(hl2))

var polyline repainted_zigzag = na

if retrepaint
    polyline.delete(repainted_zigzag)
    repainted_zigzag := polyline.new(points, xloc = xloc.bar_index, line_style = line.style_dotted, line_color = zigzag_color)

//==============================================================================
//                     AUTO FIB AI [D3R]
//==============================================================================
// COLORS
C_BULL    = color.new(#00f0ff, 0)
C_BEAR    = color.new(#ff00aa, 0)
C_GREEN   = color.new(#00c896, 0)
C_RED     = color.new(#ff4466, 0)
C_AMBER   = color.new(#ffb700, 0)
C_NEUTRAL = color.new(#64748b, 0)
C_BG      = color.new(#131722, 5)
C_TXT     = color.new(#f8fafc, 0)
C_DIM     = color.new(#94a3b8, 0)
C_BORD    = color.new(#334155, 0)


// INPUTS
GRP_DET = "📐 Swing Detection"
GRP_TCH = "🎯 Level Grading"
GRP_VIS = "🎨 Visualization"
GRP_HUD = "🖥️ Dashboard"

pivot_leg   = input.int(8, "Pivot Leg (bars each side)", minval=3, maxval=30, group=GRP_DET,
              tooltip="Bars required on each side to confirm a swing pivot. Larger = bigger, more significant swings.")
min_swing_atr = input.float(3.0, "Min Swing Size (×ATR)", minval=0.5, maxval=20.0, step=0.5, group=GRP_DET,
              tooltip="Swings smaller than this are ignored — tiny swings produce meaningless fib structures.")

touch_tol   = input.float(0.2, "Touch Tolerance (×ATR)", minval=0.05, maxval=1.0, step=0.05, group=GRP_TCH)
break_buf   = input.float(0.3, "Break Buffer (×ATR)", minval=0.05, maxval=1.5, step=0.05, group=GRP_TCH,
              tooltip="Close must clear a level by this margin to grade the touch as a break.")
bounce_atr  = input.float(1.0, "Bounce Distance (×ATR)", minval=0.3, maxval=5.0, step=0.1, group=GRP_TCH,
              tooltip="Price must move away from the level at least this far, without breaking, to grade as a bounce.")
outcome_bars = input.int(10, "Outcome Window (bars)", minval=3, maxval=50, group=GRP_TCH)
ext_window  = input.int(40, "Extension Window (bars)", minval=10, maxval=200, group=GRP_TCH,
              tooltip="Bars after a swing-extreme break within which extension targets must be reached to count as hit.")

show_ext    = input.bool(true, "Show Extension Targets", group=GRP_VIS)
show_stats  = input.bool(true, "Per-Level Stat Labels", group=GRP_VIS)

show_hud = input.bool(true, "Show Dashboard", group=GRP_HUD)
hud_pos  = input.string("Top Right", "Position",
           options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=GRP_HUD)


atr_raw = ta.atr(14)
fib_ph = ta.pivothigh(high, pivot_leg, pivot_leg)
fib_pl = ta.pivotlow(low,  pivot_leg, pivot_leg)


// FIB LEVELS
var float[] FIB_R = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
var float[] FIB_E = array.from(1.272, 1.618)

var int[] lvl_touches = array.new<int>(5, 0)
var int[] lvl_bounces = array.new<int>(5, 0)

var int ext_attempts = 0
var int ext_hit_1    = 0   // reached 1.272
var int ext_hit_2    = 0   // reached 1.618

// ACTIVE FIB STRUCTURE
var bool  fib_active  = false
var bool  fib_is_up   = false     // up-swing: levels retrace DOWN from high
var float fib_hi      = na
var float fib_lo      = na
var int   fib_hi_bar  = na
var int   fib_lo_bar  = na

// Most recent confirmed pivots
var float last_ph = na
var int   last_ph_bar = na
var float last_pl = na
var int   last_pl_bar = na

// Pending touch (single slot)
var int   pend_bar   = na
var int   pend_lvl   = na
var float pend_price = na

// Extension pending
var int   extp_bar = na
var float extp_t1  = na
var float extp_t2  = na
var bool  extp_hit1 = false

// Drawing storage
var line[]  fib_lines  = array.new<line>()
var label[] fib_labels = array.new<label>()

f_lvl_price(int i) =>
    float r = array.get(FIB_R, i)
    fib_is_up ? fib_hi - (fib_hi - fib_lo) * r : fib_lo + (fib_hi - fib_lo) * r

f_ext_price(int i) =>
    float r = array.get(FIB_E, i)
    fib_is_up ? fib_hi + (fib_hi - fib_lo) * (r - 1.0) : fib_lo - (fib_hi - fib_lo) * (r - 1.0)

f_clear_fib() =>
    if array.size(fib_lines) > 0
        for i = 0 to array.size(fib_lines) - 1
            line.delete(array.get(fib_lines, i))
        array.clear(fib_lines)
    if array.size(fib_labels) > 0
        for i = 0 to array.size(fib_labels) - 1
            label.delete(array.get(fib_labels, i))
        array.clear(fib_labels)

f_draw_fib() =>
    f_clear_fib()
    int x1 = math.min(fib_hi_bar, fib_lo_bar)
    int x2 = bar_index + 10
    array.push(fib_lines, line.new(x1, fib_is_up ? fib_hi : fib_lo, x2, fib_is_up ? fib_hi : fib_lo,
               color=color.new(fib_is_up ? C_BULL : C_BEAR, 30), width=2))
    array.push(fib_lines, line.new(x1, fib_is_up ? fib_lo : fib_hi, x2, fib_is_up ? fib_lo : fib_hi,
               color=color.new(C_NEUTRAL, 55), width=1))
    for i = 0 to 4
        float lp = f_lvl_price(i)
        color lc = i == 3 ? C_AMBER : C_DIM
        array.push(fib_lines, line.new(x1, lp, x2, lp,
                   color=color.new(lc, i == 3 ? 20 : 40), width=1,
                   style=line.style_dotted))
        if show_stats
            int t = array.get(lvl_touches, i)
            int b = array.get(lvl_bounces, i)
            string s = str.tostring(array.get(FIB_R, i), "#.###")
            if t > 0
                s := s + "  |  " + str.tostring(math.round(float(b) / float(t) * 100.0)) + "% bounced (n=" + str.tostring(t) + ")"
            else
                s := s + "  |  no touches yet"
            array.push(fib_labels, label.new(x2, lp, s,
                       style=label.style_label_left,
                       color=color.new(#000000, 100),
                       textcolor=lc, size=10))
    if show_ext
        for i = 0 to 1
            float ep = f_ext_price(i)
            array.push(fib_lines, line.new(x1, ep, x2, ep,
                       color=color.new(C_GREEN, 60), width=1, style=line.style_dashed))
            string es = str.tostring(array.get(FIB_E, i), "#.###")
            if ext_attempts > 0
                int hits = i == 0 ? ext_hit_1 : ext_hit_2
                es := es + "  |  hit " + str.tostring(math.round(float(hits) / float(ext_attempts) * 100.0)) + "% (n=" + str.tostring(ext_attempts) + ")"
            array.push(fib_labels, label.new(x2, ep, es,
                       style=label.style_label_left,
                       color=color.new(#000000, 100),
                       textcolor=C_GREEN, size=10))
    true


if barstate.isconfirmed

    // ── COLLECT PIVOTS / REBUILD FIB
    bool rebuilt = false
    if not na(fib_ph)
        last_ph     := fib_ph
        last_ph_bar := bar_index - pivot_leg
        rebuilt := true
    if not na(fib_pl)
        last_pl     := fib_pl
        last_pl_bar := bar_index - pivot_leg
        rebuilt := true

    if rebuilt and not na(last_ph) and not na(last_pl)
        if math.abs(last_ph - last_pl) >= min_swing_atr * atr_raw
            fib_active := true
            fib_is_up  := last_ph_bar > last_pl_bar
            fib_hi     := last_ph
            fib_lo     := last_pl
            fib_hi_bar := last_ph_bar
            fib_lo_bar := last_pl_bar
            pend_bar   := na
            extp_bar   := na
            extp_hit1  := false
            f_draw_fib()

    if fib_active and not na(pend_bar)
        float lv = pend_price
        bool is_from_above = fib_is_up    // in an up-swing retracement, price comes down onto levels
        bool broke = is_from_above ? close < lv - break_buf * atr_raw : close > lv + break_buf * atr_raw
        bool bounced = is_from_above ? (close - lv) >= bounce_atr * atr_raw : (lv - close) >= bounce_atr * atr_raw
        bool timed_out = (bar_index - pend_bar) >= outcome_bars
        if broke or bounced or timed_out
            array.set(lvl_touches, pend_lvl, array.get(lvl_touches, pend_lvl) + 1)
            if bounced
                array.set(lvl_bounces, pend_lvl, array.get(lvl_bounces, pend_lvl) + 1)
            pend_bar := na
            f_draw_fib()

    if fib_active and na(pend_bar)
        int   best_i = na
        float best_d = touch_tol * atr_raw
        for i = 0 to 4
            float lp = f_lvl_price(i)
            float d = fib_is_up ? math.abs(low - lp) : math.abs(high - lp)
            bool correct_side = fib_is_up ? close > lp : close < lp
            if d <= best_d and correct_side
                best_d := d
                best_i := i
        if not na(best_i)
            pend_bar   := bar_index
            pend_lvl   := best_i
            pend_price := f_lvl_price(best_i)

    // ── EXTENSION TARGET TRACKING
    if fib_active and na(extp_bar)
        bool broke_extreme = fib_is_up ? close > fib_hi + break_buf * atr_raw : close < fib_lo - break_buf * atr_raw
        if broke_extreme
            extp_bar  := bar_index
            extp_t1   := f_ext_price(0)
            extp_t2   := f_ext_price(1)
            extp_hit1 := false
            ext_attempts += 1

    if not na(extp_bar)
        bool hit1 = fib_is_up ? high >= extp_t1 : low <= extp_t1
        bool hit2 = fib_is_up ? high >= extp_t2 : low <= extp_t2
        if hit1 and not extp_hit1
            ext_hit_1 += 1
            extp_hit1 := true
        if hit2
            ext_hit_2 += 1
            extp_bar := na
            f_draw_fib()
        else if (bar_index - extp_bar) >= ext_window
            extp_bar := na
            f_draw_fib()


// DASHBOARD
f_hud_pos(string s) =>
    switch s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        =>                position.bottom_left

var table hud = table.new(f_hud_pos(hud_pos), 2, 10,
                           bgcolor=C_BG, border_color=C_BORD,
                           border_width=1, frame_color=C_BORD, frame_width=2)

if show_hud and barstate.islast
    table.cell(hud, 0, 0, "AUTO FIB AI [D3R]", text_color=C_TXT,
               bgcolor=color.new(#1e293b, 0), text_size=11, text_halign=text.align_center)
    table.merge_cells(hud, 0, 0, 1, 0)

    table.cell(hud, 0, 1, "Swing", text_color=C_DIM, bgcolor=color.new(#1e293b, 40), text_size=11)
    table.cell(hud, 1, 1, not fib_active ? "—" : fib_is_up ? "▲ UP" : "▼ DOWN",
               text_color=not fib_active ? C_DIM : fib_is_up ? C_BULL : C_BEAR,
               bgcolor=color.new(#1e293b, 40), text_size=11, text_halign=text.align_center)

    for i = 0 to 4
        int t = array.get(lvl_touches, i)
        int b = array.get(lvl_bounces, i)
        string rowlab = str.tostring(array.get(FIB_R, i), "#.###")
        string rowval = t > 0 ? str.tostring(math.round(float(b) / float(t) * 100.0)) + "%  (n=" + str.tostring(t) + ")" : "—"
        color rc = t == 0 ? C_DIM : float(b) / float(t) >= 0.5 ? C_GREEN : C_RED
        table.cell(hud, 0, 2 + i, rowlab, text_color=i == 3 ? C_AMBER : C_DIM,
                   bgcolor=color.new(i % 2 == 0 ? #1e293b : #0f172a, 40), text_size=11)
        table.cell(hud, 1, 2 + i, rowval, text_color=rc,
                   bgcolor=color.new(i % 2 == 0 ? #1e293b : #0f172a, 40),
                   text_size=11, text_halign=text.align_center)

    string e1 = ext_attempts > 0 ? str.tostring(math.round(float(ext_hit_1) / float(ext_attempts) * 100.0)) + "% / " + str.tostring(math.round(float(ext_hit_2) / float(ext_attempts) * 100.0)) + "%" : "—"
    table.cell(hud, 0, 7, "Ext 1.272/1.618", text_color=C_DIM, bgcolor=color.new(#1e293b, 40), text_size=11)
    table.cell(hud, 1, 7, e1 + (ext_attempts > 0 ? "  (n=" + str.tostring(ext_attempts) + ")" : ""),
               text_color=ext_attempts > 0 ? C_GREEN : C_DIM,
               bgcolor=color.new(#1e293b, 40), text_size=11, text_halign=text.align_center)


// ALERTS
bool touch_now = fib_active and not na(pend_bar) and pend_bar == bar_index
var bool extreme_broken_prev = false
bool extreme_broken_now = not na(extp_bar) and extp_bar == bar_index

alertcondition(touch_now,          "Fib Level Touch",    "D3R Auto Fib: price touched a fibonacci level — check its measured bounce rate")
alertcondition(extreme_broken_now, "Swing Extreme Break","D3R Auto Fib: swing extreme broken — extension targets active")


//////////////Liquidity Sentiment Profile///////////
group_mode = '🎯 Mode Selection'
advanced_mode = input.bool(false, 'Advanced Mode', group = group_mode, tooltip = 'Enable advanced features and customization options')

group1 = '🔍 Detection Settings'
liq_swing_length = input.int(20, 'Swing Length', minval = 5, maxval = 100, group = group1, tooltip = 'Bars checked for swing point detection')
zscore_period = input.int(50, 'Z-Score Period', minval = 20, maxval = 200, group = group1, tooltip = 'Period for volume statistics calculation')

group2 = '📊 Thresholds'
normal_threshold = input.float(1.0, 'Normal Activity', minval = 0.5, maxval = 2.0, step = 0.1, group = group2, tooltip = 'Below this = Normal volume')
elevated_threshold = input.float(2.0, 'Elevated Activity', minval = 1.0, maxval = 3.0, step = 0.1, group = group2, tooltip = 'Above this = Elevated volume')
institutional_threshold = input.float(3.0, 'Institutional Activity', minval = 2.0, maxval = 5.0, step = 0.1, group = group2, tooltip = 'Above this = Potential accumulation/distribution')

group3 = '⚙️ Advanced Features'
use_adaptive = input.bool(true, 'Enable Adaptive Thresholds', group = group3, tooltip = 'Adjust thresholds based on market regime')
use_htf_confirm = input.bool(true, 'Higher Timeframe Confirmation', group = group3, tooltip = 'Confirm signals with HTF volume')
htf_timeframe = input.timeframe('', 'HTF (Auto if empty)', group = group3, tooltip = 'Leave empty for auto-detection')

group3_adv = '🚀 Advanced HTF Settings'
adaptive_htf_threshold = advanced_mode ? input.bool(true, 'Adaptive HTF Threshold', group = group3_adv, tooltip = 'Adjust HTF confirmation threshold based on market volatility') : true
volume_trend_arrows = advanced_mode ? input.bool(true, 'Volume Trend Arrows', group = group3_adv, tooltip = 'Show volume acceleration/deceleration arrows') : true
enhanced_sizing = advanced_mode ? input.bool(true, 'Enhanced Label Sizing', group = group3_adv, tooltip = 'Use larger labels for extreme institutional activity') : true

group4 = '📈 Display Options'
show_swing_labels = input.bool(true, 'Show Swing Labels', group = group4, tooltip = 'Display HH, LH, HL, LL labels')
show_zscore_values = input.bool(true, 'Show Z-Score Values', group = group4, tooltip = 'Display numerical Z-score values')
show_zscore_plot = input.bool(false, 'Show Z-Score Plot', group = group4, tooltip = 'Display Z-score in separate pane')
show_info_table = input.bool(true, 'Show Info Table', group = group4, tooltip = 'Display real-time statistics')
base_label_size = input.string('Medium', 'Label Size', options = ['Small', 'Medium', 'Large', 'X-Large'], group = group4, tooltip = 'Base size for all labels - adjust to your screen/chart setup')

group_table = '📊 Table Customization'
table_position = advanced_mode ? input.string('Top Right', 'Table Position', options = ['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right', 'Middle Left', 'Middle Right'], group = group_table) : 'Top Right'
table_size = advanced_mode ? input.string('Normal', 'Table Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = group_table) : 'Normal'
table_transparency = advanced_mode ? input.int(10, 'Table Transparency', minval = 0, maxval = 95, step = 5, group = group_table) : 10

volume_mean = ta.sma(volume, zscore_period)
volume_stdev = ta.stdev(volume, zscore_period)
volume_zscore = volume_stdev > 0 ? (volume - volume_mean) / volume_stdev : 0

volume_trend_period = 10
volume_sma_short = ta.sma(volume, 5)
volume_sma_long = ta.sma(volume, volume_trend_period)
volume_trend_ratio = volume_sma_long > 0 ? volume_sma_short / volume_sma_long : 1

get_volume_trend_arrow() =>
    if not volume_trend_arrows
        ''
    else if volume_trend_ratio > 1.15
        ' ↗️'
    else if volume_trend_ratio < 0.85
        ' ↘️'
    else
        ' ↔️'

ma20 = ta.sma(close, 20)
ma_slope = (ma20 - ma20[5]) / ta.atr(10) * 100
atr_current = ta.atr(14)
atr_avg = ta.sma(atr_current, 20)

is_trending = math.abs(ma_slope) > 0.5
is_high_vol = atr_current > atr_avg * 1.2

adaptive_multiplier = if use_adaptive
    base = is_trending ? 1.3 : 0.8
    vol_adj = is_high_vol ? 1.2 : 1.0
    base * vol_adj
else
    1.0

current_normal = normal_threshold * adaptive_multiplier
current_elevated = elevated_threshold * adaptive_multiplier
current_institutional = institutional_threshold * adaptive_multiplier

get_htf() =>
    if htf_timeframe != '' and htf_timeframe != timeframe.period
        htf_timeframe
    else
        current_tf_seconds = timeframe.in_seconds()
        if current_tf_seconds <= 60
            '5'
        else if current_tf_seconds <= 300
            '15'
        else if current_tf_seconds <= 900
            '60'
        else if current_tf_seconds <= 3600
            '240'
        else if current_tf_seconds <= 14400
            '1D'
        else if current_tf_seconds <= 86400
            '1W'
        else
            '1M'

liq_htf = get_htf()
current_tf_seconds = timeframe.in_seconds()
htf_seconds = timeframe.in_seconds(liq_htf)
is_htf_valid = htf_seconds > current_tf_seconds and use_htf_confirm

// Corrected: Replaced ternary tuple return with if/else
[htf_volume, htf_vol_mean, htf_vol_stdev] = if is_htf_valid
    request.security(syminfo.tickerid, liq_htf, [volume, ta.sma(volume, zscore_period), ta.stdev(volume, zscore_period)], lookahead = barmerge.lookahead_off)
else
    [volume, volume_mean, volume_stdev]

htf_zscore = if is_htf_valid and htf_vol_stdev > 0
    (htf_volume - htf_vol_mean) / htf_vol_stdev
else
    volume_zscore

base_htf_threshold = 1.5
adaptive_htf_multiplier = if adaptive_htf_threshold and is_htf_valid
    volatility_factor = atr_current / ta.sma(atr_current, 50)
    if volatility_factor > 1.5
        1.3
    else if volatility_factor < 0.7
        0.8
    else
        1.0
else
    1.0

current_htf_threshold = base_htf_threshold * adaptive_htf_multiplier

htf_confirmed = if use_htf_confirm and is_htf_valid
    math.abs(htf_zscore) >= current_htf_threshold
else
    true

var int total_signals = 0
var int confirmed_signals = 0

if not na(ta.pivothigh(high, liq_swing_length, liq_swing_length)) or not na(ta.pivotlow(low, liq_swing_length, liq_swing_length))
    total_signals := total_signals + 1
    if htf_confirmed
        confirmed_signals := confirmed_signals + 1

success_rate = total_signals > 0 ? math.round(confirmed_signals * 100 / total_signals) : 0

pivot_high = ta.pivothigh(high, liq_swing_length, liq_swing_length)
pivot_low = ta.pivotlow(low, liq_swing_length, liq_swing_length)

var float prev_high = 0.0
var float prev_low = 0.0
var bool first_high = true
var bool first_low = true

higher_high = false
lower_high = false
higher_low = false
lower_low = false

if not na(pivot_high)
    if first_high
        higher_high := true
        first_high := false
    else if pivot_high >= prev_high
        higher_high := true
    else
        lower_high := true
    prev_high := pivot_high

if not na(pivot_low)
    if first_low
        higher_low := true
        first_low := false
    else if pivot_low >= prev_low
        higher_low := true
    else
        lower_low := true
    prev_low := pivot_low

INSTITUTIONAL_COLOR = color.new(#ff4444, 0)
INSTITUTIONAL_COLOR_WEAK = color.new(#ff4444, 30)
ELEVATED_COLOR = color.new(#ff9800, 0)
ELEVATED_COLOR_WEAK = color.new(#ff9800, 30)
NORMAL_COLOR = color.new(#4caf50, 0)
NORMAL_COLOR_WEAK = color.new(#4caf50, 30)
LOW_COLOR = color.new(#9e9e9e, 60)

get_zscore_color(zscore) =>
    abs_zscore = math.abs(zscore)
    if abs_zscore >= current_institutional
        htf_confirmed ? INSTITUTIONAL_COLOR : INSTITUTIONAL_COLOR_WEAK
    else if abs_zscore >= current_elevated
        htf_confirmed ? ELEVATED_COLOR : ELEVATED_COLOR_WEAK
    else if abs_zscore >= current_normal
        htf_confirmed ? NORMAL_COLOR : NORMAL_COLOR_WEAK
    else
        LOW_COLOR

get_significance_text(zscore) =>
    abs_zscore = math.abs(zscore)
    if abs_zscore >= current_institutional
        '🔴 INSTITUTIONAL'
    else if abs_zscore >= current_elevated
        '🟠 ELEVATED'
    else if abs_zscore >= current_normal
        '🟢 NORMAL'
    else
        '⚪ LOW'

get_base_label_size() =>
    switch base_label_size
        'Small' => size.small
        'Medium' => size.normal
        'Large' => size.large
        'X-Large' => size.huge
        => size.normal

get_label_size(zscore) =>
    abs_zscore = math.abs(zscore)
    base_size = get_base_label_size()

    if enhanced_sizing and abs_zscore >= current_institutional and htf_confirmed
        switch base_label_size
            'Small' => size.large
            'Medium' => size.large
            'Large' => size.huge
            'X-Large' => size.huge
            => size.large
    else if enhanced_sizing and abs_zscore >= current_institutional
        base_size
    else if is_htf_valid and not htf_confirmed
        switch base_label_size
            'Small' => size.tiny
            'Medium' => size.small
            'Large' => size.normal
            'X-Large' => size.large
            => size.small
    else
        base_size

get_table_position() =>
    switch table_position
        'Top Left' => position.top_left
        'Top Right' => position.top_right
        'Bottom Left' => position.bottom_left
        'Bottom Right' => position.bottom_right
        'Middle Left' => position.middle_left
        'Middle Right' => position.middle_right
        => position.top_right

get_table_text_size() =>
    switch table_size
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        => size.normal

if not na(pivot_high)
    zscore_at_swing = volume_zscore[liq_swing_length]
    htf_zscore_at_swing = htf_zscore[liq_swing_length]
    swing_color = get_zscore_color(zscore_at_swing)

    label_text = ''
    volume_arrow = get_volume_trend_arrow()

    if show_swing_labels and show_zscore_values
        swing_type = higher_high ? 'HH' : 'LH'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow
    else if show_swing_labels
        swing_type = higher_high ? 'HH' : 'LH'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        label_text := htf_indicator + swing_type + volume_arrow
    else if show_zscore_values
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + 'Z:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := 'Z:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow

    if label_text != ''
        tooltip_text = 'Swing High: ' + (higher_high ? 'Higher High' : 'Lower High') + '\nCurrent TF Z-Score: ' + str.tostring(zscore_at_swing, '#.##') + '\nHTF Z-Score (' + liq_htf + '): ' + str.tostring(htf_zscore_at_swing, '#.##') + '\nSignificance: ' + get_significance_text(zscore_at_swing) + '\nHTF Confirmed: ' + (htf_confirmed ? '✓ YES' : '✗ NO') + '\nHTF Threshold: ' + str.tostring(current_htf_threshold, '#.##') + '\nVolume Trend: ' + (volume_trend_ratio > 1.15 ? 'Accelerating' : volume_trend_ratio < 0.85 ? 'Decelerating' : 'Stable') + '\nVolume: ' + str.tostring(volume[liq_swing_length] / 1000, '#.#') + 'K'

        label_size = get_label_size(zscore_at_swing)
        label.new(bar_index - liq_swing_length, pivot_high, label_text, color = swing_color, style = label.style_label_down, textcolor = color.white, size = label_size, tooltip = tooltip_text)

if not na(pivot_low)
    zscore_at_swing = volume_zscore[liq_swing_length]
    htf_zscore_at_swing = htf_zscore[liq_swing_length]
    swing_color = get_zscore_color(zscore_at_swing)

    label_text = ''
    volume_arrow = get_volume_trend_arrow()

    if show_swing_labels and show_zscore_values
        swing_type = higher_low ? 'HL' : 'LL'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow
    else if show_swing_labels
        swing_type = higher_low ? 'HL' : 'LL'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        label_text := htf_indicator + swing_type + volume_arrow
    else if show_zscore_values
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + 'Z:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := 'Z:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow

    if label_text != ''
        tooltip_text = 'Swing Low: ' + (higher_low ? 'Higher Low' : 'Lower Low') + '\nCurrent TF Z-Score: ' + str.tostring(zscore_at_swing, '#.##') + '\nHTF Z-Score (' + liq_htf + '): ' + str.tostring(htf_zscore_at_swing, '#.##') + '\nSignificance: ' + get_significance_text(zscore_at_swing) + '\nHTF Confirmed: ' + (htf_confirmed ? '✓ YES' : '✗ NO') + '\nHTF Threshold: ' + str.tostring(current_htf_threshold, '#.##') + '\nVolume Trend: ' + (volume_trend_ratio > 1.15 ? 'Accelerating' : volume_trend_ratio < 0.85 ? 'Decelerating' : 'Stable') + '\nVolume: ' + str.tostring(volume[liq_swing_length] / 1000, '#.#') + 'K'

        label_size = get_label_size(zscore_at_swing)
        label.new(bar_index - liq_swing_length, pivot_low, label_text, color = swing_color, style = label.style_label_up, textcolor = color.white, size = label_size, tooltip = tooltip_text)

plot(show_zscore_plot ? volume_zscore : na, 'Volume Z-Score', color = #2196f3, linewidth = 2)
plot(show_zscore_plot ? current_institutional : na, 'Institutional', color = #ff4444, linewidth = 1)
plot(show_zscore_plot ? current_elevated : na, 'Elevated', color = #ff9800, linewidth = 1)
plot(show_zscore_plot ? current_normal : na, 'Normal', color = #4caf50, linewidth = 1)
plot(show_zscore_plot ? -current_normal : na, '-Normal', color = #4caf50, linewidth = 1)
plot(show_zscore_plot ? -current_elevated : na, '-Elevated', color = #ff9800, linewidth = 1)
plot(show_zscore_plot ? -current_institutional : na, '-Institutional', color = #ff4444, linewidth = 1)

bg_color = if show_zscore_plot
    abs_zscore = math.abs(volume_zscore)
    if abs_zscore >= current_institutional
        color.new(#ff4444, 95)
    else if abs_zscore >= current_elevated
        color.new(#ff9800, 95)
    else if abs_zscore >= current_normal
        color.new(#4caf50, 95)
    else
        na
else
    na

bgcolor(bg_color, title = 'Z-Score Background')

if show_info_table and barstate.isconfirmed
    table_pos = get_table_position()
    text_size = get_table_text_size()
    table_rows = advanced_mode ? 12 : 8

    var table info_table = table.new(table_pos, 2, table_rows, bgcolor = color.new(color.white, table_transparency), border_width = 1)

    header_color = advanced_mode ? color.new(color.blue, 20) : color.new(color.gray, 20)
    table.cell(info_table, 0, 0, 'VOLUME Z-SCORE', text_color = color.white, bgcolor = header_color, text_size = text_size)
    table.cell(info_table, 1, 0, advanced_mode ? 'ADVANCED ANALYSIS' : 'ANALYSIS', text_color = color.white, bgcolor = header_color, text_size = text_size)

    table.cell(info_table, 0, 1, 'Current TF Z-Score', text_color = color.black, text_size = text_size)
    zscore_color = get_zscore_color(volume_zscore)
    table.cell(info_table, 1, 1, str.tostring(volume_zscore, '#.##'), text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 2, 'HTF Z-Score (' + liq_htf + ')', text_color = color.black, text_size = text_size)
    htf_text = is_htf_valid ? str.tostring(htf_zscore, '#.##') : 'Disabled/Invalid'
    htf_color = is_htf_valid ? get_zscore_color(htf_zscore) : color.gray
    table.cell(info_table, 1, 2, htf_text, text_color = htf_color, text_size = text_size)

    table.cell(info_table, 0, 3, 'Combined Z-Scores', text_color = color.black, text_size = text_size)
    combined_text = is_htf_valid ? str.tostring(volume_zscore, '#.##') + ' / ' + str.tostring(htf_zscore, '#.##') : str.tostring(volume_zscore, '#.##') + ' / N/A'
    table.cell(info_table, 1, 3, combined_text, text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 4, 'Volume Trend', text_color = color.black, text_size = text_size)
    trend_text = volume_trend_ratio > 1.15 ? '↗️ Accelerating' : volume_trend_ratio < 0.85 ? '↘️ Decelerating' : '↔️ Stable'
    trend_color = volume_trend_ratio > 1.15 ? color.green : volume_trend_ratio < 0.85 ? color.red : color.blue
    table.cell(info_table, 1, 4, trend_text, text_color = trend_color, text_size = text_size)

    table.cell(info_table, 0, 5, 'HTF Confirmation', text_color = color.black, text_size = text_size)
    confirm_text = use_htf_confirm and is_htf_valid ? (htf_confirmed ? '✓ CONFIRMED' : '✗ NOT CONFIRMED') : 'DISABLED/INVALID'
    confirm_color = use_htf_confirm and is_htf_valid ? (htf_confirmed ? NORMAL_COLOR : INSTITUTIONAL_COLOR) : color.gray
    table.cell(info_table, 1, 5, confirm_text, text_color = confirm_color, text_size = text_size)

    table.cell(info_table, 0, 6, 'Significance', text_color = color.black, text_size = text_size)
    significance = get_significance_text(volume_zscore)
    table.cell(info_table, 1, 6, significance, text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 7, 'HTF Success Rate', text_color = color.black, text_size = text_size)
    success_text = str.tostring(success_rate) + '% (' + str.tostring(confirmed_signals) + '/' + str.tostring(total_signals) + ')'
    success_color = success_rate >= 70 ? color.green : success_rate >= 50 ? color.orange : color.red
    table.cell(info_table, 1, 7, success_text, text_color = success_color, text_size = text_size)

    if advanced_mode
        table.cell(info_table, 0, 8, 'HTF Threshold', text_color = color.black, text_size = text_size)
        htf_threshold_text = str.tostring(current_htf_threshold, '#.##') + (adaptive_htf_threshold ? ' (Adaptive)' : ' (Static)')
        table.cell(info_table, 1, 8, htf_threshold_text, text_color = color.blue, text_size = text_size)

        table.cell(info_table, 0, 9, 'Market Regime', text_color = color.black, text_size = text_size)
        regime_text = use_adaptive ? (is_trending ? 'Trending' : 'Ranging') + (is_high_vol ? ' High-Vol' : '') : 'Static'
        regime_color = use_adaptive ? (is_trending ? color.blue : color.orange) : color.gray
        table.cell(info_table, 1, 9, regime_text, text_color = regime_color, text_size = text_size)

        table.cell(info_table, 0, 10, 'Threshold Multiplier', text_color = color.black, text_size = text_size)
        multiplier_text = use_adaptive ? str.tostring(adaptive_multiplier, '#.##') + 'x' : '1.00x'
        table.cell(info_table, 1, 10, multiplier_text, text_color = color.blue, text_size = text_size)

        table.cell(info_table, 0, 11, 'Active Thresholds', text_color = color.black, text_size = text_size)
        active_thresholds_text = '🟢' + str.tostring(current_normal, '#.#') + ' 🟠' + str.tostring(current_elevated, '#.#') + ' 🔴' + str.tostring(current_institutional, '#.#')
        table.cell(info_table, 1, 11, active_thresholds_text, text_color = color.black, text_size = text_size)

institutional_high = not na(pivot_high) and math.abs(volume_zscore[liq_swing_length]) >= current_institutional
institutional_low = not na(pivot_low) and math.abs(volume_zscore[liq_swing_length]) >= current_institutional

alertcondition(institutional_high, '🔴 Distribution Alert', 'High volume at swing high - potential distribution')
alertcondition(institutional_low, '🟢 Accumulation Alert', 'High volume at swing low - potential accumulation')

htf_confirmed_high = institutional_high and htf_confirmed
htf_confirmed_low = institutional_low and htf_confirmed

alertcondition(htf_confirmed_high, '🔴 Confirmed Distribution', 'HTF confirmed high volume at swing high')
alertcondition(htf_confirmed_low, '🟢 Confirmed Accumulation', 'HTF confirmed high volume at swing low')

regime_change = use_adaptive and (is_trending != is_trending[1] or is_high_vol != is_high_vol[1])
alertcondition(regime_change, '📊 Regime Change', 'Market regime changed - thresholds adjusted')

htf_invalid = use_htf_confirm and not is_htf_valid
alertcondition(htf_invalid, '⚠️ HTF Invalid', 'Higher timeframe is invalid or not higher than current')

//--------------------------------------------------------------------------------------------------------------------}
//////////VWAP///////////

col1W = #00ff00b3
col1M = #ffff00b3

toolI = "[Source] [Interval] [Line Width] [Color]\nSet the periodic VWAP's desired Source, Interval, Line Width, and Color."

sho_W = input.bool(false, 'Show', inline = 'W', group = 'Intervals')
src_W = input.source(hlc3, '', inline = 'W', group = 'Intervals')
res_W = input.timeframe('W', '', inline = 'W', group = 'Intervals')
wid_W = input.int(2, '', minval = 0, inline = 'W', group = 'Intervals')
col_W = input.color(col1W, '', tooltip = toolI, inline = 'W', group = 'Intervals')

sho_M = input.bool(false, 'Show', inline = 'M', group = 'Intervals')
src_M = input.source(hlc3, '', inline = 'M', group = 'Intervals')
res_M = input.timeframe('M', '', inline = 'M', group = 'Intervals')
wid_M = input.int(2, '', minval = 0, inline = 'M', group = 'Intervals')
col_M = input.color(col1M, '', tooltip = toolI, inline = 'M', group = 'Intervals')

shoTF(res) =>
    timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(res)

vwapW = sho_W and shoTF(res_W) ? ta.vwap(src_W, timeframe.change(res_W)) : float(na)
vwapM = sho_M and shoTF(res_M) ? ta.vwap(src_M, timeframe.change(res_M)) : float(na)

plt1W = plot(vwapW, 'WTD VWAP Line', col_W, math.max(1, wid_W))
plt1M = plot(vwapM, 'MTD VWAP Line', col_M, math.max(1, wid_M))

/////////////Pivot Channel/.////////
i_pivothigh_len = input.int(21, 'Pivot high length(left, right)', group = 'Pivot points', inline = 'phb')
i_pivothigh_n = input.int(5, 'Max pivot points', group = 'Pivot points', inline = 'phb')
i_pivotlow_len = input.int(21, 'Pivot low  length(left, right)', group = 'Pivot points', inline = 'plb')
i_pivotlow_n = input.int(5, 'Max pivot points', group = 'Pivot points', inline = 'plb')
i_drawpivots = input.bool(true, 'Draw pivot points', group = 'Pivot points')
i_hsource_test = input.source(close, 'Pivot high test source', group = 'Pivot points', tooltip = 'Series that is tested for a high pivot point, if yes takes price from Pivot high source')
i_hsource = input.source(high, 'Pivot high source', group = 'Pivot points')
i_lsource_test = input.source(close, 'Pivot low test source', group = 'Pivot points', tooltip = 'Series that is tested for a low pivot point, if yes takes price from Pivot low source')
i_lsource = input.source(low, 'Pivot low source', group = 'Pivot points')

i_trend_old_method = input.bool(false, 'Use old method to find channel lines', group = 'Trends')
i_htrend_style = input.string(line.style_dashed, 'High trend line style', options = [line.style_dotted, line.style_dashed, line.style_solid, line.style_arrow_both, line.style_arrow_left, line.style_arrow_right], group = 'Trends', inline = 'htr')
i_htrend_width = input.int(2, 'High trend line width', group = 'Trends', inline = 'htr')
i_ltrend_style = input.string(line.style_dashed, 'Low trend line style', options = [line.style_dotted, line.style_dashed, line.style_solid, line.style_arrow_both, line.style_arrow_left, line.style_arrow_right], group = 'Trends', inline = 'ltr')
i_ltrend_width = input.int(2, 'Low trend line width', group = 'Trends', inline = 'ltr')
i_trend_extlen = input.int(5, 'Right channel extension length', group = 'Trends')

i_hcolor = input.color(color.new(#99d31b, 0), 'High color', group = 'Colors', inline = 'clr')
i_lcolor = input.color(color.new(#FA5032, 0), 'Low color', group = 'Colors', inline = 'clr')

i_drawfibs = input.bool(true, 'Enable', group = 'Fibs', inline = 'fiblines')
i_drawfibs_extended = input.bool(false, 'Draw fib lines > 1.618', group = 'Fibs', inline = 'fiblines')
i_fibline_widths = input.int(1, 'Fib line widths', group = 'Fibs')
i_fibline_styles = input.string(line.style_dotted, 'Fib lines style', options = [line.style_dotted, line.style_dashed, line.style_solid, line.style_arrow_both, line.style_arrow_left, line.style_arrow_right], group = 'Fibs')

interp(l, h, s) =>
    l + (h - l) * s

type PivotPoint
    float price
    int index

var high_pivots = array.new<PivotPoint>()
var low_pivots = array.new<PivotPoint>()

ph = ta.pivothigh(i_hsource_test, i_pivothigh_len, i_pivothigh_len)
if bool(ph)
    if array.size(high_pivots) >= i_pivothigh_n
        array.shift(high_pivots)
    array.push(high_pivots, PivotPoint.new(i_hsource[i_pivothigh_len], bar_index[i_pivothigh_len]))

pl = ta.pivotlow(i_lsource_test, i_pivotlow_len, i_pivotlow_len)
if bool(pl)
    if array.size(low_pivots) >= i_pivotlow_n
        array.shift(low_pivots)
    array.push(low_pivots, PivotPoint.new(i_lsource[i_pivotlow_len], bar_index[i_pivotlow_len]))

var low_trend = line(na)
var high_trend = line(na)
var labels = array.new_label()

while array.size(labels) > 0
    label.delete(array.shift(labels))

// Extracted the two structurally-parallel high/low pivot-channel blocks into one
// helper. Every per-side difference is preserved via cmpIsHigh / ext_src /
// min_sentinel — including the load-bearing old-method sentinel (1e7 for high vs
// 1e5 for low), the direction of the old-method (lp > high vs lp < low), the count
// comparison (>= vs <=), and the tie-break direction. The side-specific label push
// and the distinct persistent var lines (high_trend/low_trend) stay in the callers
// so their line histories remain independent.
pivot_channel(array<PivotPoint> pivots, color col, bool cmpIsHigh, float ext_src, float min_sentinel) =>
    result = line(na)
    tmp = array.new_line()
    for i = 0 to array.size(pivots) - 1 by 1
        for j = i to array.size(pivots) - 1 by 1
            if i != j
                PivotPoint pp0 = array.get(pivots, i)
                PivotPoint pp1 = array.get(pivots, j)
                array.push(tmp, line.new(pp0.index, pp0.price, pp1.index, pp1.price, color = col, width = 1, style = line.style_dashed))

    best_ind = int(na)
    if i_trend_old_method
        min_val = min_sentinel
        for i = 0 to array.size(tmp) - 1 by 1
            lp = line.get_price(array.get(tmp, i), bar_index)
            cond = cmpIsHigh ? lp > high : lp < low
            if cond
                if min_val > math.abs(lp - close)
                    min_val := math.abs(lp - close)
                    best_ind := i
    else
        best_cnt = 0
        for i = 0 to array.size(tmp) - 1 by 1
            trend = array.get(tmp, i)
            cnt = 0

            for pivot in pivots
                matchp = cmpIsHigh ? line.get_price(trend, pivot.index) >= pivot.price : line.get_price(trend, pivot.index) <= pivot.price
                if matchp
                    cnt := cnt + 1

            if cnt > best_cnt
                best_cnt := cnt
                best_ind := i

            if cnt == best_cnt
                tie = cmpIsHigh ? (line.get_price(array.get(tmp, best_ind), bar_index + 1) > line.get_price(trend, bar_index + 1) and line.get_price(trend, bar_index + 1) > ext_src) : (line.get_price(array.get(tmp, best_ind), bar_index + 1) < line.get_price(trend, bar_index + 1) and line.get_price(trend, bar_index + 1) < ext_src)
                if tie
                    best_cnt := cnt
                    best_ind := i

    if not na(best_ind)
        result := array.get(tmp, best_ind)
        array.remove(tmp, best_ind)

    while array.size(tmp) > 0
        line.delete(array.shift(tmp))
    result

if array.size(high_pivots) > 1
    if i_drawpivots
        for pivot in high_pivots
            array.push(labels, label.new(pivot.index, pivot.price, '', style = label.style_label_down, size = size.tiny, color = color.new(#99d31b, 70)))
    high_chosen = pivot_channel(high_pivots, i_hcolor, true, i_hsource, 10000000.0)
    if not na(high_chosen)
        line.delete(high_trend)
        high_trend := high_chosen

if array.size(low_pivots) > 1
    if i_drawpivots
        for pivot in low_pivots
            array.push(labels, label.new(pivot.index, pivot.price, '', style = label.style_label_up, size = size.tiny, color = color.new(#FA5032, 70)))
    low_chosen = pivot_channel(low_pivots, i_lcolor, false, i_lsource, 100000.0)
    if not na(low_chosen)
        line.delete(low_trend)
        low_trend := low_chosen

if not na(low_trend) and not na(high_trend)
    for l in labels
        if label.get_x(l) == line.get_x1(low_trend) or label.get_x(l) == line.get_x2(low_trend)
            label.set_color(l, color.new(#FA5032, 0))
    line.set_y2(low_trend, line.get_price(low_trend, bar_index + i_trend_extlen))
    line.set_x2(low_trend, bar_index + i_trend_extlen)
    line.set_width(low_trend, i_ltrend_width)
    line.set_style(low_trend, i_ltrend_style)
    if line.get_x1(high_trend) > line.get_x1(low_trend)
        line.set_y1(high_trend, line.get_price(high_trend, line.get_x1(low_trend)))
        line.set_x1(high_trend, line.get_x1(low_trend))

    for l in labels
        if label.get_x(l) == line.get_x1(high_trend) or label.get_x(l) == line.get_x2(high_trend)
            label.set_color(l, color.new(#99d31b, 0))
    line.set_y2(high_trend, line.get_price(high_trend, bar_index + i_trend_extlen))
    line.set_x2(high_trend, bar_index + i_trend_extlen)
    line.set_width(high_trend, i_htrend_width)
    line.set_style(high_trend, i_htrend_style)
    if line.get_x1(low_trend) > line.get_x1(high_trend)
        line.set_y1(low_trend, line.get_price(low_trend, line.get_x1(high_trend)))
        line.set_x1(low_trend, line.get_x1(high_trend))

var fibs = array.new_line()

while array.size(fibs) > 0
    line.delete(array.shift(fibs))

if not na(high_trend) and not na(low_trend) and barstate.islast and i_drawfibs
    left = line.get_x1(low_trend)
    right = bar_index + i_trend_extlen
    // Hoisted the four per-bar-constant line.get_price reads out of the 7-10 copy-pasted
    // blocks and looped over the ratio list. Push order and values are identical.
    lp_ll = line.get_price(low_trend, left)
    lp_hl = line.get_price(high_trend, left)
    lp_lr = line.get_price(low_trend, right)
    lp_hr = line.get_price(high_trend, right)
    ratios = i_drawfibs_extended ? array.from(-0.618, 0.236, 0.382, 0.5, 0.618, 0.75, 1.618, 2.618, 3.618, 4.236) : array.from(-0.618, 0.236, 0.382, 0.5, 0.618, 0.75, 1.618)
    for s in ratios
        lv = interp(lp_ll, lp_hl, s)
        rv = interp(lp_lr, lp_hr, s)
        array.push(fibs, line.new(left, lv, right, rv, style = i_fibline_styles, width = i_fibline_widths, color = color.from_gradient(rv, lp_lr, lp_hr, i_lcolor, i_hcolor)))

//////Moving Averages/////////////
outC = ta.sma(close, 50)
outD = ta.sma(close, 100)
outE = ta.sma(close, 200)

plot(outC, color = color.lime, linewidth = 2, title = 'SMA(50)')
plot(outD, color = color.rgb(230, 123, 0), linewidth = 2, title = 'SMA(100)')
plot(outE, color = color.rgb(229, 20, 177), linewidth = 2, title = 'SMA(200)')

/////////CVD//////
g = 'CVD Histogram Settings'

CumMode = input.string('EMA', 'Cumulative Mode', ['Total', 'Periodic', 'EMA'], group = g)
Period = input.int(21, 'Period', group = g)
UltraData = input.bool(false, '', inline = 'Data', group = g)
Market = input.string('Forex', 'Market Ultra Data', options = ['Forex', 'Crypto', 'Stock'], inline = 'Data', group = g)

Transparency = input.int(0, 'Plot Transparency', minval = 0, maxval = 100, group = g)
UseNormalized = input.bool(false, 'Use Normalized Values (-50 to +50)', group = g)
NormalizePeriod = input.int(100, 'Normalization Period', minval = 10, maxval = 500, group = g)

h = input.bool(true, 'Show Histogram', group = g)
oscPlacement = input.string('Bottom', '', options = ['Top', 'Bottom'], inline = 'VOL', group = g)
oscHight = 21 - input.int(7, ' Hight', minval = 1, maxval = 10, inline = 'VOL', group = g) * 2
lookbackLength = input.int(200, 'Overlay Indicator Display Length', minval = 10, maxval = 495, group = g)
cvdSize  = input.float(3.0, 'CVD Size (Height)', minval = 0.1, maxval = 20.0, step = 0.5, inline = 'CVDSZ', group = g, tooltip = 'Vertical size multiplier for the CVD histogram. Higher = taller and more visible. (Works on top of the "Hight" setting.)')
cvdWidth = input.int(3, 'Bar Width', minval = 1, maxval = 10, inline = 'CVDSZ', group = g, tooltip = 'Thickness of each CVD bar. Higher = thicker and easier to see.')

// Optimized API Calls: Reduced from 26 to 3 conditional calls
Vsum = 0.0
if UltraData
    if Market == 'Forex'
        V1 = nz(request.security('FX:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V2 = nz(request.security('OANDA:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V3 = nz(request.security('FOREXCOM:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        Vsum := V1 + V2 + V3
    else if Market == 'Crypto'
        V1 = nz(request.security('BITSTAMP:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V2 = nz(request.security('COINBASE:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V3 = nz(request.security('BINANCE:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        Vsum := V1 + V2 + V3

Volume = UltraData ? Vsum : volume

Buying = Volume * ((close - low) / (high - low))
Selling = Volume * ((high - close) / (high - low))

delta = Buying - Selling

Cumulative = if CumMode == 'Total'
    ta.cum(delta)
else if CumMode == 'Periodic'
    math.sum(delta, Period)
else if CumMode == 'EMA'
    ta.ema(delta, Period)

PercentRank = ta.percentrank(Cumulative, NormalizePeriod)
NormalizedCumulative = PercentRank - 50

cvdHistogram = UseNormalized ? NormalizedCumulative : Cumulative

var a_lines = array.new_line()
var a_fill = array.new_linefill()

priceHighest = ta.highest(high, lookbackLength)
priceLowest = ta.lowest(low, lookbackLength)

cvdHighest = ta.highest(cvdHistogram, lookbackLength)
cvdLowest = ta.lowest(cvdHistogram, lookbackLength)
cvdMaxAbs = math.max(math.abs(cvdHighest), math.abs(cvdLowest))

cvdColor = cvdHistogram >= 0 ? (cvdHistogram[1] < cvdHistogram ? color.new(#006400, Transparency) : color.new(color.green, Transparency)) : (cvdHistogram[1] < cvdHistogram ? color.new(color.red, Transparency) : color.new(#910000, Transparency))

if barstate.islast and h
    if array.size(a_lines) > 0
        for i = 1 to array.size(a_lines) by 1
            line.delete(array.shift(a_lines))

    if array.size(a_fill) > 0
        for i = 1 to array.size(a_fill) by 1
            linefill.delete(array.shift(a_fill))

    priceChangeRate = (priceHighest - priceLowest) / priceHighest / oscHight * cvdSize

    for barIndex = 0 to lookbackLength - 1 by 1
        cvdValue = cvdHistogram[barIndex]
        basePrice = oscPlacement == 'Top' ? priceHighest : priceLowest

        endPrice = if cvdMaxAbs > 0
            basePrice * (1 + cvdValue / cvdMaxAbs * priceChangeRate)
        else
            basePrice

        array.push(a_lines, line.new(x1 = bar_index[barIndex], y1 = basePrice, x2 = bar_index[barIndex], y2 = endPrice, xloc = xloc.bar_index, extend = extend.none, color = cvdColor[barIndex], style = line.style_solid, width = cvdWidth))

//==============================================================================
//        MACHINE LEARNING SUPPORT & RESISTANCE  (© FEELS)
//------------------------------------------------------------------------------
// Merged into the single indicator. Stand-alone @version/indicator() header
// removed. Replaces the previous K-Means clustering S/R engine. Collision fix:
// `boxes` -> `mlsr_boxes` (clashed with the DeltaFlow VP box array), and the
// pivot vars `ph`/`pl` -> `mlsr_ph`/`mlsr_pl` (bare ph/pl are global pivots in
// the Pivot Channel section). All other identifiers (pivLen, histBars, f_kmeans,
// f_silhouette, f_holdRate, stat, pvP/pvB, etc.) are unique in this file. The
// engine's `Hold rate -> Lookback, bars` setting reads deep history; the main
// indicator's max_bars_back was raised to 1000 to cover its default range.
//==============================================================================

//--- inputs
pivLen   = input.int(10, "Swing size", minval = 2, maxval = 50, tooltip = "Pivot width on each side. Bigger = fewer, more significant swing points feed the model")
histBars = input.int(1000, "History, bars", minval = 200, maxval = 5000, step = 100, tooltip = "Only swing points from this many recent bars feed the model, so levels come from structure that still matters")
maxPiv   = input.int(250, "Swing points used", minval = 20, maxval = 400, tooltip = "How many of the most recent swing highs and lows the model runs on")
autoK    = input.bool(true, "Model picks the level count", tooltip = "The model tries every level count in the range below, scores how cleanly each one separates the swings, and keeps the best. Turn off to fix the count yourself")
kMin     = input.int(3, "Fewest levels", minval = 2, maxval = 12, tooltip = "Lower end of the range the model searches")
kMax     = input.int(9, "Most levels", minval = 3, maxval = 14, tooltip = "Upper end of the range the model searches")
kFix     = input.int(6, "Level count", minval = 2, maxval = 14, tooltip = "Used when the model is not picking the count itself")
minPts   = input.int(3, "Min swings per level", minval = 2, maxval = 20, tooltip = "A group with fewer swings than this is not treated as a level, and its swings are labelled noise")
selPct   = input.int(60, "Selectivity", minval = 0, maxval = 200, step = 10, tooltip = "How concentrated a group must be to count as a level, measured against the average group on the chart. Higher values keep only the levels where swings really pile up and label the rest noise")
maxZones = input.int(8, "Max levels shown", minval = 1, maxval = 20, tooltip = "Only the levels nearest to price are drawn")
maxDist  = input.float(60, "Max distance from price, %", minval = 0, maxval = 500, step = 10, tooltip = "Levels further than this from the current price are hidden, measured proportionally so up and down are treated alike. Set 0 to show every level")
passes   = input.int(15, "Refinement passes", minval = 3, maxval = 40, tooltip = "How many times the model re-centres the groups before settling")

grpW = "Zone width"
minWIn = input.float(0.15, "Minimum width, %", minval = 0.05, maxval = 5, step = 0.05, group = grpW, tooltip = "A very tight group still draws at least this wide so it stays visible")
maxWIn = input.float(1.0, "Maximum width, %", minval = 0.1, maxval = 25, step = 0.1, group = grpW, tooltip = "Safety cap. A group is never drawn wider than this share of its level")
maxWRng = input.float(6.0, "Maximum width, % of range", minval = 1, maxval = 50, step = 1, group = grpW, tooltip = "Second cap, measured against the whole price range the model looked at. This keeps zones thin on intraday charts, where the range is small and a percentage of price would cover the screen")
softEdge = input.bool(true, "Density edges", group = grpW, tooltip = "Draws each level as a dense core fading into softer edges, so a tightly agreed level looks sharp and a loosely agreed one looks blurred")

grpP = "Density profile"
showProf = input.bool(false, "Show profile", group = grpP, tooltip = "Draws how the swing points are distributed across price, which is the raw data the model works on")
profBins = input.int(48, "Resolution", minval = 12, maxval = 100, group = grpP)
profW    = input.int(70, "Width, bars", minval = 10, maxval = 200, group = grpP)

grpT = "Hold rate"
showStats = input.bool(true, "Show hold rate", group = grpT, tooltip = "Counts how often price entered a level and left from the same side instead of closing through it")
showTable = input.bool(true, "Show table", group = grpT)
statBack  = input.int(500, "Lookback, bars", minval = 100, maxval = 1500, group = grpT)
statWin   = input.int(10, "Reaction window, bars", minval = 3, maxval = 100, group = grpT, tooltip = "How long price has to close through a level before that visit counts as broken")

grpS = "Style"
supCol   = input.color(#089981, "Support", group = grpS)
resCol   = input.color(#f23645, "Resistance", group = grpS)
noiseCol = input.color(#787b86, "Noise", group = grpS, tooltip = "Swings the model rejected as too sparse to form a level")
showDots = input.bool(true, "Show swing points", group = grpS, tooltip = "Draws every swing point the model looked at, coloured by the level it belongs to")
showNoise = input.bool(true, "Show rejected swings", group = grpS)
dotSizeS = input.string("Large", "Swing point size", options = ["Tiny", "Small", "Normal", "Large"], group = grpS)
showMid  = input.bool(true, "Show level centre", group = grpS)
extBars  = input.int(8, "Extend right, bars", minval = 0, maxval = 100, group = grpS)
txtSizeS = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpS)

txtSize = txtSizeS == "Tiny" ? size.tiny : txtSizeS == "Normal" ? size.normal : txtSizeS == "Large" ? size.large : size.small
dotSize = dotSizeS == "Large" ? size.large : dotSizeS == "Normal" ? size.normal : dotSizeS == "Small" ? size.small : size.tiny

//--- state
var pvP = array.new<float>()
var pvB = array.new<int>()
var mlsr_boxes = array.new<box>()
var tags  = array.new<label>()
var dots  = array.new<label>()
var mids  = array.new<line>()

mlsr_ph = ta.pivothigh(pivLen, pivLen)
mlsr_pl = ta.pivotlow(pivLen, pivLen)

//--- k-means in one dimension, deterministic quantile seeding
f_kmeans(array<float> data, int k, int iters) =>
    n = array.size(data)
    cent = array.new<float>(k, 0.0)
    if n > 0
        srt = array.copy(data)
        array.sort(srt)
        for i = 0 to k - 1
            idx = math.max(0, math.min(n - 1, int((i + 0.5) * n / k)))
            array.set(cent, i, array.get(srt, idx))
        for it = 1 to iters
            sums = array.new<float>(k, 0.0)
            cnts = array.new<int>(k, 0)
            for j = 0 to n - 1
                v = array.get(data, j)
                best = 0
                bd = math.abs(v - array.get(cent, 0))
                for c = 1 to k - 1
                    d = math.abs(v - array.get(cent, c))
                    if d < bd
                        bd := d
                        best := c
                array.set(sums, best, array.get(sums, best) + v)
                array.set(cnts, best, array.get(cnts, best) + 1)
            for c = 0 to k - 1
                if array.get(cnts, c) > 0
                    array.set(cent, c, array.get(sums, c) / array.get(cnts, c))
    cent

f_nearest(array<float> cent, float v) =>
    best = 0
    bd = math.abs(v - array.get(cent, 0))
    for c = 1 to array.size(cent) - 1
        d = math.abs(v - array.get(cent, c))
        if d < bd
            bd := d
            best := c
    best

//--- silhouette: how much closer a swing sits to its own centre than to the next best one
f_silhouette(array<float> data, array<float> cent) =>
    n = array.size(data)
    k = array.size(cent)
    tot = 0.0
    cnt = 0
    for j = 0 to n - 1
        v = array.get(data, j)
        d1 = 1e9
        d2 = 1e9
        for c = 0 to k - 1
            d = math.abs(v - array.get(cent, c))
            if d < d1
                d2 := d1
                d1 := d
            else if d < d2
                d2 := d
        if d2 > 0
            tot += (d2 - d1) / d2
            cnt += 1
    cnt > 0 ? tot / cnt : 0.0

//--- how often price entered the zone and left from the side it came from
f_holdRate(float bot, float top) =>
    visits = 0
    held = 0
    lim = math.min(statBack, bar_index - 1)
    if lim > statWin + 2
        for o = lim to statWin + 1
            if o <= 4980
                inNow = low[o] <= top and high[o] >= bot
                inPrev = low[o + 1] <= top and high[o + 1] >= bot
                if inNow and not inPrev
                    fromBelow = close[o + 1] < bot
                    fromAbove = close[o + 1] > top
                    if fromBelow or fromAbove
                        visits += 1
                        broke = false
                        for f = 1 to statWin
                            c = close[o - f]
                            if not broke and (fromBelow ? c > top : c < bot)
                                broke := true
                        if not broke
                            held += 1
    [visits, held]

f_clear() =>
    if array.size(mlsr_boxes) > 0
        for i = 0 to array.size(mlsr_boxes) - 1
            box.delete(array.get(mlsr_boxes, i))
        array.clear(mlsr_boxes)
    if array.size(tags) > 0
        for i = 0 to array.size(tags) - 1
            label.delete(array.get(tags, i))
        array.clear(tags)
    if array.size(dots) > 0
        for i = 0 to array.size(dots) - 1
            label.delete(array.get(dots, i))
        array.clear(dots)
    if array.size(mids) > 0
        for i = 0 to array.size(mids) - 1
            line.delete(array.get(mids, i))
        array.clear(mids)

//--- collect confirmed swing points
if barstate.isconfirmed
    if not na(mlsr_ph) and mlsr_ph > 0
        array.push(pvP, mlsr_ph)
        array.push(pvB, bar_index - pivLen)
    if not na(mlsr_pl) and mlsr_pl > 0
        array.push(pvP, mlsr_pl)
        array.push(pvB, bar_index - pivLen)
    while array.size(pvP) > maxPiv
        array.shift(pvP)
        array.shift(pvB)
    while array.size(pvB) > 0 and bar_index - array.get(pvB, 0) > histBars
        array.shift(pvP)
        array.shift(pvB)

//--- cluster and draw on the last bar
var table stat = table.new(position.top_right, 3, 24, border_width = 1)
touched = false
brokeZ  = false

//--- only swings inside the price band that still matters reach the model,
//--- otherwise a long weekly history spans several orders of magnitude
band = maxDist == 0 ? 1e9 : math.log(1 + maxDist * 1.5 / 100)
fp = array.new<float>()
fb = array.new<int>()
if barstate.islast and array.size(pvP) > 0
    need = kMin * minPts + 2
    for att = 1 to 4
        if array.size(fp) < need
            array.clear(fp)
            array.clear(fb)
            b2 = band * att
            for j = 0 to array.size(pvP) - 1
                p = array.get(pvP, j)
                if math.abs(math.log(p / close)) <= b2
                    array.push(fp, p)
                    array.push(fb, array.get(pvB, j))

if barstate.islast and array.size(fp) >= kMin * minPts
    f_clear()
    table.clear(stat, 0, 0, 2, 23)
    n = array.size(fp)

    //--- work in log space so the model behaves the same at any price level
    logs = array.new<float>()
    for j = 0 to n - 1
        array.push(logs, math.log(array.get(fp, j)))

    rngLog = math.max(array.max(logs) - array.min(logs), 1e-6)

    //--- the model searches the level count and keeps the cleanest separation
    bestK = autoK ? kMin : kFix
    bestSil = -1.0
    cent = autoK ? array.new<float>(1, 0.0) : f_kmeans(logs, kFix, passes)
    if autoK
        for kk = kMin to math.min(kMax, int(n / minPts))
            cTry = f_kmeans(logs, kk, passes)
            s = f_silhouette(logs, cTry)
            if s > bestSil
                bestSil := s
                bestK := kk
                cent := cTry
    else
        bestSil := f_silhouette(logs, cent)
    nK = array.size(cent)

    //--- membership, extents and rejection of groups too sparse to be a level
    cLo  = array.new<float>(nK, 0.0)
    cHi  = array.new<float>(nK, 0.0)
    cSum = array.new<float>(nK, 0.0)
    cCnt = array.new<int>(nK, 0)
    cFst = array.new<int>(nK, bar_index)
    cid  = array.new<int>(n, -1)
    for j = 0 to n - 1
        v = array.get(logs, j)
        c = f_nearest(cent, v)
        array.set(cid, j, c)
        if array.get(cCnt, c) == 0
            array.set(cLo, c, v)
            array.set(cHi, c, v)
        array.set(cLo, c, math.min(array.get(cLo, c), v))
        array.set(cHi, c, math.max(array.get(cHi, c), v))
        array.set(cSum, c, array.get(cSum, c) + v)
        array.set(cCnt, c, array.get(cCnt, c) + 1)
        b = array.get(fb, j)
        if b < array.get(cFst, c)
            array.set(cFst, c, b)

    //--- how tightly each group is packed, so the model can reject the loose ones
    dens = array.new<float>(nK, 0.0)
    dSum = 0.0
    dN = 0
    for c = 0 to nK - 1
        cnt = array.get(cCnt, c)
        if cnt >= minPts
            ext = math.max(array.get(cHi, c) - array.get(cLo, c), 1e-6)
            d = cnt / ext
            array.set(dens, c, d)
            dSum += d
            dN += 1
    dCut = dN > 0 ? (dSum / dN) * selPct / 100 : 0.0

    keep = array.new<bool>(nK, false)
    levels = 0
    noise = 0
    for c = 0 to nK - 1
        if array.get(cCnt, c) >= minPts and array.get(dens, c) >= dCut
            array.set(keep, c, true)
            levels += 1
        else
            noise += array.get(cCnt, c)
    for j = 0 to n - 1
        if not array.get(keep, array.get(cid, j))
            array.set(cid, j, -1)

    //--- keep the levels nearest to price
    pick = array.new<int>()
    used = array.new<bool>(nK, false)
    for s = 1 to math.min(maxZones, levels)
        bi = -1
        bd = 1e9
        for c = 0 to nK - 1
            if not array.get(used, c) and array.get(keep, c)
                ct = math.exp(array.get(cSum, c) / array.get(cCnt, c))
                d = math.abs(math.log(ct / close))
                if d < bd and (maxDist == 0 or d <= math.log(1 + maxDist / 100))
                    bd := d
                    bi := c
        if bi >= 0
            array.set(used, bi, true)
            array.push(pick, bi)

    //--- raw distribution of swing points across price, the input the model sees
    if showProf and n > 1
        loL = array.min(logs)
        hiL = array.max(logs)
        span = math.max(hiL - loL, 1e-9)
        bins = array.new<int>(profBins, 0)
        for j = 0 to n - 1
            bi = math.max(0, math.min(profBins - 1, int((array.get(logs, j) - loL) / span * profBins)))
            array.set(bins, bi, array.get(bins, bi) + 1)
        mb = 1
        for i2 = 0 to profBins - 1
            if array.get(bins, i2) > mb
                mb := array.get(bins, i2)
        for i2 = 0 to profBins - 1
            v = array.get(bins, i2)
            if v > 0
                pb = math.exp(loL + span * i2 / profBins)
                pt = math.exp(loL + span * (i2 + 1) / profBins)
                ln = math.max(1, int(profW * v / mb))
                pc = (pb + pt) / 2 < close ? supCol : resCol
                array.push(mlsr_boxes, box.new(bar_index - ln, pt, bar_index, pb, bgcolor = color.new(pc, 82), border_color = color.new(pc, 100)))

    //--- swing points, coloured by the level they belong to, grey where the model saw noise
    if showDots
        for j = 0 to n - 1
            c = array.get(cid, j)
            shown = c >= 0 and array.indexof(pick, c) >= 0
            if array.size(dots) < 400 and (shown or (showNoise and c < 0))
                dc = c < 0 ? noiseCol : (math.exp(array.get(cSum, c) / array.get(cCnt, c)) < close ? supCol : resCol)
                array.push(dots, label.new(array.get(fb, j), array.get(fp, j), "•", style = label.style_none, textcolor = color.new(dc, c < 0 ? 35 : 0), size = dotSize))

    //--- header: what the model decided on its own
    row = 0
    if showTable
        shown = array.size(pick)
        table.cell(stat, 0, 0, str.tostring(levels) + (levels == 1 ? " level" : " levels") + (shown < levels ? ", " + str.tostring(shown) + " near price" : " found"), text_color = color.gray, text_size = txtSize, bgcolor = color.new(color.gray, 90))
        table.cell(stat, 1, 0, "fit " + str.tostring(math.round(bestSil * 100)) + "%", text_color = color.gray, text_size = txtSize, bgcolor = color.new(color.gray, 90))
        table.cell(stat, 2, 0, str.tostring(noise) + " noise", text_color = color.gray, text_size = txtSize, bgcolor = color.new(color.gray, 90))
        table.cell(stat, 0, 1, "Level", text_color = color.gray, text_size = txtSize)
        table.cell(stat, 1, 1, "swings", text_color = color.gray, text_size = txtSize)
        table.cell(stat, 2, 1, "held", text_color = color.gray, text_size = txtSize)
        row := 2

    maxCnt = 1
    if array.size(pick) > 0
        for s = 0 to array.size(pick) - 1
            maxCnt := math.max(maxCnt, array.get(cCnt, array.get(pick, s)))

    if array.size(pick) > 0
        for s = 0 to array.size(pick) - 1
            c = array.get(pick, s)
            cnt = array.get(cCnt, c)
            ctr = math.exp(array.get(cSum, c) / cnt)
            top = math.exp(array.get(cHi, c))
            bot = math.exp(array.get(cLo, c))
            half = math.max((top - bot) / 2, ctr * minWIn / 100)
            half := math.min(half, ctr * maxWIn / 100)
            half := math.min(half, ctr * (math.exp(rngLog * maxWRng / 200) - 1))
            top := ctr + half
            bot := ctr - half
            isSup = ctr < close
            col = isSup ? supCol : resCol
            fill = math.round(92 - 18 * cnt / maxCnt)
            lft = array.get(cFst, c)
            rgt = bar_index + extBars
            if softEdge
                array.push(mlsr_boxes, box.new(lft, ctr + half * 1.3, rgt, ctr - half * 1.3, bgcolor = color.new(col, math.min(96, fill + 5)), border_color = color.new(col, 100)))
                array.push(mlsr_boxes, box.new(lft, top, rgt, bot, bgcolor = color.new(col, fill), border_color = color.new(col, 100)))
                array.push(mlsr_boxes, box.new(lft, ctr + half * 0.45, rgt, ctr - half * 0.45, bgcolor = color.new(col, math.max(62, fill - 16)), border_color = color.new(col, 100)))
            else
                array.push(mlsr_boxes, box.new(lft, top, rgt, bot, bgcolor = color.new(col, fill), border_color = color.new(col, 45), border_width = 1))

            if showMid
                array.push(mids, line.new(lft, ctr, rgt, ctr, color = color.new(col, 25), style = line.style_dotted, width = 1))

            array.push(tags, label.new(rgt, ctr, str.tostring(math.round_to_mintick(ctr)) + "  " + str.tostring(cnt), style = label.style_label_left, color = color.new(col, 15), textcolor = color.white, size = txtSize))

            if showTable and showStats and row <= 23
                [visits, held] = f_holdRate(bot, top)
                table.cell(stat, 0, row, str.tostring(math.round_to_mintick(ctr)), text_color = col, text_size = txtSize)
                table.cell(stat, 1, row, str.tostring(cnt), text_color = col, text_size = txtSize)
                table.cell(stat, 2, row, visits > 0 ? str.tostring(held) + "/" + str.tostring(visits) : "-", text_color = col, text_size = txtSize)
                row += 1

            if low <= top and high >= bot and not (low[1] <= top and high[1] >= bot)
                touched := true
            if (isSup and close < bot and close[1] >= bot) or (not isSup and close > top and close[1] <= top)
                brokeZ := true

if barstate.islast and barstate.isconfirmed
    if touched
        alert("Price entered a clustered support or resistance level", alert.freq_once_per_bar_close)
    if brokeZ
        alert("Price closed through a clustered support or resistance level", alert.freq_once_per_bar_close)

//==============================================================================
//        AUTO PATTERN DETECTOR TARGETS  (© MarkitTick)
//------------------------------------------------------------------------------
// Merged into the single indicator. Stand-alone @version/indicator() header
// removed. Collision fix: this engine's pivot temporaries `ph`/`pl` were renamed
// to `mk_ph`/`mk_pl` — bare `ph`/`pl` are already global pivots in the Pivot
// Channel section above. All other identifiers (types Pivot/PatternResult/
// PatternDrawings, f_*/detect* functions, dash_* state) are unique. The dashboard
// table moved to middle_left to avoid the crowded top_right corner. The 8 detect
// functions must run every bar (they hold ta.highest/lowest state), so they are
// left ungated — drawing is already capped at Max Patterns Displayed.
//==============================================================================

// ── INPUTS ──────────────────────────────────────────────────────────────────
grp_gen = "Pattern: General"
grp_pat = "Pattern: Patterns"
grp_piv = "Pattern: Pivot"
grp_vis = "Pattern: Vis"
grp_flt = "Pattern: Filters"
string GRP_DASH = "📊 Pattern Dashboard Settings"

cooldown          = input.int(5,      "Pattern Cooldown (Bars)",    minval=1,    group=grp_gen)
sym_tol           = input.float(10.0, "Symmetry Tolerance (%)",     minval=1.0,  step=0.5,  group=grp_gen) / 100
lvl_tol           = input.float(3.0,  "Level Tolerance (%)",        minval=0.1,  step=0.1,  group=grp_gen) / 100
min_size_pct      = input.float(0.5,  "Min Pattern Size (% of Price)", minval=0.1, group=grp_gen) / 100
min_atr_mult      = input.float(1.0,  "Min Pattern Size (ATR Multiplier)", minval=0.1, step=0.1, group=grp_gen)

show_dt_top       = input.bool(true,  "Double Top",                 group=grp_pat)
show_dt_bot       = input.bool(true,  "Double Bottom",              group=grp_pat)
show_tt_top       = input.bool(true,  "Triple Top",                 group=grp_pat)
show_tt_bot       = input.bool(true,  "Triple Bottom",              group=grp_pat)
show_hs_std       = input.bool(true,  "Head and Shoulders",         group=grp_pat)
show_hs_inv       = input.bool(true,  "Inverted Head and Shoulders",group=grp_pat)
show_flag_bull    = input.bool(true,  "Bullish Flag",               group=grp_pat)
show_flag_bear    = input.bool(true,  "Bearish Flag",               group=grp_pat)
show_pennant_bull = input.bool(true,  "Bullish Pennant",            group=grp_pat)
show_pennant_bear = input.bool(true,  "Bearish Pennant",            group=grp_pat)
show_wedge_rise   = input.bool(true,  "Rising Wedge",               group=grp_pat)
show_wedge_fall   = input.bool(true,  "Falling Wedge",              group=grp_pat)
show_tri_gen      = input.bool(true,  "Triangle",                   group=grp_pat)
show_rect_gen     = input.bool(true,  "Rectangle",                  group=grp_pat)
show_cup_std      = input.bool(true,  "Cup and Handle",             group=grp_pat)
show_cup_inv      = input.bool(true,  "Inverted Cup and Handle",    group=grp_pat)

lb_left          = input.int(10,   "Pivot Lookback Left",    minval=1,   group=grp_piv)
lb_right         = input.int(10,   "Pivot Lookback Right",   minval=1,   group=grp_piv)
max_piv_hist     = input.int(500, "Max Pivots to Remember", minval=5, maxval=1000, group=grp_piv)

req_close_brk    = input.bool(false,  "Require Candle Close Outside?",    group=grp_flt)
req_body_brk     = input.bool(false, "Require Full Body Breakout?",       group=grp_flt)
use_atr_brk      = input.bool(true, "Use ATR for Threshold?",           group=grp_flt)
break_atr        = input.float(1.0,  "Breakout Threshold (ATR)",  minval=0.1, step=0.1, group=grp_flt)
break_pct        = input.float(0.3,  "Breakout Threshold (%)",    minval=0.0, step=0.1, group=grp_flt) / 100
brk_confirm_bars = input.int(1,      "Confirmation Bars (Consecutive)", minval=1, group=grp_flt)
show_ignore_conf = input.bool(false, "Show Patterns Without Confirmation", group=grp_flt)
min_brk_bar      = input.int(1,      "Scan Lookback Bars",           minval=1,   group=grp_flt)
req_vol          = input.bool(false,  "Require Volume Spike?",               group=grp_flt)
vol_mult         = input.float(1,    "Volume Multiplier",  minval=1.0, step=0.1, group=grp_flt)
vol_len          = input.int(20,     "Volume SMA Length",                   group=grp_flt)
min_rr           = input.float(1.0,  "Min Risk:Reward Ratio",  minval=0.1, step=0.1, group=grp_flt)
slippage_ticks   = input.float(1.0,  "Slippage (Ticks)",       minval=0.0, step=0.1, group=grp_flt)
commission_pct   = input.float(0.0001,"Commission (%)",         minval=0.0, step=0.0001, group=grp_flt)

col_bull         = input.color(color.rgb(0, 255, 180, 0),    "Bullish Color",       group=grp_vis)
col_bear         = input.color(color.rgb(255, 30, 120, 0),   "Bearish Color",       group=grp_vis)
fill_transp      = input.int(80, "Fill Transparency", minval=50, maxval=99, group=grp_vis)
show_tgt         = input.bool(true,  "Show Measured Targets",     group=grp_vis)
stop_buffer      = input.float(0.5,  "Stop Loss ATR Buffer", minval=0.0, step=0.1, group=grp_vis)
use_sl_pct_tgt   = input.bool(true, "SL as % of Target Dist", group=grp_vis)
sl_pct_tgt       = input.float(25.0, "SL % of Target Dist",    minval=1.0, maxval=100.0, step=0.5, group=grp_vis) / 100
max_patterns     = input.int(1,      "Max Patterns Displayed", minval=1, maxval=50, group=grp_vis)
extend_lines     = input.bool(false, "Extend Breakout Lines",      group=grp_vis)
col_entry        = input.color(color.rgb(255, 220, 0, 0),    "Entry Line Color",  group=grp_vis)
col_stop         = input.color(color.rgb(255, 50, 130, 0),   "Stop Line Color",   group=grp_vis)
col_target       = input.color(color.rgb(0, 255, 160, 0),    "Target Line Color", group=grp_vis)

color  dash_bg_color  = input.color(color.rgb(10, 10, 18, 5),    "Background Color", group=GRP_DASH)
color  dash_txt_color = input.color(color.rgb(220, 220, 235, 0), "Text Color",       group=GRP_DASH)
string GRP_ALRT = "Pattern: Alerts"
string GRP_RISK = "Pattern: Risk"
string GRP_VOL  = "Pattern: Volatility"
string GRP_UX   = "Pattern: UI/UX"
bool   alert_en      = input.bool(true, "Enable Alerts",           group=GRP_ALRT)
bool   rr_dyn_en     = input.bool(false, "Dynamic R:R Multiplier",  group=GRP_RISK)
float  rr_dyn_mult   = input.float(2.0,  "R:R Multiplier", minval=0.1, step=0.1, group=GRP_RISK)
bool   atr_norm_en   = input.bool(false, "Normalized ATR Display",  group=GRP_VOL)
bool   lbl_scale_en  = input.bool(false, "Custom Label Scaling",    group=GRP_UX)
string lbl_scale_sel = input.string("Normal", "Label Size", options=["Small", "Normal", "Large"], group=GRP_UX)

// ── USER-DEFINED TYPES ───────────────────────────────────────────────────────
type Pivot
    float p
    int   i

// Trimmed to 8 actionable fields (was 26). The drawing-coordinate fields
// (fux1..lly2) and dead l_upper/l_lower were removed to cut compile cost —
// pattern OUTLINE drawing is dropped; detection + entry/stop/target + labels stay.
type PatternResult
    bool   detected
    string name
    bool   isBullish
    float  entryPrice
    float  stopPrice
    float  targetPrice
    int    start_idx
    int    breakout_idx

type PatternDrawings
    line[]  lns
    label[] lbls

// ── PERSISTENT STATE ─────────────────────────────────────────────────────────
var PatternResult EMPTY_RES = PatternResult.new(false, "", false, na, na, na, na, na)
var array<Pivot> pivotHighs = array.new<Pivot>()
var array<Pivot> pivotLows  = array.new<Pivot>()

var array<PatternDrawings> pat_history = array.new<PatternDrawings>()

var bool active_shown  = false
var float SLIP_COST_ABS = slippage_ticks * syminfo.mintick
var string dash_pat_name   = "—"
var bool   dash_pat_bull   = false
var int    dash_last_bar   = 0
var float  dash_entry      = na
var float  dash_stop       = na
var float  dash_target     = na

string clean_ticker = syminfo.prefix + ':' + syminfo.ticker

// ── GLOBAL CALCULATIONS ──────────────────────────────────────────────────────
vol_sma = ta.sma(volume, math.max(1, math.min(vol_len, bar_index + 1)))
atr_val = ta.atr(14)

int   dash_piv_total = array.size(pivotHighs) + array.size(pivotLows)
int   dash_bars_since = bar_index - dash_last_bar
float dash_vol_ratio  = vol_sma > 0 ? volume / vol_sma : 1.0
float dash_vol_score  = math.min(math.max((dash_vol_ratio - 1.0) / 4.0 * 10.0, 0.0), 10.0)

float dash_rr_raw     = not na(dash_entry) and not na(dash_stop) and not na(dash_target) and math.abs(dash_entry - dash_stop) > 0 ? math.abs(dash_target - dash_entry) / math.abs(dash_entry - dash_stop) : 0.0
float dash_rr_score   = math.min(dash_rr_raw / 5.0 * 10.0, 10.0)
float dash_piv_score  = math.min(int(dash_piv_total) / 20.0 * 10.0, 10.0)

f_blockBar(float score) =>
    int    n = math.min(math.max(math.round(score), 0), 10)
    string s = ''
    for i = 1 to 10
        s += i <= n ? '█' : '░'
    s + ' ' + str.tostring(math.round(score / 10.0 * 100.0), '##0') + '%'

f_blockColor(float score) =>
    score >= 7.0 ? color.rgb(0, 255, 120) : score >= 4.0 ? color.rgb(80, 255, 0) : score >= 1.5 ? color.rgb(200, 200, 0) : color.rgb(110, 110, 110)

string dash_vol_str   = f_blockBar(dash_vol_score)
string dash_rr_str    = f_blockBar(dash_rr_score)
string dash_piv_str   = f_blockBar(dash_piv_score)

color  dash_vol_col   = f_blockColor(dash_vol_score)
color  dash_rr_col    = f_blockColor(dash_rr_score)
color  dash_piv_col   = f_blockColor(dash_piv_score)

string dash_bias_str  = dash_pat_bull ? "▲ Bull" : "▼ Bear"
color  dash_bias_col  = dash_pat_bull ? color.rgb(0, 255, 120) : color.rgb(255, 60, 80)
string dash_name_str  = dash_pat_name
color  dash_name_col  = dash_pat_bull ? color.rgb(0, 255, 120) : color.rgb(255, 60, 80)
string dash_atr_str   = atr_norm_en ? str.tostring(math.round(atr_val / syminfo.mintick), "##0") + " ticks" : str.tostring(atr_val, format.mintick)
string dash_since_str = "⏳ " + str.tostring(dash_bars_since) + " Bars"

// ── HELPER FUNCTIONS ─────────────────────────────────────────────────────────
f_pivotHigh(series float src, simple int len) =>
    float candidate = src[len]
    bool  isValid   = true
    for i = 1 to len * 2
        if i != len and src[i] >= candidate
            isValid := false
    isValid ? candidate : na

f_pivotLow(series float src, simple int len) =>
    float candidate = src[len]
    bool  isValid   = true
    for i = 1 to len * 2
        if i != len and src[i] <= candidate
            isValid := false
    isValid ? candidate : na

f_project(float x1, float y1, float x2, float y2, float target_x) =>
    x2 == x1 ? y1 : y1 + ((y2 - y1) / (x2 - x1)) * (target_x - x1)

f_isNear(float v1, float v2, float tol_pct) =>
    math.abs(v1 - v2) <= ((v1 + v2) / 2) * tol_pct

f_neck_at_break(int nl_i, float nl_p, int nr_i, float nr_p, int b_idx) =>
    na(nl_i) and na(nr_i) ? na :
     na(nl_i) ? nr_p :
     na(nr_i) ? nl_p :
     nl_i == nr_i ? nl_p : f_project(nl_i, nl_p, nr_i, nr_p, b_idx)

f_isValidSize(float height, float price) =>
    height > math.max(price * min_size_pct, atr_val * min_atr_mult)

f_apply_buffer(float price, bool isBullish) =>
    isBullish ? price - (atr_val * stop_buffer) : price + (atr_val * stop_buffer)

f_sl_pat(float anchor, bool isBull, float entry_p, float target_p) =>
    if use_sl_pct_tgt and not na(entry_p) and not na(target_p)
        float _dist = math.abs(target_p - entry_p)
        isBull ? entry_p - _dist * sl_pct_tgt : entry_p + _dist * sl_pct_tgt
    else
        f_apply_buffer(anchor, isBull)

f_get_entry_price(int b_idx) =>
    int offs = bar_index - b_idx
    offs >= 1 ? open[offs] : na

f_get_break_idx_precise(float x1, float y1, float x2, float y2, bool isUp) =>
    int   b_idx      = na
    int   scan_limit = math.max(min_brk_bar, lb_right) + 10
    float m          = x2 == x1 ? 0.0 : (y2 - y1) / (x2 - x1)
    for i = scan_limit to 1
        if (bar_index - i) < 0
            continue
        float proj_price  = x2 == x1 ? y1 : y1 + m * ((bar_index - i) - x1)
        float margin      = use_atr_brk ? atr_val[i] * break_atr : proj_price * break_pct
        float up_thresh   = proj_price + margin
        float down_thresh = proj_price - margin
        float check_val   = req_close_brk ? close[i] : isUp ? high[i] : low[i]
        bool  is_broken   = isUp ? check_val > up_thresh : check_val < down_thresh
        if req_body_brk and is_broken and not show_ignore_conf
            is_broken := isUp ? open[i] > up_thresh and close[i] > up_thresh : open[i] < down_thresh and close[i] < down_thresh
        if is_broken
            bool confirmed = true
            if brk_confirm_bars > 1 and not show_ignore_conf
                for k = 1 to brk_confirm_bars - 1
                    int check_idx = i - k
                    if check_idx < 0
                        confirmed := false
                        break
                    float proj_k   = x2 == x1 ? y1 : y1 + m * ((bar_index - check_idx) - x1)
                    float margin_k = use_atr_brk ? atr_val[check_idx] * break_atr : proj_k * break_pct
                    if isUp and close[check_idx] <= proj_k + margin_k
                        confirmed := false
                        break
                    else if not isUp and close[check_idx] >= proj_k - margin_k
                        confirmed := false
                        break
            if confirmed
                b_idx := bar_index - i
                break
    b_idx

f_validate_pattern(int b_idx, float entry_p, float stop_p, float target_p) =>
    if show_ignore_conf
        true
    else
        bool valid = true
        if req_vol and not na(b_idx)
            int offs = bar_index - b_idx
            if offs >= 0 and offs < bar_index
                float sma_at_offs = vol_sma[offs]
                if not na(sma_at_offs) and volume[offs] <= sma_at_offs * vol_mult
                    valid := false
        if valid and not na(entry_p)
            float total_cost = SLIP_COST_ABS + entry_p * (commission_pct / 100) * 2
            float risk       = math.abs(entry_p - stop_p)
            float reward_adj = math.max(0, math.abs(target_p - entry_p) - total_cost)
            if risk == 0 or reward_adj / risk < min_rr
                valid := false
        valid

f_manage_drawings(int max_items) =>
    while array.size(pat_history) > max_items
        PatternDrawings old_pat = array.shift(pat_history)
        for _ln in old_pat.lns
            if not na(_ln)
                line.delete(_ln)
        for _lb in old_pat.lbls
            if not na(_lb)
                label.delete(_lb)

// ── PATTERN DETECTION FUNCTIONS ──────────────────────────────────────────────
detectHS() =>
    res = EMPTY_RES
    _has_hs  = pivotHighs.size() >= 3 and pivotLows.size() >= 2
    _has_ihs = pivotLows.size() >= 3 and pivotHighs.size() >= 2
    _rs       = _has_hs  ? pivotHighs.get(0) : Pivot.new(na, na)
    _head     = _has_hs  ? pivotHighs.get(1) : Pivot.new(na, na)
    _ls       = _has_hs  ? pivotHighs.get(2) : Pivot.new(na, na)
    _l_neck_r = _has_hs  ? pivotLows.get(0)  : Pivot.new(na, na)
    _l_neck_l = _has_hs  ? pivotLows.get(1)  : Pivot.new(na, na)
    _rs_inv   = _has_ihs ? pivotLows.get(0)   : Pivot.new(na, na)
    _head_inv = _has_ihs ? pivotLows.get(1)   : Pivot.new(na, na)
    _ls_inv   = _has_ihs ? pivotLows.get(2)   : Pivot.new(na, na)
    _h_neck_r = _has_ihs ? pivotHighs.get(0)  : Pivot.new(na, na)
    _h_neck_l = _has_ihs ? pivotHighs.get(1)  : Pivot.new(na, na)
    int   _b_hs      = f_get_break_idx_precise(_l_neck_l.i, _l_neck_l.p, _l_neck_r.i, _l_neck_r.p, false)
    int   _b_ihs     = f_get_break_idx_precise(_h_neck_l.i, _h_neck_l.p, _h_neck_r.i, _h_neck_r.p, true)
    float _ep_hs     = f_get_entry_price(_b_hs)
    float _na_hs     = f_neck_at_break(_l_neck_l.i, _l_neck_l.p, _l_neck_r.i, _l_neck_r.p, nz(_b_hs))
    float _neck_avg  = (nz(_l_neck_r.p) + nz(_l_neck_l.p)) / 2
    float _ht_hs     = nz(_head.p) - _neck_avg
    float _tp_hs     = _na_hs - _ht_hs
    float _sp_hs     = f_sl_pat(_rs.p, false, _ep_hs, _tp_hs)
    bool  _val_hs    = f_validate_pattern(_b_hs, _ep_hs, _sp_hs, _tp_hs)
    float _ep_ihs    = f_get_entry_price(_b_ihs)
    float _na_ihs    = f_neck_at_break(_h_neck_l.i, _h_neck_l.p, _h_neck_r.i, _h_neck_r.p, nz(_b_ihs))
    float _neck_avg_inv = (nz(_h_neck_r.p) + nz(_h_neck_l.p)) / 2
    float _ht_ihs    = _neck_avg_inv - nz(_head_inv.p)
    float _tp_ihs    = _na_ihs + _ht_ihs
    float _sp_ihs    = f_sl_pat(_rs_inv.p, true, _ep_ihs, _tp_ihs)
    bool  _val_ihs   = f_validate_pattern(_b_ihs, _ep_ihs, _sp_ihs, _tp_ihs)
    if _has_hs
        if _rs.i > _l_neck_r.i and _l_neck_r.i > _head.i and _head.i > _l_neck_l.i and _l_neck_l.i > _ls.i
            if _head.p > _rs.p and _head.p > _ls.p and f_isNear(_ls.p, _rs.p, sym_tol)
                if f_isValidSize(_ht_hs, close)
                    if not na(_b_hs)
                        if not na(_ep_hs) and _val_hs and show_hs_std
                            res         := PatternResult.new(true, "Head & Shoulders", false, _ep_hs, _sp_hs, _tp_hs, _ls.i, _b_hs)
    if not res.detected and _has_ihs
        if _rs_inv.i > _h_neck_r.i and _h_neck_r.i > _head_inv.i and _head_inv.i > _h_neck_l.i and _h_neck_l.i > _ls_inv.i
            if _head_inv.p < _rs_inv.p and _head_inv.p < _ls_inv.p and f_isNear(_ls_inv.p, _rs_inv.p, sym_tol)
                if f_isValidSize(_ht_ihs, close)
                    if not na(_b_ihs)
                        if not na(_ep_ihs) and _val_ihs and show_hs_inv
                            res         := PatternResult.new(true, "Inv Head & Shoulders", true, _ep_ihs, _sp_ihs, _tp_ihs, _ls_inv.i, _b_ihs)
    res

detectDouble() =>
    res = EMPTY_RES
    _has_dt  = pivotHighs.size() >= 2 and pivotLows.size() >= 1
    _has_db  = pivotLows.size() >= 2 and pivotHighs.size() >= 1
    _p1      = _has_dt ? pivotHighs.get(0) : Pivot.new(na, na)
    _p2      = _has_dt ? pivotHighs.get(1) : Pivot.new(na, na)
    _mid     = _has_dt ? pivotLows.get(0)  : Pivot.new(na, na)
    _p1b     = _has_db ? pivotLows.get(0)   : Pivot.new(na, na)
    _p2b     = _has_db ? pivotLows.get(1)   : Pivot.new(na, na)
    _mid_b   = _has_db ? pivotHighs.get(0)  : Pivot.new(na, na)
    int   _b_dt   = f_get_break_idx_precise(_mid.i, _mid.p, bar_index, _mid.p, false)
    int   _b_db   = f_get_break_idx_precise(_mid_b.i, _mid_b.p, bar_index, _mid_b.p, true)
    float _ep_dt  = f_get_entry_price(_b_dt)
    float _avg_top = (nz(_p1.p) + nz(_p2.p)) / 2
    float _ht_dt  = _avg_top - nz(_mid.p)
    float _tp_dt  = nz(_mid.p) - _ht_dt
    float _sp_dt  = f_sl_pat(math.max(nz(_p1.p), nz(_p2.p)), false, _ep_dt, _tp_dt)
    bool  _val_dt = f_validate_pattern(_b_dt, _ep_dt, _sp_dt, _tp_dt)
    float _ep_db  = f_get_entry_price(_b_db)
    float _avg_bot = (nz(_p1b.p) + nz(_p2b.p)) / 2
    float _ht_db  = nz(_mid_b.p) - _avg_bot
    float _tp_db  = nz(_mid_b.p) + _ht_db
    float _sp_db  = f_sl_pat(math.min(nz(_p1b.p), nz(_p2b.p)), true, _ep_db, _tp_db)
    bool  _val_db = f_validate_pattern(_b_db, _ep_db, _sp_db, _tp_db)
    if _has_dt
        if _p1.i > _mid.i and _mid.i > _p2.i and f_isNear(_p1.p, _p2.p, lvl_tol)
            if f_isValidSize(_ht_dt, close)
                if not na(_b_dt)
                    if not na(_ep_dt) and _val_dt and show_dt_top
                        res := PatternResult.new(true, "Double Top", false, _ep_dt, _sp_dt, _tp_dt, _p2.i, _b_dt)
    if not res.detected and _has_db
        if _p1b.i > _mid_b.i and _mid_b.i > _p2b.i and f_isNear(_p1b.p, _p2b.p, lvl_tol)
            if f_isValidSize(_ht_db, close)
                if not na(_b_db)
                    if not na(_ep_db) and _val_db and show_dt_bot
                        res := PatternResult.new(true, "Double Bottom", true, _ep_db, _sp_db, _tp_db, _p2b.i, _b_db)
    res

detectTriple() =>
    res = EMPTY_RES
    _has_tt  = pivotHighs.size() >= 3 and pivotLows.size() >= 2
    _has_tb  = pivotLows.size() >= 3 and pivotHighs.size() >= 2
    _h1      = _has_tt ? pivotHighs.get(0) : Pivot.new(na, na)
    _h2      = _has_tt ? pivotHighs.get(1) : Pivot.new(na, na)
    _h3      = _has_tt ? pivotHighs.get(2) : Pivot.new(na, na)
    _l1t     = _has_tt ? pivotLows.get(0)  : Pivot.new(na, na)
    _l2t     = _has_tt ? pivotLows.get(1)  : Pivot.new(na, na)
    _l1b     = _has_tb ? pivotLows.get(0)   : Pivot.new(na, na)
    _l2b     = _has_tb ? pivotLows.get(1)   : Pivot.new(na, na)
    _l3b     = _has_tb ? pivotLows.get(2)   : Pivot.new(na, na)
    _h1b     = _has_tb ? pivotHighs.get(0)  : Pivot.new(na, na)
    _h2b     = _has_tb ? pivotHighs.get(1)  : Pivot.new(na, na)
    float _neck_tt    = math.min(nz(_l1t.p), nz(_l2t.p))
    float _ht_tt      = math.max(nz(_h1.p), math.max(nz(_h2.p), nz(_h3.p))) - _neck_tt
    float _neck_tb    = math.max(nz(_h1b.p), nz(_h2b.p))
    float _ht_tb      = _neck_tb - math.min(nz(_l1b.p), math.min(nz(_l2b.p), nz(_l3b.p)))
    int   _b_tt       = f_get_break_idx_precise(_l2t.i, _l2t.p, _l1t.i, _l1t.p, false)
    int   _b_tb       = f_get_break_idx_precise(_h2b.i, _neck_tb, _h1b.i, _neck_tb, true)
    float _na_tt      = f_neck_at_break(_l2t.i, _l2t.p, _l1t.i, _l1t.p, nz(_b_tt))
    float _na_tb      = f_neck_at_break(_h2b.i, _neck_tb, _h1b.i, _neck_tb, nz(_b_tb))
    float _ep_tt      = f_get_entry_price(_b_tt)
    float _ep_tb      = f_get_entry_price(_b_tb)
    float _tp_tt      = _na_tt - _ht_tt
    float _tp_tb      = _na_tb + _ht_tb
    float _sp_tt      = f_sl_pat(math.max(nz(_h1.p), math.max(nz(_h2.p), nz(_h3.p))), false, _ep_tt, _tp_tt)
    float _sp_tb      = f_sl_pat(math.min(nz(_l1b.p), math.min(nz(_l2b.p), nz(_l3b.p))), true, _ep_tb, _tp_tb)
    bool  _val_tt     = f_validate_pattern(_b_tt, _ep_tt, _sp_tt, _tp_tt)
    bool  _val_tb     = f_validate_pattern(_b_tb, _ep_tb, _sp_tb, _tp_tb)
    if _has_tt
        if _h1.i > _l1t.i and _l1t.i > _h2.i and _h2.i > _l2t.i and _l2t.i > _h3.i
            if f_isNear(_h1.p, _h2.p, lvl_tol) and f_isNear(_h2.p, _h3.p, lvl_tol)
                if f_isValidSize(_ht_tt, close)
                    if not na(_b_tt)
                        if not na(_ep_tt) and _val_tt and show_tt_top
                            res := PatternResult.new(true, "Triple Top", false, _ep_tt, _sp_tt, _tp_tt, _h3.i, _b_tt)
    if not res.detected and _has_tb
        if _l1b.i > _h1b.i and _h1b.i > _l2b.i and _l2b.i > _h2b.i and _h2b.i > _l3b.i
            if f_isNear(_l1b.p, _l2b.p, lvl_tol) and f_isNear(_l2b.p, _l3b.p, lvl_tol)
                if f_isValidSize(_ht_tb, close)
                    if not na(_b_tb)
                        if not na(_ep_tb) and _val_tb and show_tt_bot
                            res := PatternResult.new(true, "Triple Bottom", true, _ep_tb, _sp_tb, _tp_tb, _l3b.i, _b_tb)
    res

detectCupHandle() =>
    res = EMPTY_RES
    _has_cup  = pivotHighs.size() >= 2 and pivotLows.size() >= 2
    _h_rim    = _has_cup ? pivotHighs.get(0) : Pivot.new(na, na)
    _h_left   = _has_cup ? pivotHighs.get(1) : Pivot.new(na, na)
    _l_handle = _has_cup ? pivotLows.get(0)  : Pivot.new(na, na)
    _l_bot    = _has_cup ? pivotLows.get(1)  : Pivot.new(na, na)
    _l_rim    = _has_cup ? pivotLows.get(0)  : Pivot.new(na, na)
    _l_left   = _has_cup ? pivotLows.get(1)  : Pivot.new(na, na)
    _h_handle = _has_cup ? pivotHighs.get(0) : Pivot.new(na, na)
    _h_top    = _has_cup ? pivotHighs.get(1) : Pivot.new(na, na)
    float _cup_h_std  = nz(_h_rim.p) - nz(_l_bot.p)
    float _cup_h_inv  = nz(_h_top.p) - nz(_l_rim.p)
    int   _b_cup      = f_get_break_idx_precise(_h_rim.i, _h_rim.p, bar_index, _h_rim.p, true)
    int   _b_inv      = f_get_break_idx_precise(_l_rim.i, _l_rim.p, bar_index, _l_rim.p, false)
    float _na_cup     = f_neck_at_break(_h_left.i, _h_left.p, _h_rim.i, _h_rim.p, nz(_b_cup))
    float _na_inv     = f_neck_at_break(_l_left.i, _l_left.p, _l_rim.i, _l_rim.p, nz(_b_inv))
    float _ep_cup     = f_get_entry_price(_b_cup)
    float _ep_inv     = f_get_entry_price(_b_inv)
    float _tp_cup     = _na_cup + _cup_h_std
    float _tp_inv     = _na_inv - _cup_h_inv
    float _sp_cup     = f_sl_pat(_l_handle.p, true, _ep_cup, _tp_cup)
    float _sp_inv     = f_sl_pat(_h_handle.p, false, _ep_inv, _tp_inv)
    bool  _val_cup    = f_validate_pattern(_b_cup, _ep_cup, _sp_cup, _tp_cup)
    bool  _val_inv    = f_validate_pattern(_b_inv, _ep_inv, _sp_inv, _tp_inv)
    if _has_cup
        if _l_handle.i > _h_rim.i and _h_rim.i > _l_bot.i and _l_bot.i > _h_left.i
            if f_isNear(_h_rim.p, _h_left.p, sym_tol) and _l_handle.p > _l_bot.p and _l_handle.p < _h_rim.p
                if f_isValidSize(_cup_h_std, close)
                    if not na(_b_cup)
                        if not na(_ep_cup) and _val_cup and show_cup_std
                            res := PatternResult.new(true, "Cup & Handle", true, _ep_cup, _sp_cup, _tp_cup, _h_left.i, _b_cup)
    if not res.detected and _has_cup
        if _h_handle.i > _l_rim.i and _l_rim.i > _h_top.i and _h_top.i > _l_left.i
            if f_isNear(_l_rim.p, _l_left.p, sym_tol) and _h_handle.p < _h_top.p and _h_handle.p > _l_rim.p
                if f_isValidSize(_cup_h_inv, close)
                    if not na(_b_inv)
                        if not na(_ep_inv) and _val_inv and show_cup_inv
                            res := PatternResult.new(true, "Inv Cup & Handle", false, _ep_inv, _sp_inv, _tp_inv, _l_left.i, _b_inv)
    res

detectFlagPennant() =>
    res = EMPTY_RES
    _has = pivotHighs.size() >= 2 and pivotLows.size() >= 2
    _h1  = _has ? pivotHighs.get(0) : Pivot.new(na, na)
    _h2  = _has ? pivotHighs.get(1) : Pivot.new(na, na)
    _l1  = _has ? pivotLows.get(0)  : Pivot.new(na, na)
    _l2  = _has ? pivotLows.get(1)  : Pivot.new(na, na)
    int   _start_bar  = math.min(nz(_h2.i), nz(_l2.i))
    int   _pole_len   = math.min(200, bar_index - _start_bar + 1)
    float _pole_move  = ta.highest(high, _pole_len) - ta.lowest(low, _pole_len)
    float _slope_u    = _h1.i == _h2.i ? 0.0 : (nz(_h1.p) - nz(_h2.p)) / math.max(1, _h1.i - _h2.i)
    float _slope_l    = _l1.i == _l2.i ? 0.0 : (nz(_l1.p) - nz(_l2.p)) / math.max(1, _l1.i - _l2.i)
    bool  _parallel   = f_isNear(_slope_u, _slope_l, 0.2)
    int   _b_bull     = f_get_break_idx_precise(_h2.i, _h2.p, _h1.i, _h1.p, true)
    int   _b_bear     = f_get_break_idx_precise(_l2.i, _l2.p, _l1.i, _l1.p, false)
    float _ub_bull    = f_project(_h2.i, _h2.p, _h1.i, _h1.p, nz(_b_bull))
    float _lb_bull    = f_project(_l2.i, _l2.p, _l1.i, _l1.p, nz(_b_bull))
    float _ub_bear    = f_project(_h2.i, _h2.p, _h1.i, _h1.p, nz(_b_bear))
    float _lb_bear    = f_project(_l2.i, _l2.p, _l1.i, _l1.p, nz(_b_bear))
    float _ep_bull    = f_get_entry_price(_b_bull)
    float _ep_bear    = f_get_entry_price(_b_bear)
    float _tp_bull    = _ub_bull + _pole_move
    float _tp_bear    = _lb_bear - _pole_move
    float _sp_bull    = f_sl_pat(_lb_bull, true, _ep_bull, _tp_bull)
    float _sp_bear    = f_sl_pat(_ub_bear, false, _ep_bear, _tp_bear)
    bool  _val_bull   = f_validate_pattern(_b_bull, _ep_bull, _sp_bull, _tp_bull)
    bool  _val_bear   = f_validate_pattern(_b_bear, _ep_bear, _sp_bear, _tp_bear)
    if _has and _pole_move > atr_val * 3
        if _slope_u < 0 and _slope_l < 0
            if not na(_b_bull)
                if not na(_ep_bull) and _val_bull
                    if (_parallel and show_flag_bull) or (not _parallel and show_pennant_bull)
                        res := PatternResult.new(true, _parallel ? "Bullish Flag" : "Bullish Pennant", true, _ep_bull, _sp_bull, _tp_bull, _h2.i, _b_bull)
        else if _slope_u > 0 and _slope_l > 0
            if not na(_b_bear)
                if not na(_ep_bear) and _val_bear
                    if (_parallel and show_flag_bear) or (not _parallel and show_pennant_bear)
                        res := PatternResult.new(true, _parallel ? "Bearish Flag" : "Bearish Pennant", false, _ep_bear, _sp_bear, _tp_bear, _h2.i, _b_bear)
    res

detectWedge() =>
    res = EMPTY_RES
    _has = pivotHighs.size() >= 2 and pivotLows.size() >= 2
    _h1  = _has ? pivotHighs.get(0) : Pivot.new(na, na)
    _h2  = _has ? pivotHighs.get(1) : Pivot.new(na, na)
    _l1  = _has ? pivotLows.get(0)  : Pivot.new(na, na)
    _l2  = _has ? pivotLows.get(1)  : Pivot.new(na, na)
    float _slope_u         = _h1.i == _h2.i ? 0.0 : (nz(_h1.p) - nz(_h2.p)) / math.max(1, _h1.i - _h2.i)
    float _slope_l         = _l1.i == _l2.i ? 0.0 : (nz(_l1.p) - nz(_l2.p)) / math.max(1, _l1.i - _l2.i)
    int   _start_idx_wedge = math.min(nz(_h2.i), nz(_l2.i))
    float _proj_u_now      = f_project(_h2.i, _h2.p, _h1.i, _h1.p, bar_index)
    float _proj_l_now      = f_project(_l2.i, _l2.p, _l1.i, _l1.p, bar_index)
    float _height_now      = _proj_u_now - _proj_l_now
    int   _b_fall          = f_get_break_idx_precise(_h2.i, _h2.p, _h1.i, _h1.p, true)
    int   _b_rise          = f_get_break_idx_precise(_l2.i, _l2.p, _l1.i, _l1.p, false)
    float _ub_fall         = f_project(_h2.i, _h2.p, _h1.i, _h1.p, nz(_b_fall))
    float _lb_fall         = f_project(_l2.i, _l2.p, _l1.i, _l1.p, nz(_b_fall))
    float _ub_rise         = f_project(_h2.i, _h2.p, _h1.i, _h1.p, nz(_b_rise))
    float _lb_rise         = f_project(_l2.i, _l2.p, _l1.i, _l1.p, nz(_b_rise))
    float _ep_fall         = f_get_entry_price(_b_fall)
    float _ep_rise         = f_get_entry_price(_b_rise)
    float _tp_fall         = nz(_h2.p)
    float _tp_rise         = nz(_l2.p)
    float _sp_fall         = f_sl_pat(_lb_fall, true, _ep_fall, _tp_fall)
    float _sp_rise         = f_sl_pat(_ub_rise, false, _ep_rise, _tp_rise)
    bool  _val_fall        = f_validate_pattern(_b_fall, _ep_fall, _sp_fall, _tp_fall)
    bool  _val_rise        = f_validate_pattern(_b_rise, _ep_rise, _sp_rise, _tp_rise)
    if _has and _height_now > 0
        if _slope_u < 0 and _slope_l < 0 and _slope_l < _slope_u
            if not na(_b_fall)
                if not na(_ep_fall) and _val_fall and show_wedge_fall
                    res := PatternResult.new(true, "Falling Wedge", true, _ep_fall, _sp_fall, _tp_fall, _h2.i, _b_fall)
        else if _slope_u > 0 and _slope_l > 0 and _slope_l > _slope_u
            if not na(_b_rise)
                if not na(_ep_rise) and _val_rise and show_wedge_rise
                    res := PatternResult.new(true, "Rising Wedge", false, _ep_rise, _sp_rise, _tp_rise, _h2.i, _b_rise)
    res

detectTriangles() =>
    res = EMPTY_RES
    _has = pivotHighs.size() >= 2 and pivotLows.size() >= 2
    _h1  = _has ? pivotHighs.get(0) : Pivot.new(na, na)
    _h2  = _has ? pivotHighs.get(1) : Pivot.new(na, na)
    _l1  = _has ? pivotLows.get(0)  : Pivot.new(na, na)
    _l2  = _has ? pivotLows.get(1)  : Pivot.new(na, na)
    float _slope_u      = _h1.i == _h2.i ? 0.0 : (nz(_h1.p) - nz(_h2.p)) / math.max(1, _h1.i - _h2.i)
    float _slope_l      = _l1.i == _l2.i ? 0.0 : (nz(_l1.p) - nz(_l2.p)) / math.max(1, _l1.i - _l2.i)
    int   _start_tri    = math.min(nz(_h2.i), nz(_l2.i))
    float _base_height  = math.abs(f_project(_h2.i, _h2.p, _h1.i, _h1.p, _start_tri) - f_project(_l2.i, _l2.p, _l1.i, _l1.p, _start_tri))
    float _flat_tol     = close * 0.0005
    bool  _converging   = f_project(_h2.i, _h2.p, _h1.i, _h1.p, bar_index) > f_project(_l2.i, _l2.p, _l1.i, _l1.p, bar_index)
    int   _b_bull       = f_get_break_idx_precise(_h2.i, _h2.p, _h1.i, _h1.p, true)
    int   _b_bear       = f_get_break_idx_precise(_l2.i, _l2.p, _l1.i, _l1.p, false)
    float _ub_bull      = f_project(_h2.i, _h2.p, _h1.i, _h1.p, nz(_b_bull))
    float _lb_bull      = f_project(_l2.i, _l2.p, _l1.i, _l1.p, nz(_b_bull))
    float _ub_bear      = f_project(_h2.i, _h2.p, _h1.i, _h1.p, nz(_b_bear))
    float _lb_bear      = f_project(_l2.i, _l2.p, _l1.i, _l1.p, nz(_b_bear))
    float _ep_bull      = f_get_entry_price(_b_bull)
    float _ep_bear      = f_get_entry_price(_b_bear)
    float _tp_bull      = _ub_bull + _base_height
    float _tp_bear      = _lb_bear - _base_height
    float _sp_bull      = f_sl_pat(_lb_bull, true, _ep_bull, _tp_bull)
    float _sp_bear      = f_sl_pat(_ub_bear, false, _ep_bear, _tp_bear)
    bool  _val_bull     = f_validate_pattern(_b_bull, _ep_bull, _sp_bull, _tp_bull)
    bool  _val_bear     = f_validate_pattern(_b_bear, _ep_bear, _sp_bear, _tp_bear)
    if _has and _converging and f_isValidSize(_base_height, close)
        if (_slope_u < 0 and _slope_l > 0) or (math.abs(_slope_u) < _flat_tol and _slope_l > 0)
            if not na(_b_bull)
                if not na(_ep_bull) and _val_bull and show_tri_gen
                    bool _isBullish = math.abs(_slope_u) < _flat_tol
                    res := PatternResult.new(true, _isBullish ? "Ascending Triangle" : "Symmetrical Triangle", true, _ep_bull, _sp_bull, _tp_bull, _h2.i, _b_bull)
        if not res.detected and ((_slope_u < 0 and _slope_l > 0) or (_slope_u < 0 and math.abs(_slope_l) < _flat_tol))
            if not na(_b_bear)
                if not na(_ep_bear) and _val_bear and show_tri_gen
                    bool _isBearish = math.abs(_slope_l) < _flat_tol
                    res := PatternResult.new(true, _isBearish ? "Descending Triangle" : "Symmetrical Triangle", false, _ep_bear, _sp_bear, _tp_bear, _h2.i, _b_bear)
    res

detectRectangles() =>
    res = EMPTY_RES
    _has = pivotHighs.size() >= 2 and pivotLows.size() >= 2
    _h1  = _has ? pivotHighs.get(0) : Pivot.new(na, na)
    _h2  = _has ? pivotHighs.get(1) : Pivot.new(na, na)
    _l1  = _has ? pivotLows.get(0)  : Pivot.new(na, na)
    _l2  = _has ? pivotLows.get(1)  : Pivot.new(na, na)
    float _slope_u      = _h1.i == _h2.i ? 0.0 : (nz(_h1.p) - nz(_h2.p)) / math.max(1, _h1.i - _h2.i)
    float _slope_l      = _l1.i == _l2.i ? 0.0 : (nz(_l1.p) - nz(_l2.p)) / math.max(1, _l1.i - _l2.i)
    float _flat_tol_r   = atr_val * 0.05
    bool  _is_flat      = math.abs(_slope_u) < _flat_tol_r and math.abs(_slope_l) < _flat_tol_r
    int   _start_rect   = math.min(nz(_h2.i), nz(_l2.i))
    float _avg_top      = (nz(_h1.p) + nz(_h2.p)) / 2
    float _avg_bot      = (nz(_l1.p) + nz(_l2.p)) / 2
    float _height       = _avg_top - _avg_bot
    int   _b_bull       = f_get_break_idx_precise(_start_rect, _avg_top, bar_index, _avg_top, true)
    int   _b_bear       = f_get_break_idx_precise(_start_rect, _avg_bot, bar_index, _avg_bot, false)
    float _ep_bull      = f_get_entry_price(_b_bull)
    float _ep_bear      = f_get_entry_price(_b_bear)
    float _tp_bull      = _avg_top + _height
    float _tp_bear      = _avg_bot - _height
    float _sp_bull      = f_sl_pat(_avg_bot, true, _ep_bull, _tp_bull)
    float _sp_bear      = f_sl_pat(_avg_top, false, _ep_bear, _tp_bear)
    bool  _val_bull     = f_validate_pattern(_b_bull, _ep_bull, _sp_bull, _tp_bull)
    bool  _val_bear     = f_validate_pattern(_b_bear, _ep_bear, _sp_bear, _tp_bear)
    if _has and _is_flat and f_isNear(_slope_u, _slope_l, 0.5) and f_isValidSize(_height, close)
        if not na(_b_bull)
            if not na(_ep_bull) and _val_bull and show_rect_gen
                res := PatternResult.new(true, "Rectangle", true, _ep_bull, _sp_bull, _tp_bull, _h2.i, _b_bull)
        if not res.detected and not na(_b_bear)
            if not na(_ep_bear) and _val_bear and show_rect_gen
                res := PatternResult.new(true, "Rectangle", false, _ep_bear, _sp_bear, _tp_bear, _h2.i, _b_bear)
    res

// ── PIVOT COLLECTION & PENDING LINES ─────────────────────────────────────────
// renamed ph/pl -> mk_ph/mk_pl (bare ph/pl are Pivot Channel globals above)
float mk_ph = f_pivotHigh(high, lb_left)
float mk_pl = f_pivotLow(low, lb_left)
if not na(mk_ph)
    pivotHighs.unshift(Pivot.new(mk_ph, bar_index - lb_right))
    if pivotHighs.size() > max_piv_hist
        pivotHighs.pop()
if not na(mk_pl)
    pivotLows.unshift(Pivot.new(mk_pl, bar_index - lb_right))
    if pivotLows.size() > max_piv_hist
        pivotLows.pop()
bool has_pivots = pivotHighs.size() >= 2 and pivotLows.size() >= 2

// ── PATTERN ENGINE & SIGNAL DISPATCH ─────────────────────────────────────────
var int last_idx = 0
var int frozen_start_idx = na
PatternResult _r_dbl  = detectDouble()
PatternResult _r_tri  = detectTriple()
PatternResult _r_hs   = detectHS()
PatternResult _r_fp   = detectFlagPennant()
PatternResult _r_wdg  = detectWedge()
PatternResult _r_trng = detectTriangles()
PatternResult _r_rect = detectRectangles()
PatternResult _r_cup  = detectCupHandle()
PatternResult res = EMPTY_RES

bool _gate = bar_index > 600 and has_pivots
if _gate
    if (show_dt_top or show_dt_bot) and not res.detected and _r_dbl.detected
        res := _r_dbl
    if (show_tt_top or show_tt_bot) and not res.detected and _r_tri.detected
        res := _r_tri
    if (show_hs_std or show_hs_inv) and not res.detected and _r_hs.detected
        res := _r_hs
    if (show_flag_bull or show_flag_bear or show_pennant_bull or show_pennant_bear) and not res.detected and _r_fp.detected
        res := _r_fp
    if (show_wedge_rise or show_wedge_fall) and not res.detected and _r_wdg.detected
        res := _r_wdg
    if show_tri_gen and not res.detected and _r_trng.detected
        res := _r_trng
    if show_rect_gen and not res.detected and _r_rect.detected
        res := _r_rect
    if (show_cup_std or show_cup_inv) and not res.detected and _r_cup.detected
        res := _r_cup

// ── RENDERING & DRAWING ──────────────────────────────────────────────────────
bool _is_new_pattern = res.detected and barstate.isconfirmed and (na(frozen_start_idx) or math.abs(res.start_idx - frozen_start_idx) > cooldown)
if _is_new_pattern and rr_dyn_en and not na(res.entryPrice) and not na(res.stopPrice)
    float _rr_risk   = math.abs(res.entryPrice - res.stopPrice)
    res.targetPrice := res.isBullish ? res.entryPrice + _rr_risk * rr_dyn_mult : res.entryPrice - _rr_risk * rr_dyn_mult
if _is_new_pattern
    PatternDrawings current_pat = PatternDrawings.new(array.new_line(), array.new_label())

    last_idx             := bar_index
    frozen_start_idx     := res.start_idx
    active_shown         := true
    dash_pat_name        := res.name
    dash_pat_bull        := res.isBullish
    dash_last_bar        := last_idx
    dash_entry           := res.entryPrice
    dash_stop            := res.stopPrice
    dash_target          := res.targetPrice

    string txt = res.name

    // Outline drawing removed for compile budget; place the pattern-name label at
    // the pattern midpoint / entry level.
    if not na(res.start_idx) and not na(res.breakout_idx) and not na(res.entryPrice)
        int   _cx = (res.start_idx + res.breakout_idx) / 2
        float _cy = res.entryPrice
        string _lbl_sz_ctr = lbl_scale_en ? (lbl_scale_sel == "Small" ? size.small : lbl_scale_sel == "Large" ? size.large : size.normal) : size.small
        lbl = label.new(_cx, _cy, txt, color=color.rgb(0, 0, 0, 0), textcolor=color.white, style=label.style_label_center, size=_lbl_sz_ctr)
        array.push(current_pat.lbls, lbl)

    if alert_en and not na(res.entryPrice) and not na(res.targetPrice) and not na(res.stopPrice)
        string _alert_json = "{" + str.format('"ticker":"{0}","pattern":"{1}","bias":"{2}","entry":{3},"tp":{4},"sl":{5}', syminfo.tickerid, txt, res.isBullish ? "bull" : "bear", str.tostring(res.entryPrice, format.mintick), str.tostring(res.targetPrice, format.mintick), str.tostring(res.stopPrice, format.mintick)) + "}"
        alert(_alert_json, alert.freq_once_per_bar_close)

    if show_tgt and not na(res.breakout_idx) and not na(res.entryPrice) and not na(res.stopPrice) and not na(res.targetPrice)
        int offs = bar_index - res.breakout_idx
        if offs >= 1
            int   _x1        = res.breakout_idx
            int   _x2        = res.breakout_idx + 50
            int   _lx        = _x2 + 1
            float _ep        = res.entryPrice

            float total_cost = SLIP_COST_ABS + _ep * (commission_pct / 100) * 2
            float risk_val   = math.abs(_ep - res.stopPrice)
            float reward_adj = math.max(0, math.abs(res.targetPrice - _ep) - total_cost)
            float rr_adj     = risk_val == 0 ? 0 : reward_adj / risk_val

            string _ep_str   = str.tostring(_ep,             format.mintick)
            string _sp_str   = str.tostring(res.stopPrice,   format.mintick)
            string _tp_str   = str.tostring(res.targetPrice, format.mintick)
            string _rr_str   = str.tostring(rr_adj, "#.##")

            line  ln_entry   = line.new(_x1, _ep,             _x2, _ep,             color=col_entry,  style=line.style_dashed, width=1)
            line  ln_stop    = line.new(_x1, res.stopPrice,   _x2, res.stopPrice,   color=col_stop,   style=line.style_dashed, width=1)
            line  ln_target  = line.new(_x1, res.targetPrice, _x2, res.targetPrice, color=col_target, style=line.style_dashed, width=1)

            string _lbl_sz = lbl_scale_en ? (lbl_scale_sel == "Small" ? size.small : lbl_scale_sel == "Large" ? size.large : size.normal) : size.small
            label lbl_entry  = label.new(_lx, _ep,             "▶ [" + txt + "] Entry  " + _ep_str,                       style=label.style_label_left, color=color.new(col_entry,  70), textcolor=col_entry,  size=_lbl_sz)
            label lbl_stop   = label.new(_lx, res.stopPrice,   "▶ [" + txt + "] Stop   " + _sp_str,                       style=label.style_label_left, color=color.new(col_stop,   70), textcolor=col_stop,   size=_lbl_sz)
            label lbl_target = label.new(_lx, res.targetPrice, "▶ [" + txt + "] Target " + _tp_str + "   R:R " + _rr_str, style=label.style_label_left, color=color.new(col_target, 70), textcolor=col_target, size=_lbl_sz)

            array.push(current_pat.lns,  ln_entry)
            array.push(current_pat.lns,  ln_stop)
            array.push(current_pat.lns,  ln_target)
            array.push(current_pat.lbls, lbl_entry)
            array.push(current_pat.lbls, lbl_stop)
            array.push(current_pat.lbls, lbl_target)

    array.push(pat_history, current_pat)

    f_manage_drawings(max_patterns)
    active_shown := array.size(pat_history) > 0

// ── DASHBOARD ────────────────────────────────────────────────────────────────
// moved to middle_left to avoid the crowded top_right corner
var table dash = table.new(position.middle_left, 2, 9,
     border_width = 1,
     border_color = color.rgb(50, 50, 70, 20),
     frame_width  = 1,
     frame_color  = color.rgb(60, 60, 90, 10))

color hdrBg = color.rgb(30, 30, 45, 10)
color altBg = color.rgb(20, 20, 25, 10)
color oddBg = dash_bg_color

table.cell(dash, 0, 0, "  Pattern Detector", bgcolor=hdrBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 0, clean_ticker + " · " + timeframe.period, bgcolor=hdrBg, text_color=dash_txt_color, text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 1, "  Pattern Bias",   bgcolor=altBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 1, dash_bias_str,       bgcolor=altBg, text_color=dash_bias_col,  text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 2, "  Active Pattern",  bgcolor=oddBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 2, dash_name_str,        bgcolor=oddBg, text_color=dash_name_col,  text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 3, "  ATR (14)",        bgcolor=altBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 3, dash_atr_str,         bgcolor=altBg, text_color=color.rgb(200, 200, 60), text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 4, "  Vol Spike",       bgcolor=oddBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 4, dash_vol_str,         bgcolor=oddBg, text_color=dash_vol_col,  text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 5, "  R:R Quality",     bgcolor=altBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 5, dash_rr_str,          bgcolor=altBg, text_color=dash_rr_col,   text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 6, "  Pivot Depth",     bgcolor=oddBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 6, dash_piv_str,         bgcolor=oddBg, text_color=dash_piv_col,  text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 7, "  Bars Since Brk",  bgcolor=altBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 7, dash_since_str,       bgcolor=altBg, text_color=color.rgb(140, 180, 255), text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 0, 8, "  Pivot Count",     bgcolor=oddBg, text_color=dash_txt_color, text_halign=text.align_left,  text_font_family=font.family_monospace, text_size=size.small)
table.cell(dash, 1, 8, "⏳ " + str.tostring(dash_piv_total) + " Pivots", bgcolor=oddBg, text_color=color.rgb(140, 180, 255), text_halign=text.align_right, text_font_family=font.family_monospace, text_size=size.small)

//==============================================================================
//        MARKET STRUCTURE DYNAMICS & ORDER BLOCKS
//------------------------------------------------------------------------------
// Merged into the single indicator. Stand-alone @version/indicator() header
// removed (one declaration per script). No identifier collisions with existing
// engines (verified). NOTE: this engine draws its OWN order blocks + BOS +
// weekly levels + dashboard, overlapping the BigBeluga Order Block
// Engine already present above.
//==============================================================================

//---------------------------------------------------------------------------------------------------------------------
// Color Palette (Light Background Friendly)
//---------------------------------------------------------------------------------------------------------------------
color COLOR_BULL         = #059669 // Emerald Green
color COLOR_BEAR         = #DC2626 // Crimson Red
color COLOR_HPZ_BULL     = #0284C7 // Sky Blue
color COLOR_HPZ_BEAR     = #D97706 // Amber
color COLOR_NEUTRAL      = #6B7280 // Slate Gray

// Table Aesthetics for Light Theme
color DASH_BG            = #FFFFFF
color DASH_BORDER        = #E5E7EB
color DASH_TEXT_PRIMARY  = #111827
color DASH_TEXT_MUTED    = #6B7280

//---------------------------------------------------------------------------------------------------------------------
// User Inputs
//---------------------------------------------------------------------------------------------------------------------
string G_DASH            = "Analytics Panel"
string G_MS              = "Market Structure"
string G_OB              = "Institutional Blocks"
string G_WEEKLY          = "Weekly Levels"
string G_SIGNALS         = "Buy / Sell Signals"

// Dashboard Options
bool   cfgShowDash       = input.bool(true, "Show Analytics Panel", group = G_DASH)
string cfgDashPos        = input.string("Top Right", "Panel Position", options = ["Top Right", "Bottom Right", "Bottom Left"], group = G_DASH)
string cfgDashSize       = input.string("Small", "Panel Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_DASH)

// Structure Settings
int    cfgPivotLength    = input.int(7, "Pivot Lookback Period", minval = 1, group = G_MS)
float  cfgBreakThreshold = input.float(0.5, "Break Momentum Threshold (Z-Score)", minval = 0.1, step = 0.1, group = G_MS)

// Order Block Settings
string cfgDisplayMode    = input.string("Historical", "View Mode", options = ["Historical", "Active Only"], group = G_OB)
int    cfgMaxBlocks      = input.int(10, "Maximum Active Blocks", minval = 1, maxval = 100, group = G_OB)
bool   cfgKeepMitigated  = input.bool(false, "Extend Mitigated Blocks", group = G_OB)
bool   cfgFilterOverlap  = input.bool(true, "Filter Overlapping Blocks", group = G_OB)

// Weekly High/Low Settings
bool   cfgShowWeekly     = input.bool(true, "Show Prev Weekly High / Low", group = G_WEEKLY)
color  cfgWhColor        = input.color(#7C3AED, "Weekly High Color", group = G_WEEKLY, inline = "WH")
color  cfgWlColor        = input.color(#0D9488, "Weekly Low Color", group = G_WEEKLY, inline = "WL")

// Signal Settings
bool   cfgShowSignals    = input.bool(true, "Show Buy / Sell Signals", group = G_SIGNALS)

//---------------------------------------------------------------------------------------------------------------------
// Data Types & Storage
//---------------------------------------------------------------------------------------------------------------------
type StructureBlock
    box   boxRef
    label labelRef
    line  pocRef
    float score
    float topVal
    float btmVal
    bool  isBullish
    bool  isHighProb
    bool  isMitigated
    int   mitigationIndex

var array<StructureBlock> activeBlocks = array.new<StructureBlock>()

//---------------------------------------------------------------------------------------------------------------------
// Helper Functions
//---------------------------------------------------------------------------------------------------------------------
getPosition(string posStr) =>
    switch posStr
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

getSize(string sizeStr) =>
    switch sizeStr
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

//---------------------------------------------------------------------------------------------------------------------
// Core Indicator Logic
//---------------------------------------------------------------------------------------------------------------------
// Weekly High/Low Calculations
float prevWeeklyHigh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
float prevWeeklyLow  = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)

var line  weeklyHighLine  = na
var line  weeklyLowLine   = na
var label weeklyHighLabel = na
var label weeklyLowLabel  = na

// Draw exactly ONE PWH and ONE PWL on the last bar (delete-then-redraw prevents
// any label/line duplication).
if cfgShowWeekly and barstate.islast
    line.delete(weeklyHighLine)
    line.delete(weeklyLowLine)
    label.delete(weeklyHighLabel)
    label.delete(weeklyLowLabel)
    weeklyHighLine  := line.new(bar_index - 50, prevWeeklyHigh, bar_index + 10, prevWeeklyHigh, color = cfgWhColor, width = 1, style = line.style_dashed)
    weeklyLowLine   := line.new(bar_index - 50, prevWeeklyLow,  bar_index + 10, prevWeeklyLow,  color = cfgWlColor, width = 1, style = line.style_dashed)
    weeklyHighLabel := label.new(bar_index + 12, prevWeeklyHigh, "PWH", color = color.new(cfgWhColor, 100), textcolor = cfgWhColor, style = label.style_none, size = size.small)
    weeklyLowLabel  := label.new(bar_index + 12, prevWeeklyLow,  "PWL", color = color.new(cfgWlColor, 100), textcolor = cfgWlColor, style = label.style_none, size = size.small)

// Momentum and Volatility Metrics
float priceDiff   = ta.change(close)
float meanDiff    = ta.sma(priceDiff, 50)
float stdDevDiff  = ta.stdev(priceDiff, 50)
float zScore      = (priceDiff - meanDiff) / stdDevDiff
float volPercent  = ta.percentrank(volume, 100)

// High/Low Swings
float highPivot = ta.pivothigh(high, cfgPivotLength, cfgPivotLength)
float lowPivot  = ta.pivotlow(low, cfgPivotLength, cfgPivotLength)

var float recentHighPivot = na
var float recentLowPivot  = na
var int   recentHighIndex = na
var int   recentLowIndex  = na

if not na(highPivot)
    recentHighPivot := highPivot
    recentHighIndex := bar_index - cfgPivotLength

if not na(lowPivot)
    recentLowPivot := lowPivot
    recentLowIndex := bar_index - cfgPivotLength

// Market Structure Break Conditions
bool bullishBreak = close > recentHighPivot and close[1] <= recentHighPivot and zScore > cfgBreakThreshold
bool bearishBreak = close < recentLowPivot and close[1] >= recentLowPivot and zScore < -cfgBreakThreshold

if bullishBreak
    int midPoint = math.round(math.avg(recentHighIndex, bar_index))
    line.new(recentHighIndex, recentHighPivot, bar_index, recentHighPivot, color = COLOR_BULL, width = 1)
    label.new(midPoint, recentHighPivot, "BOS", color = color.new(COLOR_BULL, 100), textcolor = COLOR_BULL, style = label.style_label_down, size = size.small)

if bearishBreak
    int midPoint = math.round(math.avg(recentLowIndex, bar_index))
    line.new(recentLowIndex, recentLowPivot, bar_index, recentLowPivot, color = COLOR_BEAR, width = 1)
    label.new(midPoint, recentLowPivot, "BOS", color = color.new(COLOR_BEAR, 100), textcolor = COLOR_BEAR, style = label.style_label_up, size = size.small)

// Order Block Generation
if bullishBreak or bearishBreak
    int candleOffset = 0
    for i = 1 to 10
        if (bullishBreak and close[i] < open[i]) or (bearishBreak and close[i] > open[i])
            candleOffset := i
            break

    float blockTop = high[candleOffset]
    float blockBtm = low[candleOffset]
    float blockPoc = math.avg(blockTop, blockBtm)

    // Calculate Block Quality
    float qualityRating = math.min(100, (math.abs(zScore) * 20) + (volPercent * 0.5))
    bool  isHighProbability = qualityRating > 80

    color primaryColor   = bullishBreak ? COLOR_BULL : COLOR_BEAR
    color highProbColor  = bullishBreak ? COLOR_HPZ_BULL : COLOR_HPZ_BEAR

    box   blockBox   = na
    label blockLabel = na
    line  blockLine  = na

    // Check for overlapping zones
    bool isOverlapping = false
    if cfgFilterOverlap and activeBlocks.size() > 0
        for i = 0 to activeBlocks.size() - 1
            StructureBlock current = activeBlocks.get(i)
            if not current.isMitigated and ((blockTop <= current.topVal and blockTop >= current.btmVal) or (blockBtm <= current.topVal and blockBtm >= current.btmVal))
                isOverlapping := true
                break

    if not isOverlapping
        color finalColor = isHighProbability ? highProbColor : primaryColor
        int   bgTransparency = isHighProbability ? 88 : 92

        blockBox   := box.new(bar_index[candleOffset], blockTop, bar_index + 12, blockBtm, border_color = color.new(finalColor, 30), bgcolor = color.new(finalColor, bgTransparency), border_width = 1, border_style = line.style_dotted)
        blockLine  := line.new(bar_index[candleOffset], blockPoc, bar_index + 12, blockPoc, color = color.new(finalColor, 40), width = 1, style = line.style_dotted)
        blockLabel := label.new(bar_index + 14, blockPoc, str.tostring(qualityRating, "#") + "%", color = color.new(finalColor, 100), textcolor = finalColor, style = label.style_none, size = size.tiny, textalign = text.align_left)

        StructureBlock newBlock = StructureBlock.new(blockBox, blockLabel, blockLine, qualityRating, blockTop, blockBtm, bullishBreak, isHighProbability, false, 0)
        activeBlocks.push(newBlock)

    if bullishBreak
        recentHighPivot := na
    else
        recentLowPivot := na

// Buy / Sell Signals Plotting
plotshape(cfgShowSignals and bullishBreak, title = "Buy Signal", style = shape.triangleup, location = location.belowbar, color = COLOR_BULL, size = size.small, text = "BUY", textcolor = COLOR_BULL)
plotshape(cfgShowSignals and bearishBreak, title = "Sell Signal", style = shape.triangledown, location = location.abovebar, color = COLOR_BEAR, size = size.small, text = "SELL", textcolor = COLOR_BEAR)

// TradingView Alerts Setup
alertcondition(bullishBreak, title = "Bullish BOS Signal", message = "Bullish Market Structure Break Detected on {{ticker}}!")
alertcondition(bearishBreak, title = "Bearish BOS Signal", message = "Bearish Market Structure Break Detected on {{ticker}}!")

// Life-cycle Management of Order Blocks
var float totalMitigatedCount = 0.0
var float totalCreatedCount   = 0.0

if (bullishBreak or bearishBreak)
    totalCreatedCount += 1

if activeBlocks.size() > 0
    int mitigateTracker = 0
    for i = activeBlocks.size() - 1 to 0
        StructureBlock item = activeBlocks.get(i)
        if not item.isMitigated
            item.boxRef.set_right(bar_index + 12)
            item.labelRef.set_x(bar_index + 14)
            item.pocRef.set_x2(bar_index + 12)

            bool isMitigatedNow = item.isBullish ? low < item.btmVal : high > item.topVal
            if isMitigatedNow
                item.isMitigated := true
                item.mitigationIndex := bar_index
                totalMitigatedCount += 1

                if cfgDisplayMode == "Active Only"
                    item.boxRef.delete()
                    item.labelRef.delete()
                    item.pocRef.delete()
                else
                    item.boxRef.set_bgcolor(color.new(COLOR_NEUTRAL, 95))
                    item.boxRef.set_border_color(color.new(COLOR_NEUTRAL, 80))
                    item.labelRef.set_textcolor(color.new(COLOR_NEUTRAL, 60))
                    item.pocRef.set_color(color.new(COLOR_NEUTRAL, 85))

                    item.boxRef.set_right(bar_index)
                    item.labelRef.set_x(bar_index)
                    item.pocRef.set_x2(bar_index)
        else
            mitigateTracker += 1
            bool keepVisible = cfgKeepMitigated and mitigateTracker <= 2 and (bar_index - item.mitigationIndex <= 50)

            if cfgDisplayMode == "Active Only"
                item.boxRef.delete()
                item.labelRef.delete()
                item.pocRef.delete()
            else if keepVisible
                item.boxRef.set_right(bar_index + 12)
                item.labelRef.set_x(bar_index + 14)
                item.pocRef.set_x2(bar_index + 12)
            else
                item.boxRef.set_right(item.mitigationIndex)
                item.labelRef.set_x(item.mitigationIndex)
                item.pocRef.set_x2(item.mitigationIndex)

    if activeBlocks.size() > cfgMaxBlocks
        StructureBlock oldest = activeBlocks.shift()
        oldest.boxRef.delete()
        oldest.labelRef.delete()
        oldest.pocRef.delete()

//---------------------------------------------------------------------------------------------------------------------
// Light-Theme Analytics Dashboard
//---------------------------------------------------------------------------------------------------------------------
var table dashTable = table.new(getPosition(cfgDashPos), 2, 3, bgcolor = DASH_BG, border_width = 1, border_color = DASH_BORDER, frame_color = DASH_BORDER, frame_width = 1)

if cfgShowDash and barstate.islast
    float successRatio = totalCreatedCount > 0 ? (totalMitigatedCount / totalCreatedCount) * 100 : 0.0
    int highProbCount = 0

    if activeBlocks.size() > 0
        for i = 0 to activeBlocks.size() - 1
            if activeBlocks.get(i).isHighProb and not activeBlocks.get(i).isMitigated
                highProbCount += 1

    // Header
    dashTable.merge_cells(0, 0, 1, 0)
    dashTable.cell(0, 0, "Structure Analytics", text_color = DASH_TEXT_PRIMARY, text_size = getSize(cfgDashSize), text_halign = text.align_center, bgcolor = #F3F4F6)

    // Row 1: Mitigation Ratio
    dashTable.cell(0, 1, "Mitigation Rate", text_color = DASH_TEXT_MUTED, text_size = getSize(cfgDashSize), text_halign = text.align_left)
    dashTable.cell(1, 1, str.tostring(successRatio, "#.#") + "%", text_color = successRatio >= 50 ? COLOR_BULL : COLOR_BEAR, text_size = getSize(cfgDashSize), text_halign = text.align_right)

    // Row 2: High Prob Count
    dashTable.cell(0, 2, "Active HP Blocks", text_color = DASH_TEXT_MUTED, text_size = getSize(cfgDashSize), text_halign = text.align_left)
    dashTable.cell(1, 2, str.tostring(highProbCount), text_color = DASH_TEXT_PRIMARY, text_size = getSize(cfgDashSize), text_halign = text.align_right)

//==============================================================================
//        kNN MARKET ARCHITECTURE  (© LuxAlgo)
//------------------------------------------------------------------------------
// Merged into the single indicator. Stand-alone @version/indicator() header
// removed (one declaration per script). Verified: no identifier collisions with
// existing engines (maxVol/atr are local-scoped or ta.* built-ins). Trimmed for
// compile time: the redundant Delta Tank overlay and the duplicate top-right
// dashboard were removed; the core multi-term kNN support/resistance lines, BOS
// labels, and bias candle coloring remain.
//==============================================================================

//---------------------------------------------------------------------------------------------------------------------}
// Constants & Inputs
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR      = #089981 // Green (Resistance High)
color BEAR_COLOR      = #f23645 // Red (Support Low)
color NEUTRAL_COLOR   = #787b86

sensitivityInput  = input.int(5, "Structure Sensitivity", minval = 1, maxval = 10, group = "Dynamic Engine")
autoSensitivity   = input.bool(true, "Auto-Adjust Sensitivity", group = "Dynamic Engine")

knnKInput         = input.int(5, "k-Nearest Neighbors", minval = 1, maxval = 20, group = "kNN Classifier")
minConfidence     = input.float(0.4, "Confidence Threshold", minval = 0.0, maxval = 1.0, step = 0.1, group = "kNN Classifier")

showST            = input.bool(true, "Short-Term Lines (ST)", group = "Visual Hierarchy")
showMT            = input.bool(true, "Medium-Term Lines (MT)", group = "Visual Hierarchy")
showLT            = input.bool(true, "Long-Term Lines (LT)", group = "Visual Hierarchy")
colorCandlesInput = input.bool(true, "Color Candles by Bias", group = "Visual Hierarchy")
biasSourceInput   = input.string("Auto", "Bias Source", options = ["Auto", "LT", "MT", "ST", "None"], group = "Visual Hierarchy")

stLabelsInput     = input.bool(true, "Show ST Icons", inline = "ST", group = "Visual Hierarchy")
stLabelInput      = input.string("•", "Icon", inline = "ST", group = "Visual Hierarchy")
stSizeInput       = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal", "Large"], inline = "ST", group = "Visual Hierarchy")
stBOSInput        = input.string("Tiny", "ST BOS Size", options = ["None", "Tiny", "Small", "Normal", "Large"], group = "Visual Hierarchy")

mtLabelsInput     = input.bool(false, "Show MT Icons", inline = "MT", group = "Visual Hierarchy")
mtLabelInput      = input.string("•", "Icon", inline = "MT", group = "Visual Hierarchy")
mtSizeInput       = input.string("Small", "Size", options = ["Tiny", "Small", "Normal", "Large"], inline = "MT", group = "Visual Hierarchy")
mtBOSInput        = input.string("None", "MT BOS Size", options = ["None", "Tiny", "Small", "Normal", "Large"], group = "Visual Hierarchy")

ltLabelsInput     = input.bool(true, "Show LT Icons", inline = "LT", group = "Visual Hierarchy")
ltLabelInput      = input.string("●", "Icon", inline = "LT", group = "Visual Hierarchy")
ltSizeInput       = input.string("Normal", "Size", options = ["Tiny", "Small", "Normal", "Large"], inline = "LT", group = "Visual Hierarchy")
ltBOSInput        = input.string("Normal", "LT BOS Size", options = ["None", "Tiny", "Small", "Normal", "Large"], group = "Visual Hierarchy")

offsetMultiplier  = input.float(0.8, "Label Offset Multiplier", minval = 0.0, maxval = 5.0, step = 0.1, group = "Visual Hierarchy")


//---------------------------------------------------------------------------------------------------------------------}
// Types & Methods
//---------------------------------------------------------------------------------------------------------------------{
type StructurePoint
    float price
    int   index
    string term 
    float feat1 
    float feat2 
    float score 

method getDistance(StructurePoint p1, StructurePoint p2) =>
    math.abs(p1.feat1 - p2.feat1) + math.abs(p1.feat2 - p2.feat2)

//---------------------------------------------------------------------------------------------------------------------}
// Dynamic Detection Engine
//---------------------------------------------------------------------------------------------------------------------{
float atr = ta.atr(200)
float avgAtr = ta.sma(atr, 200)
float volRatio = atr / nz(avgAtr, atr)
float smoothedRatio = ta.ema(volRatio, 50) 

float dynamicMultiplier = autoSensitivity ? math.pow(nz(smoothedRatio, 1.0), 1.5) : 1.0
int baseLen = math.max(3, math.round((11 - sensitivityInput) * dynamicMultiplier))

f_detect_pivots(len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    [ph, pl]

f_knn_score(StructurePoint current, array<StructurePoint> history, int k) =>
    float score = 0.0
    if history.size() > k
        array<float> distances = array.new_float(0)
        for p in history
            distances.push(current.getDistance(p))
        array<int> ranks = array.new_int(0)
        for i = 0 to history.size() - 1
            ranks.push(i)
        for i = 0 to k - 1
            for j = i + 1 to history.size() - 1
                if distances.get(ranks.get(j)) < distances.get(ranks.get(i))
                    temp = ranks.get(i)
                    ranks.set(i, ranks.get(j))
                    ranks.set(j, temp)
        float sumScore = 0.0
        for i = 0 to k - 1
            sumScore += history.get(ranks.get(i)).score
        score := sumScore / k
    else
        score := 0.5 
    score

//---------------------------------------------------------------------------------------------------------------------}
// Core Execution
//---------------------------------------------------------------------------------------------------------------------{
var stHistoryHigh = array.new<StructurePoint>(0), var stHistoryLow  = array.new<StructurePoint>(0)
var mtHistoryHigh = array.new<StructurePoint>(0), var mtHistoryLow  = array.new<StructurePoint>(0)
var ltHistoryHigh = array.new<StructurePoint>(0), var ltHistoryLow  = array.new<StructurePoint>(0)

var float lastSTHigh = na, var float lastSTLow = na
var float lastMTHigh = na, var float lastMTLow = na
var float lastLTHigh = na, var float lastLTLow = na

var line activeSTHigh = na, var line activeSTLow = na
var line activeMTHigh = na, var line activeMTLow = na
var line activeLTHigh = na, var line activeLTLow = na

float relVol = volume / ta.sma(volume, 100)
atr14 = ta.atr(14)
float relATR = atr14 / ta.sma(atr14, 100)

// Define Active Term Hierarchy
string activeTerm = biasSourceInput == "None" ? "" : (biasSourceInput != "Auto" ? biasSourceInput : (showLT ? "LT" : showMT ? "MT" : showST ? "ST" : ""))

f_parse_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

f_process_term(float ph, float pl, int len, string term, array<StructurePoint> hHigh, array<StructurePoint> hLow, line activeH, line activeL, bool showLines, bool showLabels) =>
    line outH = activeH
    line outL = activeL
    bool phTriggered = false
    bool plTriggered = false
    
    float visualOffset = atr14 * offsetMultiplier
    
    currentSize = term == "LT" ? f_parse_size(ltSizeInput) : term == "MT" ? f_parse_size(mtSizeInput) : f_parse_size(stSizeInput)
    currentText = term == "LT" ? ltLabelInput : term == "MT" ? mtLabelInput : stLabelInput
    string lStyle = term == "LT" ? line.style_solid : term == "MT" ? line.style_dashed : line.style_dotted

    if not na(ph)
        current = StructurePoint.new(ph, bar_index[len], term, relATR[len], relVol[len], 1.0)
        bool isValid = f_knn_score(current, hHigh, knnKInput) >= minConfidence
        if isValid
            if showLabels
                y = ph + visualOffset
                label.new(bar_index[len], y, currentText, style = label.style_none, textcolor = BULL_COLOR, size = currentSize)
            
            if showLines
                if not na(outH) 
                    outH.delete()
                outH := line.new(bar_index[len], ph, bar_index, ph, color = BULL_COLOR, style = lStyle)
                phTriggered := true

        hHigh.push(current)
        if hHigh.size() > 100 
            hHigh.shift()

    if not na(pl)
        current = StructurePoint.new(pl, bar_index[len], term, relATR[len], relVol[len], 1.0)
        bool isValid = f_knn_score(current, hLow, knnKInput) >= minConfidence
        if isValid
            if showLabels
                y = pl - visualOffset
                label.new(bar_index[len], y, currentText, style = label.style_none, textcolor = BEAR_COLOR, size = currentSize)
            
            if showLines
                if not na(outL) 
                    outL.delete()
                outL := line.new(bar_index[len], pl, bar_index, pl, color = BEAR_COLOR, style = lStyle)
                plTriggered := true

        hLow.push(current)
        if hLow.size() > 100 
            hLow.shift()
    [outH, outL, phTriggered, plTriggered]

// Process Terms
[stPH, stPL] = f_detect_pivots(baseLen)
[newSTH, newSTL, stHT, stLT] = f_process_term(stPH, stPL, baseLen, "ST", stHistoryHigh, stHistoryLow, activeSTHigh, activeSTLow, showST, stLabelsInput)
activeSTHigh := newSTH, activeSTLow := newSTL

if not na(stPH)
    lastSTHigh := stPH
if not na(stPL)
    lastSTLow := stPL

mtLen = baseLen * 3
[mtPH, mtPL] = f_detect_pivots(mtLen)
[newMTH, newMTL, mtHT, mtLT] = f_process_term(mtPH, mtPL, mtLen, "MT", mtHistoryHigh, mtHistoryLow, activeMTHigh, activeMTLow, showMT, mtLabelsInput)
activeMTHigh := newMTH, activeMTLow := newMTL

if not na(mtPH)
    lastMTHigh := mtPH
if not na(mtPL)
    lastMTLow := mtPL

ltLen = mtLen * 3
[ltPH, ltPL] = f_detect_pivots(ltLen)
[newLTH, newLTL, ltHT, ltLT] = f_process_term(ltPH, ltPL, ltLen, "LT", ltHistoryHigh, ltHistoryLow, activeLTHigh, activeLTLow, showLT, ltLabelsInput)
activeLTHigh := newLTH, activeLTLow := newLTL

if not na(ltPH)
    lastLTHigh := ltPH
if not na(ltPL)
    lastLTLow := ltPL

// Termination Logic
f_terminate_line(line l, color lineCol, string term, string bosSize = "Small") =>
    line out = l
    if not na(l)
        isHigh = lineCol == BULL_COLOR
        broken = isHigh ? close > l.get_y1() : close < l.get_y1()
        if broken
            l.set_x2(bar_index)
            midX = math.round(math.avg(l.get_x1(), bar_index))
            bosCol = isHigh ? BULL_COLOR : BEAR_COLOR
            lblStyle = isHigh ? label.style_label_down : label.style_label_up
            if bosSize != "None"
                label.new(midX, l.get_y1(), term + " BOS", style = lblStyle, color = #00000000, textcolor = bosCol, size = f_parse_size(bosSize))
            out := na
        else
            l.set_x2(bar_index)
    out

activeSTHigh := f_terminate_line(activeSTHigh, BULL_COLOR, "ST", stBOSInput)
activeSTLow  := f_terminate_line(activeSTLow, BEAR_COLOR, "ST", stBOSInput)
activeMTHigh := f_terminate_line(activeMTHigh, BULL_COLOR, "MT", mtBOSInput)
activeMTLow  := f_terminate_line(activeMTLow, BEAR_COLOR, "MT", mtBOSInput)
activeLTHigh := f_terminate_line(activeLTHigh, BULL_COLOR, "LT", ltBOSInput)
activeLTLow  := f_terminate_line(activeLTLow, BEAR_COLOR, "LT", ltBOSInput)

//---------------------------------------------------------------------------------------------------------------------}
// Hierarchy Logic for Coloring and Bias
//---------------------------------------------------------------------------------------------------------------------{
selectedHigh = activeTerm == "LT" ? lastLTHigh : activeTerm == "MT" ? lastMTHigh : activeTerm == "ST" ? lastSTHigh : na
selectedLow  = activeTerm == "LT" ? lastLTLow  : activeTerm == "MT" ? lastMTLow  : activeTerm == "ST" ? lastSTLow  : na

color candleColor = na
if not na(selectedHigh) and not na(selectedLow)
    float factor = (close - selectedLow) / math.max(1e-6, selectedHigh - selectedLow)
    candleColor := factor > 0.5 ? color.from_gradient(factor, 0.5, 1.0, NEUTRAL_COLOR, BULL_COLOR) : color.from_gradient(factor, 0.0, 0.5, BEAR_COLOR, NEUTRAL_COLOR)
    if close > selectedHigh
        candleColor := BULL_COLOR
    if close < selectedLow
        candleColor := BEAR_COLOR

barcolor(colorCandlesInput ? candleColor : na)

//==============================================================================
//        SWING PROFILE  (© BigBeluga)
//------------------------------------------------------------------------------
// Merged into the single indicator. Stand-alone license/@version/indicator()
// header removed (one declaration per script). Replaces the previous DeltaFlow
// Volume Profile. Verified: no identifier collisions with existing engines
// (all globals below are unique in this file). Builds a per-swing volume
// profile (Buy/Sell bins, PoC, optional heat map), a zigzag connector, and an
// optional smoothing MA plot.
//==============================================================================

// INPUTS ---------------------------------------------------------------------

swingLen = input.int(50, "Swing Length", minval = 10)

swingColorUp = input.color(color.lime, "▲", inline = "colors")
swingColorDown = input.color(color.orange, "▼", inline = "colors")

showProfile = input.bool(true, "Profile", group = "Swing Volume Profile")
showHeatMap = input.bool(false, "HeatMap", group = "Swing Volume Profile")

showZigZag = input.bool(true, "ZigZag", inline = "Zz")
zigZagStyleInput = input.string("Dotted", "", ["Dotted", "Dashed", "Solid"], inline = "Zz")

showPOC = input.bool(true, "PoC", "", inline = "Poc", group = "Point of Control")
pocWidthInput = input.int(2, "", inline = "Poc", group = "Point of Control")
pocColor = input.color(color.red, "", inline = "Poc", group = "Point of Control")

transparentNA = color.new(color.black, 100)

string dataSizeInput = input.string("Small", title = "Data Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"])

// Size switcher for labels
getLabelSize() =>
    switch dataSizeInput
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.tiny

getZigZagLineStyle() =>
    switch zigZagStyleInput
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        "Solid"  => line.style_solid


// Persistent storage containers
var polyline profilePoly = na
var dataLabel = label(na)
var pocLineHandle = line(na)
var profileBoxes = array.new<box>()

// Structs for swing points
type SwingData
    float price
    int index

var highSwing = SwingData.new(na, na)
var lowSwing  = SwingData.new(na, na)

// Direction flag: true = down move, false = up move
var isDownMove = false

// CALCULATIONS ---------------------------------------------------------------

// Detect swing highs and lows
highestSwingHigh = ta.highest(swingLen)
lowestSwingLow   = ta.lowest(swingLen)

if high == highestSwingHigh
    isDownMove := true
if low == lowestSwingLow
    isDownMove := false

// Store completed swing high
if high[1] == highestSwingHigh[1] and high < highestSwingHigh
    highSwing.index := bar_index[1]
    highSwing.price := high[1]

// Store completed swing low
if low[1] == lowestSwingLow[1] and low > lowestSwingLow
    lowSwing.index := bar_index[1]
    lowSwing.price := low[1]

// Default bin size based on ATR
priceBinSize = ta.atr(200) * 0.5

// HISTORICAL SWING LEG -------------------------------------------------------

// When direction flips we finalize previous swing leg and build full profile
if isDownMove != isDownMove[1]

    // Clear previous drawings
    profilePoly.delete()
    dataLabel.delete()
    for b in profileBoxes
        b.delete()
    profileBoxes.clear()

    swingMainColor = isDownMove ? swingColorDown : swingColorUp

    // Draw zigzag connector
    if showZigZag
        line.new(highSwing.index, highSwing.price, lowSwing.index, lowSwing.price, color = swingMainColor, style = getZigZagLineStyle())

    // Determine swing boundaries
    swingBottom = math.min(highSwing.price, lowSwing.price)
    swingTop    = math.max(highSwing.price, lowSwing.price)

    // Number of volume bins
    binCount = int(math.abs(highSwing.price - lowSwing.price) / priceBinSize)
    binStep  = math.abs(highSwing.price - lowSwing.price) / binCount

    lastSwingIndex = math.max(highSwing.index, lowSwing.index)
    prevSwingIndex = math.min(highSwing.index, lowSwing.index)

    // Arrays for volume accumulation
    volumeBins = array.new<float>(binCount, 0.)
    profilePoints = array.new<chart.point>()
    buyVolumeBins = array.new<float>(binCount, 0.)
    sellVolumeBins = array.new<float>(binCount, 0.)

    barOffset = bar_index - lastSwingIndex

    // Accumulate volume per price bin
    for i = barOffset to (lastSwingIndex - prevSwingIndex) + barOffset

        candleClose = close[i]
        candleOpen  = open[i]
        candleVol   = volume[i]

        for k = 0 to binCount - 1
            binMidPrice = swingBottom + (k * binStep) + (binStep / 2)

            if math.abs(binMidPrice - candleClose) < binStep

                volumeBins.set(k, volumeBins.get(k) + candleVol)

                if candleClose > candleOpen
                    buyVolumeBins.set(k, buyVolumeBins.get(k) + candleVol)
                else
                    sellVolumeBins.set(k, sellVolumeBins.get(k) + candleVol)

    // Draw boxes and build profile outline
    for k = 0 to binCount - 1

        binLow  = swingBottom + (k * binStep)
        binHigh = binLow + binStep

        volumeRatio = volumeBins.get(k) / volumeBins.max()
        profileWidth = int(volumeRatio * ((lastSwingIndex - prevSwingIndex) / 2))

        // Draw POC line
        if volumeRatio == 1 and showPOC
            line.new(showProfile ? prevSwingIndex + profileWidth : prevSwingIndex, math.avg(binLow, binHigh), lastSwingIndex, math.avg(binLow, binHigh), color = pocColor, width = pocWidthInput)

        // Create volume box
        box.new(
            showProfile ? prevSwingIndex + profileWidth : prevSwingIndex,
            binHigh,
            showHeatMap ? lastSwingIndex : prevSwingIndex,
            binLow,
            transparentNA,
            0,
            bgcolor = showProfile or showHeatMap ? color.from_gradient(volumeRatio, 0, 1, color.new(swingMainColor, 90), color.new(volumeRatio == 1 and showPOC ? pocColor : swingMainColor, 50)) : transparentNA,
            text = showHeatMap ? "" : volumeRatio == 1 ? str.tostring(volumeBins.max(), format.volume) : ""
        )

        // Build polygon outline
        if k == 0
            profilePoints.push(chart.point.from_index(prevSwingIndex, binLow))
        profilePoints.push(chart.point.from_index(prevSwingIndex + profileWidth, binLow))
        profilePoints.push(chart.point.from_index(prevSwingIndex + profileWidth, binHigh))
        if k == binCount - 1
            profilePoints.push(chart.point.from_index(prevSwingIndex, binHigh))

    // Draw outer polyline
    if showProfile
        polyline.new(profilePoints, false, true, line_color = showHeatMap ? color.new(swingMainColor, 50) : swingMainColor)

    // Summary label for historical swing
    swingArrowText = isDownMove ? "▼" : "▲"

    swingTooltip =
          "Total Volume: " + str.tostring(volumeBins.sum(), format.volume)
         + "\nBuy Volume: " + str.tostring(buyVolumeBins.sum(), format.volume)
         + "\nSell Volume: " + str.tostring(sellVolumeBins.sum(), format.volume)
         + "\nDelta Volume: " + str.tostring((buyVolumeBins.sum() - sellVolumeBins.sum()) / volumeBins.sum() * 100, format.percent)

    label.new(prevSwingIndex, isDownMove ? swingTop : swingBottom, swingArrowText,
         style = isDownMove ? label.style_label_down : label.style_label_up,
         color = transparentNA,
         textcolor = swingMainColor,
         size = getLabelSize(),
         tooltip = swingTooltip)


// REAL-TIME SWING LEG --------------------------------------------------------

// Real-time profile rebuilding while swing is still forming
if not isDownMove

    // Clear boxes on every update
    for b in profileBoxes
        b.delete()
    profileBoxes.clear()

    if barstate.islast

        swingMainColor = chart.fg_color

        // Remove previous zigzag preview line
        line.delete(line.new(highSwing.index, highSwing.price, lowSwing.index, lowSwing.price, color = swingMainColor, style = line.style_dashed)[1])

        swingBottom = math.min(highSwing.price, lowSwing.price)
        swingTop    = math.max(highSwing.price, lowSwing.price)

        binCount = int(math.abs(highSwing.price - lowSwing.price) / priceBinSize)
        binStep  = math.abs(highSwing.price - lowSwing.price) / binCount

        lastSwingIndex = math.max(highSwing.index, lowSwing.index)
        prevSwingIndex = math.min(highSwing.index, lowSwing.index)

        volumeBins = array.new<float>(binCount, 0.)
        profilePoints = array.new<chart.point>()
        buyVolumeBins = array.new<float>(binCount, 0.)
        sellVolumeBins = array.new<float>(binCount, 0.)

        barOffset = bar_index - lastSwingIndex

        // Accumulate volume in real time
        for i = barOffset to (lastSwingIndex - prevSwingIndex) + barOffset

            candleClose = close[i]
            candleOpen  = open[i]
            candleVol   = volume[i]

            for k = 0 to binCount - 1
                binMidPrice = swingBottom + (k * binStep) + (binStep / 2)

                if math.abs(binMidPrice - candleClose) < binStep

                    volumeBins.set(k, volumeBins.get(k) + candleVol)
                    if candleClose > candleOpen
                        buyVolumeBins.set(k, buyVolumeBins.get(k) + candleVol)
                    else
                        sellVolumeBins.set(k, sellVolumeBins.get(k) + candleVol)

        // Draw real-time boxes
        for k = 0 to binCount - 1

            binLow  = swingBottom + (k * binStep)
            binHigh = binLow + binStep

            volumeRatio = volumeBins.get(k) / volumeBins.max()
            profileWidth = int(volumeRatio * ((lastSwingIndex - prevSwingIndex) / 2))

            if volumeRatio == 1 and showPOC
                pocLineHandle := line.new(showProfile ? prevSwingIndex + profileWidth : prevSwingIndex, math.avg(binLow, binHigh), lastSwingIndex, math.avg(binLow, binHigh), color = pocColor, width = pocWidthInput)
                line.delete(pocLineHandle[1])

            profileBoxes.push(box.new(
                 showProfile ? prevSwingIndex + profileWidth : prevSwingIndex,
                 binHigh,
                 showHeatMap ? lastSwingIndex : prevSwingIndex,
                 binLow,
                 transparentNA,
                 0,
                 bgcolor = showProfile or showHeatMap ? color.from_gradient(volumeRatio, 0, 1, color.new(swingMainColor, 90), color.new(volumeRatio == 1 and showPOC ? pocColor : swingMainColor, 50)) : transparentNA,
                 text = showHeatMap ? "" : volumeRatio == 1 ? str.tostring(volumeBins.max(), format.volume) : ""
            ))

            if k == 0
                profilePoints.push(chart.point.from_index(prevSwingIndex, binLow))
            profilePoints.push(chart.point.from_index(prevSwingIndex + profileWidth, binLow))
            profilePoints.push(chart.point.from_index(prevSwingIndex + profileWidth, binHigh))
            if k == binCount - 1
                profilePoints.push(chart.point.from_index(prevSwingIndex, binHigh))

        // Update polyline in real time
        if showProfile
            polyline.delete(profilePoly[1])
            profilePoly := polyline.new(profilePoints, false, true, line_color = showHeatMap ? color.new(swingMainColor, 50) : swingMainColor)

        // Label with summary data
        swingTooltip = "T - Total Volume\nB - Buy Volume\nS - Sell Volume\nD - Delta Volume"

        swingDataText =
              "T: " + str.tostring(volumeBins.sum(), format.volume)
             + "\nB: " + str.tostring(buyVolumeBins.sum(), format.volume)
             + "\nS: " + str.tostring(sellVolumeBins.sum(), format.volume)
             + "\nD: " + str.tostring((buyVolumeBins.sum() - sellVolumeBins.sum()) / volumeBins.sum() * 100, format.percent)

        dataLabel := label.new(prevSwingIndex, not isDownMove ? swingTop : swingBottom, swingDataText,
             style = not isDownMove ? label.style_label_down : label.style_label_up,
             color = transparentNA,
             textcolor = swingMainColor,
             size = getLabelSize(),
             tooltip = swingTooltip,
             textalign = text.align_left)

        label.delete(dataLabel[1])


// MIRROR OF ABOVE FOR isDownMove == true ------------------------------------------

// Mirror logic for bullish direction
else

    for b in profileBoxes
        b.delete()
    profileBoxes.clear()

    if barstate.islast

        swingMainColor = chart.fg_color

        line.delete(line.new(highSwing.index, highSwing.price, lowSwing.index, lowSwing.price, color = swingMainColor, style = line.style_dashed)[1])

        swingBottom = math.min(highSwing.price, lowSwing.price)
        swingTop    = math.max(highSwing.price, lowSwing.price)

        binCount = int(math.abs(highSwing.price - lowSwing.price) / priceBinSize)
        binStep  = math.abs(highSwing.price - lowSwing.price) / binCount

        lastSwingIndex = math.max(highSwing.index, lowSwing.index)
        prevSwingIndex = math.min(highSwing.index, lowSwing.index)

        volumeBins = array.new<float>(binCount, 0.)
        profilePoints = array.new<chart.point>()
        buyVolumeBins = array.new<float>(binCount, 0.)
        sellVolumeBins = array.new<float>(binCount, 0.)

        barOffset = bar_index - lastSwingIndex

        for i = barOffset to (lastSwingIndex - prevSwingIndex) + barOffset

            candleClose = close[i]
            candleOpen  = open[i]
            candleVol   = volume[i]

            for k = 0 to binCount - 1

                binMidPrice = swingBottom + (k * binStep) + (binStep / 2)

                if math.abs(binMidPrice - candleClose) < binStep

                    volumeBins.set(k, volumeBins.get(k) + candleVol)
                    if candleClose > candleOpen
                        buyVolumeBins.set(k, buyVolumeBins.get(k) + candleVol)
                    else
                        sellVolumeBins.set(k, sellVolumeBins.get(k) + candleVol)

        for k = 0 to binCount - 1

            binLow  = swingBottom + (k * binStep)
            binHigh = binLow + binStep

            volumeRatio = volumeBins.get(k) / volumeBins.max()
            profileWidth = int(volumeRatio * ((lastSwingIndex - prevSwingIndex) / 2))

            if volumeRatio == 1 and showPOC
                pocLineHandle := line.new(showProfile ? prevSwingIndex + profileWidth : prevSwingIndex, math.avg(binLow, binHigh), lastSwingIndex, math.avg(binLow, binHigh), color = pocColor, width = pocWidthInput)
                line.delete(pocLineHandle[1])

            profileBoxes.push(box.new(
                 showProfile ? prevSwingIndex + profileWidth : prevSwingIndex,
                 binHigh,
                 showHeatMap ? lastSwingIndex : prevSwingIndex,
                 binLow,
                 transparentNA,
                 0,
                 bgcolor = showProfile or showHeatMap ? color.from_gradient(volumeRatio, 0, 1, color.new(swingMainColor, 90), color.new(volumeRatio == 1 and showPOC ? pocColor : swingMainColor, 50)) : transparentNA,
                 text = showHeatMap ? "" : volumeRatio == 1 ? str.tostring(volumeBins.max(), format.volume) : ""
             ))

            if k == 0
                profilePoints.push(chart.point.from_index(prevSwingIndex, binLow))
            profilePoints.push(chart.point.from_index(prevSwingIndex + profileWidth, binLow))
            profilePoints.push(chart.point.from_index(prevSwingIndex + profileWidth, binHigh))
            if k == binCount - 1
                profilePoints.push(chart.point.from_index(prevSwingIndex, binHigh))

        if showProfile
            polyline.delete(profilePoly[1])
            profilePoly := polyline.new(profilePoints, false, true, line_color = showHeatMap ? color.new(swingMainColor, 50) : swingMainColor)

        swingTooltip = "T - Total Volume\nB - Buy Volume\nS - Sell Volume\nD - Delta Volume"

        swingDataText =
              "T: " + str.tostring(volumeBins.sum(), format.volume)
             + "\nB: " + str.tostring(buyVolumeBins.sum(), format.volume)
             + "\nS: " + str.tostring(sellVolumeBins.sum(), format.volume)
             + "\nD: " + str.tostring((buyVolumeBins.sum() - sellVolumeBins.sum()) / volumeBins.sum() * 100, format.percent)

        dataLabel := label.new(prevSwingIndex, not isDownMove ? swingTop : swingBottom, swingDataText,
             style = not isDownMove ? label.style_label_down : label.style_label_up,
             color = transparentNA,
             textcolor = swingMainColor,
             size = getLabelSize(),
             tooltip = swingTooltip,
             textalign = text.align_left)

        label.delete(dataLabel[1])


// Smoothing MA inputs
GRP = "Moving Average"
maTypeInput = input.string("None", "Type", options = ["None", "SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GRP, display = display.none)
