plot(show_ema2 and show_candle2 ? e3 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 56, show_last = 15)

f_candlestick(_close, _open, _high, _low, _time, _tf, _bar, _plot, start, _show_candle, _htf, e, te) =>
    [ch1, cl1, cc1, co1, ct1, ch0, cl0, cc0, co0, ct0] = f_live_sym(_close, _open, _high, _low, _time, _tf)
    var tf_h = array.new_float()
    var tf_l = array.new_float()
    var tf_c = array.new_float()
    var tf_o = array.new_float()
    var tf_t = array.new_int()
    var lbl1 = label.new(na, na)
    var ln1 = line.new(na, na, na, na)
    var ln2 = line.new(na, na, na, na)
    if timeframe.change(_tf)
        add_to_array_tf(tf_h, ch1, _bar)
        add_to_array_tf(tf_l, cl1, _bar)
        add_to_array_tf(tf_o, co1, _bar)
        add_to_array_tf(tf_c, cc1, _bar)
        add_to_array_tf(tf_t, ct1, _bar)

    if array.size(tf_h) > 5 * _bar - 1 and tf_ok(_tf) and _show_candle
        array_h0 = array.from(ch0)
        array_l0 = array.from(cl0)
        array_o0 = array.from(co0)
        array_c0 = array.from(cc0)
        array_t0 = array.from(ct0)

        tf_hh = array.concat(array_h0, tf_h)
        tf_ll = array.concat(array_l0, tf_l)
        tf_oo = array.concat(array_o0, tf_o)
        tf_cc = array.concat(array_c0, tf_c)
        tf_tt = array.concat(array_t0, tf_t)

        // Optimized Loop without Array Allocations
        _h0 = -1e8
        _l0 = 1e8
        for i = 0 to _bar - 1 by 1
            _h0 := math.max(_h0, array.get(tf_hh, i))
            _l0 := math.min(_l0, array.get(tf_ll, i))
        _o0 = array.get(tf_oo, _bar - 1)
        _c0 = _close
        _t0 = array.get(tf_tt, _bar - 1)

        _h1 = -1e8
        _l1 = 1e8
        for i = _bar to 2 * _bar - 1 by 1
            _h1 := math.max(_h1, array.get(tf_hh, i))
            _l1 := math.min(_l1, array.get(tf_ll, i))
        _o1 = array.get(tf_oo, 2 * _bar - 1)
        _c1 = array.get(tf_cc, _bar)
        _t1 = array.get(tf_tt, 2 * _bar - 1)

        _h2 = -1e8
        _l2 = 1e8
        for i = 2 * _bar to 3 * _bar - 1 by 1
            _h2 := math.max(_h2, array.get(tf_hh, i))
            _l2 := math.min(_l2, array.get(tf_ll, i))
        _o2 = array.get(tf_oo, 3 * _bar - 1)
        _c2 = array.get(tf_cc, 2 * _bar)
        _t2 = array.get(tf_tt, 3 * _bar - 1)

        _h3 = -1e8
        _l3 = 1e8
        for i = 3 * _bar to 4 * _bar - 1 by 1
            _h3 := math.max(_h3, array.get(tf_hh, i))
            _l3 := math.min(_l3, array.get(tf_ll, i))
        _o3 = array.get(tf_oo, 4 * _bar - 1)
        _c3 = array.get(tf_cc, 3 * _bar)
        _t3 = array.get(tf_tt, 4 * _bar - 1)

        _h4 = -1e8
        _l4 = 1e8
        for i = 4 * _bar to 5 * _bar - 1 by 1
            _h4 := math.max(_h4, array.get(tf_hh, i))
            _l4 := math.min(_l4, array.get(tf_ll, i))
        _o4 = array.get(tf_oo, 5 * _bar - 1)
        _c4 = array.get(tf_cc, 4 * _bar)
        _t4 = array.get(tf_tt, 5 * _bar - 1)

        if _plot
            f_secret_candle(_close, _o0, _h0, _l0, 0, start, _bar)
            f_secret_candle(_c1, _o1, _h1, _l1, 1, start, _bar)
            f_secret_candle(_c2, _o2, _h2, _l2, 2, start, _bar)
            f_secret_candle(_c3, _o3, _h3, _l3, 3, start, _bar)
            f_secret_candle(_c4, _o4, _h4, _l4, 4, start, _bar)

            lbltop = math.min(_l0, _l1, _l2, _l3, _l4)
            addtext_ = te == 1 ? str.tostring(syminfo.prefix(sym2)) : ''
            lbx = box.new(left = bar_index + dxx + start, top = lbltop - pattatr, right = bar_index + dxx + start + 20, bottom = lbltop - 1.8 * pattatr, bgcolor = color.teal, border_color = color.white, text = addtext_ + ' TF : ' + f_text(_tf) + ' / ' + str.tostring(_bar) + ' bar', text_size = sz, text_valign = text.align_center, text_halign = text.align_center, text_color = color.white)
            box.delete(lbx[1])

        var text1 = ''
        text_ = ''
        stext_ = ''
        found = false
        num = 0
        ploth = 0.0
        plotl = 0.0
        plott = 0
        singleh = 0.0
        singlel = 0.0
        singleo = 0.0

        [htf2h1, htf2l1, h2c1, h2o1, h2t1, htf2h0, htf2l0, h2c0, h2o0, h2t0] = f_live_sym(_close, _open, _high, _low, _time, _htf)
        arr_htf2h = array.from(htf2h0 == _h4, htf2h0 == _h3, htf2h0 == _h2, htf2h0 == _h1, htf2h0 == _h0, htf2h1 == _h4, htf2h1 == _h3, htf2h1 == _h2, htf2h1 == _h1, htf2h1 == _h0)
        arr_htf2l = array.from(htf2l0 == _l4, htf2l0 == _l3, htf2l0 == _l2, htf2l0 == _l1, htf2l0 == _l0, htf2l1 == _l4, htf2l1 == _l3, htf2l1 == _l2, htf2l1 == _l1, htf2l1 == _l0)

        con_ema_bull = str_emabull == 'All' ? true : (str_emabull == 'close > ema' and _c0 > e) or (str_emabull == 'close < ema' and _c0 < e)
        con_ema_bear = str_emabear == 'All' ? true : (str_emabear == 'close > ema' and _c0 > e) or (str_emabear == 'close < ema' and _c0 < e)

        con_htfbear = con_htf ? array.some(arr_htf2h) : true
        con_htfbull = con_htf ? array.some(arr_htf2l) : true
        filterbear = con_htfbear and con_ema_bear
        filterbull = con_htfbull and con_ema_bull

        form_51 = filterbull and _o4 > _c4 and math.max(_o3, _c3, _o2, _c2, _o1, _c1) <= (_h4 + _l4) / 2 and math.min(_o3, _c3, _o2, _c2, _o1, _c1) >= _l4 and math.max(_h3, _h2, _h1) < math.min(_o4, _c0) and _c0 > _o4
        if form_51 and alert51
            text_ := 'Bullish 5 candle'
            found := true
            num := 5
            ploth := _o4
            plotl := math.min(_l4, _l3, _l2, _l1, _l0)
            plott := _t4
            singleh := math.max(_h4, _h3, _h2, _h1, _h0)
            singlel := math.min(_l4, _l3, _l2, _l1, _l0)
            singleo := _o4

        if not found and alert52 and text_ == ''
            form_52 = filterbear and _o4 < _c4 and math.min(_o3, _c3, _o2, _c2, _o1, _c1) >= (_h4 + _l4) / 2 and math.max(_o3, _c3, _o2, _c2, _o1, _c1) <= _h4 and math.min(_l3, _l2, _l1) > math.max(_o4, _c0) and _c0 < _o4
            if form_52
                text_ := 'Bearish 5 candle'
                found := true
                num := -5
                ploth := math.max(_h4, _h3, _h2, _h1, _h0)
                plotl := _o4
                plott := _t4
                singleh := math.max(_h4, _h3, _h2, _h1, _h0)
                singlel := math.min(_l4, _l3, _l2, _l1, _l0)
                singleo := _o4

        if not found and alert41 and text_ == ''
            form_41 = filterbull and _c3 < _o3 and _c2 >= _o2 and _c1 <= _o1 and _c0 > _o0 and _c0 > _o3 and math.max(_h2, _h1) < math.min(_o3, _c0) and math.max(_o2, _c1) <= (_h3 + _l3) / 2
            if form_41
                text_ := 'Bullish Horse Shoe'
                found := true
                num := 4
                ploth := _o3
                plotl := math.min(_l3, _l2, _l1, _l0)
                plott := _t3
                singleh := math.max(_h3, _h2, _h1, _h0)
                singlel := math.min(_l3, _l2, _l1, _l0)
                singleo := _o3

        if not found and alert42 and text_ == ''
            form_42 = filterbear and _c3 > _o3 and _c2 <= _o2 and _c1 >= _o1 and _c0 < _o0 and _c0 < _o3 and math.min(_l2, _l1) > math.max(_o3, _c0) and math.min(_o2, _c1) >= (_h3 + _l3) / 2
            if form_42
                text_ := 'Bearish Horse Shoe'
                found := true
                num := -4
                ploth := math.max(_h3, _h2, _h1, _h0)
                plotl := _o3
                plott := _t3
                singleh := math.max(_h3, _h2, _h1, _h0)
                singlel := math.min(_l3, _l2, _l1, _l0)
                singleo := _o3

        if not found and alert43 and text_ == ''
            form_43 = filterbull and _c3 < _o3 and _c2 < _o2 and _c1 > _o1 and _c0 > _o0 and _c0 > _o3 and math.max(_h2, _h1) < math.min(_o3, _c0) and math.max(_o2, _c1) <= (_h3 + _l3) / 2
            if form_43
                text_ := 'Bullish 4 candle'
                found := true
                num := 4
                ploth := _o3
                plotl := math.min(_l3, _l2, _l1, _l0)
                plott := _t3
                singleh := math.max(_h3, _h2, _h1, _h0)
                singlel := math.min(_l3, _l2, _l1, _l0)
                singleo := _o3

        if not found and alert44 and text_ == ''
            form_44 = filterbear and _c3 > _o3 and _c2 > _o2 and _c1 < _o1 and _c0 < _o0 and _c0 < _o3 and math.min(_l2, _l1) > math.max(_o3, _c0) and math.min(_o2, _c1) >= (_h3 + _l3) / 2
            if form_44
                text_ := 'Bearish 4 candle'
                found := true
                num := -4
                ploth := math.max(_h3, _h2, _h1, _h0)
                plotl := _o3
                plott := _t3
                singleh := math.max(_h3, _h2, _h1, _h0)
                singlel := math.min(_l3, _l2, _l1, _l0)
                singleo := _o3

        if not found and alert31 and text_ == ''
            form_31 = filterbull and _o2 > _c2 and _c1 > _o1 and _c2 <= _l1 and _o2 >= _h1 and _c0 > _o0 and _c0 > _h2 and not(_l2 == _l1 and _h2 == _h1)
            if form_31
                text_ := 'Bullish 3 inside up'
                found := true
                num := 3
                ploth := _h2
                plotl := math.min(_l2, _l1, _l0)
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert32 and text_ == ''
            form_32 = filterbear and _o2 < _c2 and _c1 < _o1 and _c2 >= _h1 and _o2 <= _l1 and _c0 < _o0 and _c0 < _l2 and not(_l2 == _l1 and _h2 == _h1)
            if form_32
                text_ := 'Bearish 3 inside down'
                found := true
                num := -3
                ploth := math.max(_h2, _h1, _h0)
                plotl := _l2
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert33 and text_ == ''
            form_33 = _o1 < _o2 and _o1 > _c2 and _o0 < _o1 and _o0 > _c1 and _c1 < _l2 and _c0 < _l1 and _c2 < 1.05 * _l2 and _c1 < 1.05 * _l1 and _c0 < 1.05 * _l0
            if form_33
                text_ := 'Bearish 3 Black Crows'
                found := true
                num := -3
                ploth := _h2
                plotl := _l0
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert34 and text_ == ''
            form_34 = filterbear and _c2 > _o2 and math.min(_o1, _c1) > _c2 and _o0 < math.min(_o1, _c1) and _c0 < _o0 and _c0 < (_h2 + _l2) / 2 and _h1 > math.max(_h0, _h2)
            if form_34
                text_ := 'Bearish Evening Star'
                found := true
                num := -3
                ploth := _h1
                plotl := (_h2 + _l2) / 2
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert35 and text_ == ''
            form_35 = filterbull and _o2 > _c2 and _o2 - _c2 > 0.6 * (_h2 - _l2) and _c2 > _o1 and math.abs(_o1 - _c1) < 0.5 * math.abs(_o2 - _c2) and _h1 - _l1 > 3 * (_c1 - _o1) and _c0 > _o0 and _o0 > math.max(_o1, _c1) and _c0 > (_h2 + _l2) / 2 and _l1 < math.min(_l0, _l2)
            if form_35
                text_ := 'Bullish Morning Star'
                found := true
                num := 3
                ploth := (_h2 + _l2) / 2
                plotl := _l1
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert36 and text_ == ''
            form_36 = filterbull and _c1 >= _o1 and _o2 > _c2 and _c0 > _o0 and _l2 > _h1 and _l0 > _h1 and _l1 < math.min(_l0, _l2) and _c0 > _o2
            if form_36
                text_ := 'Bullish Abandone Baby'
                found := true
                num := 3
                ploth := _o2
                plotl := _l1
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert37 and text1 != 'Bearish MeReT' and text_ == ''
            form_37 = filterbear and _c2 > _o2 and _c1 < _o1 and _l1 > _o2 and _c0 < _o0 and _h1 > _h2 and _c0 < _o2
            if form_37
                text_ := 'Bearish 3 candle'
                found := true
                num := -3
                ploth := math.max(_h2, _h1, _h0)
                plotl := _o2
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert38 and text1 != 'Bullish MeReT' and text_ == ''
            form_38 = filterbull and _c2 < _o2 and _c1 > _o1 and _h1 < _o2 and _c0 > _o0 and _l1 < _l2 and _c0 > _o2
            if form_38
                text_ := 'Bullish 3 candle'
                found := true
                num := 3
                ploth := _o2
                plotl := math.min(_l2, _l1, _l0)
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert39 and text_ == ''
            form_39 = filterbear and _o2 > _c2 and _c1 > _o1 and _c1 > _h2 and _h0 >= _h2 and _h1 > _h0 and _c0 < _l1 and _c1 - _o1 > math.max(_h1 - _c1, _o1 - _l1)
            if form_39
                text_ := 'Bearish MeReT'
                found := true
                num := -3
                ploth := _h1
                plotl := _l1
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert310 and text_ == ''
            form_310 = filterbull and _o2 < _c2 and _c1 < _o1 and _c1 < _l2 and _l0 <= _l2 and _l1 < _l0 and _c0 > _h1 and _o1 - _c1 > math.max(_h1 - _o1, _c1 - _l1)
            if form_310
                text_ := 'Bullish MeReT'
                found := true
                num := 3
                ploth := _h1
                plotl := _l1
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert311 and text_ == ''
            form_311 = filterbear and _o2 > _c2 and _l1 < _l2 and _h2 >= math.max(_h0, _h1) and _c1 > _o1 and _o0 > _c0 and math.max(_h1, _h0) >= math.max(_c2, _o2) and _c0 < _l1
            if form_311
                text_ := 'Bearish Protected Engulf'
                found := true
                num := -3
                ploth := _h2
                plotl := _l1
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        if not found and alert312 and text_ == ''
            form_312 = filterbull and _c2 > _o2 and _h1 > _h2 and _l2 <= math.min(_l0, _l1) and _c1 < _o1 and _o0 < _c0 and math.min(_l1, _l0) <= math.min(_c2, _o2) and _c0 > _h1
            if form_312
                text_ := 'Bullish Protected Engulf'
                found := true
                num := 3
                ploth := _h1
                plotl := _l2
                plott := _t2
                singleh := math.max(_h2, _h1, _h0)
                singlel := math.min(_l2, _l1, _l0)
                singleo := _o2

        text1 := text_

        label.delete(lbl1)
        if str.length(text_) > 0 and _show_candle
            lbl1 := label.new(bar_index + dxx + start + 10, math.max(_h0, _h1, _h2, _h3, _h4) + 1.5 * pattatr, text = text_, xloc = xloc.bar_index, color = color.new(color.teal, 0), style = label.style_label_center, textcolor = lbl_clr, size = sz)

        if text_ == 'Bearish Protected Engulf' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _h2, bar_index + dxx + start + 16, _h2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 13, _l1, bar_index + dxx + start + 15, _l1, width = 2)
            stext_ := 'P. Engulf'
        if text_ == 'Bullish Protected Engulf' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _l2, bar_index + dxx + start + 16, _l2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 13, _h1, bar_index + dxx + start + 15, _h1, width = 2)
