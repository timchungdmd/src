//@version=6
indicator('Smart Money Concepts [LUX]', 'Smart Money Concepts [LuxAlgo]', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 500)

// NOTE: All library imports were removed — none of the imported namespaces
// (Refiner/Drawing/FVG/Liq/Alert/D/PF/ND/M/SMC and the unaliased ta) is referenced
// anywhere in the script. Every ta.* call used is a core Pine v6 built-in, and the
// only 'FVG.new(...)' references bind to the user-defined `type FVG` declared below,
// not to the imported library. Compiling these unused libraries was the single
// largest contributor to the compile-time timeout.

/////////////HTF FGV///////////
display = display.all - display.status_line

fvgGR = 'Fair Value Gaps #1, Chart/HTF'
fvgTip1 = 'Select the timeframe from which Fair Value Gaps (FVGs) will be detected.\n• Chart — uses the current chart timeframe.\n• Higher timeframes — plots FVGs derived from the selected timeframe above the chart.\n\nIf a lower timeframe than the chart is selected, the script automatically defaults to the chart timeframe.'
fvgFillTip1 = 'Defines how a Fair Value Gap (FVG) is considered filled:\n• Any Touch — when price (wick or body) touches any part of the imbalance zone.\n• Midpoint Reached — when price trades to at least the midpoint (50%) of the zone.\n• Wick Sweep — when a wick fully passes through the entire FVG and returns inside the zone.\n• Body Beyond — when the candle body closes beyond the opposite edge of the FVG, confirming full repair.'
fvgLBTip1 = 'Controls the visibility of Fair Value Gap (FVG) labels.\n\n• **Show** — displays labels directly on the chart. Each label indicates the timeframe and fill progress of the zone.\n• **Hide** — hides on-chart labels, but tooltips remain accessible by hovering over the midpoint of each FVG zone.'

fvgSH1 = input.bool(true, 'Fair Value Gaps #1, Chart/HTF', inline = 'fvg1', group = fvgGR)
fvgTF1 = input.string('Chart', '', options = ['Chart', '5 Minutes', '15 Minutes', '1 Hour', '4 Hours', '1 Day', '1 Week', '1 Month'], inline = 'fvg1', group = fvgGR, tooltip = fvgTip1, display = display)
fvgFill1 = input.string('Wick Sweep', '  FVG #1 Fill Method', options = ['Any Touch', 'Midpoint Reached', 'Wick Sweep', 'Body Beyond'], display = display, tooltip = fvgFillTip1, group = fvgGR)
fvgCb1 = input.color(#00B8D9, '  FVG #1 Zones    ', inline = 'fvg', group = fvgGR)
fvgCs1 = input.color(#FF8B00, '', inline = 'fvg', group = fvgGR)
fvgLB1 = input.string('Show', '  FVG #1 Labels', options = ['Show', 'Hide'], tooltip = fvgLBTip1, display = display, group = fvgGR)
maxBars = input.int(360, '  Max Bars Back', minval = 1, step = 20, group = fvgGR, display = display, tooltip = 'This determines how far back the script will analyze for Fair Value Gaps.')

fvgGR2 = 'Fair Value Gaps #, Chart/HTF'
fvgSH2 = input.bool(false, 'Fair Value Gaps #2, Chart/HTF', inline = 'fvg2', group = fvgGR2)
fvgTF2 = input.string('1 Hour', '', options = ['Chart', '5 Minutes', '15 Minutes', '1 Hour', '4 Hours', '1 Day', '1 Week', '1 Month'], inline = 'fvg2', group = fvgGR2, tooltip = fvgTip1, display = display)
fvgFill2 = input.string('Wick Sweep', '  FVG #2 Fill Method', options = ['Any Touch', 'Midpoint Reached', 'Wick Sweep', 'Body Beyond'], display = display, tooltip = fvgFillTip1, group = fvgGR2)
fvgCb2 = input.color(#6EE7B7, '  FVG #2 Zones    ', inline = 'fvg', group = fvgGR2)
fvgCs2 = input.color(#FF6B6B, '', inline = 'fvg', group = fvgGR2)
fvgLB2 = input.string('Hide', '  FVG #2 Labels', options = ['Show', 'Hide'], tooltip = fvgLBTip1, display = display, group = fvgGR2)
maxBars2 = input.int(360, '  Max Bars Back', minval = 1, step = 20, group = fvgGR2, display = display, tooltip = 'This determines how far back the script will analyze for Fair Value Gaps.')

fvgGR3 = 'Fair Value Gaps #3, LTF'
fvgTip3 = 'Intrabar timeframe (lower timeframe, LTF) setting option. When set to "Auto", the lower timeframe is determined by the following algorithm:\n  Chart Timeframe → Lower Timeframe\n\t\t<= 3 min\t\t→ 15 sec\n\t\t<= 30 min\t\t→ 1 min\n\t\t<= 2 hour\t\t→ 5 min\n\t\t<= 4 hour\t\t→ 15 min\n\t\t<= 1 day\t\t→ 1 hour\n\t\t<= 1 week\t\t→ 4 hour\n\t\t<= 1 month\t→ 1 day\n\t\t>  1 month\t→ 1 week'

fvgSH3 = input.bool(false, 'Fair Value Gaps #3, LTF', inline = 'fvg3', group = fvgGR3)
fvgTF3 = input.timeframe('Auto', '', options = ['Auto', '1S', '5S', '10S', '15S', '30S', '1m', '3m', '5m', '15m', '30m', '45m', '1H', '2H', '3H', '4H', 'D'], inline = 'fvg3', group = fvgGR3, tooltip = fvgTip3)
fvgThTip = 'Checks the significance of the detected fair value gap compared to a fixed-length average true range. Setting the value to 0 means that no filtering will be applied, whereas values greater than zero determine the filtering threshold value'
fvgTH3 = input.float(.7, '  FVG Filter Threshold', minval = 0, step = .1, group = fvgGR3, tooltip = fvgThTip)

fvgCb3 = input.color(#8BC34A, '  FVG #3 Zones    ', inline = 'VD', group = fvgGR3)
fvgCs3 = input.color(#E91E63, '', inline = 'VD', group = fvgGR3)

fvgLBTip3 = 'Controls the visibility of lower-timeframe Fair Value Gap (FVG) labels.\n\n• **Show** — displays labels for each detected LTF FVG, indicating the source lower timeframe of the zone.\n• **Hide** — hides the on-chart labels, while tooltips remain available when hovering over the midpoint of each LTF FVG zone.'
fvgLB3 = input.string('Hide', '  FVG #3 Labels', options = ['Show', 'Hide'], tooltip = fvgLBTip3, display = display, group = fvgGR3)

type BAR
    float open  = open
    float high  = high
    float low   = low
    float close = close
    int   index = bar_index

    float ltfHigh
    float ltfHigh1
    float ltfHigh2
    float ltfLow
    float ltfLow1
    float ltfLow2
    float ltfClose
    float ltfClose1

type HTFBar
    float price = na
    int   index = na

type HTFBarOHLC
    HTFBar open
    HTFBar high
    HTFBar low
    HTFBar close

type FVG
    label  lbTxt
    line   lnTop
    line   lnAvg
    line   lnBtm
    float  mitPrice
    float  mit
    string txt
    
BAR htfbar = BAR.new()

ltfTF(_t) =>
    str.contains(_t, 'S') or str.contains(_t, 'D') or str.contains(_t, 'W') or str.contains(_t, 'M') ? _t : 
     str.contains(_t, 'm') ? str.replace(_t, 'm', '', 0) : str.contains(_t, 'H') ? str.tostring(str.tonumber(str.replace(_t, 'H', '', 0)) * 60) : '12M'

ltfTF() =>
    int tfInMs = timeframe.in_seconds(timeframe.period)
    int mInMS = 60
    switch 
        tfInMs <= 1 * mInMS => '5S'
        tfInMs <= 3 * mInMS => '15S'
        tfInMs <= 30 * mInMS => '1'
        tfInMs <= 120 * mInMS => '5'
        tfInMs <= 240 * mInMS => '15'
        tfInMs <= 1440 * mInMS => '60'
        tfInMs <= 7 * 1440 * mInMS => '240'
        tfInMs <= 31 * 1440 * mInMS => 'D'
        => 'W'

htfTF(usrTF) =>
    float chartTFin = timeframe.in_seconds() / 60
    switch 
        usrTF == '5 Minutes' and chartTFin <= 5 => '5'
        usrTF == '15 Minutes' and chartTFin <= 15 => '15'
        usrTF == '1 Hour' and chartTFin <= 60 => '60'
        usrTF == '4 Hours' and chartTFin <= 240 => '240'
        usrTF == '1 Day' and timeframe.isintraday => 'D'
        usrTF == '1 Week' and (timeframe.isdaily or timeframe.isintraday) => 'W'
        usrTF == '1 Month' and (timeframe.isweekly or timeframe.isdaily or timeframe.isintraday) => 'M'
        => timeframe.period

updateFvg(fvgArray, fill, side, fvgLb) =>
    if fvgArray.size() > 0
        for i = array.size(fvgArray) - 1 to 0
            this = array.get(fvgArray, i)

            if side == "bull" ? (fill == 'Body Beyond' ? htfbar.close : htfbar.low) <= this.mitPrice : (fill == 'Body Beyond' ? htfbar.close : htfbar.high) > this.mitPrice
                fvgArray.remove(i)

                this.lbTxt.delete()
                this.lnTop.delete()
                this.lnAvg.delete()
                this.lnBtm.delete()
            else
                this.lbTxt.set_x(htfbar.index + 1)
                this.lnTop.set_x2(htfbar.index + 1)
                this.lnAvg.set_x2(htfbar.index + 1)
                this.lnBtm.set_x2(htfbar.index + 1)

                fillRatio = switch side
                    "bull" => (this.lnTop.get_y1() - htfbar.low)  / (this.lnTop.get_y1() - this.lnBtm.get_y1())
                    "bear" => (htfbar.high - this.lnBtm.get_y1()) / (this.lnTop.get_y1() - this.lnBtm.get_y1())
                    => 0.0
                
                if fillRatio > this.mit
                    this.mit := fillRatio
                    this.lbTxt.set_text( fvgLb == 'Show' ? this.txt + str.format("{0,number,(#.#%)}", fillRatio) : '') 

renderFvg(show, tfIn, fill, cBull, cBear, fvgLb) =>
    if show
        var array<FVG> bullFvgArray = array.new<FVG>()
        var array<FVG> bearFvgArray = array.new<FVG>()
        var array<HTFBarOHLC> barArray = array.new<HTFBarOHLC>()

        var HTFBar barOpen = HTFBar.new(htfbar.open,htfbar.index)
        var HTFBar barHigh = HTFBar.new(htfbar.high, htfbar.index)
        var HTFBar barLow = HTFBar.new(htfbar.low, htfbar.index)
        var HTFBar barClose = HTFBar.new(htfbar.close, htfbar.index)

        var barHist = HTFBarOHLC.new(barOpen, barHigh, barLow, barClose)

        var int bullBarIndexEnd = na
        var int bullBarIndexEnd1 = na
        var int bearBarIndexEnd = na
        var int bearBarIndexEnd1 = na

        var bool bullProcess = false
        var bool bearProcess = false

        bool bullG = false
        bool bearG = false
        bool bullCondition = false
        bool bearCondition = false

        string tf = htfTF(tfIn)
        fvgTf = tf == timeframe.period

        if timeframe.change(tf)
            bullProcess := false
            bearProcess := false

            if barArray.size() > 2
                barArray.pop()

            barArray.unshift(barHist)

            barOpen  := HTFBar.new(htfbar.open, htfbar.index)
            barHigh  := HTFBar.new(htfbar.high, htfbar.index)
            barLow   := HTFBar.new(htfbar.low, htfbar.index)
            barClose := HTFBar.new(htfbar.close, htfbar.index)

            barHist  := HTFBarOHLC.new(barOpen, barHigh, barLow, barClose) 

            bullBarIndexEnd1 := bullBarIndexEnd
            bullBarIndexEnd  := htfbar.index
            bearBarIndexEnd1 := bearBarIndexEnd
            bearBarIndexEnd  := htfbar.index

        else
            if htfbar.high > barHigh.price
                barHigh.price := htfbar.high
                barHigh.index := htfbar.index

            if htfbar.low < barLow.price
                barLow.price := htfbar.low
                barLow.index := htfbar.index

            barClose.price := htfbar.close
            barClose.index := htfbar.index

            if barArray.size() > 2
                if htfbar.low < barArray.get(1).high.price
                    bullBarIndexEnd := htfbar.index

                if htfbar.high > barArray.get(1).low.price
                    bearBarIndexEnd := htfbar.index

        if barArray.size() > 2
            bullG := barArray.get(0).low.price > barArray.get(1).high.price or barArray.get(1).low.price > barArray.get(2).high.price
            bullCondition := barArray.get(0).low.price > barArray.get(2).high.price and barArray.get(1).close.price > barArray.get(2).high.price and not bullG

            bearG := barArray.get(0).high.price < barArray.get(1).low.price or barArray.get(1).high.price < barArray.get(2).low.price
            bearCondition := barArray.get(0).high.price < barArray.get(2).low.price and barArray.get(1).close.price < barArray.get(2).low.price and not bearG

        if bullCondition and not bullProcess
            bullProcess := true

            bullFvgArray.unshift(
             FVG.new(
                 label.new(htfbar.index + 1, math.avg(barArray.get(0).low.price, barArray.get(2).high.price), fvgLb == 'Show' ? fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = cBull, size = size.small, 
                  tooltip = (fvgTf ? 'Chart(' + tf + ') Bullish FVG' : 'HTF(' + tf + ') Bullish FVG') + '\n\nZone Top · ' + str.format("{0, number, #,###.##}", barArray.get(0).low.price) + '\nZone Mid · ' + str.format("{0, number, #,###.##}", math.avg(barArray.get(0).low.price, barArray.get(2).high.price)) + '\nZone Btm · ' + str.format("{0, number, #,###.##}", barArray.get(2).high.price) ),
                 line.new(barArray.get(0).low.index, barArray.get(0).low.price, htfbar.index + 1, barArray.get(0).low.price, color = color.new(cBull, 65)),
                 line.new(math.ceil(math.avg(barArray.get(0).low.index, barArray.get(2).high.index)), math.avg(barArray.get(0).low.price, barArray.get(2).high.price), htfbar.index + 1, math.avg(barArray.get(0).low.price, barArray.get(2).high.price), style = line.style_dotted, color = color.new(cBull, 25)),
                 line.new(barArray.get(2).high.index, barArray.get(2).high.price, htfbar.index + 1, barArray.get(2).high.price, color = color.new(cBull, 50), width = 2), 
                 fill == 'Midpoint Reached' ? math.avg(barArray.get(2).low.price, barArray.get(0).high.price) : fill == 'Any Touch' ? barArray.get(0).low.price : barArray.get(2).high.price, 0, fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG')
             )

            first = bullFvgArray.first()
            linefill.new(first.lnTop, first.lnBtm, color.new(cBull, 89))

        if bearCondition and not bearProcess
            bearProcess := true

            bearFvgArray.unshift(
             FVG.new(
                 label.new(htfbar.index + 1, math.avg(barArray.get(2).low.price, barArray.get(0).high.price), fvgLb == 'Show' ? fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = cBear, size = size.small, 
                  tooltip = (fvgTf ? 'Chart(' + tf + ') Bearish FVG' : 'HTF(' + tf + ') Bearish FVG') + '\n\nZone Top · ' + str.format("{0, number, #,###.##}", barArray.get(2).low.price) + '\nZone Mid · ' + str.format("{0, number, #,###.##}", math.avg(barArray.get(2).low.price, barArray.get(0).high.price)) + '\nZone Btm · ' + str.format("{0, number, #,###.##}", barArray.get(0).high.price) ),
                 line.new(barArray.get(2).low.index, barArray.get(2).low.price, htfbar.index + 1, barArray.get(2).low.price, color = color.new(cBear, 50), width = 2), 
                 line.new(math.ceil(math.avg(barArray.get(2).low.index, barArray.get(0).high.index)), math.avg(barArray.get(2).low.price, barArray.get(0).high.price), htfbar.index + 1, math.avg(barArray.get(2).low.price, barArray.get(0).high.price), style = line.style_dotted, color = color.new(cBear, 25)), 
                 line.new(barArray.get(0).high.index, barArray.get(0).high.price, htfbar.index + 1, barArray.get(0).high.price, color = color.new(cBear, 65)), 
                 fill == 'Midpoint Reached' ? math.avg(barArray.get(2).low.price, barArray.get(0).high.price) : fill == 'Any Touch' ? barArray.get(0).high.price : barArray.get(2).low.price, 0, fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG')
             )
             
            first = bearFvgArray.first()
            linefill.new(first.lnTop, first.lnBtm, color.new(cBear, 89))

        updateFvg(bullFvgArray, fill, 'bull', fvgLb)
        updateFvg(bearFvgArray, fill, 'bear', fvgLb)

var fvgLTFbx = array.new_box()
var fvgLTFlb = array.new_label()

ltf = fvgTF3 == 'Auto' ? ltfTF() : ltfTF(fvgTF3)
[aO, aH, aL, aC, atr] = request.security_lower_tf(syminfo.tickerid, ltf, [htfbar.open, htfbar.high, htfbar.low, htfbar.close, ta.atr(13)])

if fvgSH3 and timeframe.change(timeframe.period) and array.size(aH) > 0 
    for i = 0 to aH.size() - 1 by 1

        htfbar.ltfClose1 := htfbar.ltfClose
        htfbar.ltfClose  := aC.get(i)

        htfbar.ltfHigh2  := htfbar.ltfHigh1
        htfbar.ltfHigh1  := htfbar.ltfHigh
        htfbar.ltfHigh   := aH.get(i)

        htfbar.ltfLow2   := htfbar.ltfLow1
        htfbar.ltfLow1   := htfbar.ltfLow
        htfbar.ltfLow    := aL.get(i)

        bull = htfbar.ltfLow - htfbar.ltfHigh2 > atr.get(i) * fvgTH3 and htfbar.ltfLow > htfbar.ltfHigh2 and htfbar.ltfClose1 > htfbar.ltfHigh2

        if bull
            fvgLTFbx.push(box.new(htfbar.index, htfbar.ltfLow, htfbar.index + 1, htfbar.ltfHigh2, color.new(fvgCb3, 73), bgcolor = color.new(fvgCb3, 73))) 
            fvgLTFlb.push(
             label.new(htfbar.index + 1, math.avg(htfbar.ltfLow, htfbar.ltfHigh2), fvgLB3 == 'Show' ? 'LTF(' + ltf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = fvgCb3, size = size.small, 
                  tooltip = 'LTF(' + ltf + ') Bullish FVG' )
             )

        bear = htfbar.ltfLow2 - htfbar.ltfHigh > atr.get(i) * fvgTH3 and htfbar.ltfHigh < htfbar.ltfLow2 and htfbar.ltfClose1 < htfbar.ltfLow2

        if bear
            fvgLTFbx.push(box.new(htfbar.index, htfbar.ltfLow2, htfbar.index + 1, htfbar.ltfHigh, color.new(fvgCs3, 73), bgcolor = color.new(fvgCs3, 73)))
            fvgLTFlb.push(
             label.new(htfbar.index + 1, math.avg(htfbar.ltfLow2, htfbar.ltfHigh), fvgLB3 == 'Show' ? 'LTF(' + ltf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = fvgCs3, size = size.small, 
                  tooltip = 'LTF(' + ltf + ') Bearish FVG' )
             )

        if fvgLTFbx.size() > 0
            qt = fvgLTFbx.size()

            for bn = qt - 1 to 0 by 1
                if bn < fvgLTFbx.size()
                    cBX = fvgLTFbx.get(bn)
                    cLB = fvgLTFlb.get(bn)
                    tBX = cBX.get_top()
                    bBX = cBX.get_bottom()

                    if htfbar.ltfHigh >= tBX and htfbar.ltfLow <= bBX
                        cBX.delete()
                        fvgLTFbx.remove(bn)
                        fvgLTFlb.remove(bn)
                        cLB.delete()
                    else
                        if htfbar.ltfHigh > bBX and htfbar.ltfHigh < tBX
                            cBX.set_bottom(htfbar.ltfHigh)
                            cLB.set_y(math.avg(cBX.get_top(), htfbar.ltfHigh))

                        if htfbar.ltfLow < tBX and htfbar.ltfLow > bBX
                            cBX.set_top(htfbar.ltfLow)
                            cLB.set_y(math.avg(cBX.get_bottom(),htfbar.ltfLow))

        if fvgLTFbx.size() > 250
            cBX = fvgLTFbx.shift()
            cLB = fvgLTFlb.shift()
            cBX.delete()
            cLB.delete()

if fvgLTFbx.size() > 0
    qt = fvgLTFbx.size()

    for bn = qt - 1 to 0 by 1
        if bn < fvgLTFbx.size()
            cBX = fvgLTFbx.get(bn)
            cLB = fvgLTFlb.get(bn)
            tBX = cBX.get_top()
            bBX = cBX.get_bottom()

            if htfbar.high > tBX and htfbar.low < bBX and htfbar.index > cBX.get_left()
                fvgLTFbx.remove(bn)
                cBX.delete()
                fvgLTFlb.remove(bn)
                cLB.delete()
            else
                cBX.set_right(htfbar.index + 1)
                cBX.set_border_color(na)
                cLB.set_x(htfbar.index + 1)

if last_bar_index - bar_index <= maxBars and fvgSH1
    renderFvg(fvgSH1, fvgTF1, fvgFill1, fvgCb1, fvgCs1, fvgLB1)

if last_bar_index - bar_index <= maxBars2 and fvgSH2
    renderFvg(fvgSH2, fvgTF2, fvgFill2, fvgCb2, fvgCs2, fvgLB2)

table logo = table.new(position.bottom_right, 1, 1)
if barstate.isfirst
    table.cell(logo, 0, 0, '☼☾  ', text_size = size.normal, text_color = color.teal)

//==============================================================================
//                     SHARED ZIGZAG SETTINGS
//==============================================================================
lbR = input.int(5, 'Lookback: Right', inline = 'lb', group = 'Zigzag Settings')
lbL = input.int(120, 'Left', inline = 'lb', group = 'Zigzag Settings')
show_zigzag = input.bool(true, 'Show Zigzag', inline = 'zigzag', group = 'Zigzag Settings')
zigzag_color = input.color(#c8ff0004, 'Color', inline = 'zigzag', group = 'Zigzag Settings')
retrepaint = input.bool(true, 'Repaint', inline = 'zigzag', group = 'Zigzag Settings') and show_zigzag

//==============================================================================
//                     FIBONACCI RETRACEMENT SETTINGS
//==============================================================================
fib = array.new_float(0)
fib_col = array.new_color(0)

fib_a_lvl = input(0, '', inline = 'ret_inline1', group = 'Fibonacci Retracement Levels')
fib_a_col = input(#ffffff, '', inline = 'ret_inline1', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline1', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_a_lvl)
    array.push(fib_col, fib_a_col)

fib_b_lvl = input(0.236, '', inline = 'ret_inline2', group = 'Fibonacci Retracement Levels')
fib_b_col = input(#ffffff, '', inline = 'ret_inline2', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline2', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_b_lvl)
    array.push(fib_col, fib_b_col)

fib_c_lvl = input(0.382, '', inline = 'ret_inline3', group = 'Fibonacci Retracement Levels')
fib_c_col = input(#ffffff, '', inline = 'ret_inline3', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline3', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_c_lvl)
    array.push(fib_col, fib_c_col)

fib_d_lvl = input(0.5, '', inline = 'ret_inline4', group = 'Fibonacci Retracement Levels')
fib_d_col = input(#ffffff, '', inline = 'ret_inline4', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline4', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_d_lvl)
    array.push(fib_col, fib_d_col)

fib_e_lvl = input(0.618, '', inline = 'ret_inline5', group = 'Fibonacci Retracement Levels')
fib_e_col = input(#ffffff, '', inline = 'ret_inline5', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline5', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_e_lvl)
    array.push(fib_col, fib_e_col)

fib_f_lvl = input(0.786, '', inline = 'ret_inline6', group = 'Fibonacci Retracement Levels')
fib_f_col = input(#ffffff, '', inline = 'ret_inline6', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline6', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_f_lvl)
    array.push(fib_col, fib_f_col)

fib_g_lvl = input(1, '', inline = 'ret_inline7', group = 'Fibonacci Retracement Levels')
fib_g_col = input(#ffffff, '', inline = 'ret_inline7', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline7', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_g_lvl)
    array.push(fib_col, fib_g_col)

fib_h_lvl = input(1.272, '', inline = 'ret_inline8', group = 'Fibonacci Retracement Levels')
fib_h_col = input(#ffffff, '', inline = 'ret_inline8', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline8', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_h_lvl)
    array.push(fib_col, fib_h_col)

fib_i_lvl = input(1.414, '', inline = 'ret_inline9', group = 'Fibonacci Retracement Levels')
fib_i_col = input(#ffffff, '', inline = 'ret_inline9', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline9', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_i_lvl)
    array.push(fib_col, fib_i_col)

fib_j_lvl = input(1.618, '', inline = 'ret_inline10', group = 'Fibonacci Retracement Levels')
fib_j_col = input(#ffffff, '', inline = 'ret_inline10', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline10', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_j_lvl)
    array.push(fib_col, fib_j_col)

ret_bars = input.int(60, 'Retracement Bars', group = 'Fibonacci Retracement Levels', tooltip = 'the lines will be extended "Bars" + "Right Lookback" bars to the right')

//==============================================================================
//                     SHARED ZIGZAG LOGIC
//==============================================================================
new_pivot_high = not na(ta.pivothigh(high, lbL, lbR))
new_pivot_low = not na(ta.pivotlow(low, lbL, lbR))
new_pivot = new_pivot_high or new_pivot_low

direction = math.sign(ta.barssince(new_pivot_high) - ta.barssince(new_pivot_low))
new_direction = bool(ta.change(direction))

var chart.point last_pivot = chart.point.now(low)
var chart.point second_last_pivot = chart.point.now(high)

if new_direction
    second_last_pivot := last_pivot.copy()

if new_pivot_high
    if new_direction
        last_pivot := chart.point.from_index(bar_index - lbR, high[lbR])
    else
        if high[lbR] > last_pivot.price
            last_pivot := chart.point.from_index(bar_index - lbR, high[lbR])

if new_pivot_low
    if new_direction
        last_pivot := chart.point.from_index(bar_index - lbR, low[lbR])
    else
        if low[lbR] < last_pivot.price
            last_pivot := chart.point.from_index(bar_index - lbR, low[lbR])

var line retzigzag = na

if new_pivot and show_zigzag
    retzigzag := line.new(last_pivot, second_last_pivot, xloc.bar_index, extend.none, zigzag_color)
    if not new_direction
        line.delete(retzigzag[1])

var array<chart.point> points = array.new<chart.point>()

if bool(ta.change(bar_index))
    points.clear()
    points.push(last_pivot)
    points.push(chart.point.now(hl2))

var polyline repainted_zigzag = na

if retrepaint
    polyline.delete(repainted_zigzag)
    repainted_zigzag := polyline.new(points, xloc = xloc.bar_index, line_style = line.style_dotted, line_color = zigzag_color)

//==============================================================================
//                     FIBONACCI RETRACEMENT CALCULATION
//==============================================================================
var array<float> fib_levels = array.new<float>()

if bool(ta.change(bar_index))
    fib_levels.clear()
    for i = 0 to fib.size() - 1 by 1
        fib_levels.push(second_last_pivot.price + array.get(fib, i) * (last_pivot.price - second_last_pivot.price))

var array<label> fib_labels = array.new<label>()
var array<line> fib_lines = array.new<line>()

if new_pivot
    if fib_lines.size() > 0
        for j = 0 to fib_lines.size() - 1 by 1
            line.delete(fib_lines.get(j))
            label.delete(fib_labels.get(j))
    fib_lines.clear()
    fib_labels.clear()

    for i = 0 to array.size(fib) - 1 by 1
        fib_lines.push(line.new(second_last_pivot.index, fib_levels.get(i), bar_index + lbR + ret_bars, fib_levels.get(i), xloc.bar_index, color = fib_col.get(i), extend = extend.none))
        fib_labels.push(label.new(bar_index + lbR + ret_bars, fib_levels.get(i), str.tostring(fib.get(i)), xloc.bar_index, yloc.price, #00000000, label.style_label_left, fib_col.get(i), size.small, text.align_center))


//////////////Liquidity Sentiment Profile///////////
group_mode = '🎯 Mode Selection'
advanced_mode = input.bool(false, 'Advanced Mode', group = group_mode, tooltip = 'Enable advanced features and customization options')

group1 = '🔍 Detection Settings'
liq_swing_length = input.int(20, 'Swing Length', minval = 5, maxval = 100, group = group1, tooltip = 'Bars checked for swing point detection')
zscore_period = input.int(50, 'Z-Score Period', minval = 20, maxval = 200, group = group1, tooltip = 'Period for volume statistics calculation')

group2 = '📊 Thresholds'
normal_threshold = input.float(1.0, 'Normal Activity', minval = 0.5, maxval = 2.0, step = 0.1, group = group2, tooltip = 'Below this = Normal volume')
elevated_threshold = input.float(2.0, 'Elevated Activity', minval = 1.0, maxval = 3.0, step = 0.1, group = group2, tooltip = 'Above this = Elevated volume')
institutional_threshold = input.float(3.0, 'Institutional Activity', minval = 2.0, maxval = 5.0, step = 0.1, group = group2, tooltip = 'Above this = Potential accumulation/distribution')

group3 = '⚙️ Advanced Features'
use_adaptive = input.bool(true, 'Enable Adaptive Thresholds', group = group3, tooltip = 'Adjust thresholds based on market regime')
use_htf_confirm = input.bool(true, 'Higher Timeframe Confirmation', group = group3, tooltip = 'Confirm signals with HTF volume')
htf_timeframe = input.timeframe('', 'HTF (Auto if empty)', group = group3, tooltip = 'Leave empty for auto-detection')

group3_adv = '🚀 Advanced HTF Settings'
adaptive_htf_threshold = advanced_mode ? input.bool(true, 'Adaptive HTF Threshold', group = group3_adv, tooltip = 'Adjust HTF confirmation threshold based on market volatility') : true
volume_trend_arrows = advanced_mode ? input.bool(true, 'Volume Trend Arrows', group = group3_adv, tooltip = 'Show volume acceleration/deceleration arrows') : true
enhanced_sizing = advanced_mode ? input.bool(true, 'Enhanced Label Sizing', group = group3_adv, tooltip = 'Use larger labels for extreme institutional activity') : true

group4 = '📈 Display Options'
show_swing_labels = input.bool(true, 'Show Swing Labels', group = group4, tooltip = 'Display HH, LH, HL, LL labels')
show_zscore_values = input.bool(true, 'Show Z-Score Values', group = group4, tooltip = 'Display numerical Z-score values')
show_zscore_plot = input.bool(false, 'Show Z-Score Plot', group = group4, tooltip = 'Display Z-score in separate pane')
show_info_table = input.bool(true, 'Show Info Table', group = group4, tooltip = 'Display real-time statistics')
base_label_size = input.string('Medium', 'Label Size', options = ['Small', 'Medium', 'Large', 'X-Large'], group = group4, tooltip = 'Base size for all labels - adjust to your screen/chart setup')

group_table = '📊 Table Customization'
table_position = advanced_mode ? input.string('Top Right', 'Table Position', options = ['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right', 'Middle Left', 'Middle Right'], group = group_table) : 'Top Right'
table_size = advanced_mode ? input.string('Normal', 'Table Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = group_table) : 'Normal'
table_transparency = advanced_mode ? input.int(10, 'Table Transparency', minval = 0, maxval = 95, step = 5, group = group_table) : 10

volume_mean = ta.sma(volume, zscore_period)
volume_stdev = ta.stdev(volume, zscore_period)
volume_zscore = volume_stdev > 0 ? (volume - volume_mean) / volume_stdev : 0

volume_trend_period = 10
volume_sma_short = ta.sma(volume, 5)
volume_sma_long = ta.sma(volume, volume_trend_period)
volume_trend_ratio = volume_sma_long > 0 ? volume_sma_short / volume_sma_long : 1

get_volume_trend_arrow() =>
    if not volume_trend_arrows
        ''
    else if volume_trend_ratio > 1.15
        ' ↗️'
    else if volume_trend_ratio < 0.85
        ' ↘️'
    else
        ' ↔️'

ma20 = ta.sma(close, 20)
ma_slope = (ma20 - ma20[5]) / ta.atr(10) * 100
atr_current = ta.atr(14)
atr_avg = ta.sma(atr_current, 20)

is_trending = math.abs(ma_slope) > 0.5
is_high_vol = atr_current > atr_avg * 1.2

adaptive_multiplier = if use_adaptive
    base = is_trending ? 1.3 : 0.8
    vol_adj = is_high_vol ? 1.2 : 1.0
    base * vol_adj
else
    1.0

current_normal = normal_threshold * adaptive_multiplier
current_elevated = elevated_threshold * adaptive_multiplier
current_institutional = institutional_threshold * adaptive_multiplier

get_htf() =>
    if htf_timeframe != '' and htf_timeframe != timeframe.period
        htf_timeframe
    else
        current_tf_seconds = timeframe.in_seconds()
        if current_tf_seconds <= 60
            '5'
        else if current_tf_seconds <= 300
            '15'
        else if current_tf_seconds <= 900
            '60'
        else if current_tf_seconds <= 3600
            '240'
        else if current_tf_seconds <= 14400
            '1D'
        else if current_tf_seconds <= 86400
            '1W'
        else
            '1M'

liq_htf = get_htf()
current_tf_seconds = timeframe.in_seconds()
htf_seconds = timeframe.in_seconds(liq_htf)
is_htf_valid = htf_seconds > current_tf_seconds and use_htf_confirm

// Corrected: Replaced ternary tuple return with if/else
[htf_volume, htf_vol_mean, htf_vol_stdev] = if is_htf_valid
    request.security(syminfo.tickerid, liq_htf, [volume, ta.sma(volume, zscore_period), ta.stdev(volume, zscore_period)], lookahead = barmerge.lookahead_off)
else
    [volume, volume_mean, volume_stdev]

htf_zscore = if is_htf_valid and htf_vol_stdev > 0
    (htf_volume - htf_vol_mean) / htf_vol_stdev
else
    volume_zscore

base_htf_threshold = 1.5
adaptive_htf_multiplier = if adaptive_htf_threshold and is_htf_valid
    volatility_factor = atr_current / ta.sma(atr_current, 50)
    if volatility_factor > 1.5
        1.3
    else if volatility_factor < 0.7
        0.8
    else
        1.0
else
    1.0

current_htf_threshold = base_htf_threshold * adaptive_htf_multiplier

htf_confirmed = if use_htf_confirm and is_htf_valid
    math.abs(htf_zscore) >= current_htf_threshold
else
    true

var int total_signals = 0
var int confirmed_signals = 0

if not na(ta.pivothigh(high, liq_swing_length, liq_swing_length)) or not na(ta.pivotlow(low, liq_swing_length, liq_swing_length))
    total_signals := total_signals + 1
    if htf_confirmed
        confirmed_signals := confirmed_signals + 1

success_rate = total_signals > 0 ? math.round(confirmed_signals * 100 / total_signals) : 0

pivot_high = ta.pivothigh(high, liq_swing_length, liq_swing_length)
pivot_low = ta.pivotlow(low, liq_swing_length, liq_swing_length)

var float prev_high = 0.0
var float prev_low = 0.0
var bool first_high = true
var bool first_low = true

higher_high = false
lower_high = false
higher_low = false
lower_low = false

if not na(pivot_high)
    if first_high
        higher_high := true
        first_high := false
    else if pivot_high >= prev_high
        higher_high := true
    else
        lower_high := true
    prev_high := pivot_high

if not na(pivot_low)
    if first_low
        higher_low := true
        first_low := false
    else if pivot_low >= prev_low
        higher_low := true
    else
        lower_low := true
    prev_low := pivot_low

INSTITUTIONAL_COLOR = color.new(#ff4444, 0)
INSTITUTIONAL_COLOR_WEAK = color.new(#ff4444, 30)
ELEVATED_COLOR = color.new(#ff9800, 0)
ELEVATED_COLOR_WEAK = color.new(#ff9800, 30)
NORMAL_COLOR = color.new(#4caf50, 0)
NORMAL_COLOR_WEAK = color.new(#4caf50, 30)
LOW_COLOR = color.new(#9e9e9e, 60)

get_zscore_color(zscore) =>
    abs_zscore = math.abs(zscore)
    if abs_zscore >= current_institutional
        htf_confirmed ? INSTITUTIONAL_COLOR : INSTITUTIONAL_COLOR_WEAK
    else if abs_zscore >= current_elevated
        htf_confirmed ? ELEVATED_COLOR : ELEVATED_COLOR_WEAK
    else if abs_zscore >= current_normal
        htf_confirmed ? NORMAL_COLOR : NORMAL_COLOR_WEAK
    else
        LOW_COLOR

get_significance_text(zscore) =>
    abs_zscore = math.abs(zscore)
    if abs_zscore >= current_institutional
        '🔴 INSTITUTIONAL'
    else if abs_zscore >= current_elevated
        '🟠 ELEVATED'
    else if abs_zscore >= current_normal
        '🟢 NORMAL'
    else
        '⚪ LOW'

get_base_label_size() =>
    switch base_label_size
        'Small' => size.small
        'Medium' => size.normal
        'Large' => size.large
        'X-Large' => size.huge
        => size.normal

get_label_size(zscore) =>
    abs_zscore = math.abs(zscore)
    base_size = get_base_label_size()

    if enhanced_sizing and abs_zscore >= current_institutional and htf_confirmed
        switch base_label_size
            'Small' => size.large
            'Medium' => size.large
            'Large' => size.huge
            'X-Large' => size.huge
            => size.large
    else if enhanced_sizing and abs_zscore >= current_institutional
        base_size
    else if is_htf_valid and not htf_confirmed
        switch base_label_size
            'Small' => size.tiny
            'Medium' => size.small
            'Large' => size.normal
            'X-Large' => size.large
            => size.small
    else
        base_size

get_table_position() =>
    switch table_position
        'Top Left' => position.top_left
        'Top Right' => position.top_right
        'Bottom Left' => position.bottom_left
        'Bottom Right' => position.bottom_right
        'Middle Left' => position.middle_left
        'Middle Right' => position.middle_right
        => position.top_right

get_table_text_size() =>
    switch table_size
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        => size.normal

if not na(pivot_high)
    zscore_at_swing = volume_zscore[liq_swing_length]
    htf_zscore_at_swing = htf_zscore[liq_swing_length]
    swing_color = get_zscore_color(zscore_at_swing)

    label_text = ''
    volume_arrow = get_volume_trend_arrow()

    if show_swing_labels and show_zscore_values
        swing_type = higher_high ? 'HH' : 'LH'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow
    else if show_swing_labels
        swing_type = higher_high ? 'HH' : 'LH'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        label_text := htf_indicator + swing_type + volume_arrow
    else if show_zscore_values
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + 'Z:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := 'Z:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow

    if label_text != ''
        tooltip_text = 'Swing High: ' + (higher_high ? 'Higher High' : 'Lower High') + '\nCurrent TF Z-Score: ' + str.tostring(zscore_at_swing, '#.##') + '\nHTF Z-Score (' + liq_htf + '): ' + str.tostring(htf_zscore_at_swing, '#.##') + '\nSignificance: ' + get_significance_text(zscore_at_swing) + '\nHTF Confirmed: ' + (htf_confirmed ? '✓ YES' : '✗ NO') + '\nHTF Threshold: ' + str.tostring(current_htf_threshold, '#.##') + '\nVolume Trend: ' + (volume_trend_ratio > 1.15 ? 'Accelerating' : volume_trend_ratio < 0.85 ? 'Decelerating' : 'Stable') + '\nVolume: ' + str.tostring(volume[liq_swing_length] / 1000, '#.#') + 'K'

        label_size = get_label_size(zscore_at_swing)
        label.new(bar_index - liq_swing_length, pivot_high, label_text, color = swing_color, style = label.style_label_down, textcolor = color.white, size = label_size, tooltip = tooltip_text)

if not na(pivot_low)
    zscore_at_swing = volume_zscore[liq_swing_length]
    htf_zscore_at_swing = htf_zscore[liq_swing_length]
    swing_color = get_zscore_color(zscore_at_swing)

    label_text = ''
    volume_arrow = get_volume_trend_arrow()

    if show_swing_labels and show_zscore_values
        swing_type = higher_low ? 'HL' : 'LL'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow
    else if show_swing_labels
        swing_type = higher_low ? 'HL' : 'LL'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        label_text := htf_indicator + swing_type + volume_arrow
    else if show_zscore_values
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + 'Z:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := 'Z:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow

    if label_text != ''
        tooltip_text = 'Swing Low: ' + (higher_low ? 'Higher Low' : 'Lower Low') + '\nCurrent TF Z-Score: ' + str.tostring(zscore_at_swing, '#.##') + '\nHTF Z-Score (' + liq_htf + '): ' + str.tostring(htf_zscore_at_swing, '#.##') + '\nSignificance: ' + get_significance_text(zscore_at_swing) + '\nHTF Confirmed: ' + (htf_confirmed ? '✓ YES' : '✗ NO') + '\nHTF Threshold: ' + str.tostring(current_htf_threshold, '#.##') + '\nVolume Trend: ' + (volume_trend_ratio > 1.15 ? 'Accelerating' : volume_trend_ratio < 0.85 ? 'Decelerating' : 'Stable') + '\nVolume: ' + str.tostring(volume[liq_swing_length] / 1000, '#.#') + 'K'

        label_size = get_label_size(zscore_at_swing)
        label.new(bar_index - liq_swing_length, pivot_low, label_text, color = swing_color, style = label.style_label_up, textcolor = color.white, size = label_size, tooltip = tooltip_text)

plot(show_zscore_plot ? volume_zscore : na, 'Volume Z-Score', color = #2196f3, linewidth = 2)
plot(show_zscore_plot ? current_institutional : na, 'Institutional', color = #ff4444, linewidth = 1)
plot(show_zscore_plot ? current_elevated : na, 'Elevated', color = #ff9800, linewidth = 1)
plot(show_zscore_plot ? current_normal : na, 'Normal', color = #4caf50, linewidth = 1)
plot(show_zscore_plot ? -current_normal : na, '-Normal', color = #4caf50, linewidth = 1)
plot(show_zscore_plot ? -current_elevated : na, '-Elevated', color = #ff9800, linewidth = 1)
plot(show_zscore_plot ? -current_institutional : na, '-Institutional', color = #ff4444, linewidth = 1)

bg_color = if show_zscore_plot
    abs_zscore = math.abs(volume_zscore)
    if abs_zscore >= current_institutional
        color.new(#ff4444, 95)
    else if abs_zscore >= current_elevated
        color.new(#ff9800, 95)
    else if abs_zscore >= current_normal
        color.new(#4caf50, 95)
    else
        na
else
    na

bgcolor(bg_color, title = 'Z-Score Background')

if show_info_table and barstate.isconfirmed
    table_pos = get_table_position()
    text_size = get_table_text_size()
    table_rows = advanced_mode ? 12 : 8

    var table info_table = table.new(table_pos, 2, table_rows, bgcolor = color.new(color.white, table_transparency), border_width = 1)

    header_color = advanced_mode ? color.new(color.blue, 20) : color.new(color.gray, 20)
    table.cell(info_table, 0, 0, 'VOLUME Z-SCORE', text_color = color.white, bgcolor = header_color, text_size = text_size)
    table.cell(info_table, 1, 0, advanced_mode ? 'ADVANCED ANALYSIS' : 'ANALYSIS', text_color = color.white, bgcolor = header_color, text_size = text_size)

    table.cell(info_table, 0, 1, 'Current TF Z-Score', text_color = color.black, text_size = text_size)
    zscore_color = get_zscore_color(volume_zscore)
    table.cell(info_table, 1, 1, str.tostring(volume_zscore, '#.##'), text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 2, 'HTF Z-Score (' + liq_htf + ')', text_color = color.black, text_size = text_size)
    htf_text = is_htf_valid ? str.tostring(htf_zscore, '#.##') : 'Disabled/Invalid'
    htf_color = is_htf_valid ? get_zscore_color(htf_zscore) : color.gray
    table.cell(info_table, 1, 2, htf_text, text_color = htf_color, text_size = text_size)

    table.cell(info_table, 0, 3, 'Combined Z-Scores', text_color = color.black, text_size = text_size)
    combined_text = is_htf_valid ? str.tostring(volume_zscore, '#.##') + ' / ' + str.tostring(htf_zscore, '#.##') : str.tostring(volume_zscore, '#.##') + ' / N/A'
    table.cell(info_table, 1, 3, combined_text, text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 4, 'Volume Trend', text_color = color.black, text_size = text_size)
    trend_text = volume_trend_ratio > 1.15 ? '↗️ Accelerating' : volume_trend_ratio < 0.85 ? '↘️ Decelerating' : '↔️ Stable'
    trend_color = volume_trend_ratio > 1.15 ? color.green : volume_trend_ratio < 0.85 ? color.red : color.blue
    table.cell(info_table, 1, 4, trend_text, text_color = trend_color, text_size = text_size)

    table.cell(info_table, 0, 5, 'HTF Confirmation', text_color = color.black, text_size = text_size)
    confirm_text = use_htf_confirm and is_htf_valid ? (htf_confirmed ? '✓ CONFIRMED' : '✗ NOT CONFIRMED') : 'DISABLED/INVALID'
    confirm_color = use_htf_confirm and is_htf_valid ? (htf_confirmed ? NORMAL_COLOR : INSTITUTIONAL_COLOR) : color.gray
    table.cell(info_table, 1, 5, confirm_text, text_color = confirm_color, text_size = text_size)

    table.cell(info_table, 0, 6, 'Significance', text_color = color.black, text_size = text_size)
    significance = get_significance_text(volume_zscore)
    table.cell(info_table, 1, 6, significance, text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 7, 'HTF Success Rate', text_color = color.black, text_size = text_size)
    success_text = str.tostring(success_rate) + '% (' + str.tostring(confirmed_signals) + '/' + str.tostring(total_signals) + ')'
    success_color = success_rate >= 70 ? color.green : success_rate >= 50 ? color.orange : color.red
    table.cell(info_table, 1, 7, success_text, text_color = success_color, text_size = text_size)

    if advanced_mode
        table.cell(info_table, 0, 8, 'HTF Threshold', text_color = color.black, text_size = text_size)
        htf_threshold_text = str.tostring(current_htf_threshold, '#.##') + (adaptive_htf_threshold ? ' (Adaptive)' : ' (Static)')
        table.cell(info_table, 1, 8, htf_threshold_text, text_color = color.blue, text_size = text_size)

        table.cell(info_table, 0, 9, 'Market Regime', text_color = color.black, text_size = text_size)
        regime_text = use_adaptive ? (is_trending ? 'Trending' : 'Ranging') + (is_high_vol ? ' High-Vol' : '') : 'Static'
        regime_color = use_adaptive ? (is_trending ? color.blue : color.orange) : color.gray
        table.cell(info_table, 1, 9, regime_text, text_color = regime_color, text_size = text_size)

        table.cell(info_table, 0, 10, 'Threshold Multiplier', text_color = color.black, text_size = text_size)
        multiplier_text = use_adaptive ? str.tostring(adaptive_multiplier, '#.##') + 'x' : '1.00x'
        table.cell(info_table, 1, 10, multiplier_text, text_color = color.blue, text_size = text_size)

        table.cell(info_table, 0, 11, 'Active Thresholds', text_color = color.black, text_size = text_size)
        active_thresholds_text = '🟢' + str.tostring(current_normal, '#.#') + ' 🟠' + str.tostring(current_elevated, '#.#') + ' 🔴' + str.tostring(current_institutional, '#.#')
        table.cell(info_table, 1, 11, active_thresholds_text, text_color = color.black, text_size = text_size)

institutional_high = not na(pivot_high) and math.abs(volume_zscore[liq_swing_length]) >= current_institutional
institutional_low = not na(pivot_low) and math.abs(volume_zscore[liq_swing_length]) >= current_institutional

alertcondition(institutional_high, '🔴 Distribution Alert', 'High volume at swing high - potential distribution')
alertcondition(institutional_low, '🟢 Accumulation Alert', 'High volume at swing low - potential accumulation')

htf_confirmed_high = institutional_high and htf_confirmed
htf_confirmed_low = institutional_low and htf_confirmed

alertcondition(htf_confirmed_high, '🔴 Confirmed Distribution', 'HTF confirmed high volume at swing high')
alertcondition(htf_confirmed_low, '🟢 Confirmed Accumulation', 'HTF confirmed high volume at swing low')

regime_change = use_adaptive and (is_trending != is_trending[1] or is_high_vol != is_high_vol[1])
alertcondition(regime_change, '📊 Regime Change', 'Market regime changed - thresholds adjusted')

htf_invalid = use_htf_confirm and not is_htf_valid
alertcondition(htf_invalid, '⚠️ HTF Invalid', 'Higher timeframe is invalid or not higher than current')

//--------------------------------------------------------------------------------------------------------------------}
/////////////Pivot Channel/.////////
i_pivothigh_len = input.int(21, 'Pivot high length(left, right)', group = 'Pivot points', inline = 'phb')
i_pivothigh_n = input.int(5, 'Max pivot points', group = 'Pivot points', inline = 'phb')
i_pivotlow_len = input.int(21, 'Pivot low  length(left, right)', group = 'Pivot points', inline = 'plb')
i_pivotlow_n = input.int(5, 'Max pivot points', group = 'Pivot points', inline = 'plb')
i_drawpivots = input.bool(true, 'Draw pivot points', group = 'Pivot points')
i_hsource_test = input.source(close, 'Pivot high test source', group = 'Pivot points', tooltip = 'Series that is tested for a high pivot point, if yes takes price from Pivot high source')
i_hsource = input.source(high, 'Pivot high source', group = 'Pivot points')
i_lsource_test = input.source(close, 'Pivot low test source', group = 'Pivot points', tooltip = 'Series that is tested for a low pivot point, if yes takes price from Pivot low source')
i_lsource = input.source(low, 'Pivot low source', group = 'Pivot points')

i_trend_old_method = input.bool(false, 'Use old method to find channel lines', group = 'Trends')
i_htrend_style = input.string(line.style_dashed, 'High trend line style', options = [line.style_dotted, line.style_dashed, line.style_solid, line.style_arrow_both, line.style_arrow_left, line.style_arrow_right], group = 'Trends', inline = 'htr')
i_htrend_width = input.int(2, 'High trend line width', group = 'Trends', inline = 'htr')
i_ltrend_style = input.string(line.style_dashed, 'Low trend line style', options = [line.style_dotted, line.style_dashed, line.style_solid, line.style_arrow_both, line.style_arrow_left, line.style_arrow_right], group = 'Trends', inline = 'ltr')
i_ltrend_width = input.int(2, 'Low trend line width', group = 'Trends', inline = 'ltr')
i_trend_extlen = input.int(5, 'Right channel extension length', group = 'Trends')

i_hcolor = input.color(color.new(#99d31b, 0), 'High color', group = 'Colors', inline = 'clr')
i_lcolor = input.color(color.new(#FA5032, 0), 'Low color', group = 'Colors', inline = 'clr')

i_drawfibs = input.bool(true, 'Enable', group = 'Fibs', inline = 'fiblines')
i_drawfibs_extended = input.bool(false, 'Draw fib lines > 1.618', group = 'Fibs', inline = 'fiblines')
i_fibline_widths = input.int(1, 'Fib line widths', group = 'Fibs')
i_fibline_styles = input.string(line.style_dotted, 'Fib lines style', options = [line.style_dotted, line.style_dashed, line.style_solid, line.style_arrow_both, line.style_arrow_left, line.style_arrow_right], group = 'Fibs')

interp(l, h, s) =>
    l + (h - l) * s

type PivotPoint
    float price
    int index

var high_pivots = array.new<PivotPoint>()
var low_pivots = array.new<PivotPoint>()

ph = ta.pivothigh(i_hsource_test, i_pivothigh_len, i_pivothigh_len)
if bool(ph)
    if array.size(high_pivots) >= i_pivothigh_n
        array.shift(high_pivots)
    array.push(high_pivots, PivotPoint.new(i_hsource[i_pivothigh_len], bar_index[i_pivothigh_len]))

pl = ta.pivotlow(i_lsource_test, i_pivotlow_len, i_pivotlow_len)
if bool(pl)
    if array.size(low_pivots) >= i_pivotlow_n
        array.shift(low_pivots)
    array.push(low_pivots, PivotPoint.new(i_lsource[i_pivotlow_len], bar_index[i_pivotlow_len]))

var low_trend = line(na)
var high_trend = line(na)
var labels = array.new_label()

while array.size(labels) > 0
    label.delete(array.shift(labels))

// Extracted the two structurally-parallel high/low pivot-channel blocks into one
// helper. Every per-side difference is preserved via cmpIsHigh / ext_src /
// min_sentinel — including the load-bearing old-method sentinel (1e7 for high vs
// 1e5 for low), the direction of the old-method (lp > high vs lp < low), the count
// comparison (>= vs <=), and the tie-break direction. The side-specific label push
// and the distinct persistent var lines (high_trend/low_trend) stay in the callers
// so their line histories remain independent.
pivot_channel(array<PivotPoint> pivots, color col, bool cmpIsHigh, float ext_src, float min_sentinel) =>
    result = line(na)
    tmp = array.new_line()
    for i = 0 to array.size(pivots) - 1 by 1
        for j = i to array.size(pivots) - 1 by 1
            if i != j
                PivotPoint pp0 = array.get(pivots, i)
                PivotPoint pp1 = array.get(pivots, j)
                array.push(tmp, line.new(pp0.index, pp0.price, pp1.index, pp1.price, color = col, width = 1, style = line.style_dashed))

    best_ind = int(na)
    if i_trend_old_method
        min_val = min_sentinel
        for i = 0 to array.size(tmp) - 1 by 1
            lp = line.get_price(array.get(tmp, i), bar_index)
            cond = cmpIsHigh ? lp > high : lp < low
            if cond
                if min_val > math.abs(lp - close)
                    min_val := math.abs(lp - close)
                    best_ind := i
    else
        best_cnt = 0
        for i = 0 to array.size(tmp) - 1 by 1
            trend = array.get(tmp, i)
            cnt = 0

            for pivot in pivots
                matchp = cmpIsHigh ? line.get_price(trend, pivot.index) >= pivot.price : line.get_price(trend, pivot.index) <= pivot.price
                if matchp
                    cnt := cnt + 1

            if cnt > best_cnt
                best_cnt := cnt
                best_ind := i

            if cnt == best_cnt
                tie = cmpIsHigh ? (line.get_price(array.get(tmp, best_ind), bar_index + 1) > line.get_price(trend, bar_index + 1) and line.get_price(trend, bar_index + 1) > ext_src) : (line.get_price(array.get(tmp, best_ind), bar_index + 1) < line.get_price(trend, bar_index + 1) and line.get_price(trend, bar_index + 1) < ext_src)
                if tie
                    best_cnt := cnt
                    best_ind := i

    if not na(best_ind)
        result := array.get(tmp, best_ind)
        array.remove(tmp, best_ind)

    while array.size(tmp) > 0
        line.delete(array.shift(tmp))
    result

if array.size(high_pivots) > 1
    if i_drawpivots
        for pivot in high_pivots
            array.push(labels, label.new(pivot.index, pivot.price, '', style = label.style_label_down, size = size.tiny, color = color.new(#99d31b, 70)))
    high_chosen = pivot_channel(high_pivots, i_hcolor, true, i_hsource, 10000000.0)
    if not na(high_chosen)
        line.delete(high_trend)
        high_trend := high_chosen

if array.size(low_pivots) > 1
    if i_drawpivots
        for pivot in low_pivots
            array.push(labels, label.new(pivot.index, pivot.price, '', style = label.style_label_up, size = size.tiny, color = color.new(#FA5032, 70)))
    low_chosen = pivot_channel(low_pivots, i_lcolor, false, i_lsource, 100000.0)
    if not na(low_chosen)
        line.delete(low_trend)
        low_trend := low_chosen

if not na(low_trend) and not na(high_trend)
    for l in labels
        if label.get_x(l) == line.get_x1(low_trend) or label.get_x(l) == line.get_x2(low_trend)
            label.set_color(l, color.new(#FA5032, 0))
    line.set_y2(low_trend, line.get_price(low_trend, bar_index + i_trend_extlen))
    line.set_x2(low_trend, bar_index + i_trend_extlen)
    line.set_width(low_trend, i_ltrend_width)
    line.set_style(low_trend, i_ltrend_style)
    if line.get_x1(high_trend) > line.get_x1(low_trend)
        line.set_y1(high_trend, line.get_price(high_trend, line.get_x1(low_trend)))
        line.set_x1(high_trend, line.get_x1(low_trend))

    for l in labels
        if label.get_x(l) == line.get_x1(high_trend) or label.get_x(l) == line.get_x2(high_trend)
            label.set_color(l, color.new(#99d31b, 0))
    line.set_y2(high_trend, line.get_price(high_trend, bar_index + i_trend_extlen))
    line.set_x2(high_trend, bar_index + i_trend_extlen)
    line.set_width(high_trend, i_htrend_width)
    line.set_style(high_trend, i_htrend_style)
    if line.get_x1(low_trend) > line.get_x1(high_trend)
        line.set_y1(low_trend, line.get_price(low_trend, line.get_x1(high_trend)))
        line.set_x1(low_trend, line.get_x1(high_trend))

var fibs = array.new_line()

while array.size(fibs) > 0
    line.delete(array.shift(fibs))

if not na(high_trend) and not na(low_trend) and barstate.islast and i_drawfibs
    left = line.get_x1(low_trend)
    right = bar_index + i_trend_extlen
    // Hoisted the four per-bar-constant line.get_price reads out of the 7-10 copy-pasted
    // blocks and looped over the ratio list. Push order and values are identical.
    lp_ll = line.get_price(low_trend, left)
    lp_hl = line.get_price(high_trend, left)
    lp_lr = line.get_price(low_trend, right)
    lp_hr = line.get_price(high_trend, right)
    ratios = i_drawfibs_extended ? array.from(-0.618, 0.236, 0.382, 0.5, 0.618, 0.75, 1.618, 2.618, 3.618, 4.236) : array.from(-0.618, 0.236, 0.382, 0.5, 0.618, 0.75, 1.618)
    for s in ratios
        lv = interp(lp_ll, lp_hl, s)
        rv = interp(lp_lr, lp_hr, s)
        array.push(fibs, line.new(left, lv, right, rv, style = i_fibline_styles, width = i_fibline_widths, color = color.from_gradient(rv, lp_lr, lp_hr, i_lcolor, i_hcolor)))

//////Moving Averages/////////////
outC = ta.sma(close, 50)
outD = ta.sma(close, 100)
outE = ta.sma(close, 200)

plot(outC, color = color.lime, linewidth = 2, title = 'SMA(50)')
plot(outD, color = color.rgb(230, 123, 0), linewidth = 2, title = 'SMA(100)')
plot(outE, color = color.rgb(229, 20, 177), linewidth = 2, title = 'SMA(200)')

/////////CVD//////
g = 'CVD Histogram Settings'

CumMode = input.string('EMA', 'Cumulative Mode', ['Total', 'Periodic', 'EMA'], group = g)
Period = input.int(21, 'Period', group = g)
UltraData = input.bool(false, '', inline = 'Data', group = g)
Market = input.string('Forex', 'Market Ultra Data', options = ['Forex', 'Crypto', 'Stock'], inline = 'Data', group = g)

Transparency = input.int(0, 'Plot Transparency', minval = 0, maxval = 100, group = g)
UseNormalized = input.bool(false, 'Use Normalized Values (-50 to +50)', group = g)
NormalizePeriod = input.int(100, 'Normalization Period', minval = 10, maxval = 500, group = g)

h = input.bool(true, 'Show Histogram', group = g)
oscPlacement = input.string('Bottom', '', options = ['Top', 'Bottom'], inline = 'VOL', group = g)
oscHight = 21 - input.int(7, ' Hight', minval = 1, maxval = 10, inline = 'VOL', group = g) * 2
lookbackLength = input.int(200, 'Overlay Indicator Display Length', minval = 10, maxval = 495, group = g)

// Optimized API Calls: Reduced from 26 to 3 conditional calls
Vsum = 0.0
if UltraData
    if Market == 'Forex'
        V1 = nz(request.security('FX:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V2 = nz(request.security('OANDA:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V3 = nz(request.security('FOREXCOM:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        Vsum := V1 + V2 + V3
    else if Market == 'Crypto'
        V1 = nz(request.security('BITSTAMP:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V2 = nz(request.security('COINBASE:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        V3 = nz(request.security('BINANCE:' + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true))
        Vsum := V1 + V2 + V3

Volume = UltraData ? Vsum : volume

Buying = Volume * ((close - low) / (high - low))
Selling = Volume * ((high - close) / (high - low))

delta = Buying - Selling

Cumulative = if CumMode == 'Total'
    ta.cum(delta)
else if CumMode == 'Periodic'
    math.sum(delta, Period)
else if CumMode == 'EMA'
    ta.ema(delta, Period)

PercentRank = ta.percentrank(Cumulative, NormalizePeriod)
NormalizedCumulative = PercentRank - 50

cvdHistogram = UseNormalized ? NormalizedCumulative : Cumulative

var a_lines = array.new_line()
var a_fill = array.new_linefill()

priceHighest = ta.highest(high, lookbackLength)
priceLowest = ta.lowest(low, lookbackLength)

cvdHighest = ta.highest(cvdHistogram, lookbackLength)
cvdLowest = ta.lowest(cvdHistogram, lookbackLength)
cvdMaxAbs = math.max(math.abs(cvdHighest), math.abs(cvdLowest))

cvdColor = cvdHistogram >= 0 ? (cvdHistogram[1] < cvdHistogram ? color.new(#006400, Transparency) : color.new(color.green, Transparency)) : (cvdHistogram[1] < cvdHistogram ? color.new(color.red, Transparency) : color.new(#910000, Transparency))

if barstate.islast and h
    if array.size(a_lines) > 0
        for i = 1 to array.size(a_lines) by 1
            line.delete(array.shift(a_lines))

    if array.size(a_fill) > 0
        for i = 1 to array.size(a_fill) by 1
            linefill.delete(array.shift(a_fill))

    priceChangeRate = (priceHighest - priceLowest) / priceHighest / oscHight

    for barIndex = 0 to lookbackLength - 1 by 1
        cvdValue = cvdHistogram[barIndex]
        basePrice = oscPlacement == 'Top' ? priceHighest : priceLowest

        endPrice = if cvdMaxAbs > 0
            basePrice * (1 + cvdValue / cvdMaxAbs * priceChangeRate)
        else
            basePrice

        array.push(a_lines, line.new(x1 = bar_index[barIndex], y1 = basePrice, x2 = bar_index[barIndex], y2 = endPrice, xloc = xloc.bar_index, extend = extend.none, color = cvdColor[barIndex], style = line.style_solid, width = 2))

//////volume profile/////
var string t1  = "Number of historical bars used to build the volume profile and zero-volume gaps.\nHigher = smoother, more stable profile but heavier on performance."
var string t2  = "Number of price rows (bins) between the highest and lowest price in the lookback range.\nHigher = more detailed profile, lower = more compact."
var string t3  = "Price source used when assigning each bar to a price row in the profile (e.g. HLC3, Close)."
var string t4  = "Horizontal width in bars for the main volume profile drawn to the right of price."
var string t5  = "Fill color for the bullish portion of each price row (bars where Close > Open)."
var string t6  = "Fill color for the bearish portion of each price row (bars where Close <= Open)."
var string t7  = "Background color used to highlight zero-volume price gaps (no traded volume in that row)."
var string t8  = "Number of stacked sections in the delta panel.\nEach section aggregates Buy/Sell delta for a vertical slice of the full profile."
var string t9  = "Horizontal width in bars of the delta summary panel."
var string t10 = "Horizontal gap, in bars, between the main volume profile and the delta panel."
var string t11 = "Show or hide the Δ (delta) percentage text inside each delta bar."
var string t12 = "Color used when delta is positive in a section (Buy volume > Sell volume)."
var string t13 = "Color used when delta is negative in a section (Sell volume > Buy volume)."
var string t14 = "Background color of the delta panel and neutral areas when there is little or no delta."
var string t15 = "Text color for the Δ percentage labels inside the delta bars."
var string t16 = "Minimum visual size of any non-zero delta bar as a fraction of the panel width.\nUse a larger value to keep small deltas visible."

prd         = input.int(200, "Lookback", minval = 50, maxval = 2000, tooltip = t1, group = "Profile Settings")
rows        = input.int(50, "Rows", minval = 10, maxval = 100, inline = "a", tooltip = t2, group = "Profile Settings")
src         = input.source(hlc3, "", inline = "a", tooltip = t1 + "\n\n" + t2 + "\n\n" + t3, group = "Profile Settings")

width       = input.int(100, "Profile Placement", minval = 1, maxval = 500, tooltip = t4, group = "Profile Styling")
bull_color  = input.color(color.new(color.blue, 30), "Bull Color", inline = "prof_set", tooltip = t5, group = "Profile Styling")
bear_color  = input.color(color.new(color.orange, 30), "Bear Color", inline = "prof_set", tooltip = t6, group = "Profile Styling")
zone_color  = input.color(color.new(color.navy, 50), "Zero-Volume Zone", inline = "prof_set", tooltip = t5 + "\n\n" + t6 + "\n\n" + t7, group = "Profile Styling")

sum_sections   = input.int(20, "Summary Sections", minval = 1, maxval = 100, tooltip = t8, group = "Delta Summary")
sum_panel_w    = input.int(40, "Summary Width", minval = 10, maxval = 200, tooltip = t9, group = "Delta Summary")
sum_gap_x      = input.int(4,  "Gap From Profile", minval = 1, maxval = 50, tooltip = t10, group = "Delta Summary")
sum_show_label = input.bool(true, "Show Delta Text", tooltip = t11, group = "Delta Summary")

delta_pos_color  = input.color(color.new(color.lime, 20), "Delta Buy Color", tooltip = t12, group = "Delta Styling")
delta_neg_color  = input.color(color.new(color.red,  20), "Delta Sell Color", tooltip = t13, group = "Delta Styling")
delta_neutral_bg = input.color(color.new(color.gray, 90), "Delta Neutral BG", tooltip = t14, group = "Delta Styling")
delta_text_color = input.color(color.white, "Delta Text Color", tooltip = t15, group = "Delta Styling")
delta_min_frac   = input.float(0.2, "Delta Min Size (fraction of width)", minval = 0.0, maxval = 1.0, step = 0.1, tooltip = t16, group = "Delta Styling")

b = bar_index

lvls        = array.new<float>()
bull_vols   = array.new<float>()
bear_vols   = array.new<float>()
zone        = array.new<box>()

hi = ta.highest(high, prd)
lo = ta.lowest(low, prd)

if barstate.islast
    for e in box.all
        e.delete()
    for l in label.all
        label.delete(l)

    box.new(
         chart.point.from_index(b-prd,hi),
         chart.point.from_index(b+width,lo),
         color.new(chart.fg_color,50),
         2,
         line.style_dotted,
         bgcolor = color(na)
     )

    step = (hi - lo) / rows
    for i = lo to hi by step
        lvls.push(i)
        bull_vols.push(0.0)
        bear_vols.push(0.0)

    // Optimized Binning: Eliminated inner loop
    for i = prd to 0
        price   = src[i]
        is_bull = close[i] > open[i]
        idx = math.floor((price - lo) / step)
        idx := math.max(0, math.min(idx, rows - 1))
        if is_bull
            bull_vols.set(idx, bull_vols.get(idx) + volume[i])
        else
            bear_vols.set(idx, bear_vols.get(idx) + volume[i])

    maxVol = 0.0
    for i = 0 to lvls.size() - 2
        vol_i = bull_vols.get(i) + bear_vols.get(i)
        if vol_i > maxVol
            maxVol := vol_i

    for i = 0 to lvls.size() - 2
        bull_i = bull_vols.get(i)
        bear_i = bear_vols.get(i)
        vol_i  = bull_i + bear_i
        norm_v = maxVol > 0 ? math.round((vol_i / maxVol) * width) : 0

        if norm_v > 0
            norm_bull  = bull_i > 0 ? math.round((bull_i / vol_i) * norm_v) : 0
            norm_bear  = norm_v - norm_bull
            left_start = b + width - norm_v

            if norm_bull > 0
                box.new(
                     left   = left_start,
                     top    = lvls.get(i + 1),
                     right  = left_start + norm_bull,
                     bottom = lvls.get(i),
                     border_color = color.new(chart.fg_color,90),
                     bgcolor = bull_color
                 )

            if norm_bear > 0
                box.new(
                     left   = left_start + norm_bull,
                     top    = lvls.get(i + 1),
                     right  = b + width,
                     bottom = lvls.get(i),
                     border_color = color.new(chart.fg_color,90),
                     bgcolor = bear_color
                 )

        if vol_i == 0
            zeroBox = box.new(
                 left   = b - prd,
                 top    = lvls.get(i + 1),
                 right  = b,
                 bottom = lvls.get(i),
                 border_color = na,
                 bgcolor = zone_color
             )
            zone.push(zeroBox)

    if zone.size() > 1
        i = 0
        while i < zone.size()
            currentBox = zone.get(i)
            currentTop = currentBox.get_top()

            j = i + 1
            while j < zone.size()
                nextBox = zone.get(j)
                if math.abs(nextBox.get_bottom() - currentTop) > 1e-10
                    break
                currentTop := nextBox.get_top()
                j += 1

            chainLength = j - i

            if chainLength > 1
                firstBox = zone.get(i)
                lastBox  = zone.get(j - 1)

                mergedBox = box.new(
                     left   = b - prd,
                     top    = lastBox.get_top(),
                     right  = b,
                     bottom = firstBox.get_bottom(),
                     border_color = na,
                     bgcolor = zone_color
                 )

                for k = j - 1 to i by 1
                    boxToDelete = zone.get(k)
                    boxToDelete.delete()
                    zone.remove(k)

                zone.insert(i, mergedBox)
                i += 1
            else
                i += 1
    
    if zone.size()>0
        float epsilon = 1e-10
        for ii = 0 to zone.size() - 1
            currentBox = zone.get(ii)
            ztop = currentBox.get_top()
            zbot = currentBox.get_bottom()
            left_idx = b - prd
            for off = prd to 0 by 1
                if low[off] <= ztop + epsilon and high[off] >= zbot - epsilon or
                   high[off] >= zbot - epsilon and low[off] <= zbot + epsilon or
                   low[off] <= zbot + epsilon and high[off] >= ztop - epsilon
                    left_idx := b - off
                    break
            currentBox.set_left(left_idx)

    lvlCount = lvls.size()
    rowsUsed = lvlCount > 0 ? lvlCount - 1 : 0

    if rowsUsed > 0 and sum_sections > 0
        secRows = math.max(1, math.floor(rowsUsed / sum_sections))

        baseLeft  = b + width + sum_gap_x
        baseRight = baseLeft + sum_panel_w

        for s = 0 to sum_sections - 1
            startIdx = s * secRows
            endIdx   = s == sum_sections - 1 ? rowsUsed - 1 : math.min(rowsUsed - 1, (s + 1) * secRows - 1)

            if startIdx > endIdx
                continue

            segBull = 0.0
            segBear = 0.0

            for j = startIdx to endIdx
                segBull += bull_vols.get(j)
                segBear += bear_vols.get(j)

            segTot = segBull + segBear
            if segTot <= 0
                continue

            segTop    = lvls.get(endIdx + 1)
            segBottom = lvls.get(startIdx)

            box.new(
                 left   = baseLeft,
                 top    = segTop,
                 right  = baseRight,
                 bottom = segBottom,
                 border_color = color.new(chart.fg_color, 70),
                 bgcolor = delta_neutral_bg
             )

            deltaPct = (segBull - segBear) / segTot * 100.0

            float barLenFrac = 0.0
            float barLen     = 0.0

            if deltaPct != 0
                norm       = math.abs(deltaPct) / 100.0
                barLenFrac := math.max(delta_min_frac, math.min(1.0, norm))
                barLen     := sum_panel_w * barLenFrac
            else
                barLenFrac := 0.0
                barLen     := 0.0

            float dLeft  = baseLeft
            float dRight = baseLeft + barLen

            colDelta = delta_neutral_bg
            if deltaPct > 0
                colDelta := delta_pos_color
            else if deltaPct < 0
                colDelta := delta_neg_color

            if deltaPct == 0
                dRight := baseLeft + 1

            deltaBox = box.new(
                 left   = int(math.round(dLeft)),
                 top    = segTop,
                 right  = int(math.round(dRight)),
                 bottom = segBottom,
                 border_color = color.new(chart.fg_color, 20),
                 bgcolor = colDelta
             )

            if sum_show_label
                txt = "Δ " + str.tostring(deltaPct, "#.0") + "%"
                box.set_text(deltaBox, txt)
                box.set_text_color(deltaBox, delta_text_color)
                box.set_text_halign(deltaBox, text.align_center)
                box.set_text_valign(deltaBox, text.align_center)

// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © AlgoAlpha

clear = input.int(5000, 'Remove Levels After x Bars', group = 'Main Settings', tooltip = 'How many bars after the fixed levels are considered irrelevant')
len = input.int(200, 'Clustering Training Length', group = 'Main Settings', tooltip = 'The lookback window for the maching learning algorithm')
srConfirmLen = input.int(50, 'Confirmation Length for Fixed Levels ', group = 'Main Settings', tooltip = 'The confirmation length for fixed levels')
shw = input.bool(true, 'Show Trailing Levels', group = 'Appearance')
shw1 = input.bool(true, 'Show Fixed Levels', group = 'Appearance')
collvls = input.bool(false, 'Color Fixed Levels', group = 'Appearance', tooltip = 'Colors fixed levels based on whether price is above or below the level. This is computationally intensive so turn off this setting if the indicator is unable to load.')
green = input.color(#00ffbb, 'Bullish Color', group = 'Appearance')
red = input.color(#ff1100, 'Bearish Color', group = 'Appearance')

// Highly Optimized K-Means: Eliminated array allocations inside while loop
k_means_optimize_centroids(value, lookback, init_centroid_1, init_centroid_2, init_centroid_3) =>
    amean = init_centroid_1
    bmean = init_centroid_2
    cmean = init_centroid_3
    
    if nz(value) > 0 and bar_index >= lookback - 1
        converged = false
        iter = 0
        // Reduced iterations from 10 to 5 to prevent timeout
        while not converged and iter < 5
            sum_a = 0.0
            cnt_a = 0
            sum_b = 0.0
            cnt_b = 0
            sum_c = 0.0
            cnt_c = 0
            
            for i = lookback - 1 to 0 by 1
                val = value[i]
                dist_a = math.abs(val - amean)
                dist_b = math.abs(val - bmean)
                dist_c = math.abs(val - cmean)
                
                if dist_a <= dist_b and dist_a <= dist_c
                    sum_a += val
                    cnt_a += 1
                else if dist_b <= dist_a and dist_b <= dist_c
                    sum_b += val
                    cnt_b += 1
                else
                    sum_c += val
                    cnt_c += 1
            
            new_amean = cnt_a > 0 ? sum_a / cnt_a : amean
            new_bmean = cnt_b > 0 ? sum_b / cnt_b : bmean
            new_cmean = cnt_c > 0 ? sum_c / cnt_c : cmean
            
            if new_amean == amean and new_bmean == bmean and new_cmean == cmean
                converged := true
            else
                amean := new_amean
                bmean := new_bmean
                cmean := new_cmean
            iter += 1
            
    [amean, bmean, cmean]

[up, middle, down] = k_means_optimize_centroids(close, len, ta.highest(len), math.avg(ta.highest(len), ta.lowest(len)), ta.lowest(len))

type store
    line lvl
    float src

var array<store> aR = array.new<store>()
var array<store> aM = array.new<store>()
var array<store> aS = array.new<store>()

up_cluster = 0
middle_cluster = 0
down_cluster = 0

// FIX: Changed ta.atR to ta.atr
volatility = ta.atr(14)
anti_cluster_mult = 1

// Extracted the three byte-identical aR/aM/aS cluster-check blocks into one helper.
// The `arr.size() > 0` guard is kept INSIDE the function: Pine auto-detects loop
// direction, so `for i = 0 to arr.size()-1` on an empty array would count down and
// read arr.get(0) out of bounds. Arrays pass by reference (read-only here); flags
// only accumulate to 1, so combining with math.max reproduces the original OR exactly.
check_cluster(array<store> arr, float up, float middle, float down, float vol, float mult) =>
    int uc = 0
    int mc = 0
    int dc = 0
    if arr.size() > 0
        for i = 0 to arr.size() - 1 by 1
            price = arr.get(i).src
            if up > price - vol * mult and up < price + vol * mult
                uc := 1
                break
            if middle > price - vol * mult and middle < price + vol * mult
                mc := 1
                break
            if down > price - vol * mult and down < price + vol * mult
                dc := 1
                break
    [uc, mc, dc]

[uc1, mc1, dc1] = check_cluster(aR, up, middle, down, volatility, anti_cluster_mult)
[uc2, mc2, dc2] = check_cluster(aM, up, middle, down, volatility, anti_cluster_mult)
[uc3, mc3, dc3] = check_cluster(aS, up, middle, down, volatility, anti_cluster_mult)
up_cluster     := math.max(uc1, uc2, uc3)
middle_cluster := math.max(mc1, mc2, mc3)
down_cluster   := math.max(dc1, dc2, dc3)

if up == up[srConfirmLen] and up_cluster != 1 and shw1
    aR.push(store.new(line.new(bar_index, up, bar_index + 1, up, color = chart.fg_color, extend = extend.right, width = 3), up))

if middle == middle[srConfirmLen] and middle_cluster != 1 and shw1
    aM.push(store.new(line.new(bar_index, middle, bar_index + 1, middle, color = chart.fg_color, extend = extend.right, width = 3), middle))

if down == down[srConfirmLen] and down_cluster != 1 and shw1
    aS.push(store.new(line.new(bar_index, down, bar_index + 1, down, color = chart.fg_color, extend = extend.right, width = 3), down))

// Extracted the three byte-identical aR/aM/aS trailing-level maintenance blocks
// into one helper. Arrays pass by reference so shift/delete/set_* mutate the
// caller's array; the three var arrays keep independent persistent state.
maintain_levels(array<store> arr, int clearN, bool colOn, color colUp, color colDn) =>
    if arr.size() > 0
        qt = arr.size()
        for ln = qt - 1 to 0 by 1
            if ln < arr.size()
                cL = arr.get(ln)
                yL = cL.lvl.get_x1()
                vert = cL.lvl.get_y1()

                if bar_index - yL > clearN
                    arr.shift().lvl.delete()
                else
                    cL.lvl.set_x2(bar_index + 1)

                if close > vert and colOn
                    cL.lvl.set_color(colUp)
                else if colOn
                    cL.lvl.set_color(colDn)

        while arr.size() > 500
            arr.shift().lvl.delete()

maintain_levels(aR, clear, collvls, green, red)
maintain_levels(aM, clear, collvls, green, red)
maintain_levels(aS, clear, collvls, green, red)

u = plot(up, 'Upper', color.new(green, 50), display = shw ? display.all : display.none)
m = plot(middle, 'Middle', color.new(color.blue, 50), display = shw ? display.all : display.none)
l = plot(down, 'Lower', color.new(red, 50), display = shw ? display.all : display.none)

fill(u, m, up, middle, color.new(green, 90), color.new(color.blue, 90), display = shw ? display.all : display.none)
fill(l, m, middle, down, color.new(color.blue, 90), color.new(red, 90), display = shw ? display.all : display.none)


//////////-------------------------------------------------------------------------------------------------------------------------------------------------\


// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

// Group: Core Settings
var string G_CORE = "Core Settings"
source        = input.source(hl2, 'Source', group = G_CORE, tooltip = 'The price data used to calculate the regression channel (e.g., Close, Open, HL2).')
length        = input.int(200, 'Period', 2, group = G_CORE, tooltip = 'The number of bars back used to calculate the regression fit window.')
degree_       = input.string("Polynomial", "Regression Mode", ["Linear", "Polynomial"], group = G_CORE, tooltip = 'Choose between a straight trendline (Linear) or a curved trendline (Polynomial).') == "Linear"

// Group: Grid & Profile Settings
var string G_GRID = "Grid & Profile Settings"
num_bins      = input.int(20, 'Grid Rows Each Side', 5, group = G_GRID, tooltip = 'The number of parallel channel levels plotted above and below the center line.')
profile_width_pct = input.int(20, 'Max Profile Width (% of Period)', 5, 50, group = G_GRID, tooltip = 'Controls how far back across the channel the volume profile lines can stretch horizontally.')

// Group: Trend Colors & POC Settings
var string G_COLOR = "POC Settings"
showPoc       = input.bool(true, "Show POC Line", inline = "poc_cfg", group = G_COLOR, tooltip = 'Toggle to show or hide the full-length Point of Control line matrix.')
pocColor      = input.color(color.rgb(255, 166, 0), "", inline = "poc_cfg", group = G_COLOR, tooltip = 'Color assigned to the Point of Control (highest volume zone) line.')
pocWidth      = input.int(2, "", minval = 1, maxval = 10, inline = "poc_cfg", group = G_COLOR, tooltip = 'Line thickness/width for the full-width Point of Control line.')

// Group: Standard Deviation Channel Settings
var string G_SD    = "Standard Deviation Levels"
showSd        = input.bool(true, "Show SD Levels", inline = "sd_toggle", group = G_SD, tooltip = 'Toggle to show or hide the Standard Deviation line channels and labels.')
sdColor       = input.color(color.rgb(99, 122, 120, 10), "", inline = "sd_toggle", group = G_SD, tooltip = 'Color choice assigned exclusively to the Standard Deviation grid bounds.')
sdStyle_      = input.string("Dashed", "SD Line Style", ["Solid", "Dashed", "Dotted"], group = G_SD, tooltip = 'Select visual line pattern for tracking standard deviations.')
sdWidth       = input.int(1, "SD Line Width", minval = 1, maxval = 5, group = G_SD, tooltip = 'Set structural width parameters for standard deviation bands.')

// Group: Volume Profile Gradient Colors
var string G_GRAD = "Volume Profile Gradient Colors"
profMidColor1  = input.color(color.blue, "Bullish/Bearish", inline = "prof_cols", group = G_GRAD, tooltip = 'Color used for low-tier volume areas.')
profMidColor2  = input.color(color.orange, "", inline = "prof_cols", group = G_GRAD, tooltip = 'Color used for middle-tier volume areas.')
profMidColor   = input.color(color.rgb(175, 43, 43, 63), "Low Volume", inline = "prof_cols", group = G_GRAD, tooltip = 'Color used for middle-tier volume areas.')

// Group: Style & UI Settings
var string G_STYLE = "Style & UI Settings"
baseStyle_    = input.string("Dashed", "Baseline Style", ["Solid", "Dashed", "Dotted"], group = G_STYLE, tooltip = 'Line style for the central trend baseline.')
gridStyle_    = input.string("Dotted", "Grid Lines Style", ["Solid", "Dashed", "Dotted"], group = G_STYLE, tooltip = 'Line style for the upper and lower boundary channels.')
pocStyle_     = input.string("Solid", "POC Line Style", ["Solid", "Dashed", "Dotted"], group = G_STYLE, tooltip = 'Line style for the full-width Point of Control line.')
dashSize_     = input.string("Normal", "Dashboard Size", ["Auto", "Small", "Normal", "Large"], group = G_STYLE, tooltip = 'Changes the visual size of the information dashboard text and cell boundaries.')

// Helper function to map text selections to native line style properties
getLineStyle(styleText) =>
    switch styleText
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// Helper function to map text selections to native table text sizes
getDashSize(sizeText) =>
    switch sizeText
        "Auto"   => size.auto
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal

string baseStyle = getLineStyle(baseStyle_)
string gridStyle = getLineStyle(gridStyle_)
string pocStyle  = getLineStyle(pocStyle_)
string sdStyle   = getLineStyle(sdStyle_)
string dashSize  = getDashSize(dashSize_)

// }
// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

degree = degree_ ? 1 : 2

polyreg(source, length, degree) =>
    if barstate.islast
        X_all = matrix.new<float>(length, degree + 1, 0.0)
        for i = 0 to length - 1
            for j = 0 to degree
                matrix.set(X_all, i, j, math.pow(i, j))

        // y (length × 1), oldest → newest over the fit window
        y = matrix.new<float>(length, 1, 0.0)
        for i = 0 to length - 1
            matrix.set(y, i, 0, source[length - 1 - i])

        // OLS via normal equations: b = (X'X)^(-1) X'y
        Xt      = matrix.transpose(X_all)   
        XtX     = matrix.mult(Xt, X_all)     
        Xty     = matrix.mult(Xt, y)        
        XtX_inv = matrix.inv(XtX)          
        b       = matrix.mult(XtX_inv, Xty) 

        // Predictions for the historical fit window
        preds = matrix.mult(X_all, matrix.col(b, 0))    
        preds

// Calculate baseline predictions
predictions = polyreg(source, length, degree)

// Determine 1 Standard Deviation 
stdev_val = ta.stdev(source, length)

// Scale calculation step sizes so 3 SD boundary matches max outer channel constraint
dev = (stdev_val * 3) / num_bins

float[] bin_volumes = array.new<float>(num_bins * 2, 0.0)
float max_vol = 0.0

// }
// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

var polyline[] active_lines = array.new<polyline>()
var label lbl_poc_high = na
var label lbl_chan_high = na
var label lbl_chan_low  = na
var label[] sd_labels = array.new<label>()
var table info_dash     = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_color=chart.bg_color, border_width=2)
var color mainCol = na

// Helper function to paint regression layers
drawGridLayer(offset_ticks, is_baseline, up_col, dn_col, b_sty, g_sty) =>
    grid_points = array.new<chart.point>()
    
    int pred_size = array.size(predictions)
    if pred_size > 0
        for i = 0 to pred_size - 1
            base_p = array.get(predictions, i)
            target_p = base_p + offset_ticks
            grid_points.push(chart.point.from_index(bar_index + i - length + 1, target_p))
        
        int line_w  = is_baseline ? 2 : 1
        string sty = is_baseline ? b_sty : g_sty
        color clr  = is_baseline ? (array.get(predictions, pred_size - 1) > array.get(predictions, 0) ? up_col : dn_col) : color.new(chart.fg_color, 90)
        
        array.push(active_lines, polyline.new(grid_points, line_width = line_w, line_style = sty, line_color = is_baseline ? chart.fg_color : clr))
        clr
    else
        color(na)

// Helper function to paint tracking SD curved polylines
drawSdLine(multiplier, clr, sty, wdt) =>
    int pred_size = array.size(predictions)
    if pred_size > 0
        sd_points = array.new<chart.point>()
        for idx = 0 to pred_size - 1
            base_p = array.get(predictions, idx)
            sd_points.push(chart.point.from_index(bar_index + idx - length + 1, base_p + (multiplier * stdev_val)))
        if array.size(sd_points) > 1
            array.push(active_lines, polyline.new(sd_points, line_width = wdt, line_style = sty, line_color = clr))

// Wrap calculations strictly when array exists and contains data
if barstate.islast and not na(predictions)
    int pred_size = array.size(predictions)
    
    // 1. Calculate profile distributions safely
    array.fill(bin_volumes, 0.0)
    for i = 0 to length - 1
        int lookup_idx = math.min(i, pred_size - 1)
        curr_close = source[length - 1 - lookup_idx]
        base_pred  = array.get(predictions, lookup_idx)
        
        float diff = curr_close - base_pred
        int bin_index = math.floor(diff / dev) + num_bins
        
        if bin_index >= 0 and bin_index < num_bins * 2
            array.set(bin_volumes, bin_index, array.get(bin_volumes, bin_index) + nz(volume[length - 1 - lookup_idx]))

    max_vol := array.max(bin_volumes)
    
    // Find the Bin Index that contains the Maximum Volume (POC Bin)
    int poc_bin_idx = array.indexof(bin_volumes, max_vol)

    // Clear old dynamic elements safely
    if array.size(active_lines) > 0
        for p in active_lines
            polyline.delete(p)
        array.clear(active_lines)
        
    label.delete(lbl_poc_high)
    label.delete(lbl_chan_high)
    label.delete(lbl_chan_low)
    
    if array.size(sd_labels) > 0
        for lbl in sd_labels
            label.delete(lbl)
        array.clear(sd_labels)

    // 2. Draw Grid Channels with user style selections
    mainCol := drawGridLayer(0.0, true, profMidColor1, profMidColor2, baseStyle, gridStyle) 

    for step = 1 to num_bins
        drawGridLayer(step * dev, false, profMidColor1, profMidColor2, baseStyle, gridStyle)  
        drawGridLayer(-step * dev, false, profMidColor1, profMidColor2, baseStyle, gridStyle) 

    // 3. Draw standard deviation paths conforming directly to channel trends
    if showSd
        drawSdLine(1.0, sdColor, sdStyle, sdWidth)
        drawSdLine(-1.0, sdColor, sdStyle, sdWidth)
        drawSdLine(2.0, sdColor, sdStyle, sdWidth)
        drawSdLine(-2.0, sdColor, sdStyle, sdWidth)
        drawSdLine(3.0, sdColor, sdStyle, sdWidth)
        drawSdLine(-3.0, sdColor, sdStyle, sdWidth)

    // Determine general trend slope (Comparing last prediction point to the first)
    bool is_bullish = array.get(predictions, pred_size - 1) > array.get(predictions, 0)

    // Variables for calculation storage
    float y_high = 0.0
    string vol_str = str.tostring(max_vol, format.volume)

    // 4. Draw the full-length POC Line Matrix with user line styles
    if poc_bin_idx >= 0 and pred_size > 0
        float poc_offset = (poc_bin_idx - num_bins) * dev
        y_high := array.get(predictions, pred_size - 1) + poc_offset
        
        if showPoc
            poc_points = array.new<chart.point>()
            for idx = 0 to length - 1
                int safe_idx = math.min(idx, pred_size - 1)
                base_p = array.get(predictions, safe_idx)
                poc_points.push(chart.point.from_index(bar_index + safe_idx - length + 1, base_p + poc_offset))
                
            if array.size(poc_points) > 1
                array.push(active_lines, polyline.new(poc_points, line_width = pocWidth, line_style = pocStyle, line_color = pocColor))
            
        // 5. Generate dynamic High POC boundary label containing volume format string
        int x_high   = bar_index
        lbl_poc_high := label.new(x_high, y_high, "<- POC  Vol: " + vol_str, color=color.new(pocColor, 20), textcolor=chart.fg_color, style=label.style_label_left)

    // 6. Draw Channel High/Low Price labels on the last bar
    float chan_high_y = 0.0
    float chan_low_y  = 0.0
    if pred_size > 0
        chan_high_y := array.get(predictions, pred_size - 1) + (num_bins * dev)
        chan_low_y  := array.get(predictions, pred_size - 1) - (num_bins * dev)
        
        lbl_chan_high := label.new(bar_index, chan_high_y, "Channel High (+3 SD): " + str.tostring(chan_high_y, "#.##"), color=color.new(chart.fg_color, 90), textcolor=chart.fg_color, style=label.style_label_lower_left)
        lbl_chan_low  := label.new(bar_index, chan_low_y, "Channel Low (-3 SD): " + str.tostring(chan_low_y, "#.##"), color=color.new(chart.fg_color, 90), textcolor=chart.fg_color, style=label.style_label_upper_left)

        // Add standard deviation context data flags on historical terminal print instances
        if showSd
            float last_pred = array.get(predictions, pred_size - 1)
            array.push(sd_labels, label.new(bar_index, last_pred + (1 * stdev_val), "+1 SD", color=color.new(sdColor, 100), textcolor=sdColor, style=label.style_label_left))
            array.push(sd_labels, label.new(bar_index, last_pred - (1 * stdev_val), "-1 SD", color=color.new(sdColor, 100), textcolor=sdColor, style=label.style_label_left))
            array.push(sd_labels, label.new(bar_index, last_pred + (2 * stdev_val), "+2 SD", color=color.new(sdColor, 100), textcolor=sdColor, style=label.style_label_left))
            array.push(sd_labels, label.new(bar_index, last_pred - (2 * stdev_val), "-2 SD", color=color.new(sdColor, 100), textcolor=sdColor, style=label.style_label_left))

    // 7. Update the Information Dashboard Table with Custom Size Constants
    // Row 0: Header
    table.cell(info_dash, 0, 0, "Regression Matrix", text_color=chart.fg_color, text_size=dashSize, bgcolor=chart.bg_color)
    table.cell(info_dash, 1, 0, "Metrics", text_color=chart.fg_color, text_size=dashSize, bgcolor=chart.bg_color)
    
    // Row 1: Bull/Bear Direction
    table.cell(info_dash, 0, 1, "Direction", text_color=color.white, text_size=dashSize, text_halign=text.align_left)
    table.cell(info_dash, 1, 1, is_bullish ? "Bullish ↗" : "Bearish ↘", text_color=color.white, text_size=dashSize, bgcolor=is_bullish ? profMidColor1 : profMidColor2)
    
    // Row 2: Point of Control Tracking
    table.cell(info_dash, 0, 2, "POC Level", text_color=color.white, text_size=dashSize, text_halign=text.align_left)
    table.cell(info_dash, 1, 2, str.tostring(y_high, "#.##"), text_color=color.yellow, text_size=dashSize)
    
    // Row 3: POC Volume
    table.cell(info_dash, 0, 3, "POC Volume", text_color=color.white, text_size=dashSize, text_halign=text.align_left)
    table.cell(info_dash, 1, 3, vol_str, text_color=color.orange, text_size=dashSize)

    // Row 4: Channel Boundaries
    table.cell(info_dash, 0, 4, "Channel High/Low", text_color=color.white, text_size=dashSize, text_halign=text.align_left)
    table.cell(info_dash, 1, 4, "H: " + str.tostring(chan_high_y, "#.##") + "\nL: " + str.tostring(chan_low_y, "#.##"), text_color=color.white, text_size=dashSize)

    // 8. Draw Fixed & Curved Volume Profile Lines
    if max_vol > 0 and pred_size > 0
        int profile_len = math.round(length * (profile_width_pct / 100.0))

        // DYNAMIC LINE WIDTH CALCULATION:
        int dynamic_bin_width = math.max(1, math.round(150 / num_bins))

        for step = 0 to (num_bins * 2) - 1
            vol_weight = array.get(bin_volumes, step)
            if vol_weight > 0
                int max_line_width = math.round(profile_len * (vol_weight / max_vol))
                int line_start_idx = length - max_line_width
                float bin_offset   = (step - num_bins) * dev
                
                profile_points = array.new<chart.point>()
                
                color colbin = color(na)
                float relative_weight = vol_weight / max_vol
                
                // Interpolate between Mid threshold color and Max threshold color
                colbin := color.from_gradient(relative_weight, 0, 1, profMidColor, mainCol)

                for idx = line_start_idx to length - 1
                    int safe_idx = math.min(idx, pred_size - 1)
                    base_p = array.get(predictions, safe_idx)
                    int target_x = bar_index + safe_idx - length + 1
                    profile_points.push(chart.point.from_index(target_x, base_p + bin_offset))

                if array.size(profile_points) > 1
                    array.push(active_lines, polyline.new(profile_points, line_width = dynamic_bin_width, line_style = line.style_solid, line_color = colbin))

// }

/////////////////////////////////////////////////////////////////////////////////////////////

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

fvgp_period     = input.int(500, "Lookback Period", tooltip = "The number of bars back from the current price to analyze for Fair Value Gaps.")
fvgp_binSize    = input.int(40, "Profile Resolution (Bins)", tooltip = "The number of rows (price levels) the profile is divided into. Higher values create a more detailed but narrower profile.")
fvgp_offset     = input.int(10, "Horizontal Offset", tooltip = "Moves the profile further to the right of the current bar to avoid overlapping price action.")

fvgp_displayFVG = input.bool(true, "Show Fair Value Gaps", tooltip = "When enabled, highlights individual FVG boxes directly on the price chart.")
fvgp_displayPer = input.bool(true, "Show Strength Percentage", tooltip = "Displays the percentage of total gap activity for each price bin.")
fvgp_showPOC    = input.bool(true, "Show Rolling POC Line", tooltip = "Draws a line tracking the price level with the most FVG activity.")

fvgp_DisplayDelta = input.bool(true, "Show Delta Volume", tooltip = "Shows the net volume difference between bullish and bearish gaps at that level.")
fvgp_Displayqty   = input.bool(true, "Show Bull / Bear FVG Count", tooltip = "Displays the total count of bullish (▲) and bearish (▼) gaps found in each bin.")
fvgp_heatMap      = input.bool(false, "Enable Heatmap", tooltip = "Overlays a color gradient on the background based on the density of gap activity.", inline = "hm")

fvgp_bullCol = input.color(color.lime, "Bullish/Bearish Color", tooltip = "Color used for bullish gaps and positive volume delta.", inline = "col")
fvgp_bearCol = input.color(color.orange, "", tooltip = "Color used for bearish gaps and negative volume delta.", inline = "col")
fvgp_bgColor = input.color(color.rgb(73, 73, 73, 80), "Background Colorㅤㅤ", tooltip = "The background color of the profile area.", inline = "col1")

fvgp_pocCol  = input.color(color.rgb(255, 102, 0), "POC Color", tooltip = "The color of the Rolling Point of Control line.")

fvgp_topBot  = array.new<float>()
fvgp_colorNA = color.new(color.black, 100)
// }

// ＲＯＬＬＩＮＧ ＰＯＣ ＬＯＧＩＣ ―――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

// We need a way to find the POC on every bar for the 'Rolling' effect
// This function finds which bin the current FVG falls into based on the global high/low range
fvgp_get_poc() =>
    float fvgp_hi = ta.highest(high, fvgp_period)
    float fvgp_lo = ta.lowest(low, fvgp_period)
    float fvgp_stp = (fvgp_hi - fvgp_lo) / fvgp_binSize
    
    array<int>   fvgp_counts = array.new<int>(fvgp_binSize, 0)
    float fvgp_pocPrice = na
    
    for fvgp_i = 0 to fvgp_period - 1
        // Bull FVG Logic
        if high[fvgp_i+2] < low[fvgp_i]
            fvgp_avg = math.avg(high[fvgp_i+2], low[fvgp_i])
            fvgp_binIdx = math.floor((fvgp_avg - fvgp_lo) / fvgp_stp)
            if fvgp_binIdx >= 0 and fvgp_binIdx < fvgp_binSize
                fvgp_counts.set(fvgp_binIdx, fvgp_counts.get(fvgp_binIdx) + 1)
        
        // Bear FVG Logic
        if low[fvgp_i+2] > high[fvgp_i]
            fvgp_avg = math.avg(low[fvgp_i+2], high[fvgp_i])
            fvgp_binIdx = math.floor((fvgp_avg - fvgp_lo) / fvgp_stp)
            if fvgp_binIdx >= 0 and fvgp_binIdx < fvgp_binSize
                fvgp_counts.set(fvgp_binIdx, fvgp_counts.get(fvgp_binIdx) + 1)
    
    // Find index of max activity
    fvgp_maxAct = fvgp_counts.max()
    if fvgp_maxAct > 0
        fvgp_pocIdx = fvgp_counts.indexof(fvgp_maxAct)
        fvgp_pocPrice := fvgp_lo + (fvgp_stp * fvgp_pocIdx) + (fvgp_stp / 2)
    fvgp_pocPrice

// OPTIMIZATION: Only calculate rolling POC for the last `fvgp_period` bars to match the `show_last` plot limit.
// This prevents millions of loop iterations on historical bars.
fvgp_rollingPoc = (bar_index >= last_bar_index - fvgp_period or barstate.islast) ? fvgp_get_poc() : na
fvgp_poc = ta.sma(fvgp_rollingPoc, 10)
plot(fvgp_poc, "Rolling POC", color = fvgp_pocCol, linewidth = 2, show_last = fvgp_period, style = plot.style_linebr)
if barstate.islast and fvgp_showPOC
    label.delete(label.new(bar_index, fvgp_poc, "< PoC", style = label.style_label_left, color = fvgp_colorNA, textcolor = fvgp_pocCol)[1])

// }

// ＣＡＬＣＵＬＡＴＩＯＮＳ (Static Profile for Last Bar) ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

if barstate.islast
    var fvgp_boxes = array.new<box>()
    for fvgp_b in fvgp_boxes 
        fvgp_b.delete()
    fvgp_boxes.clear()

    for fvgp_i = 0 to fvgp_period - 1
        fvgp_topBot.push(high[fvgp_i])
        fvgp_topBot.push(low[fvgp_i])

    fvgp_step = (fvgp_topBot.max() - fvgp_topBot.min()) / fvgp_binSize
    fvgp_bullGaps = array.new<int>(fvgp_binSize, 0)
    fvgp_bearGaps = array.new<int>(fvgp_binSize, 0)
    fvgp_bullVol  = array.new<float>(fvgp_binSize, 0.)
    fvgp_bearVol  = array.new<float>(fvgp_binSize, 0.)

    float fvgp_min_val = fvgp_topBot.min()
    
    // OPTIMIZATION: Eliminated nested loop. Replaced with mathematical binning.
    for fvgp_i = 0 to fvgp_period - 1
        fvgp_avgBull = math.avg(high[fvgp_i+2], low[fvgp_i])
        if high[fvgp_i+2] < low[fvgp_i] // bullFVG 
            if fvgp_displayFVG
                fvgp_boxes.push(box.new(bar_index[fvgp_i]-2, high[fvgp_i+2], bar_index[fvgp_i]+1, low[fvgp_i], color.new(fvgp_bullCol, 10), 1, bgcolor = color.new(fvgp_bullCol, 80)))

            fvgp_binIdx = math.floor((fvgp_avgBull - fvgp_min_val) / fvgp_step)
            if fvgp_binIdx >= 0 and fvgp_binIdx < fvgp_binSize
                fvgp_bullGaps.set(fvgp_binIdx, fvgp_bullGaps.get(fvgp_binIdx) + 1)
                fvgp_bullVol.set(fvgp_binIdx, fvgp_bullVol.get(fvgp_binIdx) + volume[fvgp_i+1])

        fvgp_avgBear = math.avg(low[fvgp_i+2], high[fvgp_i])
        if low[fvgp_i+2] > high[fvgp_i] // bearFVG 
            if fvgp_displayFVG
                fvgp_boxes.push(box.new(bar_index[fvgp_i]-2, low[fvgp_i+2], bar_index[fvgp_i]+1, high[fvgp_i], color.new(fvgp_bearCol, 10), 1, bgcolor = color.new(fvgp_bearCol, 80)))

            fvgp_binIdx = math.floor((fvgp_avgBear - fvgp_min_val) / fvgp_step)
            if fvgp_binIdx >= 0 and fvgp_binIdx < fvgp_binSize
                fvgp_bearGaps.set(fvgp_binIdx, fvgp_bearGaps.get(fvgp_binIdx) + 1)
                fvgp_bearVol.set(fvgp_binIdx, fvgp_bearVol.get(fvgp_binIdx) + volume[fvgp_i+1])

    fvgp_max_ = 0.
    for fvgp_k = 0 to fvgp_binSize - 1 
        fvgp_delta = fvgp_bullVol.get(fvgp_k) - fvgp_bearVol.get(fvgp_k)
        fvgp_max_ := math.max(math.abs(fvgp_delta), fvgp_max_)

    // ＰＬＯＴ Profile Bars
    for fvgp_k = 0 to fvgp_binSize - 1 
        fvgp_L = fvgp_topBot.min() + fvgp_step * fvgp_k 
        fvgp_H = fvgp_L + fvgp_step
        fvgp_bullFVG_w = int(fvgp_bullGaps.get(fvgp_k) / math.max(1, fvgp_bullGaps.max()) * 25) 
        fvgp_bearFVG_w = int(fvgp_bearGaps.get(fvgp_k) / math.max(1, fvgp_bearGaps.max()) * 25) 
        
        fvgp_max_act = fvgp_bullGaps.max() + fvgp_bearGaps.max()
        fvgp_tot = (fvgp_bullGaps.get(fvgp_k) + fvgp_bearGaps.get(fvgp_k)) / math.max(1, fvgp_max_act) * 100
        fvgp_delta = fvgp_bullVol.get(fvgp_k) - fvgp_bearVol.get(fvgp_k)

        if fvgp_bullGaps.get(fvgp_k) != 0 or fvgp_bearGaps.get(fvgp_k) != 0
            if fvgp_heatMap
                fvgp_boxes.push(box.new(bar_index-fvgp_period, fvgp_H, bar_index+50+fvgp_offset, fvgp_L, bgcolor = color.from_gradient(fvgp_tot, 0, 100, fvgp_colorNA, color.new(chart.fg_color, 50)), border_color = fvgp_colorNA))

            fvgp_boxes.push(box.new(bar_index+50+fvgp_offset, fvgp_H, bar_index+50+fvgp_offset-fvgp_bullFVG_w, fvgp_L, bgcolor = fvgp_bullCol, border_color = chart.bg_color, text = fvgp_Displayqty ?  "▲" + str.tostring(fvgp_bullGaps.get(fvgp_k)) : ""))
            fvgp_boxes.push(box.new(bar_index+50+fvgp_offset-fvgp_bullFVG_w, fvgp_H, bar_index+50+fvgp_offset-fvgp_bullFVG_w-fvgp_bearFVG_w, fvgp_L, bgcolor = fvgp_bearCol, border_color = chart.bg_color, text = fvgp_Displayqty ? "▼" + str.tostring(fvgp_bearGaps.get(fvgp_k)) : ""))

            if fvgp_displayPer
                fvgp_boxes.push(box.new(bar_index+ 50 + fvgp_offset, fvgp_H, bar_index+ 60 + fvgp_offset, fvgp_L, fvgp_colorNA, 0, bgcolor = fvgp_colorNA, text =  str.tostring(fvgp_tot, format.percent) + " |", text_halign = text.align_left, text_color = fvgp_delta > 0 ? fvgp_bullCol : fvgp_bearCol))
            
            if fvgp_DisplayDelta
                fvgp_boxes.push(box.new(bar_index+ (fvgp_displayPer ? 60 : 50) + fvgp_offset, fvgp_H, bar_index+ (fvgp_displayPer ? 75 : 60) + fvgp_offset, fvgp_L, fvgp_colorNA, 0, bgcolor = fvgp_colorNA, text =  "Δ " + str.tostring(fvgp_delta, format.volume), text_halign = text.align_left, text_color = fvgp_delta > 0 ? fvgp_bullCol : fvgp_bearCol))

    fvgp_boxes.push(box.new(bar_index-fvgp_period, fvgp_topBot.max(), bar_index+50+fvgp_offset, fvgp_topBot.min(), fvgp_colorNA, 0, bgcolor = fvgp_bgColor))

    line.delete(line.new(bar_index+50+fvgp_offset, fvgp_topBot.max(), bar_index+50+fvgp_offset, fvgp_topBot.min(), color = chart.fg_color)[1])

// }

// Smoothing MA inputs
var fvgp_ma_length = 2

if bar_index == last_bar_index - fvgp_period 
    fvgp_ma_length := 2

fvgp_ma_length += 1


fvgp_GRP = "Moving Average"
fvgp_maTypeInput = input.string("None", "Type", options = ["None", "SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = fvgp_GRP, display = display.none)
fvgp_maLengthInput = input.int(25, "Length", group = fvgp_GRP, display = display.none, inline = "len")
fvgp_autoLength = input.bool(false, "Auto", group = fvgp_GRP, display = display.none, inline = "len")
fvgp_ma_src = input(close, title="Source", group = fvgp_GRP)

fvgp_pine_ema(src, length) =>
    alpha = 2 / (length + 1)
    sum = 0.0
    sum := na(sum[1]) ? src : alpha * src + (1 - alpha) * nz(sum[1])

fvgp_pine_rma(src, length) =>
    alpha = 1/length
    sum = 0.0
    sum := na(sum[1]) ? ta.sma(src, length) : alpha * src + (1 - alpha) * nz(sum[1])

// Smoothing MA Calculation
fvgp_ma_func(source, length, MAtype) =>
    switch MAtype
        "SMA"                   => ta.sma(source, length)
        "EMA"                   => fvgp_pine_ema(source, length)
        "SMMA (RMA)"            => fvgp_pine_rma(source, length)
        "WMA"                   => ta.wma(source, length)
        "VWMA"                  => ta.vwma(source, length)
fvgp_ma_val = fvgp_ma_func(fvgp_ma_src, fvgp_autoLength ? fvgp_ma_length : fvgp_maLengthInput, fvgp_maTypeInput)
plot(fvgp_ma_val, color=color.yellow, title="MA", show_last = fvgp_period, style = plot.style_linebr)

if barstate.islast and fvgp_maTypeInput != "None"
    label.delete(label.new(bar_index, fvgp_ma_val, fvgp_maTypeInput + ": " + str.tostring(fvgp_autoLength ? fvgp_ma_length : fvgp_maLengthInput), style = label.style_label_left, color = fvgp_colorNA, textcolor = color.yellow)[1])

// }
//==============================================================================
//        VOLUME-TREND ORDER BLOCK ENGINE  (© BigBeluga)
//------------------------------------------------------------------------------
// Merged into the single indicator. Stand-alone @version/indicator() header
// removed. Collision fix: this engine's `pivot_high`/`pivot_low` were renamed to
// `ob_pivot_high`/`ob_pivot_low` — the bare names are already global pivots in the
// Liquidity Sentiment section above. No other identifiers collide. This block is
// light (2 live boxes, a pivot-window volume loop bounded by Pivot Strength), so
// no further efficiency guards are required.
//==============================================================================

gp_st = 'Custom Supertrend Settings'
st_len = input.int(50, title = 'Volatility SMA Length', tooltip = 'Number of candles used to calculate the average range (High - Low).', group = gp_st)
st_mult = input.float(3.5, title = 'Multiplier', step = 0.1, tooltip = 'Multiplication factor for the custom volatility band.', group = gp_st)
show_fill = input.bool(true, title = 'Show Trend Cloud Fill', tooltip = 'Enables or disables the background color shading between the close price and the trailing stop line.', group = gp_st)

gp_cloud = 'Trend Cloud Settings'
cloud_bull_col = input.color(#00ffcc, title = 'Bullish Cloud Color', group = gp_cloud)
cloud_bear_col = input.color(#ff007f, title = 'Bearish Cloud Color', group = gp_cloud)

gp_ob = 'Order Block Settings'
pivot_len = input.int(7, title = 'Pivot Strength', minval = 1, tooltip = 'The number of bars required to confirm a swing high or swing low pivot (Left & Right strength).', group = gp_ob)
bull_col = input.color(#00ffcc, title = 'Bullish OB Color', tooltip = 'Color used for both zones inside a Bullish Order Block.', group = gp_ob)
bear_col = input.color(#ff007f, title = 'Bearish OB Color', tooltip = 'Color used for both zones inside a Bearish Order Block.', group=gp_ob)
txt_col = input.color(#e0e0e0, title = 'OB Text Label Color', tooltip = 'Color of the Buy % and Sell % text inside the order blocks.', group = gp_ob)
delete_on_break = input.bool(true, title = 'Delete OB on Complete Break', tooltip = 'If enabled, order blocks will be automatically deleted from the chart once price completely breaks past them.', group = gp_ob)

gp_filt = 'Retest Filter Settings'
show_bull_retest = input.bool(true, title = 'Bullish Retest Signals', tooltip = 'Enable or disable signals when price cross above the Bullish OB top.', group = gp_filt, inline = 'bull_ret')
bull_vol_pct    = input.float(50.0, title = 'Min Buy %', minval = 0.0, maxval = 100.0, step = 5.0, tooltip = 'Minimum Buy Volume percentage required in the original pivot window.', group = gp_filt, inline = 'bull_ret')
bull_sig_col    = input.color(#00ffcc, title = 'Color', group = gp_filt, inline = 'bull_ret')

show_bear_retest = input.bool(true, title = 'Bearish Retest Signals', tooltip = 'Enable or disable signals when price cross below the Bearish OB bottom.', group = gp_filt, inline = 'bear_ret')
bear_vol_pct    = input.float(50.0, title = 'Min Sell %', minval = 0.0, maxval = 100.0, step = 5.0, tooltip = 'Minimum Sell Volume percentage required in the original pivot window.', group = gp_filt, inline = 'bear_ret')
bear_sig_col    = input.color(#ff007f, title = 'Color', group = gp_filt, inline = 'bear_ret')

custom_atr = ta.sma(high - low, st_len)

var float trend_stop = na
var int market_trend = 1

upper_band = hl2 + st_mult * custom_atr
lower_band = hl2 - st_mult * custom_atr

trend_stop := market_trend == 1 ? math.max(lower_band, nz(trend_stop[1], lower_band)) : math.min(upper_band, nz(trend_stop[1], upper_band))

if close > trend_stop[1] and close[1] <= trend_stop[1]
    market_trend := 1
    trend_stop := lower_band
else if close < trend_stop[1] and close[1] >= trend_stop[1]
    market_trend := -1
    trend_stop := upper_band

// Pivot & Overlap Logic  (renamed pivot_high/low -> ob_pivot_high/low to avoid collision)
ob_pivot_low = ta.pivotlow(low, pivot_len, pivot_len)
ob_pivot_high = ta.pivothigh(high, pivot_len, pivot_len)

var box active_top_box = na
var box active_bot_box = na
var float active_top = na
var float active_bot = na
var float active_buy_ratio = na
var int active_ob_trend = 0

is_overlapping(float new_top, float new_bot) =>
    if na(active_top) or na(active_bot)
        false
    else
        not(new_bot > active_top or new_top < active_bot)

p_idx = bar_index - pivot_len

// Local Chart Volume Ratio Calculation
get_window_volume_ratio(int lookback_len) =>
    float buy_vol = 0.0
    float sell_vol = 0.0

    for i = 0 to lookback_len by 1
        if close[i] >= open[i]
            buy_vol := buy_vol + volume[i]
        else
            sell_vol := sell_vol + volume[i]

    total_vol = buy_vol + sell_vol
    float buy_pct = total_vol > 0 ? buy_vol / total_vol : 0.5
    buy_pct

// Trend Based OB Execution
var int ob_start_bar = na

// 1. Uptrend Order Blocks (Lower Pivots)
if market_trend == 1 and not na(ob_pivot_low)
    ob_top = math.min(open[pivot_len], close[pivot_len])
    ob_bot = ob_top - custom_atr

    if not is_overlapping(ob_top, ob_bot)
        if not na(active_top_box)
            box.set_right(active_top_box, p_idx)
            box.set_right(active_bot_box, p_idx)

        ob_start_bar := p_idx
        active_top := ob_top
        active_bot := ob_bot
        active_ob_trend := 1

        float buy_ratio = get_window_volume_ratio(pivot_len)
        active_buy_ratio := buy_ratio
        float sell_ratio = 1.0 - buy_ratio
        float split_price = active_bot + (active_top - active_bot) * buy_ratio

        string top_text = 'Sell: ' + str.tostring(math.round(sell_ratio * 100)) + '%'
        string bot_text = 'Buy: ' + str.tostring(math.round(buy_ratio * 100)) + '%'

        active_top_box := box.new(left = ob_start_bar, top = active_top, right = bar_index, bottom = split_price, bgcolor = color.new(bull_col, 85), border_color = color.new(bull_col, 40), text = top_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)
        active_bot_box := box.new(left = ob_start_bar, top = split_price, right = bar_index, bottom = active_bot, bgcolor = color.new(bull_col, 75), border_color = color.new(bull_col, 40), text = bot_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)

// 2. Downtrend Order Blocks (High Pivots)
if market_trend == -1 and not na(ob_pivot_high)
    ob_bot = math.max(open[pivot_len], close[pivot_len])
    ob_top = ob_bot + custom_atr

    if not is_overlapping(ob_top, ob_bot)
        if not na(active_top_box)
            box.set_right(active_top_box, p_idx)
            box.set_right(active_bot_box, p_idx)

        ob_start_bar := p_idx
        active_top := ob_top
        active_bot := ob_bot
        active_ob_trend := -1

        float buy_ratio = get_window_volume_ratio(pivot_len)
        active_buy_ratio := buy_ratio
        float sell_ratio = 1.0 - buy_ratio
        float split_price = active_bot + (active_top - active_bot) * buy_ratio

        string top_text = 'Sell: ' + str.tostring(math.round(sell_ratio * 100)) + '%'
        string bot_text = 'Buy: ' + str.tostring(math.round(buy_ratio * 100)) + '%'

        active_top_box := box.new(left = ob_start_bar, top = active_top, right = bar_index, bottom = split_price, bgcolor = color.new(bear_col, 75), border_color = color.new(bear_col, 40), text = top_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)
        active_bot_box := box.new(left = ob_start_bar, top = split_price, right = bar_index, bottom = active_bot, bgcolor = color.new(bear_col, 85), border_color = color.new(bear_col, 40), text = bot_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)

// Complete Invalidation / Deletion Engine
if delete_on_break and not na(active_top) and not na(active_bot)
    bool is_broken = (active_ob_trend == 1 and high < active_bot) or (active_ob_trend == -1 and low > active_top)
    if is_broken
        box.delete(active_top_box)
        box.delete(active_bot_box)
        active_top := na
        active_bot := na
        active_ob_trend := 0

// Real-time Right Extension
if not na(active_top_box) and not na(active_bot_box)
    box.set_right(active_top_box, bar_index)
    box.set_right(active_bot_box, bar_index)

// Retest Signals Logic with Dynamic Independent Filters
float active_sell_ratio = 1.0 - active_buy_ratio
float bull_threshold   = bull_vol_pct / 100.0
float bear_threshold   = bear_vol_pct / 100.0

marketChange = market_trend != market_trend[1]

bool buy_retest = ta.crossover(low, active_top) and show_bull_retest and na(ob_pivot_low) and not na(active_top) and (active_buy_ratio >= bull_threshold) and not marketChange and barstate.isconfirmed
bool sell_retest = ta.crossunder(high, active_bot) and na(ob_pivot_high) and show_bear_retest and not na(active_bot) and (active_sell_ratio >= bear_threshold) and not marketChange and barstate.isconfirmed

// Modified line plot to use the new cloud/trend colors
st_plot = plot(market_trend != market_trend[1] ? float(na) : trend_stop, title = 'Trend Stop', color = market_trend == 1 ? cloud_bull_col : cloud_bear_col, linewidth = 1, style = plot.style_linebr)
price_plot = plot(close, title = 'Close Price Reference', display = display.none)

fill_color = show_fill ? market_trend == 1 ? color.new(cloud_bull_col, 80) : color.new(cloud_bear_col, 80) : na
fill(price_plot, st_plot, close, trend_stop, fill_color, color(na))

plotshape(buy_retest, title = "Bullish OB Retest", style = shape.cross, location = location.belowbar, color = bull_sig_col, size = size.tiny)
plotshape(sell_retest, title = "Bearish OB Retest", style = shape.cross, location = location.abovebar, color = bear_sig_col, size = size.tiny)

