var lbl2 = label.new(na, na)

sym = syminfo.tickerid
tf = timeframe.period
tick = syminfo.mintick
pattatr = ta.atr(20) / 2

add_to_array_tf(arr, value, _bar) =>
    array.unshift(arr, value)
    if array.size(arr) > 5 * _bar
        array.pop(arr)

f_text(string _tf) =>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm' : str.tonumber(_tf) > 59 ? 'h' + str.tostring(math.floor(str.tonumber(_tf) / 60)) : _tf
    _text := _tf == '1D' ? 'D' : _tf == '1W' ? 'W' : _tf == '1M' ? 'M' : _text
    _text

tf_ok(_htf) =>
    _ok = timeframe.in_seconds(_htf) >= timeframe.in_seconds(timeframe.period) or _htf == '1D' and str.tonumber(timeframe.period) <= 720 or _htf == '1W' and str.tonumber(timeframe.period) <= 720 or _htf == '1W' and timeframe.isdaily or _htf == '1M' and str.tonumber(timeframe.period) <= 720 or _htf == '1M' and timeframe.isdaily or _htf == '1M' and timeframe.isweekly or _htf == '3M' and timeframe.isweekly or _htf == '3M' and timeframe.isdaily or _htf == '3M' and timeframe.period == '240'
    _ok

Getcolor_candle(_o, _c) =>
    _c > _o ? bull_clr : _o > _c ? bear_clr : eq_clr

f_secret_candle(_c, _o, _h, _l, i, start, _bar) =>
    n = 5
    m = n - i
    bl0 = box.new(left = bar_index + dxx + start + 0 + m * 3, top = _c, right = bar_index + dxx + start + 2 + m * 3, bottom = _o, bgcolor = Getcolor_candle(_o, _c), border_color = Getcolor_candle(_o, _c), text = '', text_size = size.tiny, text_valign = text.align_center, text_halign = text.align_center, text_color = color.gray)
    wup = box.new(left = bar_index + dxx + start + 1 + m * 3, top = _h, right = bar_index + dxx + start + 1 + m * 3, bottom = math.max(_o, _c), border_color = color.new(Getcolor_candle(_o, _c), 30), border_width = 1)
    wdw = box.new(left = bar_index + dxx + start + 1 + m * 3, top = _l, right = bar_index + dxx + start + 1 + m * 3, bottom = math.min(_o, _c), border_color = color.new(Getcolor_candle(_o, _c), 30), border_width = 1)
    box.delete(bl0[1])
    box.delete(wup[1])
    box.delete(wdw[1])

f_live(_htf) =>
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    var _h1 = high
    var _l1 = low
    var _t1 = time
    var _c1 = close
    var _o1 = open
    if timeframe.change(_htf)
        _t0 := bar_index
        _o0 := open
        _h0 := high
        _l0 := low
    if high >= _h0
        _h0 := high
    if low <= _l0
        _l0 := low
    if timeframe.change(_htf)
        _o1 := _o0[1]
        _h1 := _h0[1]
        _l1 := _l0[1]
        _t1 := _t0[1]
        _c1 := close[1]
    _c0 := close
    [_h1, _l1, _c1, _o1, _t1, _h0, _l0, _c0, _o0, _t0]

f_live_sym(_xc0, _xo0, _xh0, _xl0, _xt0, _tf) =>
    var _c1 = 0.0
    var _o1 = 0.0
    var _h1 = 0.0
    var _l1 = 0.0
    var _t1 = 0
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    if timeframe.change(_tf)
        _t0 := _xt0
        _o0 := _xo0
        _h0 := _xh0
        _l0 := _xl0
    if _xh0 >= _h0
        _h0 := _xh0
    if _xl0 <= _l0
        _l0 := _xl0
    _c0 := _xc0
    if timeframe.change(_tf)
        _c1 := _c0[1]
        _o1 := _o0[1]
        _h1 := _h0[1]
        _l1 := _l0[1]
        _t1 := _t0[1]
    [_h1, _l1, _c1, _o1, _t1, _h0, _l0, _c0, _o0, _t0]

e1 = ta.ema(close, len1)
plot(show_ema1 and show_candle ? e1 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 16, show_last = 15)
plot(showemamain ? e1 : na, color = ema_clr)
e2 = request.security(sym2, tf, e1)
plot(show_ema1 and showdbl ? e2 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 36, show_last = 15)
