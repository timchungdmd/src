            ln1 := line.new(bar_index + dxx + start + 10, (_h2 + _l2) / 2, bar_index + dxx + start + 15, (_h2 + _l2) / 2, width = 2)
            stext_ := text_ == 'Bearish Evening Star' ? 'Ev. Star' : 'Mor.Star'
        if (text_ == 'Bullish 3 candle' or text_ == 'Bearish 3 candle') and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _o2, bar_index + dxx + start + 15, _o2, width = 2)
            stext_ := '3 Candle'
        if text_ == 'Bullish 3 inside up' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _h2, bar_index + dxx + start + 16, _h2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 10, _l2, bar_index + dxx + start + 17, _l2, width = 2)
            stext_ := '3 inside up'
        if text_ == 'Bearish 3 inside down' and _show_candle
