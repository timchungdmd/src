var tablo = table.new(position = pos, columns = 4, rows = 20, frame_color = color.white, frame_width = 2, border_color = color.white, border_width = 1)
var box0 = box.new(na, na, na, na)
var box2 = box.new(na, na, na, na)
var lbl0 = label.new(na, na)
var lbl2 = label.new(na, na)

sym = syminfo.tickerid
tf = timeframe.period
tick = syminfo.mintick
pattatr = ta.atr(20) / 2

add_to_array_tf(arr, value, _bar) =>
    array.unshift(arr, value)
    if array.size(arr) > 5 * _bar
        array.pop(arr)

f_text(string _tf) =>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm' : str.tonumber(_tf) > 59 ? 'h' + str.tostring(math.floor(str.tonumber(_tf) / 60)) : _tf
    _text := _tf == '1D' ? 'D' : _tf == '1W' ? 'W' : _tf == '1M' ? 'M' : _text
    _text

tf_ok(_htf) =>
    _ok = timeframe.in_seconds(_htf) >= timeframe.in_seconds(timeframe.period) or _htf == '1D' and str.tonumber(timeframe.period) <= 720 or _htf == '1W' and str.tonumber(timeframe.period) <= 720 or _htf == '1W' and timeframe.isdaily or _htf == '1M' and str.tonumber(timeframe.period) <= 720 or _htf == '1M' and timeframe.isdaily or _htf == '1M' and timeframe.isweekly or _htf == '3M' and timeframe.isweekly or _htf == '3M' and timeframe.isdaily or _htf == '3M' and timeframe.period == '240'
    _ok

Getcolor_candle(_o, _c) =>
    _c > _o ? bull_clr : _o > _c ? bear_clr : eq_clr

f_secret_candle(_c, _o, _h, _l, i, start, _bar) =>
    n = 5
    m = n - i
    clr = Getcolor_candle(_o, _c)
    bl0 = box.new(left = bar_index + dxx + start + 0 + m * 3, top = _c, right = bar_index + dxx + start + 2 + m * 3, bottom = _o, bgcolor = clr, border_color = clr, text = '', text_size = size.tiny, text_valign = text.align_center, text_halign = text.align_center, text_color = color.gray)
    wup = box.new(left = bar_index + dxx + start + 1 + m * 3, top = _h, right = bar_index + dxx + start + 1 + m * 3, bottom = math.max(_o, _c), border_color = color.new(clr, 30), border_width = 1)
    wdw = box.new(left = bar_index + dxx + start + 1 + m * 3, top = _l, right = bar_index + dxx + start + 1 + m * 3, bottom = math.min(_o, _c), border_color = color.new(clr, 30), border_width = 1)
    box.delete(bl0[1])
    box.delete(wup[1])
    box.delete(wdw[1])

f_live_sym(_xc0, _xo0, _xh0, _xl0, _xt0, _tf) =>
    var _c1 = 0.0
    var _o1 = 0.0
    var _h1 = 0.0
    var _l1 = 0.0
    var _t1 = 0
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    if timeframe.change(_tf)
        _t0 := _xt0
        _o0 := _xo0
        _h0 := _xh0
        _l0 := _xl0
    if _xh0 >= _h0
        _h0 := _xh0
    if _xl0 <= _l0
        _l0 := _xl0
    _c0 := _xc0
    if timeframe.change(_tf)
        _c1 := _c0[1]
        _o1 := _o0[1]
        _h1 := _h0[1]
        _l1 := _l0[1]
        _t1 := _t0[1]
    [_h1, _l1, _c1, _o1, _t1, _h0, _l0, _c0, _o0, _t0]

e1 = ta.ema(close, len1)
plot(show_ema1 and show_candle ? e1 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 16, show_last = 15)
plot(showemamain ? e1 : na, color = ema_clr)
e2 = request.security(sym2, tf, e1)
plot(show_ema1 and showdbl ? e2 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 36, show_last = 15)
e3 = request.security(sym, stf, ta.ema(close, len2))
plot(show_ema2 and show_candle2 ? e3 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 56, show_last = 15)

f_candlestick(_close, _open, _high, _low, _time, _tf, _bar, _plot, start, _show_candle, _htf, e, te) =>
    [ch1, cl1, cc1, co1, ct1, ch0, cl0, cc0, co0, ct0] = f_live_sym(_close, _open, _high, _low, _time, _tf)
    var tf_h = array.new_float()
    var tf_l = array.new_float()
    var tf_c = array.new_float()
    var tf_o = array.new_float()
    var tf_t = array.new_int()
    var lbl1 = label.new(na, na)
    var ln1 = line.new(na, na, na, na)
    var ln2 = line.new(na, na, na, na)
    if timeframe.change(_tf)
        add_to_array_tf(tf_h, ch1, _bar)
        add_to_array_tf(tf_l, cl1, _bar)
        add_to_array_tf(tf_o, co1, _bar)
        add_to_array_tf(tf_c, cc1, _bar)
        add_to_array_tf(tf_t, ct1, _bar)

    if array.size(tf_h) > 5 * _bar - 1 and tf_ok(_tf) and _show_candle
        array_h0 = array.from(ch0)
        array_l0 = array.from(cl0)
        array_o0 = array.from(co0)
        array_c0 = array.from(cc0)
        array_t0 = array.from(ct0)

        tf_hh = array.concat(array_h0, tf_h)
        tf_ll = array.concat(array_l0, tf_l)
        tf_oo = array.concat(array_o0, tf_o)
        tf_cc = array.concat(array_c0, tf_c)
        tf_tt = array.concat(array_t0, tf_t)

        // Optimized Loop without Array Allocations
        _h0 = -1e8
        _l0 = 1e8
        for i = 0 to _bar - 1 by 1
            _h0 := math.max(_h0, array.get(tf_hh, i))
            _l0 := math.min(_l0, array.get(tf_ll, i))
        _o0 = array.get(tf_oo, _bar - 1)
        _c0 = _close
        _t0 = array.get(tf_tt, _bar - 1)

        _h1 = -1e8
        _l1 = 1e8
        for i = _bar to 2 * _bar - 1 by 1
            _h1 := math.max(_h1, array.get(tf_hh, i))
            _l1 := math.min(_l1, array.get(tf_ll, i))
        _o1 = array.get(tf_oo, 2 * _bar - 1)
        _c1 = array.get(tf_cc, _bar)
        _t1 = array.get(tf_tt, 2 * _bar - 1)

        _h2 = -1e8
        _l2 = 1e8
        for i = 2 * _bar to 3 * _bar - 1 by 1
            _h2 := math.max(_h2, array.get(tf_hh, i))
            _l2 := math.min(_l2, array.get(tf_ll, i))
        _o2 = array.get(tf_oo, 3 * _bar - 1)
        _c2 = array.get(tf_cc, 2 * _bar)
        _t2 = array.get(tf_tt, 3 * _bar - 1)

        _h3 = -1e8
        _l3 = 1e8
        for i = 3 * _bar to 4 * _bar - 1 by 1
            _h3 := math.max(_h3, array.get(tf_hh, i))
            _l3 := math.min(_l3, array.get(tf_ll, i))
        _o3 = array.get(tf_oo, 4 * _bar - 1)
        _c3 = array.get(tf_cc, 3 * _bar)
        _t3 = array.get(tf_tt, 4 * _bar - 1)

        _h4 = -1e8
        _l4 = 1e8
        for i = 4 * _bar to 5 * _bar - 1 by 1
            _h4 := math.max(_h4, array.get(tf_hh, i))
            _l4 := math.min(_l4, array.get(tf_ll, i))
        _o4 = array.get(tf_oo, 5 * _bar - 1)
        _c4 = array.get(tf_cc, 4 * _bar)
        _t4 = array.get(tf_tt, 5 * _bar - 1)

        if _plot
            f_secret_candle(_close, _o0, _h0, _l0, 0, start, _bar)
            f_secret_candle(_c1, _o1, _h1, _l1, 1, start, _bar)
            f_secret_candle(_c2, _o2, _h2, _l2, 2, start, _bar)
            f_secret_candle(_c3, _o3, _h3, _l3, 3, start, _bar)
            f_secret_candle(_c4, _o4, _h4, _l4, 4, start, _bar)

            lbltop = math.min(_l0, _l1, _l2, _l3, _l4)
            addtext_ = te == 1 ? str.tostring(syminfo.prefix(sym2)) : ''
            lbx = box.new(left = bar_index + dxx + start, top = lbltop - pattatr, right = bar_index + dxx + start + 20, bottom = lbltop - 1.8 * pattatr, bgcolor = color.teal, border_color = color.white, text = addtext_ + ' TF : ' + f_text(_tf) + ' / ' + str.tostring(_bar) + ' bar', text_size = sz, text_valign = text.align_center, text_halign = text.align_center, text_color = color.white)
            box.delete(lbx[1])

        var text1 = ''
        text_ = ''
        stext_ = ''
        found = false
        num = 0
        ploth = 0.0
        plotl = 0.0
        plott = 0
        singleh = 0.0
        singlel = 0.0
        singleo = 0.0

        [htf2h1, htf2l1, h2c1, h2o1, h2t1, htf2h0, htf2l0, h2c0, h2o0, h2t0] = f_live_sym(_close, _open, _high, _low, _time, _htf)
        arr_htf2h = array.from(htf2h0 == _h4, htf2h0 == _h3, htf2h0 == _h2, htf2h0 == _h1, htf2h0 == _h0, htf2h1 == _h4, htf2h1 == _h3, htf2h1 == _h2, htf2h1 == _h1, htf2h1 == _h0)
        arr_htf2l = array.from(htf2l0 == _l4, htf2l0 == _l3, htf2l0 == _l2, htf2l0 == _l1, htf2l0 == _l0, htf2l1 == _l4, htf2l1 == _l3, htf2l1 == _l2, htf2l1 == _l1, htf2l1 == _l0)

        con_ema_bull = str_emabull == 'All' ? true : (str_emabull == 'close > ema' and _c0 > e) or (str_emabull == 'close < ema' and _c0 < e)
        con_ema_bear = str_emabear == 'All' ? true : (str_emabear == 'close > ema' and _c0 > e) or (str_emabear == 'close < ema' and _c0 < e)

        con_htfbear = con_htf ? array.some(arr_htf2h) : true
        con_htfbull = con_htf ? array.some(arr_htf2l) : true
        filterbear = con_htfbear and con_ema_bear
        filterbull = con_htfbull and con_ema_bull

        // Hoisted repeated per-group high/low aggregates (computed once per bar;
        // side-effect-free, so unconditional computation is observationally identical).
        s2h = math.max(_h2, _h1, _h0)
        s2l = math.min(_l2, _l1, _l0)
        s3h = math.max(_h3, _h2, _h1, _h0)
        s3l = math.min(_l3, _l2, _l1, _l0)
        s4h = math.max(_h4, _h3, _h2, _h1, _h0)
        s4l = math.min(_l4, _l3, _l2, _l1, _l0)

        form_51 = filterbull and _o4 > _c4 and math.max(_o3, _c3, _o2, _c2, _o1, _c1) <= (_h4 + _l4) / 2 and math.min(_o3, _c3, _o2, _c2, _o1, _c1) >= _l4 and math.max(_h3, _h2, _h1) < math.min(_o4, _c0) and _c0 > _o4
        if form_51 and alert51
            text_ := 'Bullish 5 candle'
            found := true
            num := 5
            ploth := _o4
            plotl := s4l
            plott := _t4
            singleh := s4h
            singlel := s4l
            singleo := _o4

        if not found and alert52 and text_ == '' and (filterbear and _o4 < _c4 and math.min(_o3, _c3, _o2, _c2, _o1, _c1) >= (_h4 + _l4) / 2 and math.max(_o3, _c3, _o2, _c2, _o1, _c1) <= _h4 and math.min(_l3, _l2, _l1) > math.max(_o4, _c0) and _c0 < _o4)
            text_ := 'Bearish 5 candle'
            found := true
            num := -5
            ploth := s4h
            plotl := _o4
            plott := _t4
            singleh := s4h
            singlel := s4l
            singleo := _o4

        if not found and alert41 and text_ == '' and (filterbull and _c3 < _o3 and _c2 >= _o2 and _c1 <= _o1 and _c0 > _o0 and _c0 > _o3 and math.max(_h2, _h1) < math.min(_o3, _c0) and math.max(_o2, _c1) <= (_h3 + _l3) / 2)
            text_ := 'Bullish Horse Shoe'
            found := true
            num := 4
            ploth := _o3
            plotl := s3l
            plott := _t3
            singleh := s3h
            singlel := s3l
            singleo := _o3

        if not found and alert42 and text_ == '' and (filterbear and _c3 > _o3 and _c2 <= _o2 and _c1 >= _o1 and _c0 < _o0 and _c0 < _o3 and math.min(_l2, _l1) > math.max(_o3, _c0) and math.min(_o2, _c1) >= (_h3 + _l3) / 2)
            text_ := 'Bearish Horse Shoe'
            found := true
            num := -4
            ploth := s3h
            plotl := _o3
            plott := _t3
            singleh := s3h
            singlel := s3l
            singleo := _o3

        if not found and alert43 and text_ == '' and (filterbull and _c3 < _o3 and _c2 < _o2 and _c1 > _o1 and _c0 > _o0 and _c0 > _o3 and math.max(_h2, _h1) < math.min(_o3, _c0) and math.max(_o2, _c1) <= (_h3 + _l3) / 2)
            text_ := 'Bullish 4 candle'
            found := true
            num := 4
            ploth := _o3
            plotl := s3l
            plott := _t3
            singleh := s3h
            singlel := s3l
            singleo := _o3

        if not found and alert44 and text_ == '' and (filterbear and _c3 > _o3 and _c2 > _o2 and _c1 < _o1 and _c0 < _o0 and _c0 < _o3 and math.min(_l2, _l1) > math.max(_o3, _c0) and math.min(_o2, _c1) >= (_h3 + _l3) / 2)
            text_ := 'Bearish 4 candle'
            found := true
            num := -4
            ploth := s3h
            plotl := _o3
            plott := _t3
            singleh := s3h
            singlel := s3l
            singleo := _o3

        if not found and alert31 and text_ == '' and (filterbull and _o2 > _c2 and _c1 > _o1 and _c2 <= _l1 and _o2 >= _h1 and _c0 > _o0 and _c0 > _h2 and not(_l2 == _l1 and _h2 == _h1))
            text_ := 'Bullish 3 inside up'
            found := true
            num := 3
            ploth := _h2
            plotl := s2l
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert32 and text_ == '' and (filterbear and _o2 < _c2 and _c1 < _o1 and _c2 >= _h1 and _o2 <= _l1 and _c0 < _o0 and _c0 < _l2 and not(_l2 == _l1 and _h2 == _h1))
            text_ := 'Bearish 3 inside down'
            found := true
            num := -3
            ploth := s2h
            plotl := _l2
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert33 and text_ == '' and (_o1 < _o2 and _o1 > _c2 and _o0 < _o1 and _o0 > _c1 and _c1 < _l2 and _c0 < _l1 and _c2 < 1.05 * _l2 and _c1 < 1.05 * _l1 and _c0 < 1.05 * _l0)
            text_ := 'Bearish 3 Black Crows'
            found := true
            num := -3
            ploth := _h2
            plotl := _l0
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert34 and text_ == '' and (filterbear and _c2 > _o2 and math.min(_o1, _c1) > _c2 and _o0 < math.min(_o1, _c1) and _c0 < _o0 and _c0 < (_h2 + _l2) / 2 and _h1 > math.max(_h0, _h2))
            text_ := 'Bearish Evening Star'
            found := true
            num := -3
            ploth := _h1
            plotl := (_h2 + _l2) / 2
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert35 and text_ == '' and (filterbull and _o2 > _c2 and _o2 - _c2 > 0.6 * (_h2 - _l2) and _c2 > _o1 and math.abs(_o1 - _c1) < 0.5 * math.abs(_o2 - _c2) and _h1 - _l1 > 3 * (_c1 - _o1) and _c0 > _o0 and _o0 > math.max(_o1, _c1) and _c0 > (_h2 + _l2) / 2 and _l1 < math.min(_l0, _l2))
            text_ := 'Bullish Morning Star'
            found := true
            num := 3
            ploth := (_h2 + _l2) / 2
            plotl := _l1
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert36 and text_ == '' and (filterbull and _c1 >= _o1 and _o2 > _c2 and _c0 > _o0 and _l2 > _h1 and _l0 > _h1 and _l1 < math.min(_l0, _l2) and _c0 > _o2)
            text_ := 'Bullish Abandone Baby'
            found := true
            num := 3
            ploth := _o2
            plotl := _l1
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert37 and text1 != 'Bearish MeReT' and text_ == '' and (filterbear and _c2 > _o2 and _c1 < _o1 and _l1 > _o2 and _c0 < _o0 and _h1 > _h2 and _c0 < _o2)
            text_ := 'Bearish 3 candle'
            found := true
            num := -3
            ploth := s2h
            plotl := _o2
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert38 and text1 != 'Bullish MeReT' and text_ == '' and (filterbull and _c2 < _o2 and _c1 > _o1 and _h1 < _o2 and _c0 > _o0 and _l1 < _l2 and _c0 > _o2)
            text_ := 'Bullish 3 candle'
            found := true
            num := 3
            ploth := _o2
            plotl := s2l
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert39 and text_ == '' and (filterbear and _o2 > _c2 and _c1 > _o1 and _c1 > _h2 and _h0 >= _h2 and _h1 > _h0 and _c0 < _l1 and _c1 - _o1 > math.max(_h1 - _c1, _o1 - _l1))
            text_ := 'Bearish MeReT'
            found := true
            num := -3
            ploth := _h1
            plotl := _l1
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert310 and text_ == '' and (filterbull and _o2 < _c2 and _c1 < _o1 and _c1 < _l2 and _l0 <= _l2 and _l1 < _l0 and _c0 > _h1 and _o1 - _c1 > math.max(_h1 - _o1, _c1 - _l1))
            text_ := 'Bullish MeReT'
            found := true
            num := 3
            ploth := _h1
            plotl := _l1
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert311 and text_ == '' and (filterbear and _o2 > _c2 and _l1 < _l2 and _h2 >= math.max(_h0, _h1) and _c1 > _o1 and _o0 > _c0 and math.max(_h1, _h0) >= math.max(_c2, _o2) and _c0 < _l1)
            text_ := 'Bearish Protected Engulf'
            found := true
            num := -3
            ploth := _h2
            plotl := _l1
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        if not found and alert312 and text_ == '' and (filterbull and _c2 > _o2 and _h1 > _h2 and _l2 <= math.min(_l0, _l1) and _c1 < _o1 and _o0 < _c0 and math.min(_l1, _l0) <= math.min(_c2, _o2) and _c0 > _h1)
            text_ := 'Bullish Protected Engulf'
            found := true
            num := 3
            ploth := _h1
            plotl := _l2
            plott := _t2
            singleh := s2h
            singlel := s2l
            singleo := _o2

        text1 := text_

        label.delete(lbl1)
        if str.length(text_) > 0 and _show_candle
            lbl1 := label.new(bar_index + dxx + start + 10, math.max(_h0, _h1, _h2, _h3, _h4) + 1.5 * pattatr, text = text_, xloc = xloc.bar_index, color = color.new(color.teal, 0), style = label.style_label_center, textcolor = lbl_clr, size = sz)

        if text_ == 'Bearish Protected Engulf' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _h2, bar_index + dxx + start + 16, _h2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 13, _l1, bar_index + dxx + start + 15, _l1, width = 2)
            stext_ := 'P. Engulf'
        if text_ == 'Bullish Protected Engulf' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _l2, bar_index + dxx + start + 16, _l2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 13, _h1, bar_index + dxx + start + 15, _h1, width = 2)
            stext_ := 'P. Engulf'
        if text_ == 'Bullish MeReT' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _l2, bar_index + dxx + start + 12, _l2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 13, _h1, bar_index + dxx + start + 15, _h1, width = 2)
            stext_ := 'MeReT'
        if text_ == 'Bearish MeReT' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _h2, bar_index + dxx + start + 12, _h2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 13, _l1, bar_index + dxx + start + 15, _l1, width = 2)
            stext_ := 'MeReT'
        if text_ == 'Bullish Abandone Baby' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _o2, bar_index + dxx + start + 16, _o2, width = 2)
            stext_ := 'Ab.Baby'
        if (text_ == 'Bearish Evening Star' or text_ == 'Bullish Morning Star') and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, (_h2 + _l2) / 2, bar_index + dxx + start + 15, (_h2 + _l2) / 2, width = 2)
            stext_ := text_ == 'Bearish Evening Star' ? 'Ev. Star' : 'Mor.Star'
        if (text_ == 'Bullish 3 candle' or text_ == 'Bearish 3 candle') and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _o2, bar_index + dxx + start + 15, _o2, width = 2)
            stext_ := '3 Candle'
        if text_ == 'Bullish 3 inside up' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _h2, bar_index + dxx + start + 16, _h2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 10, _l2, bar_index + dxx + start + 17, _l2, width = 2)
            stext_ := '3 inside up'
        if text_ == 'Bearish 3 inside down' and _show_candle
            ln1 := line.new(bar_index + dxx + start + 10, _l2, bar_index + dxx + start + 16, _l2, width = 2)
            ln2 := line.new(bar_index + dxx + start + 10, _h2, bar_index + dxx + start + 17, _h2, width = 2)
            stext_ := '3 inside down'
        if (text_ == 'Bullish 4 candle' or text_ == 'Bearish 4 candle') and _show_candle
            ln1 := line.new(bar_index + dxx + start + 7, _o3, bar_index + dxx + start + 16, _o3, width = 2)
            stext_ := '4 Candle'
        if (text_ == 'Bullish Horse Shoe' or text_ == 'Bearish Horse Shoe') and _show_candle
            ln1 := line.new(bar_index + dxx + start + 7, _o3, bar_index + dxx + start + 16, _o3, width = 2)
            stext_ := 'Horse Shoe'
        if (text_ == 'Bullish 5 candle' or text_ == 'Bearish 5 candle') and _show_candle
            ln1 := line.new(bar_index + dxx + start + 5, _o4, bar_index + dxx + start + 15, _o4, width = 2)
            ln2 := line.new(bar_index + dxx + start + 5, math.avg(_h4, _l4), bar_index + dxx + start + 15, math.avg(_h4, _l4), style = line.style_dotted, width = 2)
            stext_ := '5 Candle'

        line.delete(ln1[1])
        line.delete(ln2[1])

        [found, text_, num, ploth, plotl, plott, stext_, _c0, singleh, singlel, singleo]

var lastploth = bar_index
var lastplotl = bar_index
dt = timeframe.in_seconds(tf) * 1000
[xc0, xo0, xh0, xl0, xt0] = request.security(sym2, tf, [close, open, high, low, time], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

[form0, txt0, nm0, plt0h, plt0l, plt0t, stext0, hh0, singleh0, singlel0, singleo0] = f_candlestick(close, open, high, low, time, tf, bar, true, 0, show_candle, htf, e1, 0)
[form1, txt1, nm1, plt1h, plt1l, plt1t, stext1, hh1, singleh1, singlel1, singleo1] = f_candlestick(xc0, xo0, xh0, xl0, xt0, tf, bar, showdbl, 20, double, htf, e2, 1)
[form2, txt2, nm2, plt2h, plt2l, plt2t, stext2, hh2, singleh2, singlel2, singleo2] = f_candlestick(close, open, high, low, time, stf, bar2, true, 40, show_candle2, htf2, e3, 2)

confirme0 = double ? form0[1] and form1[1] : true
hammer0 = 2 * (close[1] - singleo0[1]) <= singleo0[1] - singlel0[1] and singleh0[1] - close[1] < (close[1] - singleo0[1]) / 2
hammer2 = 2 * (close[1] - singleo2[1]) <= singleo2[1] - singlel2[1] and singleh2[1] - close[1] < (close[1] - singleo2[1]) / 2
shoot0 = 2 * (singleo0[1] - close[1]) <= singleh0[1] - singleo0[1] and close[1] - singlel0[1] < (singleo0[1] - close[1]) / 2
shoot2 = 2 * (singleo2[1] - close[1]) <= singleh2[1] - singleo2[1] and close[1] - singlel2[1] < (singleo2[1] - close[1]) / 2

if form0[1] and txt0[1] != txt0[2]
    alert(f_text(tf) + ' ' + txt0[1], alert.freq_once_per_bar)
    box_clr = nm0[1] > 0 ? bull_clr : bear_clr
    // Sign-parameterized the mutually-exclusive nm0>0 / nm0<0 branches within
    // sequence 0. sgn=+1 (bull) / -1 (bear). Verified coordinate-equivalent to the
    // originals: box0 is byte-identical across signs; dq collapses to (|nm0|-1)*...
    // for both signs; the vertical offset flips as -sgn*dq; label y/textcolor and
    // the df anchor (lastplotl vs lastploth) and hammer/shoot branch on sgn.
    if (nm0[1] > 0 or nm0[1] < 0) and show_pt_box
        sgn0 = nm0[1] > 0 ? 1 : -1
        box0 := box.new(left = plt0t[1], top = plt0h[1], right = time[1], bottom = plt0l[1], xloc = xloc.bar_time, bgcolor = color.new(box_clr, cont_clr), border_color = color.new(box_clr, 30), text = '', text_size = sz, text_valign = text.align_bottom, text_halign = text.align_right, text_color = color.gray)
        if show_last_box
            box.delete(box0[1])
        if show_label
            lbl0 := label.new(math.round((plt0t[1] + time[1]) / 2), sgn0 > 0 ? plt0l[1] - (nm0[1] - 2) * pattatr : plt0h[1] + (math.abs(nm0[1]) - 2) * pattatr, text = stext0[1], xloc = xloc.bar_time, color = color.new(bull_clr, 100), style = label.style_label_center, textcolor = sgn0 > 0 ? bull_clr : bear_clr, size = sz)
            if show_last_label
                label.delete(lbl0[1])
        if show_single
            df = bar_index - (sgn0 > 0 ? lastplotl : lastploth) <= 4 ? 3 * dt : 0
            dq = (math.abs(nm0[1]) - 1) * pattatr + singleh0[1] - singlel0[1]
            cx = df + math.round((plt0t[1] + time[1]) / 2)
            sclr0 = sgn0 > 0 ? bull_clr : bear_clr
            box.new(left = cx - dt, top = singleo0[1] - sgn0 * dq, right = cx + dt, bottom = close[1] - sgn0 * dq, xloc = xloc.bar_time, border_color = color.new(color.navy, 100), bgcolor = sclr0, text = '', text_color = color.white, text_valign = text.align_center, text_halign = text.align_center, text_size = size.tiny, border_style = line.style_solid)
            line.new(x1 = cx, y1 = singleo0[1] - sgn0 * dq, x2 = cx, y2 = singleh0[1] - sgn0 * dq, xloc = xloc.bar_time, color = sclr0, style = line.style_solid)
            line.new(x1 = cx, y1 = close[1] - sgn0 * dq, x2 = cx, y2 = singlel0[1] - sgn0 * dq, xloc = xloc.bar_time, color = sclr0, style = line.style_solid)
            if sgn0 > 0 and hammer0
                label.new(x = cx, y = singlel0[1] - dq - pattatr, text = 'Hammer', xloc = xloc.bar_time, color = color.new(bull_clr, 100), style = label.style_label_center, textcolor = bull_clr, size = sz)
            if sgn0 < 0 and shoot0
                label.new(x = cx, y = singleh0[1] + dq + pattatr, text = 'Shooting Star', xloc = xloc.bar_time, color = color.new(bull_clr, 100), style = label.style_label_center, textcolor = bear_clr, size = sz)
            if sgn0 > 0
                lastplotl := bar_index
            else
                lastploth := bar_index

if timeframe.change(stf)
    if form2[1] and txt2[1] != txt2
        alert(f_text(stf) + ' ' + txt2[1], alert.freq_once_per_bar)
        box_clr = nm2[1] > 0 ? bull_clr2 : bear_clr2
        // Sign-parameterized the nm2>0 / nm2<0 branches within sequence 2 only
        // (NOT merged with sequence 0 — its dq is a constant 2*pattatr, its box
        // valign flips by sign, it uses bull_clr2/bear_clr2/cont_clr2 and text '2.').
        if (nm2[1] > 0 or nm2[1] < 0) and show_pt_box2
            sgn2 = nm2[1] > 0 ? 1 : -1
            box2 := box.new(left = plt2t[1], top = plt2h[1], right = time[1], bottom = plt2l[1], xloc = xloc.bar_time, bgcolor = color.new(box_clr, 100), border_color = color.new(box_clr, cont_clr2), text = '2.', text_size = sz, text_valign = sgn2 > 0 ? text.align_bottom : text.align_top, text_halign = text.align_right, text_color = color.gray)
            if show_last_box
                box.delete(box2[1])
            if show_label2
                lbl2 := label.new(math.round((plt2t[1] + time[1]) / 2), sgn2 > 0 ? plt2l[1] - pattatr : plt2h[1] + pattatr, text = stext2[1], xloc = xloc.bar_time, color = color.new(bull_clr, 100), style = label.style_label_center, textcolor = sgn2 > 0 ? bull_clr2 : bear_clr2, size = sz)
                if show_last_label
                    label.delete(lbl2[1])
            if show_single
                df = bar_index - (sgn2 > 0 ? lastplotl : lastploth) <= 4 ? 3 * dt : 0
                dq = 2 * pattatr + singleh2[1] - singlel2[1]
                cx = df + math.round((plt2t[1] + time[1]) / 2)
                sclr2 = sgn2 > 0 ? bull_clr2 : bear_clr2
                box.new(left = cx - dt, top = singleo2[1] - sgn2 * dq, right = cx + dt, bottom = close[1] - sgn2 * dq, xloc = xloc.bar_time, border_color = color.new(color.navy, 100), bgcolor = sclr2, text = '', text_color = color.white, text_valign = text.align_center, text_halign = text.align_center, text_size = sz, border_style = line.style_solid)
                line.new(x1 = cx, y1 = singleo2[1] - sgn2 * dq, x2 = cx, y2 = singleh2[1] - sgn2 * dq, xloc = xloc.bar_time, color = sclr2, style = line.style_solid)
                line.new(x1 = cx, y1 = close[1] - sgn2 * dq, x2 = cx, y2 = singlel2[1] - sgn2 * dq, xloc = xloc.bar_time, color = sclr2, style = line.style_solid)
                if sgn2 > 0 and hammer2
                    label.new(x = cx, y = singlel2[1] - dq - pattatr, text = 'Hammer', xloc = xloc.bar_time, color = color.new(bull_clr, 100), style = label.style_label_center, textcolor = bull_clr2, size = sz)
                if sgn2 < 0 and shoot2
                    label.new(x = cx, y = singleh2[1] + dq + pattatr, text = 'Shooting Star', xloc = xloc.bar_time, color = color.new(bull_clr, 100), style = label.style_label_center, textcolor = bear_clr2, size = sz)
                if sgn2 > 0
                    lastplotl := bar_index
                else
                    lastploth := bar_index

if show_table
    table.cell(tablo, 0, 0, text = 'Candlestick formation', text_color = color.white, bgcolor = color.red, text_size = sz)
    if show_candle
        table.cell(tablo, 0, 1, text = 'New sequence : ' + f_text(tf) + ' // ' + str.tostring(bar) + ' bar  htf : ' + (con_htf ? f_text(htf) : '-'), text_color = color.white, bgcolor = color.teal, text_size = sz)
    if show_candle2
        table.cell(tablo, 0, 2, text = 'Second Sequence : ' + f_text(stf) + ' // ' + str.tostring(bar2) + ' bar  htf : ' + (con_htf2 ? f_text(htf2) : '-'), text_color = color.white, bgcolor = color.teal, text_size = sz)

