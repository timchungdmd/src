var tablo = table.new(position = pos, columns = 4, rows = 20, frame_color = color.white, frame_width = 2, border_color = color.white, border_width = 1)
var box0 = box.new(na, na, na, na)
var box2 = box.new(na, na, na, na)
var lbl0 = label.new(na, na)
var lbl2 = label.new(na, na)

sym = syminfo.tickerid
tf = timeframe.period
tick = syminfo.mintick
pattatr = ta.atr(20) / 2

add_to_array_tf(arr, value, _bar) =>
    array.unshift(arr, value)
    if array.size(arr) > 5 * _bar
        array.pop(arr)

f_text(string _tf) =>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm' : str.tonumber(_tf) > 59 ? 'h' + str.tostring(math.floor(str.tonumber(_tf) / 60)) : _tf
    _text := _tf == '1D' ? 'D' : _tf == '1W' ? 'W' : _tf == '1M' ? 'M' : _text
    _text

tf_ok(_htf) =>
    _ok = timeframe.in_seconds(_htf) >= timeframe.in_seconds(timeframe.period) or _htf == '1D' and str.tonumber(timeframe.period) <= 720 or _htf == '1W' and str.tonumber(timeframe.period) <= 720 or _htf == '1W' and timeframe.isdaily or _htf == '1M' and str.tonumber(timeframe.period) <= 720 or _htf == '1M' and timeframe.isdaily or _htf == '1M' and timeframe.isweekly or _htf == '3M' and timeframe.isweekly or _htf == '3M' and timeframe.isdaily or _htf == '3M' and timeframe.period == '240'
    _ok

Getcolor_candle(_o, _c) =>
    _c > _o ? bull_clr : _o > _c ? bear_clr : eq_clr

f_secret_candle(_c, _o, _h, _l, i, start, _bar) =>
    n = 5
    m = n - i
    clr = Getcolor_candle(_o, _c)
    bl0 = box.new(left = bar_index + dxx + start + 0 + m * 3, top = _c, right = bar_index + dxx + start + 2 + m * 3, bottom = _o, bgcolor = clr, border_color = clr, text = '', text_size = size.tiny, text_valign = text.align_center, text_halign = text.align_center, text_color = color.gray)
    wup = box.new(left = bar_index + dxx + start + 1 + m * 3, top = _h, right = bar_index + dxx + start + 1 + m * 3, bottom = math.max(_o, _c), border_color = color.new(clr, 30), border_width = 1)
    wdw = box.new(left = bar_index + dxx + start + 1 + m * 3, top = _l, right = bar_index + dxx + start + 1 + m * 3, bottom = math.min(_o, _c), border_color = color.new(clr, 30), border_width = 1)
    box.delete(bl0[1])
    box.delete(wup[1])
    box.delete(wdw[1])

f_live_sym(_xc0, _xo0, _xh0, _xl0, _xt0, _tf) =>
    var _c1 = 0.0
    var _o1 = 0.0
    var _h1 = 0.0
    var _l1 = 0.0
    var _t1 = 0
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    if timeframe.change(_tf)
        _t0 := _xt0
        _o0 := _xo0
        _h0 := _xh0
        _l0 := _xl0
    if _xh0 >= _h0
        _h0 := _xh0
    if _xl0 <= _l0
        _l0 := _xl0
    _c0 := _xc0
    if timeframe.change(_tf)
        _c1 := _c0[1]
        _o1 := _o0[1]
        _h1 := _h0[1]
        _l1 := _l0[1]
        _t1 := _t0[1]
    [_h1, _l1, _c1, _o1, _t1, _h0, _l0, _c0, _o0, _t0]

e1 = ta.ema(close, len1)
plot(show_ema1 and show_candle ? e1 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 16, show_last = 15)
plot(showemamain ? e1 : na, color = ema_clr)
e2 = request.security(sym2, tf, e1)
plot(show_ema1 and showdbl ? e2 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 36, show_last = 15)
e3 = request.security(sym, stf, ta.ema(close, len2))
plot(show_ema2 and show_candle2 ? e3 : na, color = color.fuchsia, linewidth = 2, offset = dxx + 56, show_last = 15)

f_candlestick(_close, _open, _high, _low, _time, _tf, _bar, _plot, start, _show_candle, _htf, e, te) =>
    [ch1, cl1, cc1, co1, ct1, ch0, cl0, cc0, co0, ct0] = f_live_sym(_close, _open, _high, _low, _time, _tf)
    var tf_h = array.new_float()
    var tf_l = array.new_float()
    var tf_c = array.new_float()
    var tf_o = array.new_float()
    var tf_t = array.new_int()
    var lbl1 = label.new(na, na)
    var ln1 = line.new(na, na, na, na)
    var ln2 = line.new(na, na, na, na)
    if timeframe.change(_tf)
        add_to_array_tf(tf_h, ch1, _bar)
        add_to_array_tf(tf_l, cl1, _bar)
        add_to_array_tf(tf_o, co1, _bar)
        add_to_array_tf(tf_c, cc1, _bar)
        add_to_array_tf(tf_t, ct1, _bar)

    if array.size(tf_h) > 5 * _bar - 1 and tf_ok(_tf) and _show_candle
        array_h0 = array.from(ch0)
        array_l0 = array.from(cl0)
        array_o0 = array.from(co0)
        array_c0 = array.from(cc0)
        array_t0 = array.from(ct0)

        tf_hh = array.concat(array_h0, tf_h)
        tf_ll = array.concat(array_l0, tf_l)
        tf_oo = array.concat(array_o0, tf_o)
        tf_cc = array.concat(array_c0, tf_c)
        tf_tt = array.concat(array_t0, tf_t)

        // Optimized Loop without Array Allocations
        _h0 = -1e8
        _l0 = 1e8
        for i = 0 to _bar - 1 by 1
            _h0 := math.max(_h0, array.get(tf_hh, i))
            _l0 := math.min(_l0, array.get(tf_ll, i))
        _o0 = array.get(tf_oo, _bar - 1)
        _c0 = _close
        _t0 = array.get(tf_tt, _bar - 1)

        _h1 = -1e8
        _l1 = 1e8
        for i = _bar to 2 * _bar - 1 by 1
            _h1 := math.max(_h1, array.get(tf_hh, i))
            _l1 := math.min(_l1, array.get(tf_ll, i))
        _o1 = array.get(tf_oo, 2 * _bar - 1)
        _c1 = array.get(tf_cc, _bar)
        _t1 = array.get(tf_tt, 2 * _bar - 1)

        _h2 = -1e8
        _l2 = 1e8
        for i = 2 * _bar to 3 * _bar - 1 by 1
            _h2 := math.max(_h2, array.get(tf_hh, i))
            _l2 := math.min(_l2, array.get(tf_ll, i))
        _o2 = array.get(tf_oo, 3 * _bar - 1)
        _c2 = array.get(tf_cc, 2 * _bar)
        _t2 = array.get(tf_tt, 3 * _bar - 1)

        _h3 = -1e8
        _l3 = 1e8
        for i = 3 * _bar to 4 * _bar - 1 by 1
            _h3 := math.max(_h3, array.get(tf_hh, i))
            _l3 := math.min(_l3, array.get(tf_ll, i))
        _o3 = array.get(tf_oo, 4 * _bar - 1)
        _c3 = array.get(tf_cc, 3 * _bar)
        _t3 = array.get(tf_tt, 4 * _bar - 1)

        _h4 = -1e8
        _l4 = 1e8
        for i = 4 * _bar to 5 * _bar - 1 by 1
            _h4 := math.max(_h4, array.get(tf_hh, i))
            _l4 := math.min(_l4, array.get(tf_ll, i))
        _o4 = array.get(tf_oo, 5 * _bar - 1)
        _c4 = array.get(tf_cc, 4 * _bar)
        _t4 = array.get(tf_tt, 5 * _bar - 1)

        if _plot
            f_secret_candle(_close, _o0, _h0, _l0, 0, start, _bar)
            f_secret_candle(_c1, _o1, _h1, _l1, 1, start, _bar)
            f_secret_candle(_c2, _o2, _h2, _l2, 2, start, _bar)
            f_secret_candle(_c3, _o3, _h3, _l3, 3, start, _bar)
            f_secret_candle(_c4, _o4, _h4, _l4, 4, start, _bar)

            lbltop = math.min(_l0, _l1, _l2, _l3, _l4)
            addtext_ = te == 1 ? str.tostring(syminfo.prefix(sym2)) : ''
            lbx = box.new(left = bar_index + dxx + start, top = lbltop - pattatr, right = bar_index + dxx + start + 20, bottom = lbltop - 1.8 * pattatr, bgcolor = color.teal, border_color = color.white, text = addtext_ + ' TF : ' + f_text(_tf) + ' / ' + str.tostring(_bar) + ' bar', text_size = sz, text_valign = text.align_center, text_halign = text.align_center, text_color = color.white)
            box.delete(lbx[1])

        var text1 = ''
        text_ = ''
        stext_ = ''
        found = false
        num = 0
        ploth = 0.0
        plotl = 0.0
        plott = 0
        singleh = 0.0
        singlel = 0.0
        singleo = 0.0

        [htf2h1, htf2l1, h2c1, h2o1, h2t1, htf2h0, htf2l0, h2c0, h2o0, h2t0] = f_live_sym(_close, _open, _high, _low, _time, _htf)
        arr_htf2h = array.from(htf2h0 == _h4, htf2h0 == _h3, htf2h0 == _h2, htf2h0 == _h1, htf2h0 == _h0, htf2h1 == _h4, htf2h1 == _h3, htf2h1 == _h2, htf2h1 == _h1, htf2h1 == _h0)
        arr_htf2l = array.from(htf2l0 == _l4, htf2l0 == _l3, htf2l0 == _l2, htf2l0 == _l1, htf2l0 == _l0, htf2l1 == _l4, htf2l1 == _l3, htf2l1 == _l2, htf2l1 == _l1, htf2l1 == _l0)

        con_ema_bull = str_emabull == 'All' ? true : (str_emabull == 'close > ema' and _c0 > e) or (str_emabull == 'close < ema' and _c0 < e)
        con_ema_bear = str_emabear == 'All' ? true : (str_emabear == 'close > ema' and _c0 > e) or (str_emabear == 'close < ema' and _c0 < e)

        con_htfbear = con_htf ? array.some(arr_htf2h) : true
        con_htfbull = con_htf ? array.some(arr_htf2l) : true
        filterbear = con_htfbear and con_ema_bear
        filterbull = con_htfbull and con_ema_bull

        // Hoisted repeated per-group high/low aggregates (computed once per bar;
        // side-effect-free, so unconditional computation is observationally identical).
        s2h = math.max(_h2, _h1, _h0)
        s2l = math.min(_l2, _l1, _l0)
        s3h = math.max(_h3, _h2, _h1, _h0)
