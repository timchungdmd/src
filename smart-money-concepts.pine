show382 = input.bool(defval = true, title = '', inline = '2', group = 'Auto Fibs')
show5 = input.bool(defval = true, title = '', inline = '3', group = 'Auto Fibs')
show618 = input.bool(defval = true, title = '', inline = '4', group = 'Auto Fibs')
show786 = input.bool(defval = true, title = '', group = 'Auto Fibs', inline = '5')
fib1 = input.float(defval = .236, title = '', minval = 0, step = 0.01, inline = '1', group = 'Auto Fibs')
fib2 = input.float(defval = .382, title = '', minval = 0, step = 0.01, inline = '2', group = 'Auto Fibs')
fib3 = input.float(defval = .5, title = '', minval = 0, step = 0.01, inline = '3', group = 'Auto Fibs')
fib4 = input.float(defval = .618, title = '', minval = 0, step = 0.01, inline = '4', group = 'Auto Fibs')
fib5 = input.float(defval = .786, title = '', minval = 0, step = 0.01, group = 'Auto Fibs', inline = '5')
fib1col = input.color(title = '', defval = color.gray, inline = '1', group = 'Auto Fibs')
fib2col = input.color(title = '', defval = color.lime, inline = '2', group = 'Auto Fibs')
fib3col = input.color(title = '', defval = color.yellow, inline = '3', group = 'Auto Fibs')
fib4col = input.color(title = '', defval = color.orange, inline = '4', group = 'Auto Fibs')
fib5col = input.color(title = '', defval = color.red, group = 'Auto Fibs', inline = '5')

var bigData = map.new<string, float>()

if bigData.size() == 0
    bigData.put('moving', 0)
    bigData.put('upaxis', 0.0)
    bigData.put('upaxis2', 0)
    bigData.put('dnaxis', 0.0)
    bigData.put('dnaxis2', 0)
    bigData.put('upside', 1)
    bigData.put('downside', 1)

[pdHigh, pdLow, dayHigh, dayLow, pdBar, dayBar] = request.security(syminfo.tickerid, '1D', [high[1], low[1], high, low, time[1], time])

type rollingTF
    float highTF = 0
    float lowTF = 1e8
    int highTFt = 0
    int lowTFt = 0
    float volTF = 0
    map<string, line> rTFdraw
    map<string, label> rTFlabel

method tfDraw(int tfDiff, bool showRollingLab, string tf, bool showLevels) =>
    TFhrdata = rollingTF.new()
    var volRolling = array.new<float>()

    if bar_index > tfDiff
        for i = 0 to tfDiff by 1
            if showLevels and barstate.islast
                getHigh = high[i]
                getLow = low[i]
                getTime = time[i]

                TFhrdata.highTF := math.max(TFhrdata.highTF, getHigh)
                TFhrdata.lowTF := math.min(TFhrdata.lowTF, getLow)

                if TFhrdata.highTF == getHigh
                    TFhrdata.highTFt := time[i]
                if TFhrdata.lowTF == getLow
                    TFhrdata.lowTFt := time[i]

            TFhrdata.volTF := TFhrdata.volTF + volume[i]

        volRolling.push(TFhrdata.volTF)

        var lineDraw = rollingTF.new(rTFdraw = map.new<string, line>(), rTFlabel = map.new<string, label>())

        if showLevels
            if lineDraw.rTFdraw.size() == 0
                lineDraw.rTFdraw.put('High', line.new(TFhrdata.highTFt, TFhrdata.highTF, time, TFhrdata.highTF, xloc = xloc.bar_time, color = color.aqua))
                lineDraw.rTFdraw.put('Low', line.new(TFhrdata.lowTFt, TFhrdata.lowTF, time, TFhrdata.lowTF, xloc = xloc.bar_time, color = color.aqua))
            else
                lineDraw.rTFdraw.get('High').set_xy1(TFhrdata.highTFt, TFhrdata.highTF)
                lineDraw.rTFdraw.get('High').set_xy2(time, TFhrdata.highTF)
                lineDraw.rTFdraw.get('Low').set_xy1(TFhrdata.lowTFt, TFhrdata.lowTF)
                lineDraw.rTFdraw.get('Low').set_xy2(time, TFhrdata.lowTF)

            if showRollingLab
                if lineDraw.rTFlabel.size() == 0
                    lineDraw.rTFlabel.put('High', label.new(time, TFhrdata.highTF, xloc = xloc.bar_time, textcolor = color.aqua, text = tf + 'H', size = size.tiny, style = label.style_label_left, color = #00000000))
                    lineDraw.rTFlabel.put('Low', label.new(time, TFhrdata.lowTF, xloc = xloc.bar_time, textcolor = color.aqua, text = tf + 'L', size = size.tiny, style = label.style_label_left, color = #00000000))
                else
                    lineDraw.rTFlabel.get('High').set_xy(time, TFhrdata.highTF)
                    lineDraw.rTFlabel.get('Low').set_xy(time, TFhrdata.lowTF)

    [TFhrdata.volTF, volRolling]

tfDrawLower(bool showRollingLab, simple string tf, bool showLevels) =>
    simple int end = switch tf
        '240' => 240
        '1D' => 1440

    [o, h, l, c, v, t] = request.security_lower_tf(syminfo.tickerid, '1', [open, high, low, close, volume, time])

    var oArr = array.new_float()
    var hArr = array.new_float()
    var lArr = array.new_float()
    var cArr = array.new_float()
    var vArr = array.new_float()
    var tArr = array.new_int()

    TFhrdata = rollingTF.new()
    var volRolling = array.new<float>()

    if h.size() > 0
        for i = 0 to h.size() - 1 by 1
            oArr.push(o.get(i))
            hArr.push(h.get(i))
            lArr.push(l.get(i))
            cArr.push(c.get(i))
            vArr.push(v.get(i))
            tArr.push(t.get(i))

            if hArr.size() > end
                oArr.shift()
                hArr.shift()
                lArr.shift()
                cArr.shift()
                vArr.shift()
                tArr.shift()

        for i = 0 to hArr.size() - 1 by 1
            if showLevels
                getHigh = hArr.get(i)
                getLow = lArr.get(i)

                TFhrdata.highTF := math.max(TFhrdata.highTF, getHigh)
                TFhrdata.lowTF := math.min(TFhrdata.lowTF, getLow)

                if TFhrdata.highTF == getHigh
                    TFhrdata.highTFt := tArr.get(i)
                if TFhrdata.lowTF == getLow
                    TFhrdata.lowTFt := tArr.get(i)

            TFhrdata.volTF := TFhrdata.volTF + vArr.get(i)

        volRolling.push(TFhrdata.volTF)

        var lineDraw = rollingTF.new(rTFdraw = map.new<string, line>(), rTFlabel = map.new<string, label>())

        if showLevels
            if lineDraw.rTFdraw.size() == 0
                lineDraw.rTFdraw.put('High', line.new(TFhrdata.highTFt, TFhrdata.highTF, time, TFhrdata.highTF, xloc = xloc.bar_time, color = color.aqua))
                lineDraw.rTFdraw.put('Low', line.new(TFhrdata.lowTFt, TFhrdata.lowTF, time, TFhrdata.lowTF, xloc = xloc.bar_time, color = color.aqua))
            else
                lineDraw.rTFdraw.get('High').set_xy1(TFhrdata.highTFt, TFhrdata.highTF)
                lineDraw.rTFdraw.get('High').set_xy2(time, TFhrdata.highTF)
                lineDraw.rTFdraw.get('Low').set_xy1(TFhrdata.lowTFt, TFhrdata.lowTF)
                lineDraw.rTFdraw.get('Low').set_xy2(time, TFhrdata.lowTF)

            if showRollingLab
                if lineDraw.rTFlabel.size() == 0
                    lineDraw.rTFlabel.put('High', label.new(time, TFhrdata.highTF, xloc = xloc.bar_time, textcolor = color.aqua, text = tf + 'H', size = size.tiny, style = label.style_label_left, color = #00000000))
                    lineDraw.rTFlabel.put('Low', label.new(time, TFhrdata.lowTF, xloc = xloc.bar_time, textcolor = color.aqua, text = tf + 'L', size = size.tiny, style = label.style_label_left, color = #00000000))
                else
                    lineDraw.rTFlabel.get('High').set_xy(time, TFhrdata.highTF)
                    lineDraw.rTFlabel.get('Low').set_xy(time, TFhrdata.lowTF)

    [TFhrdata.volTF, volRolling]

var r4hrbars = math.floor(timeframe.in_seconds('240') / timeframe.in_seconds(timeframe.period))
var rDbars = math.floor(timeframe.in_seconds('1D') / timeframe.in_seconds(timeframe.period))

[vol4hr, vol4hrArr] = switch 
    timeframe.in_seconds() <= 60 => r4hrbars.tfDraw(show4hLab, '240', show4H)
    => tfDrawLower(show4hLab, '240', show4H)

[vol1D, vol1DArr] = switch 
    timeframe.in_seconds() <= 60 => rDbars.tfDraw(show1DLab, '1D', show1D)
    => tfDrawLower(show1DLab, '1D', show1D)

calculatePivots(length) =>
    var int intraCalc = 0

    if bar_index > length + 1
        up = ta.highest(high, length)
        dn = ta.lowest(low, length)

        cHi = high[length]
        cLo = low[length]

        intraCalc := switch 
            cHi > up => 0
            cLo < dn => 1
            => intraCalc[1]

        topSwing = switch 
            intraCalc == 0 and intraCalc[1] != 0 => cHi
            => 0

        botSwing = switch 
            intraCalc == 1 and intraCalc[1] != 1 => cLo
            => 0

        [topSwing, botSwing]

[bigUpper, bigLower] = calculatePivots(extSens)
[smallUpper, smallLower] = calculatePivots(intSens)

var array<label> upLabel = array.new_label(1)
var array<label> dnLabel = array.new_label(1)

var array<box> highBlock = array.new_box()
var array<box> lowBlock = array.new_box()

drawChar(x, y, str, col, down) =>
    style = switch down
        true => label.style_label_down
        => label.style_label_up

    line.new(int(x), y, bar_index, y, color = col, style = line.style_dashed)
    label.new(math.round(math.avg(x, bar_index)), y, str, color = #00000000, textcolor = col, style = style, size = size.small)

drawStructureExt() =>
    var int counter = 0

    if bigUpper != 0
        bigData.put('upside', 1)
        x1 = bar_index - extSens

        txt = bigUpper > bigData.get('upaxis') ? 'HH' : 'LH'

        if showHHLH
            upLabel.set(0, label.new(x1, bigUpper, txt, color = color.new(color.white, 100), textcolor = bearC, style = label.style_label_down, size = size.small))

        if showOB
            highBlock.push(box.new(x1, bigUpper, last_bar_index + 5, bigUpper * .998, border_color = color.new(color.red, 75), bgcolor = color.new(color.red, 95)))

        bigData.put('upaxis', bigUpper)
        bigData.put('upaxis2', x1)

        counter := 1

    if bigLower != 0
        bigData.put('downside', 1)
        x1 = bar_index - extSens

        txt = bigLower < bigData.get('dnaxis') ? 'LL' : 'HL'

        if showHLLL == true
            dnLabel.set(0, label.new(x1, bigLower, txt, color = #ffffff00, textcolor = bullC, style = label.style_label_up, size = size.small))
        if showOB
            lowBlock.push(box.new(x1, bigLower, last_bar_index + 5, bigLower * 1.002, border_color = color.new(color.blue, 75), bgcolor = color.new(color.blue, 95)))

        bigData.put('dnaxis', bigLower)
        bigData.put('dnaxis2', x1)

        counter := -1

    if showExt
        if ta.crossover(close, bigData.get('upaxis'))
            if bigData.get('upside') != 0
                str = bigData.get('moving') < 0 ? (extStru != 'BoS' ? 'CHoCH' : '') : (extStru != 'CHoCH' ? 'BoS' : '')
                if extStru == 'All' or str.contains(extStru, str)
                    drawChar(bigData.get('upaxis2'), bigData.get('upaxis'), str, bullC, true)
                bigData.put('upside', 0)
                bigData.put('moving', 1)

        if ta.crossunder(close, bigData.get('dnaxis'))
            if bigData.get('downside') != 0
                str = bigData.get('moving') > 0 ? (extStru != 'BoS' ? 'CHoCH' : '') : (extStru != 'CHoCH' ? 'BoS' : '')
                if extStru == 'All' or str.contains(extStru, str)
                    drawChar(bigData.get('dnaxis2'), bigData.get('dnaxis'), str, bearC, false)
                bigData.put('downside', 0)
                bigData.put('moving', -1)

    counter

counter = drawStructureExt()

method updateBox(array<box> id) =>
    if id.size() > 0
        for i = 0 to id.size() - 1 by 1
            id.get(i).set_right(last_bar_index + 5)

method cleanseLevel(array<box> id, bool isHighBlock) =>
    if id.size() > 0
        for i = id.size() - 1 to 0 by 1
            condition = isHighBlock ? close >= id.get(i).get_top() : close <= id.get(i).get_bottom()
            if condition
                id.remove(i).delete()

        if id.size() > showLast and showLast != 0
            for i = id.size() - showLast to 0 by 1
                id.remove(i).delete()

highBlock.cleanseLevel(true)
lowBlock.cleanseLevel(false)

if barstate.islast
    highBlock.updateBox()
    lowBlock.updateBox()

method updateMain(line id) =>
    if barstate.islast
        hi = 0.0
        lo = 1e8

        if showFibs
            [bigUpperFibs, bigLowerFibs] = calculatePivots(25)

            var int counterFibs = 0

            if bigUpperFibs != 0
                counterFibs := 1
            if bigLowerFibs != 0
                counterFibs := -1

            if counterFibs == 1
                hi := 0.0
                id.set_xy1(int(bigData.get('upaxis2')), bigData.get('upaxis'))

                dist = bar_index - int(bigData.get('dnaxis2'))
                if dist > 0
                    lo := ta.lowest(low, dist)
                    lo_idx = ta.lowestbars(low, dist)
                    id.set_xy2(bar_index + lo_idx, lo)

            else if counterFibs == -1
                lo := 1e8
                id.set_xy1(int(bigData.get('dnaxis2')), bigData.get('dnaxis'))

                dist = bar_index - int(bigData.get('upaxis2'))
                if dist > 0
                    hi := ta.highest(high, dist)
                    hi_idx = ta.highestbars(high, dist)
                    id.set_xy2(bar_index + hi_idx, hi)

            if id.get_x2() < id.get_x1()
                x2 = id.get_x2()
                x1 = id.get_x1()
                y2 = id.get_y2()
                y1 = id.get_y1()
                id.set_xy2(x1, y1)
                id.set_xy1(x2, y2)

            if id.get_y2() < id.get_y1()
                id.set_color(#F24968)
            else
                id.set_color(#14D990)

var main = line.new(dnLabel.first().get_x(), dnLabel.first().get_y(), upLabel.first().get_x(), upLabel.first().get_y(), style = line.style_dashed, width = 2)

main.updateMain()

quickLine(getX2, y, col) =>
    line.new(getX2, y, bar_index + 5, y, color = color.new(col, 75))

quickLabel(y, txt, col) =>
    label.new(bar_index + 5, y, text = str.tostring(txt), color = #00000000, style = label.style_label_left, textcolor = col)

drawFibs() =>
    if barstate.islast
        var fibLine = array.new<line>(5)
        var fibLab = array.new<label>(5)

        if fibLine.size() > 0
            for i = 0 to fibLine.size() - 1 by 1
                fibLine.get(i).delete()
                fibLab.get(i).delete()

        if showFibs
            getY2 = main.get_y2()
            sub = main.get_y1() - getY2
            getX1 = main.get_x1()
            getX2 = main.get_x2()

            for i = 0 to fibLine.size() - 1 by 1
                mod = i % fibLine.size() - 1

                [y, col, txt] = switch mod
                    0 => [sub * fib1 + getY2, show236 ? fib1col : color.new(chart.bg_color, 100), fib1]
                    1 => [sub * fib2 + getY2, show382 ? fib2col : color.new(chart.bg_color, 100), fib2]
                    2 => [sub * fib3 + getY2, show5 ? fib3col : color.new(chart.bg_color, 100), fib3]
                    3 => [sub * fib4 + getY2, show618 ? fib4col : color.new(chart.bg_color, 100), fib4]
                    => [sub * fib5 + getY2, show786 ? fib5col : color.new(chart.bg_color, 100), fib5]

                fibLine.set(i, quickLine(getX2, y, col))
                fibLab.set(i, quickLabel(y, txt, col))

drawFibs()

drawStructureInternals() =>
    if showInt
        var keyValues = map.new<string, float>()

        if keyValues.size() == 0
            keyValues.put('movingSmall', 0)

        if smallUpper != 0
            keyValues.put('upsideSmall', 1)
            keyValues.put('upaxisSmall', smallUpper)
            keyValues.put('upaxis2Small', bar_index - intSens)

        if smallLower != 0
            keyValues.put('downsideSmall', 1)
            keyValues.put('dnaxisSmall', smallLower)
            keyValues.put('dnaxis2Small', bar_index - intSens)

        if ta.crossover(close, keyValues.get('upaxisSmall'))
            if keyValues.get('upsideSmall') != 0
                str = keyValues.get('movingSmall') < 0 ? (intStru != 'BoS' ? 'I-CHoCH' : '') : (intStru != 'CHoCH' ? 'I-BoS' : '')
                if intStru == 'All' or str.contains(str, intStru)
                    drawChar(keyValues.get('upaxis2Small'), keyValues.get('upaxisSmall'), str, bullC, true)
                keyValues.put('upsideSmall', 0)
                keyValues.put('movingSmall', 1)

        if ta.crossunder(close, keyValues.get('dnaxisSmall'))
            if keyValues.get('downsideSmall') != 0
                str = keyValues.get('movingSmall') > 0 ? (intStru != 'BoS' ? 'I-CHoCH' : '') : (intStru != 'CHoCH' ? 'I-BoS' : '')
                if intStru == 'All' or str.contains(str, intStru)
                    drawChar(keyValues.get('dnaxis2Small'), keyValues.get('dnaxisSmall'), str, bearC, false)
                keyValues.put('downsideSmall', 0)
                keyValues.put('movingSmall', -1)

drawStructureInternals()

drawAOE() =>
    atr = ta.atr(14)

    if showAOE
        if bar_index > 50
            maxaoiH = math.max(ta.highest(close, 50), ta.highest(open, 50))
            minaoiL = math.min(ta.lowest(close, 50), ta.lowest(open, 50))

            var aoeLevels = map.new<string, box>()

            if aoeLevels.size() == 0
                aoeLevels.put('High', box.new(bar_index[50], maxaoiH * 1.01, bar_index + 5, maxaoiH, border_color = #00000000, bgcolor = color.new(#F24968, 90), text = 'Area of Interest', text_size = size.small, text_color = color.new(#F24968, 33)))
                aoeLevels.put('Low', box.new(bar_index[50], minaoiL, bar_index + 5, minaoiL * .99, border_color = #00000000, bgcolor = color.new(#14D990, 90), text = 'Area of Interest', text_size = size.small, text_color = color.new(#14D990, 33)))

            getHighBox = aoeLevels.get('High')

            if close <= getHighBox.get_top() * 1.01
                getHighBox.set_lefttop(bar_index[50], maxaoiH + atr)
                getHighBox.set_rightbottom(bar_index + 5, maxaoiH)
                getHighBox.set_text('Area of Interest')
            else 
                getHighBox.set_lefttop(bar_index + 5, maxaoiH + atr)
                getHighBox.set_rightbottom(bar_index + 5, maxaoiH + atr)
                getHighBox.set_text('')

            getLowBox = aoeLevels.get('Low')

            if close >= getLowBox.get_bottom() * .99
                getLowBox.set_lefttop(bar_index[50], minaoiL)
                getLowBox.set_rightbottom(bar_index + 5, minaoiL - atr)
                getLowBox.set_text('Area of Interest')
            else 
                getLowBox.set_lefttop(bar_index + 5, minaoiL)
                getLowBox.set_rightbottom(bar_index + 5, -atr)
                getLowBox.set_text('')

drawAOE()

var table tab2 = table.new(position.top_right, 13, 13, bgcolor = #20222C, border_color = #363843, frame_color = #363843, border_width = 1, frame_width = 1)

nyHour = hour(timenow, 'America/New_York')
nyMinute = minute(timenow, 'America/New_York')

fvg(direction) =>
    var fvgMat = matrix.new<float>(5)
    var fvgDrawings = array.new<box>()

    fvgMat.add_col(0, array.from(math.sign(close - open), close, high, low, time))

    if fvgMat.columns() > 3
        fvgMat.remove_col(fvgMat.columns() - 1)

    if fvgMat.row(0).sum() == direction
        getDir = math.sign(direction)

        [y, y1] = switch getDir
            -1 => [fvgMat.get(3, 2), fvgMat.get(2, 0)]
            => [fvgMat.get(3, 0), fvgMat.get(2, 2)]

        col = closeOnly ? #00000000 : color.new(fvgcol, fvgtra)

        fvgDrawings.push(box.new(int(fvgMat.get(4, 1)), y, last_bar_time, y1, xloc = xloc.bar_time, border_color = col, bgcolor = col))

    fvgDrawings

if showFVG
    fvgDn = fvg(-3)
    fvgUp = fvg(3)

    if fvgDn.size() > 0
        for i = fvgDn.size() - 1 to 0 by 1
            getfvg = fvgDn.get(i)
            if high >= getfvg.get_top()
                getfvg.delete()
                fvgDn.remove(i)
            else if contract
                if high > getfvg.get_bottom()
                    getfvg.set_bottom(high)

    if fvgUp.size() > 0
        for i = fvgUp.size() - 1 to 0 by 1
            getfvg = fvgUp.get(i)
            if low <= getfvg.get_bottom()
                getfvg.delete()
                fvgUp.remove(i)
            else if contract
                if low < getfvg.get_top()
                    getfvg.set_top(low)

    if closeOnly and barstate.islast
        minDist = matrix.new<float>(1, 2, 20e20)

        if fvgDn.size() > 0
            for i = fvgDn.size() - 1 to 0 by 1
                getBottom = fvgDn.get(i).get_bottom()
                minDist.set(0, 1, math.min(minDist.get(0, 1), math.abs(close - getBottom)))
                if math.abs(close - getBottom) == minDist.get(0, 1)
                    minDist.set(0, 0, i)
                fvgDn.get(i).set_right(fvgDn.get(i).get_left())

            fvgDn.get(int(minDist.get(0, 0))).set_bgcolor(color.new(fvgcol, fvgtra))
            fvgDn.get(int(minDist.get(0, 0))).set_border_color(color.new(fvgcol, fvgtra))
            fvgDn.get(int(minDist.get(0, 0))).set_right(last_bar_time)

        minDist.set(0, 0, 0)
        minDist.set(0, 1, 20e20)

        if fvgUp.size() > 0
            for i = fvgUp.size() - 1 to 0 by 1
                getTop = fvgUp.get(i).get_top()
                minDist.set(0, 1, math.min(minDist.get(0, 1), math.abs(close - getTop)))
                if math.abs(close - getTop) == minDist.get(0, 1)
                    minDist.set(0, 0, i)
                fvgUp.get(i).set_right(fvgUp.get(i).get_left())

            fvgUp.get(int(minDist.get(0, 0))).set_bgcolor(color.new(fvgcol, fvgtra))
            fvgUp.get(int(minDist.get(0, 0))).set_border_color(color.new(fvgcol, fvgtra))
            fvgUp.get(int(minDist.get(0, 0))).set_right(last_bar_time)

calculateTimeDifference(timestamp1, timestamp2) =>
    timeDifference = timestamp2 - timestamp1
    hours = math.floor(timeDifference / 3600000)
    minutes = math.floor(timeDifference % 3600000 / 60000)
    [hours, minutes]

dayAdjustment = hour(timenow, 'America/New_York') < 2 ? dayofmonth(timenow) + 1 : dayofmonth(timenow)

timeIsInRange(startHour, startMinute, endHour, endMinute) =>
    (nyHour > startHour or nyHour == startHour and nyMinute >= startMinute) and (nyHour < endHour or nyHour == endHour and nyMinute <= endMinute)

[chartcol, timetilchange, stringCol, stringCol2] = switch 
    timeIsInRange(9, 30, 16, 0) => [#f24968, timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 16, 0, 0), 'New York', 'Asia']
    timeIsInRange(20, 0, 2, 0) => [#14D990, timestamp('America/New_York', year(timenow), month(timenow), dayAdjustment, 2, 0, 0), 'Asia', 'London']
    timeIsInRange(3, 0, 11, 30) => [#F2B807, timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 11, 30, 0), 'London', 'New York']
    => [color.gray, int(na), 'Dead Zone', nyHour > 16 or nyHour < 3 ? 'London' : nyHour >= 11 and nyHour < 20 ? 'Asia' : 'New York']

[hours, minutes] = calculateTimeDifference(timenow, timetilchange)

timetilchange2 = switch 
    timeIsInRange(9, 30, 16, 0) => timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 20, 0, 0)
    timeIsInRange(20, 0, 2, 0) => timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 3, 0, 0)
    timeIsInRange(3, 0, 11, 30) => timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 9, 30, 0)
    => na

if na(timetilchange2)
    timetilchange2 := switch 
        nyHour < 9 or nyHour == 9 and nyMinute < 30 => timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 9, 30, 0)
        nyHour < 20 or nyHour >= 16 and nyHour < 20 => timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 20, 0, 0)
        nyHour < 3 or nyHour >= 2 and nyHour < 3 => timestamp('America/New_York', year(timenow), month(timenow), dayofmonth(timenow), 3, 0, 0)
        => na

[hours2, minutes2] = calculateTimeDifference(timenow, timetilchange2)

method getActivity(array<float> id, float id2) =>
    if id.size() > 0
        volPerc1 = id.percentile_nearest_rank(10)
        volPerc2 = id.percentile_nearest_rank(33)
        volPerc3 = id.percentile_nearest_rank(50)
        volPerc4 = id.percentile_nearest_rank(66)
        volPerc5 = id.percentile_nearest_rank(90)

        activity = switch 
            id2 <= volPerc1 => 'Very Low'
            id2 <= volPerc2 => 'Low'
            id2 <= volPerc3 => 'Average'
            id2 <= volPerc4 => 'High'
            => 'Very High'

        activity

if barstate.islast
    hr4Act = vol4hrArr.getActivity(vol4hr)
    D1Act = vol1DArr.getActivity(vol1D)

    table.cell(tab2, 0, 2, text = 'Session:', text_color = color.white, text_halign = text.align_left)
    table.cell(tab2, 0, 3, text = 'Session Close:', text_color = color.white, text_halign = text.align_left)
    table.cell(tab2, 0, 4, text = 'Next Session:', text_color = color.white, text_halign = text.align_left)
    table.cell(tab2, 0, 5, text = 'Next Session Open:', text_color = color.white, text_halign = text.align_left)
    table.cell(tab2, 0, 6, text = '4-Hr Volume:', text_color = color.white, text_halign = text.align_left)
    table.cell(tab2, 0, 7, text = '24-Hr Volume:', text_color = color.white, text_halign = text.align_left)

    table.cell(tab2, 1, 2, text = stringCol, text_color = color.white)
    table.cell(tab2, 1, 3, text = stringCol != 'Dead Zone' ? str.tostring(hours) + 'h' + str.tostring(minutes) + 'm' : 'Dead Zone', text_color = color.white)
    table.cell(tab2, 1, 4, text = stringCol2, text_color = color.white)
    table.cell(tab2, 1, 5, text = str.tostring(hours2) + 'h:' + str.tostring(minutes2) + 'm', text_color = color.white)
    table.cell(tab2, 1, 6, text = hr4Act, text_color = color.white)
    table.cell(tab2, 1, 7, text = D1Act, text_color = color.white)

nyHour2 = hour(time, 'America/New_York')
nyMinute2 = minute(time, 'America/New_York')

timeIsInRange2(startHour, startMinute, endHour, endMinute) =>
    if endHour >= startHour
        (nyHour2 > startHour or nyHour2 == startHour and nyMinute2 >= startMinute) and (nyHour2 < endHour or nyHour2 == endHour and nyMinute2 <= endMinute)
    else
        nyHour2 > startHour or nyHour2 == startHour and nyMinute2 >= startMinute or nyHour2 < endHour or nyHour2 == endHour and nyMinute2 <= endMinute

nyCol = input.color(defval = #f24968, title = 'NY Color')
asCol = input.color(defval = #14D990, title = 'Asia Color')
loCol = input.color(defval = #F2B807, title = 'London Color')
tra = input.int(defval = 98, minval = 0, maxval = 100, title = 'Transparency')

bgcolor(timeIsInRange2(9, 30, 16, 0) ? color.new(nyCol, tra) : na)
bgcolor(timeIsInRange2(20, 0, 2, 0) ? color.new(asCol, tra) : na)
bgcolor(timeIsInRange2(3, 0, 11, 30) ? color.new(loCol, tra) : na)

/////////////HTF FGV///////////
display = display.all - display.status_line

fvgGR = 'Fair Value Gaps #1, Chart/HTF'
fvgTip1 = 'Select the timeframe from which Fair Value Gaps (FVGs) will be detected.\n• Chart — uses the current chart timeframe.\n• Higher timeframes — plots FVGs derived from the selected timeframe above the chart.\n\nIf a lower timeframe than the chart is selected, the script automatically defaults to the chart timeframe.'
fvgFillTip1 = 'Defines how a Fair Value Gap (FVG) is considered filled:\n• Any Touch — when price (wick or body) touches any part of the imbalance zone.\n• Midpoint Reached — when price trades to at least the midpoint (50%) of the zone.\n• Wick Sweep — when a wick fully passes through the entire FVG and returns inside the zone.\n• Body Beyond — when the candle body closes beyond the opposite edge of the FVG, confirming full repair.'
fvgLBTip1 = 'Controls the visibility of Fair Value Gap (FVG) labels.\n\n• **Show** — displays labels directly on the chart. Each label indicates the timeframe and fill progress of the zone.\n• **Hide** — hides on-chart labels, but tooltips remain accessible by hovering over the midpoint of each FVG zone.'

fvgSH1 = input.bool(true, 'Fair Value Gaps #1, Chart/HTF', inline = 'fvg1', group = fvgGR)
fvgTF1 = input.string('Chart', '', options = ['Chart', '5 Minutes', '15 Minutes', '1 Hour', '4 Hours', '1 Day', '1 Week', '1 Month'], inline = 'fvg1', group = fvgGR, tooltip = fvgTip1, display = display)
fvgFill1 = input.string('Wick Sweep', '  FVG #1 Fill Method', options = ['Any Touch', 'Midpoint Reached', 'Wick Sweep', 'Body Beyond'], display = display, tooltip = fvgFillTip1, group = fvgGR)
fvgCb1 = input.color(#00B8D9, '  FVG #1 Zones    ', inline = 'fvg', group = fvgGR)
fvgCs1 = input.color(#FF8B00, '', inline = 'fvg', group = fvgGR)
fvgLB1 = input.string('Show', '  FVG #1 Labels', options = ['Show', 'Hide'], tooltip = fvgLBTip1, display = display, group = fvgGR)
maxBars = input.int(360, '  Max Bars Back', minval = 1, step = 20, group = fvgGR, display = display, tooltip = 'This determines how far back the script will analyze for Fair Value Gaps.')

fvgGR2 = 'Fair Value Gaps #, Chart/HTF'
fvgSH2 = input.bool(false, 'Fair Value Gaps #2, Chart/HTF', inline = 'fvg2', group = fvgGR2)
fvgTF2 = input.string('1 Hour', '', options = ['Chart', '5 Minutes', '15 Minutes', '1 Hour', '4 Hours', '1 Day', '1 Week', '1 Month'], inline = 'fvg2', group = fvgGR2, tooltip = fvgTip1, display = display)
fvgFill2 = input.string('Wick Sweep', '  FVG #2 Fill Method', options = ['Any Touch', 'Midpoint Reached', 'Wick Sweep', 'Body Beyond'], display = display, tooltip = fvgFillTip1, group = fvgGR2)
fvgCb2 = input.color(#6EE7B7, '  FVG #2 Zones    ', inline = 'fvg', group = fvgGR2)
fvgCs2 = input.color(#FF6B6B, '', inline = 'fvg', group = fvgGR2)
fvgLB2 = input.string('Hide', '  FVG #2 Labels', options = ['Show', 'Hide'], tooltip = fvgLBTip1, display = display, group = fvgGR2)
maxBars2 = input.int(360, '  Max Bars Back', minval = 1, step = 20, group = fvgGR2, display = display, tooltip = 'This determines how far back the script will analyze for Fair Value Gaps.')

fvgGR3 = 'Fair Value Gaps #3, LTF'
fvgTip3 = 'Intrabar timeframe (lower timeframe, LTF) setting option. When set to "Auto", the lower timeframe is determined by the following algorithm:\n  Chart Timeframe → Lower Timeframe\n\t\t<= 3 min\t\t→ 15 sec\n\t\t<= 30 min\t\t→ 1 min\n\t\t<= 2 hour\t\t→ 5 min\n\t\t<= 4 hour\t\t→ 15 min\n\t\t<= 1 day\t\t→ 1 hour\n\t\t<= 1 week\t\t→ 4 hour\n\t\t<= 1 month\t→ 1 day\n\t\t>  1 month\t→ 1 week'

fvgSH3 = input.bool(false, 'Fair Value Gaps #3, LTF', inline = 'fvg3', group = fvgGR3)
fvgTF3 = input.timeframe('Auto', '', options = ['Auto', '1S', '5S', '10S', '15S', '30S', '1m', '3m', '5m', '15m', '30m', '45m', '1H', '2H', '3H', '4H', 'D'], inline = 'fvg3', group = fvgGR3, tooltip = fvgTip3)
fvgThTip = 'Checks the significance of the detected fair value gap compared to a fixed-length average true range. Setting the value to 0 means that no filtering will be applied, whereas values greater than zero determine the filtering threshold value'
fvgTH3 = input.float(.7, '  FVG Filter Threshold', minval = 0, step = .1, group = fvgGR3, tooltip = fvgThTip)

fvgCb3 = input.color(#8BC34A, '  FVG #3 Zones    ', inline = 'VD', group = fvgGR3)
fvgCs3 = input.color(#E91E63, '', inline = 'VD', group = fvgGR3)

fvgLBTip3 = 'Controls the visibility of lower-timeframe Fair Value Gap (FVG) labels.\n\n• **Show** — displays labels for each detected LTF FVG, indicating the source lower timeframe of the zone.\n• **Hide** — hides the on-chart labels, while tooltips remain available when hovering over the midpoint of each LTF FVG zone.'
fvgLB3 = input.string('Hide', '  FVG #3 Labels', options = ['Show', 'Hide'], tooltip = fvgLBTip3, display = display, group = fvgGR3)

type BAR
    float open  = open
    float high  = high
    float low   = low
    float close = close
    int   index = bar_index

    float ltfHigh
    float ltfHigh1
    float ltfHigh2
    float ltfLow
    float ltfLow1
    float ltfLow2
    float ltfClose
    float ltfClose1

type HTFBar
    float price = na
    int   index = na

type HTFBarOHLC
    HTFBar open
    HTFBar high
    HTFBar low
    HTFBar close

type FVG
    label  lbTxt
    line   lnTop
    line   lnAvg
    line   lnBtm
    float  mitPrice
    float  mit
    string txt
    
BAR htfbar = BAR.new()

ltfTF(_t) =>
    str.contains(_t, 'S') or str.contains(_t, 'D') or str.contains(_t, 'W') or str.contains(_t, 'M') ? _t : 
     str.contains(_t, 'm') ? str.replace(_t, 'm', '', 0) : str.contains(_t, 'H') ? str.tostring(str.tonumber(str.replace(_t, 'H', '', 0)) * 60) : '12M'

ltfTF() =>
    int tfInMs = timeframe.in_seconds(timeframe.period)
    int mInMS = 60
    switch 
        tfInMs <= 1 * mInMS => '5S'
        tfInMs <= 3 * mInMS => '15S'
        tfInMs <= 30 * mInMS => '1'
        tfInMs <= 120 * mInMS => '5'
        tfInMs <= 240 * mInMS => '15'
        tfInMs <= 1440 * mInMS => '60'
        tfInMs <= 7 * 1440 * mInMS => '240'
        tfInMs <= 31 * 1440 * mInMS => 'D'
        => 'W'

htfTF(usrTF) =>
    float chartTFin = timeframe.in_seconds() / 60
    switch 
        usrTF == '5 Minutes' and chartTFin <= 5 => '5'
        usrTF == '15 Minutes' and chartTFin <= 15 => '15'
        usrTF == '1 Hour' and chartTFin <= 60 => '60'
        usrTF == '4 Hours' and chartTFin <= 240 => '240'
        usrTF == '1 Day' and timeframe.isintraday => 'D'
        usrTF == '1 Week' and (timeframe.isdaily or timeframe.isintraday) => 'W'
        usrTF == '1 Month' and (timeframe.isweekly or timeframe.isdaily or timeframe.isintraday) => 'M'
        => timeframe.period

updateFvg(fvgArray, fill, side, fvgLb) =>
    if fvgArray.size() > 0
        for i = array.size(fvgArray) - 1 to 0
            this = array.get(fvgArray, i)

            if side == "bull" ? (fill == 'Body Beyond' ? htfbar.close : htfbar.low) <= this.mitPrice : (fill == 'Body Beyond' ? htfbar.close : htfbar.high) > this.mitPrice
                fvgArray.remove(i)

                this.lbTxt.delete()
                this.lnTop.delete()
                this.lnAvg.delete()
                this.lnBtm.delete()
            else
                this.lbTxt.set_x(htfbar.index + 1)
                this.lnTop.set_x2(htfbar.index + 1)
                this.lnAvg.set_x2(htfbar.index + 1)
                this.lnBtm.set_x2(htfbar.index + 1)

                fillRatio = switch side
                    "bull" => (this.lnTop.get_y1() - htfbar.low)  / (this.lnTop.get_y1() - this.lnBtm.get_y1())
                    "bear" => (htfbar.high - this.lnBtm.get_y1()) / (this.lnTop.get_y1() - this.lnBtm.get_y1())
                    => 0.0
                
                if fillRatio > this.mit
                    this.mit := fillRatio
                    this.lbTxt.set_text( fvgLb == 'Show' ? this.txt + str.format("{0,number,(#.#%)}", fillRatio) : '') 

renderFvg(show, tfIn, fill, cBull, cBear, fvgLb) =>
    if show
        var array<FVG> bullFvgArray = array.new<FVG>()
        var array<FVG> bearFvgArray = array.new<FVG>()
        var array<HTFBarOHLC> barArray = array.new<HTFBarOHLC>()

        var HTFBar barOpen = HTFBar.new(htfbar.open,htfbar.index)
        var HTFBar barHigh = HTFBar.new(htfbar.high, htfbar.index)
        var HTFBar barLow = HTFBar.new(htfbar.low, htfbar.index)
        var HTFBar barClose = HTFBar.new(htfbar.close, htfbar.index)

        var barHist = HTFBarOHLC.new(barOpen, barHigh, barLow, barClose)

        var int bullBarIndexEnd = na
        var int bullBarIndexEnd1 = na
        var int bearBarIndexEnd = na
        var int bearBarIndexEnd1 = na

        var bool bullProcess = false
        var bool bearProcess = false

        bool bullG = false
        bool bearG = false
        bool bullCondition = false
        bool bearCondition = false

        string tf = htfTF(tfIn)
        fvgTf = tf == timeframe.period

        if timeframe.change(tf)
            bullProcess := false
            bearProcess := false

            if barArray.size() > 2
                barArray.pop()

            barArray.unshift(barHist)

            barOpen  := HTFBar.new(htfbar.open, htfbar.index)
            barHigh  := HTFBar.new(htfbar.high, htfbar.index)
            barLow   := HTFBar.new(htfbar.low, htfbar.index)
            barClose := HTFBar.new(htfbar.close, htfbar.index)

            barHist  := HTFBarOHLC.new(barOpen, barHigh, barLow, barClose) 

            bullBarIndexEnd1 := bullBarIndexEnd
            bullBarIndexEnd  := htfbar.index
            bearBarIndexEnd1 := bearBarIndexEnd
            bearBarIndexEnd  := htfbar.index

        else
            if htfbar.high > barHigh.price
                barHigh.price := htfbar.high
                barHigh.index := htfbar.index

            if htfbar.low < barLow.price
                barLow.price := htfbar.low
                barLow.index := htfbar.index

            barClose.price := htfbar.close
            barClose.index := htfbar.index

            if barArray.size() > 2
                if htfbar.low < barArray.get(1).high.price
                    bullBarIndexEnd := htfbar.index

                if htfbar.high > barArray.get(1).low.price
                    bearBarIndexEnd := htfbar.index

        if barArray.size() > 2
            bullG := barArray.get(0).low.price > barArray.get(1).high.price or barArray.get(1).low.price > barArray.get(2).high.price
            bullCondition := barArray.get(0).low.price > barArray.get(2).high.price and barArray.get(1).close.price > barArray.get(2).high.price and not bullG

            bearG := barArray.get(0).high.price < barArray.get(1).low.price or barArray.get(1).high.price < barArray.get(2).low.price
            bearCondition := barArray.get(0).high.price < barArray.get(2).low.price and barArray.get(1).close.price < barArray.get(2).low.price and not bearG

        if bullCondition and not bullProcess
            bullProcess := true

            bullFvgArray.unshift(
             FVG.new(
                 label.new(htfbar.index + 1, math.avg(barArray.get(0).low.price, barArray.get(2).high.price), fvgLb == 'Show' ? fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = cBull, size = size.small, 
                  tooltip = (fvgTf ? 'Chart(' + tf + ') Bullish FVG' : 'HTF(' + tf + ') Bullish FVG') + '\n\nZone Top · ' + str.format("{0, number, #,###.##}", barArray.get(0).low.price) + '\nZone Mid · ' + str.format("{0, number, #,###.##}", math.avg(barArray.get(0).low.price, barArray.get(2).high.price)) + '\nZone Btm · ' + str.format("{0, number, #,###.##}", barArray.get(2).high.price) ),
                 line.new(barArray.get(0).low.index, barArray.get(0).low.price, htfbar.index + 1, barArray.get(0).low.price, color = color.new(cBull, 65)),
                 line.new(math.ceil(math.avg(barArray.get(0).low.index, barArray.get(2).high.index)), math.avg(barArray.get(0).low.price, barArray.get(2).high.price), htfbar.index + 1, math.avg(barArray.get(0).low.price, barArray.get(2).high.price), style = line.style_dotted, color = color.new(cBull, 25)),
                 line.new(barArray.get(2).high.index, barArray.get(2).high.price, htfbar.index + 1, barArray.get(2).high.price, color = color.new(cBull, 50), width = 2), 
                 fill == 'Midpoint Reached' ? math.avg(barArray.get(2).low.price, barArray.get(0).high.price) : fill == 'Any Touch' ? barArray.get(0).low.price : barArray.get(2).high.price, 0, fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG')
             )

            first = bullFvgArray.first()
            linefill.new(first.lnTop, first.lnBtm, color.new(cBull, 89))

        if bearCondition and not bearProcess
            bearProcess := true

            bearFvgArray.unshift(
             FVG.new(
                 label.new(htfbar.index + 1, math.avg(barArray.get(2).low.price, barArray.get(0).high.price), fvgLb == 'Show' ? fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = cBear, size = size.small, 
                  tooltip = (fvgTf ? 'Chart(' + tf + ') Bearish FVG' : 'HTF(' + tf + ') Bearish FVG') + '\n\nZone Top · ' + str.format("{0, number, #,###.##}", barArray.get(2).low.price) + '\nZone Mid · ' + str.format("{0, number, #,###.##}", math.avg(barArray.get(2).low.price, barArray.get(0).high.price)) + '\nZone Btm · ' + str.format("{0, number, #,###.##}", barArray.get(0).high.price) ),
                 line.new(barArray.get(2).low.index, barArray.get(2).low.price, htfbar.index + 1, barArray.get(2).low.price, color = color.new(cBear, 50), width = 2), 
                 line.new(math.ceil(math.avg(barArray.get(2).low.index, barArray.get(0).high.index)), math.avg(barArray.get(2).low.price, barArray.get(0).high.price), htfbar.index + 1, math.avg(barArray.get(2).low.price, barArray.get(0).high.price), style = line.style_dotted, color = color.new(cBear, 25)), 
                 line.new(barArray.get(0).high.index, barArray.get(0).high.price, htfbar.index + 1, barArray.get(0).high.price, color = color.new(cBear, 65)), 
                 fill == 'Midpoint Reached' ? math.avg(barArray.get(2).low.price, barArray.get(0).high.price) : fill == 'Any Touch' ? barArray.get(0).high.price : barArray.get(2).low.price, 0, fvgTf ? 'Chart(' + tf + ') FVG' : 'HTF(' + tf + ') FVG')
             )
             
            first = bearFvgArray.first()
            linefill.new(first.lnTop, first.lnBtm, color.new(cBear, 89))

        updateFvg(bullFvgArray, fill, 'bull', fvgLb)
        updateFvg(bearFvgArray, fill, 'bear', fvgLb)

var fvgLTFbx = array.new_box()
var fvgLTFlb = array.new_label()

ltf = fvgTF3 == 'Auto' ? ltfTF() : ltfTF(fvgTF3)
[aO, aH, aL, aC, atr] = request.security_lower_tf(syminfo.tickerid, ltf, [htfbar.open, htfbar.high, htfbar.low, htfbar.close, ta.atr(13)])

if fvgSH3 and timeframe.change(timeframe.period) and array.size(aH) > 0 
    for i = 0 to aH.size() - 1 by 1

        htfbar.ltfClose1 := htfbar.ltfClose
        htfbar.ltfClose  := aC.get(i)

        htfbar.ltfHigh2  := htfbar.ltfHigh1
        htfbar.ltfHigh1  := htfbar.ltfHigh
        htfbar.ltfHigh   := aH.get(i)

        htfbar.ltfLow2   := htfbar.ltfLow1
        htfbar.ltfLow1   := htfbar.ltfLow
        htfbar.ltfLow    := aL.get(i)

        bull = htfbar.ltfLow - htfbar.ltfHigh2 > atr.get(i) * fvgTH3 and htfbar.ltfLow > htfbar.ltfHigh2 and htfbar.ltfClose1 > htfbar.ltfHigh2

        if bull
            fvgLTFbx.push(box.new(htfbar.index, htfbar.ltfLow, htfbar.index + 1, htfbar.ltfHigh2, color.new(fvgCb3, 73), bgcolor = color.new(fvgCb3, 73))) 
            fvgLTFlb.push(
             label.new(htfbar.index + 1, math.avg(htfbar.ltfLow, htfbar.ltfHigh2), fvgLB3 == 'Show' ? 'LTF(' + ltf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = fvgCb3, size = size.small, 
                  tooltip = 'LTF(' + ltf + ') Bullish FVG' )
             )

        bear = htfbar.ltfLow2 - htfbar.ltfHigh > atr.get(i) * fvgTH3 and htfbar.ltfHigh < htfbar.ltfLow2 and htfbar.ltfClose1 < htfbar.ltfLow2

        if bear
            fvgLTFbx.push(box.new(htfbar.index, htfbar.ltfLow2, htfbar.index + 1, htfbar.ltfHigh, color.new(fvgCs3, 73), bgcolor = color.new(fvgCs3, 73)))
            fvgLTFlb.push(
             label.new(htfbar.index + 1, math.avg(htfbar.ltfLow2, htfbar.ltfHigh), fvgLB3 == 'Show' ? 'LTF(' + ltf + ') FVG' : '', xloc.bar_index, color = color(na), style = label.style_label_left, textcolor = fvgCs3, size = size.small, 
                  tooltip = 'LTF(' + ltf + ') Bearish FVG' )
             )

        if fvgLTFbx.size() > 0
            qt = fvgLTFbx.size()

            for bn = qt - 1 to 0 by 1
                if bn < fvgLTFbx.size()
                    cBX = fvgLTFbx.get(bn)
                    cLB = fvgLTFlb.get(bn)
                    tBX = cBX.get_top()
                    bBX = cBX.get_bottom()

                    if htfbar.ltfHigh >= tBX and htfbar.ltfLow <= bBX
                        cBX.delete()
                        fvgLTFbx.remove(bn)
                        fvgLTFlb.remove(bn)
                        cLB.delete()
                    else
                        if htfbar.ltfHigh > bBX and htfbar.ltfHigh < tBX
                            cBX.set_bottom(htfbar.ltfHigh)
                            cLB.set_y(math.avg(cBX.get_top(), htfbar.ltfHigh))

                        if htfbar.ltfLow < tBX and htfbar.ltfLow > bBX
                            cBX.set_top(htfbar.ltfLow)
                            cLB.set_y(math.avg(cBX.get_bottom(),htfbar.ltfLow))

        if fvgLTFbx.size() > 250
            cBX = fvgLTFbx.shift()
            cLB = fvgLTFlb.shift()
            cBX.delete()
            cLB.delete()

if fvgLTFbx.size() > 0
    qt = fvgLTFbx.size()

    for bn = qt - 1 to 0 by 1
        if bn < fvgLTFbx.size()
            cBX = fvgLTFbx.get(bn)
            cLB = fvgLTFlb.get(bn)
            tBX = cBX.get_top()
            bBX = cBX.get_bottom()

            if htfbar.high > tBX and htfbar.low < bBX and htfbar.index > cBX.get_left()
                fvgLTFbx.remove(bn)
                cBX.delete()
                fvgLTFlb.remove(bn)
                cLB.delete()
            else
                cBX.set_right(htfbar.index + 1)
                cBX.set_border_color(na)
                cLB.set_x(htfbar.index + 1)

if last_bar_index - bar_index <= maxBars and fvgSH1
    renderFvg(fvgSH1, fvgTF1, fvgFill1, fvgCb1, fvgCs1, fvgLB1)

if last_bar_index - bar_index <= maxBars2 and fvgSH2
    renderFvg(fvgSH2, fvgTF2, fvgFill2, fvgCb2, fvgCs2, fvgLB2)

table logo = table.new(position.bottom_right, 1, 1)
if barstate.isfirst
    table.cell(logo, 0, 0, '☼☾  ', text_size = size.normal, text_color = color.teal)

//==============================================================================
//                     SHARED ZIGZAG SETTINGS
//==============================================================================
lbR = input.int(5, 'Lookback: Right', inline = 'lb', group = 'Zigzag Settings')
lbL = input.int(120, 'Left', inline = 'lb', group = 'Zigzag Settings')
show_zigzag = input.bool(true, 'Show Zigzag', inline = 'zigzag', group = 'Zigzag Settings')
zigzag_color = input.color(#c8ff0004, 'Color', inline = 'zigzag', group = 'Zigzag Settings')
retrepaint = input.bool(true, 'Repaint', inline = 'zigzag', group = 'Zigzag Settings') and show_zigzag

//==============================================================================
//                     FIBONACCI RETRACEMENT SETTINGS
//==============================================================================
fib = array.new_float(0)
fib_col = array.new_color(0)

fib_a_lvl = input(0, '', inline = 'ret_inline1', group = 'Fibonacci Retracement Levels')
fib_a_col = input(#ffffff, '', inline = 'ret_inline1', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline1', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_a_lvl)
    array.push(fib_col, fib_a_col)

fib_b_lvl = input(0.236, '', inline = 'ret_inline2', group = 'Fibonacci Retracement Levels')
fib_b_col = input(#ffffff, '', inline = 'ret_inline2', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline2', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_b_lvl)
    array.push(fib_col, fib_b_col)

fib_c_lvl = input(0.382, '', inline = 'ret_inline3', group = 'Fibonacci Retracement Levels')
fib_c_col = input(#ffffff, '', inline = 'ret_inline3', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline3', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_c_lvl)
    array.push(fib_col, fib_c_col)

fib_d_lvl = input(0.5, '', inline = 'ret_inline4', group = 'Fibonacci Retracement Levels')
fib_d_col = input(#ffffff, '', inline = 'ret_inline4', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline4', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_d_lvl)
    array.push(fib_col, fib_d_col)

fib_e_lvl = input(0.618, '', inline = 'ret_inline5', group = 'Fibonacci Retracement Levels')
fib_e_col = input(#ffffff, '', inline = 'ret_inline5', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline5', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_e_lvl)
    array.push(fib_col, fib_e_col)

fib_f_lvl = input(0.786, '', inline = 'ret_inline6', group = 'Fibonacci Retracement Levels')
fib_f_col = input(#ffffff, '', inline = 'ret_inline6', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline6', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_f_lvl)
    array.push(fib_col, fib_f_col)

fib_g_lvl = input(1, '', inline = 'ret_inline7', group = 'Fibonacci Retracement Levels')
fib_g_col = input(#ffffff, '', inline = 'ret_inline7', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline7', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_g_lvl)
    array.push(fib_col, fib_g_col)

fib_h_lvl = input(1.272, '', inline = 'ret_inline8', group = 'Fibonacci Retracement Levels')
fib_h_col = input(#ffffff, '', inline = 'ret_inline8', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline8', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_h_lvl)
    array.push(fib_col, fib_h_col)

fib_i_lvl = input(1.414, '', inline = 'ret_inline9', group = 'Fibonacci Retracement Levels')
fib_i_col = input(#ffffff, '', inline = 'ret_inline9', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline9', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_i_lvl)
    array.push(fib_col, fib_i_col)

fib_j_lvl = input(1.618, '', inline = 'ret_inline10', group = 'Fibonacci Retracement Levels')
fib_j_col = input(#ffffff, '', inline = 'ret_inline10', group = 'Fibonacci Retracement Levels')
if input(true, '', inline = 'ret_inline10', group = 'Fibonacci Retracement Levels')
    array.push(fib, fib_j_lvl)
    array.push(fib_col, fib_j_col)

ret_bars = input.int(60, 'Retracement Bars', group = 'Fibonacci Retracement Levels', tooltip = 'the lines will be extended "Bars" + "Right Lookback" bars to the right')

//==============================================================================
//                     SHARED ZIGZAG LOGIC
//==============================================================================
new_pivot_high = not na(ta.pivothigh(high, lbL, lbR))
new_pivot_low = not na(ta.pivotlow(low, lbL, lbR))
new_pivot = new_pivot_high or new_pivot_low

direction = math.sign(ta.barssince(new_pivot_high) - ta.barssince(new_pivot_low))
new_direction = bool(ta.change(direction))

var chart.point last_pivot = chart.point.now(low)
var chart.point second_last_pivot = chart.point.now(high)

if new_direction
    second_last_pivot := last_pivot.copy()

if new_pivot_high
    if new_direction
        last_pivot := chart.point.from_index(bar_index - lbR, high[lbR])
    else
        if high[lbR] > last_pivot.price
            last_pivot := chart.point.from_index(bar_index - lbR, high[lbR])

if new_pivot_low
    if new_direction
        last_pivot := chart.point.from_index(bar_index - lbR, low[lbR])
    else
        if low[lbR] < last_pivot.price
            last_pivot := chart.point.from_index(bar_index - lbR, low[lbR])

var line retzigzag = na

if new_pivot and show_zigzag
    retzigzag := line.new(last_pivot, second_last_pivot, xloc.bar_index, extend.none, zigzag_color)
    if not new_direction
        line.delete(retzigzag[1])

var array<chart.point> points = array.new<chart.point>()

if bool(ta.change(bar_index))
    points.clear()
    points.push(last_pivot)
    points.push(chart.point.now(hl2))

var polyline repainted_zigzag = na

if retrepaint
    polyline.delete(repainted_zigzag)
    repainted_zigzag := polyline.new(points, xloc = xloc.bar_index, line_style = line.style_dotted, line_color = zigzag_color)

//==============================================================================
//                     FIBONACCI RETRACEMENT CALCULATION
//==============================================================================
var array<float> fib_levels = array.new<float>()

if bool(ta.change(bar_index))
    fib_levels.clear()
    for i = 0 to fib.size() - 1 by 1
        fib_levels.push(second_last_pivot.price + array.get(fib, i) * (last_pivot.price - second_last_pivot.price))

var array<label> fib_labels = array.new<label>()
var array<line> fib_lines = array.new<line>()

if new_pivot
    if fib_lines.size() > 0
        for j = 0 to fib_lines.size() - 1 by 1
            line.delete(fib_lines.get(j))
            label.delete(fib_labels.get(j))
    fib_lines.clear()
    fib_labels.clear()

    for i = 0 to array.size(fib) - 1 by 1
        fib_lines.push(line.new(second_last_pivot.index, fib_levels.get(i), bar_index + lbR + ret_bars, fib_levels.get(i), xloc.bar_index, color = fib_col.get(i), extend = extend.none))
        fib_labels.push(label.new(bar_index + lbR + ret_bars, fib_levels.get(i), str.tostring(fib.get(i)), xloc.bar_index, yloc.price, #00000000, label.style_label_left, fib_col.get(i), size.small, text.align_center))


//////////////Liquidity Sentiment Profile///////////
group_mode = '🎯 Mode Selection'
advanced_mode = input.bool(false, 'Advanced Mode', group = group_mode, tooltip = 'Enable advanced features and customization options')

group1 = '🔍 Detection Settings'
liq_swing_length = input.int(20, 'Swing Length', minval = 5, maxval = 100, group = group1, tooltip = 'Bars checked for swing point detection')
zscore_period = input.int(50, 'Z-Score Period', minval = 20, maxval = 200, group = group1, tooltip = 'Period for volume statistics calculation')

group2 = '📊 Thresholds'
normal_threshold = input.float(1.0, 'Normal Activity', minval = 0.5, maxval = 2.0, step = 0.1, group = group2, tooltip = 'Below this = Normal volume')
elevated_threshold = input.float(2.0, 'Elevated Activity', minval = 1.0, maxval = 3.0, step = 0.1, group = group2, tooltip = 'Above this = Elevated volume')
institutional_threshold = input.float(3.0, 'Institutional Activity', minval = 2.0, maxval = 5.0, step = 0.1, group = group2, tooltip = 'Above this = Potential accumulation/distribution')

group3 = '⚙️ Advanced Features'
use_adaptive = input.bool(true, 'Enable Adaptive Thresholds', group = group3, tooltip = 'Adjust thresholds based on market regime')
use_htf_confirm = input.bool(true, 'Higher Timeframe Confirmation', group = group3, tooltip = 'Confirm signals with HTF volume')
htf_timeframe = input.timeframe('', 'HTF (Auto if empty)', group = group3, tooltip = 'Leave empty for auto-detection')

group3_adv = '🚀 Advanced HTF Settings'
adaptive_htf_threshold = advanced_mode ? input.bool(true, 'Adaptive HTF Threshold', group = group3_adv, tooltip = 'Adjust HTF confirmation threshold based on market volatility') : true
volume_trend_arrows = advanced_mode ? input.bool(true, 'Volume Trend Arrows', group = group3_adv, tooltip = 'Show volume acceleration/deceleration arrows') : true
enhanced_sizing = advanced_mode ? input.bool(true, 'Enhanced Label Sizing', group = group3_adv, tooltip = 'Use larger labels for extreme institutional activity') : true

group4 = '📈 Display Options'
show_swing_labels = input.bool(true, 'Show Swing Labels', group = group4, tooltip = 'Display HH, LH, HL, LL labels')
show_zscore_values = input.bool(true, 'Show Z-Score Values', group = group4, tooltip = 'Display numerical Z-score values')
show_zscore_plot = input.bool(false, 'Show Z-Score Plot', group = group4, tooltip = 'Display Z-score in separate pane')
show_info_table = input.bool(true, 'Show Info Table', group = group4, tooltip = 'Display real-time statistics')
base_label_size = input.string('Medium', 'Label Size', options = ['Small', 'Medium', 'Large', 'X-Large'], group = group4, tooltip = 'Base size for all labels - adjust to your screen/chart setup')

group_table = '📊 Table Customization'
table_position = advanced_mode ? input.string('Top Right', 'Table Position', options = ['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right', 'Middle Left', 'Middle Right'], group = group_table) : 'Top Right'
table_size = advanced_mode ? input.string('Normal', 'Table Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = group_table) : 'Normal'
table_transparency = advanced_mode ? input.int(10, 'Table Transparency', minval = 0, maxval = 95, step = 5, group = group_table) : 10

volume_mean = ta.sma(volume, zscore_period)
volume_stdev = ta.stdev(volume, zscore_period)
volume_zscore = volume_stdev > 0 ? (volume - volume_mean) / volume_stdev : 0

volume_trend_period = 10
volume_sma_short = ta.sma(volume, 5)
volume_sma_long = ta.sma(volume, volume_trend_period)
volume_trend_ratio = volume_sma_long > 0 ? volume_sma_short / volume_sma_long : 1

get_volume_trend_arrow() =>
    if not volume_trend_arrows
        ''
    else if volume_trend_ratio > 1.15
        ' ↗️'
    else if volume_trend_ratio < 0.85
        ' ↘️'
    else
        ' ↔️'

ma20 = ta.sma(close, 20)
ma_slope = (ma20 - ma20[5]) / ta.atr(10) * 100
atr_current = ta.atr(14)
atr_avg = ta.sma(atr_current, 20)

is_trending = math.abs(ma_slope) > 0.5
is_high_vol = atr_current > atr_avg * 1.2

adaptive_multiplier = if use_adaptive
    base = is_trending ? 1.3 : 0.8
    vol_adj = is_high_vol ? 1.2 : 1.0
    base * vol_adj
else
    1.0

current_normal = normal_threshold * adaptive_multiplier
current_elevated = elevated_threshold * adaptive_multiplier
current_institutional = institutional_threshold * adaptive_multiplier

get_htf() =>
    if htf_timeframe != '' and htf_timeframe != timeframe.period
        htf_timeframe
    else
        current_tf_seconds = timeframe.in_seconds()
        if current_tf_seconds <= 60
            '5'
        else if current_tf_seconds <= 300
            '15'
        else if current_tf_seconds <= 900
            '60'
        else if current_tf_seconds <= 3600
            '240'
        else if current_tf_seconds <= 14400
            '1D'
        else if current_tf_seconds <= 86400
            '1W'
        else
            '1M'

liq_htf = get_htf()
current_tf_seconds = timeframe.in_seconds()
htf_seconds = timeframe.in_seconds(liq_htf)
is_htf_valid = htf_seconds > current_tf_seconds and use_htf_confirm

// Corrected: Replaced ternary tuple return with if/else
[htf_volume, htf_vol_mean, htf_vol_stdev] = if is_htf_valid
    request.security(syminfo.tickerid, liq_htf, [volume, ta.sma(volume, zscore_period), ta.stdev(volume, zscore_period)], lookahead = barmerge.lookahead_off)
else
    [volume, volume_mean, volume_stdev]

htf_zscore = if is_htf_valid and htf_vol_stdev > 0
    (htf_volume - htf_vol_mean) / htf_vol_stdev
else
    volume_zscore

base_htf_threshold = 1.5
adaptive_htf_multiplier = if adaptive_htf_threshold and is_htf_valid
    volatility_factor = atr_current / ta.sma(atr_current, 50)
    if volatility_factor > 1.5
        1.3
    else if volatility_factor < 0.7
        0.8
    else
        1.0
else
    1.0

current_htf_threshold = base_htf_threshold * adaptive_htf_multiplier

htf_confirmed = if use_htf_confirm and is_htf_valid
    math.abs(htf_zscore) >= current_htf_threshold
else
    true

var int total_signals = 0
var int confirmed_signals = 0

if not na(ta.pivothigh(high, liq_swing_length, liq_swing_length)) or not na(ta.pivotlow(low, liq_swing_length, liq_swing_length))
    total_signals := total_signals + 1
    if htf_confirmed
        confirmed_signals := confirmed_signals + 1

success_rate = total_signals > 0 ? math.round(confirmed_signals * 100 / total_signals) : 0

pivot_high = ta.pivothigh(high, liq_swing_length, liq_swing_length)
pivot_low = ta.pivotlow(low, liq_swing_length, liq_swing_length)

var float prev_high = 0.0
var float prev_low = 0.0
var bool first_high = true
var bool first_low = true

higher_high = false
lower_high = false
higher_low = false
lower_low = false

if not na(pivot_high)
    if first_high
        higher_high := true
        first_high := false
    else if pivot_high >= prev_high
        higher_high := true
    else
        lower_high := true
    prev_high := pivot_high

if not na(pivot_low)
    if first_low
        higher_low := true
        first_low := false
    else if pivot_low >= prev_low
        higher_low := true
    else
        lower_low := true
    prev_low := pivot_low

INSTITUTIONAL_COLOR = color.new(#ff4444, 0)
INSTITUTIONAL_COLOR_WEAK = color.new(#ff4444, 30)
ELEVATED_COLOR = color.new(#ff9800, 0)
ELEVATED_COLOR_WEAK = color.new(#ff9800, 30)
NORMAL_COLOR = color.new(#4caf50, 0)
NORMAL_COLOR_WEAK = color.new(#4caf50, 30)
LOW_COLOR = color.new(#9e9e9e, 60)

get_zscore_color(zscore) =>
    abs_zscore = math.abs(zscore)
    if abs_zscore >= current_institutional
        htf_confirmed ? INSTITUTIONAL_COLOR : INSTITUTIONAL_COLOR_WEAK
    else if abs_zscore >= current_elevated
        htf_confirmed ? ELEVATED_COLOR : ELEVATED_COLOR_WEAK
    else if abs_zscore >= current_normal
        htf_confirmed ? NORMAL_COLOR : NORMAL_COLOR_WEAK
    else
        LOW_COLOR

get_significance_text(zscore) =>
    abs_zscore = math.abs(zscore)
    if abs_zscore >= current_institutional
        '🔴 INSTITUTIONAL'
    else if abs_zscore >= current_elevated
        '🟠 ELEVATED'
    else if abs_zscore >= current_normal
        '🟢 NORMAL'
    else
        '⚪ LOW'

get_base_label_size() =>
    switch base_label_size
        'Small' => size.small
        'Medium' => size.normal
        'Large' => size.large
        'X-Large' => size.huge
        => size.normal

get_label_size(zscore) =>
    abs_zscore = math.abs(zscore)
    base_size = get_base_label_size()

    if enhanced_sizing and abs_zscore >= current_institutional and htf_confirmed
        switch base_label_size
            'Small' => size.large
            'Medium' => size.large
            'Large' => size.huge
            'X-Large' => size.huge
            => size.large
    else if enhanced_sizing and abs_zscore >= current_institutional
        base_size
    else if is_htf_valid and not htf_confirmed
        switch base_label_size
            'Small' => size.tiny
            'Medium' => size.small
            'Large' => size.normal
            'X-Large' => size.large
            => size.small
    else
        base_size

get_table_position() =>
    switch table_position
        'Top Left' => position.top_left
        'Top Right' => position.top_right
        'Bottom Left' => position.bottom_left
        'Bottom Right' => position.bottom_right
        'Middle Left' => position.middle_left
        'Middle Right' => position.middle_right
        => position.top_right

get_table_text_size() =>
    switch table_size
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        => size.normal

if not na(pivot_high)
    zscore_at_swing = volume_zscore[liq_swing_length]
    htf_zscore_at_swing = htf_zscore[liq_swing_length]
    swing_color = get_zscore_color(zscore_at_swing)

    label_text = ''
    volume_arrow = get_volume_trend_arrow()

    if show_swing_labels and show_zscore_values
        swing_type = higher_high ? 'HH' : 'LH'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow
    else if show_swing_labels
        swing_type = higher_high ? 'HH' : 'LH'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        label_text := htf_indicator + swing_type + volume_arrow
    else if show_zscore_values
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + 'Z:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := 'Z:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow

    if label_text != ''
        tooltip_text = 'Swing High: ' + (higher_high ? 'Higher High' : 'Lower High') + '\nCurrent TF Z-Score: ' + str.tostring(zscore_at_swing, '#.##') + '\nHTF Z-Score (' + liq_htf + '): ' + str.tostring(htf_zscore_at_swing, '#.##') + '\nSignificance: ' + get_significance_text(zscore_at_swing) + '\nHTF Confirmed: ' + (htf_confirmed ? '✓ YES' : '✗ NO') + '\nHTF Threshold: ' + str.tostring(current_htf_threshold, '#.##') + '\nVolume Trend: ' + (volume_trend_ratio > 1.15 ? 'Accelerating' : volume_trend_ratio < 0.85 ? 'Decelerating' : 'Stable') + '\nVolume: ' + str.tostring(volume[liq_swing_length] / 1000, '#.#') + 'K'

        label_size = get_label_size(zscore_at_swing)
        label.new(bar_index - liq_swing_length, pivot_high, label_text, color = swing_color, style = label.style_label_down, textcolor = color.white, size = label_size, tooltip = tooltip_text)

if not na(pivot_low)
    zscore_at_swing = volume_zscore[liq_swing_length]
    htf_zscore_at_swing = htf_zscore[liq_swing_length]
    swing_color = get_zscore_color(zscore_at_swing)

    label_text = ''
    volume_arrow = get_volume_trend_arrow()

    if show_swing_labels and show_zscore_values
        swing_type = higher_low ? 'HL' : 'LL'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := swing_type + '\nZ:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow
    else if show_swing_labels
        swing_type = higher_low ? 'HL' : 'LL'
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        label_text := htf_indicator + swing_type + volume_arrow
    else if show_zscore_values
        htf_indicator = is_htf_valid ? (htf_confirmed ? '✓' : '✗') : ''
        if is_htf_valid
            label_text := htf_indicator + 'Z:' + str.tostring(zscore_at_swing, '#.##') + '/' + str.tostring(htf_zscore_at_swing, '#.##') + volume_arrow
        else
            label_text := 'Z:' + str.tostring(zscore_at_swing, '#.##') + volume_arrow

    if label_text != ''
        tooltip_text = 'Swing Low: ' + (higher_low ? 'Higher Low' : 'Lower Low') + '\nCurrent TF Z-Score: ' + str.tostring(zscore_at_swing, '#.##') + '\nHTF Z-Score (' + liq_htf + '): ' + str.tostring(htf_zscore_at_swing, '#.##') + '\nSignificance: ' + get_significance_text(zscore_at_swing) + '\nHTF Confirmed: ' + (htf_confirmed ? '✓ YES' : '✗ NO') + '\nHTF Threshold: ' + str.tostring(current_htf_threshold, '#.##') + '\nVolume Trend: ' + (volume_trend_ratio > 1.15 ? 'Accelerating' : volume_trend_ratio < 0.85 ? 'Decelerating' : 'Stable') + '\nVolume: ' + str.tostring(volume[liq_swing_length] / 1000, '#.#') + 'K'

        label_size = get_label_size(zscore_at_swing)
        label.new(bar_index - liq_swing_length, pivot_low, label_text, color = swing_color, style = label.style_label_up, textcolor = color.white, size = label_size, tooltip = tooltip_text)

plot(show_zscore_plot ? volume_zscore : na, 'Volume Z-Score', color = #2196f3, linewidth = 2)
plot(show_zscore_plot ? current_institutional : na, 'Institutional', color = #ff4444, linewidth = 1)
plot(show_zscore_plot ? current_elevated : na, 'Elevated', color = #ff9800, linewidth = 1)
plot(show_zscore_plot ? current_normal : na, 'Normal', color = #4caf50, linewidth = 1)
plot(show_zscore_plot ? -current_normal : na, '-Normal', color = #4caf50, linewidth = 1)
plot(show_zscore_plot ? -current_elevated : na, '-Elevated', color = #ff9800, linewidth = 1)
plot(show_zscore_plot ? -current_institutional : na, '-Institutional', color = #ff4444, linewidth = 1)

bg_color = if show_zscore_plot
    abs_zscore = math.abs(volume_zscore)
    if abs_zscore >= current_institutional
        color.new(#ff4444, 95)
    else if abs_zscore >= current_elevated
        color.new(#ff9800, 95)
    else if abs_zscore >= current_normal
        color.new(#4caf50, 95)
    else
        na
else
    na

bgcolor(bg_color, title = 'Z-Score Background')

if show_info_table and barstate.isconfirmed
    table_pos = get_table_position()
    text_size = get_table_text_size()
    table_rows = advanced_mode ? 12 : 8

    var table info_table = table.new(table_pos, 2, table_rows, bgcolor = color.new(color.white, table_transparency), border_width = 1)

    header_color = advanced_mode ? color.new(color.blue, 20) : color.new(color.gray, 20)
    table.cell(info_table, 0, 0, 'VOLUME Z-SCORE', text_color = color.white, bgcolor = header_color, text_size = text_size)
    table.cell(info_table, 1, 0, advanced_mode ? 'ADVANCED ANALYSIS' : 'ANALYSIS', text_color = color.white, bgcolor = header_color, text_size = text_size)

    table.cell(info_table, 0, 1, 'Current TF Z-Score', text_color = color.black, text_size = text_size)
    zscore_color = get_zscore_color(volume_zscore)
    table.cell(info_table, 1, 1, str.tostring(volume_zscore, '#.##'), text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 2, 'HTF Z-Score (' + liq_htf + ')', text_color = color.black, text_size = text_size)
    htf_text = is_htf_valid ? str.tostring(htf_zscore, '#.##') : 'Disabled/Invalid'
    htf_color = is_htf_valid ? get_zscore_color(htf_zscore) : color.gray
    table.cell(info_table, 1, 2, htf_text, text_color = htf_color, text_size = text_size)

    table.cell(info_table, 0, 3, 'Combined Z-Scores', text_color = color.black, text_size = text_size)
    combined_text = is_htf_valid ? str.tostring(volume_zscore, '#.##') + ' / ' + str.tostring(htf_zscore, '#.##') : str.tostring(volume_zscore, '#.##') + ' / N/A'
    table.cell(info_table, 1, 3, combined_text, text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 4, 'Volume Trend', text_color = color.black, text_size = text_size)
    trend_text = volume_trend_ratio > 1.15 ? '↗️ Accelerating' : volume_trend_ratio < 0.85 ? '↘️ Decelerating' : '↔️ Stable'
    trend_color = volume_trend_ratio > 1.15 ? color.green : volume_trend_ratio < 0.85 ? color.red : color.blue
    table.cell(info_table, 1, 4, trend_text, text_color = trend_color, text_size = text_size)

    table.cell(info_table, 0, 5, 'HTF Confirmation', text_color = color.black, text_size = text_size)
    confirm_text = use_htf_confirm and is_htf_valid ? (htf_confirmed ? '✓ CONFIRMED' : '✗ NOT CONFIRMED') : 'DISABLED/INVALID'
    confirm_color = use_htf_confirm and is_htf_valid ? (htf_confirmed ? NORMAL_COLOR : INSTITUTIONAL_COLOR) : color.gray
    table.cell(info_table, 1, 5, confirm_text, text_color = confirm_color, text_size = text_size)

    table.cell(info_table, 0, 6, 'Significance', text_color = color.black, text_size = text_size)
    significance = get_significance_text(volume_zscore)
    table.cell(info_table, 1, 6, significance, text_color = zscore_color, text_size = text_size)

    table.cell(info_table, 0, 7, 'HTF Success Rate', text_color = color.black, text_size = text_size)
    success_text = str.tostring(success_rate) + '% (' + str.tostring(confirmed_signals) + '/' + str.tostring(total_signals) + ')'
    success_color = success_rate >= 70 ? color.green : success_rate >= 50 ? color.orange : color.red
    table.cell(info_table, 1, 7, success_text, text_color = success_color, text_size = text_size)

    if advanced_mode
        table.cell(info_table, 0, 8, 'HTF Threshold', text_color = color.black, text_size = text_size)
        htf_threshold_text = str.tostring(current_htf_threshold, '#.##') + (adaptive_htf_threshold ? ' (Adaptive)' : ' (Static)')
        table.cell(info_table, 1, 8, htf_threshold_text, text_color = color.blue, text_size = text_size)

        table.cell(info_table, 0, 9, 'Market Regime', text_color = color.black, text_size = text_size)
        regime_text = use_adaptive ? (is_trending ? 'Trending' : 'Ranging') + (is_high_vol ? ' High-Vol' : '') : 'Static'
        regime_color = use_adaptive ? (is_trending ? color.blue : color.orange) : color.gray
        table.cell(info_table, 1, 9, regime_text, text_color = regime_color, text_size = text_size)

        table.cell(info_table, 0, 10, 'Threshold Multiplier', text_color = color.black, text_size = text_size)
        multiplier_text = use_adaptive ? str.tostring(adaptive_multiplier, '#.##') + 'x' : '1.00x'
        table.cell(info_table, 1, 10, multiplier_text, text_color = color.blue, text_size = text_size)

        table.cell(info_table, 0, 11, 'Active Thresholds', text_color = color.black, text_size = text_size)
        active_thresholds_text = '🟢' + str.tostring(current_normal, '#.#') + ' 🟠' + str.tostring(current_elevated, '#.#') + ' 🔴' + str.tostring(current_institutional, '#.#')
        table.cell(info_table, 1, 11, active_thresholds_text, text_color = color.black, text_size = text_size)

institutional_high = not na(pivot_high) and math.abs(volume_zscore[liq_swing_length]) >= current_institutional
institutional_low = not na(pivot_low) and math.abs(volume_zscore[liq_swing_length]) >= current_institutional

alertcondition(institutional_high, '🔴 Distribution Alert', 'High volume at swing high - potential distribution')
alertcondition(institutional_low, '🟢 Accumulation Alert', 'High volume at swing low - potential accumulation')

htf_confirmed_high = institutional_high and htf_confirmed
htf_confirmed_low = institutional_low and htf_confirmed

alertcondition(htf_confirmed_high, '🔴 Confirmed Distribution', 'HTF confirmed high volume at swing high')
alertcondition(htf_confirmed_low, '🟢 Confirmed Accumulation', 'HTF confirmed high volume at swing low')

regime_change = use_adaptive and (is_trending != is_trending[1] or is_high_vol != is_high_vol[1])
alertcondition(regime_change, '📊 Regime Change', 'Market regime changed - thresholds adjusted')

htf_invalid = use_htf_confirm and not is_htf_valid
alertcondition(htf_invalid, '⚠️ HTF Invalid', 'Higher timeframe is invalid or not higher than current')

//--------------------------------------------------------------------------------------------------------------------}
//////////VWAP///////////

evnHi = timestamp('10 Nov 2021 00:00 +0000')
evnLo = timestamp('21 Sep 2021 00:00 +0000')
evnHO = timestamp('24 Jan 2022 00:00 +0000')

colHi = #ff00664d
colLo = #ff00ff4d
colHO = #9900ff4d
